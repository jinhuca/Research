<UserControl x:Class="Module.Infrastructure.Controls.ErrorMessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:Module.Infrastructure.Controls"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:constants="clr-namespace:Module.Infrastructure.Constants"
             xmlns:infrastructure="clr-namespace:Module.Infrastructure"
             mc:Ignorable="d"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             Width="800" Height="650" d:DataContext="{d:DesignInstance local:ErrorMessageDialogViewModel}">
    <mvvm:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="mvvm:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Topmost" Value="True"/>
        </Style>
    </mvvm:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Module.Infrastructure;component/Themes/Generic.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
            <infrastructure:InvertBooleanToVisibilityConverter x:Key="invertBooleanToVisibilityConverter" />

            <Style TargetType="Border" x:Key="ErrorMessageBorderStyle">
                <Setter Property="Background" Value="{StaticResource SystemMessageBrushBackground}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsErrorMessage}" Value="true">
                        <Setter Property="Background" Value="Red"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Border BorderThickness="0" CornerRadius="10,10,10,10" Style="{StaticResource ErrorMessageBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding MessageDialogTitle}" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Background="Transparent" Foreground="White"/>
            <Button Grid.Row="0"  x:Name="WarningButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                                 Width="50" Height="50"
                                 Style="{StaticResource WarningButton}"
                                 RenderTransformOrigin="0.5,0.5"
                                 Margin="0,0,125,0"
                                 Command="{Binding ToggleErrorMessageCommand}" >
            </Button>

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" Background="{StaticResource SystemMessageBrushControlContainer}" 
                    Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" FontSize="25" FontWeight="Bold" Foreground="Yellow" HorizontalAlignment="Center" 
                                   Text="{Binding MessageTitle}"/>

                    <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" 
                            Background="{StaticResource SystemMessageBrushContentContainer }" Margin="5,5,5,5">

                        <Viewbox VerticalAlignment="Top" Height="150" HorizontalAlignment="Left" Margin="10,10,10,10" Stretch="Uniform" StretchDirection="DownOnly" >
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" >
                                <TextBlock x:Name="txtMessage" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" 
                                           TextAlignment="Left" Foreground="Black" FontSize="20" FontWeight="Bold" Height="160" Width="800" 
                                           Text="{Binding CurrentMessage}"/>
                            </ScrollViewer>
                        </Viewbox>
                    </Border>

                    <TextBlock Grid.Row="2" Margin="0,0,0,-10" FontSize="25" FontWeight="Bold" Foreground="Yellow" HorizontalAlignment="Center"
                           Text="Action Required" Height="40" 
                           Visibility="{Binding IsActionRequired, Converter={StaticResource booleanToVisibilityConverter}}" />
                    <Border Name="ActionRequiredBox" Grid.Row="3" BorderThickness="1" CornerRadius="10"
                            Background="{StaticResource SystemMessageBrushContentContainer }" Margin="5,5,5,5"
                            Visibility="{Binding IsActionRequired, Converter={StaticResource booleanToVisibilityConverter}}">
                        <Viewbox VerticalAlignment="Top" Height="150" Margin="5,10,0,0" Grid.RowSpan="2" HorizontalAlignment="Left" StretchDirection="Both">

                            <StackPanel Orientation="Horizontal" >
                                <TextBlock x:Name="txtAction" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left"
                                               Foreground="Black" FontSize="20" FontWeight="Bold" Height="160" Width="800"
                                               Text="{Binding CurrentActionDescription}"/>
                            </StackPanel>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Row="4" Margin="0,10,0,10" Orientation="Horizontal" HorizontalAlignment="Center" >
                        <Button Name="PreviousMessageButton" Width="50" Height="50" Style="{StaticResource CircularButtonStyle}" 
                                Command="{Binding GoToPreviousCommand}">
                            <Image Source="../Images/Arrow.png" Stretch="UniformToFill" Height="50" Width="50" />
                        </Button>

                        <TextBlock Foreground="White" FontSize="28" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,20,0">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} of {1}" >
                                    <Binding Path="CurrentMessageIndex" />
                                    <Binding Path="TotalMessageCount"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <Button Width="50" Height="50" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" 
                                Command="{Binding GoToNextCommand}">
                            <Button.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform />
                                    <SkewTransform />
                                    <RotateTransform Angle="180" />
                                    <TranslateTransform />
                                </TransformGroup>
                            </Button.RenderTransform>
                            <Image Source="../Images/Arrow.png" Stretch="UniformToFill" Height="50" Width="50" />
                        </Button>
                    </StackPanel>

                    <Grid Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="235" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="235" />
                        </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Name="VolumeControlStackPanel" HorizontalAlignment="Left" Margin="0,0,0,0"
                                                 Width="235" Background="Transparent">
                                <Button Name="MuteVolumeButton" Width="60" Height="60" Padding="0,0,0,0" BorderThickness="0"
                                    Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,0" HorizontalAlignment="Center" 
                                    Visibility="{Binding IsVolumeOn, Converter={StaticResource  invertBooleanToVisibilityConverter}}"
                                    Command="{Binding EnableVolumeCommand}">
                                    <Image Source="../Images/Mutebutton.png" Stretch="UniformToFill" Height="60" Width="60" RenderTransformOrigin="0.5,0.5" />
                                </Button>

                                <Button Name="MaxVolumeButton" Width="60" Height="60" Padding="0,0,0,0" BorderThickness="0"
                                    Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,0" HorizontalAlignment="Center"
                                    Visibility="{Binding IsVolumeOn, Converter={StaticResource booleanToVisibilityConverter}}"
                                    Command="{Binding MuteVolumeCommand}">
                                    <Image Source="../Images/VolumeLow.png" Stretch="UniformToFill" Height="60" Width="60" RenderTransformOrigin="0.5,0.5" />
                                </Button>
                            </Grid>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Style="{StaticResource RoundCorner}" Content="Continue" Margin="0,10,10,10" Width="150"
                                    VerticalAlignment="Center" 
                                    Command="{Binding CloseDialogCommand}" CommandParameter="{x:Static constants:Strings.YesText}"/>
                            <Button Style="{StaticResource RoundCorner}" Content="No" Margin="10,10,0,10" Width="150"
                                    VerticalAlignment="Center"  Visibility="Collapsed"
                                    Command="{Binding CloseDialogCommand}" CommandParameter="{x:Static constants:Strings.NoText}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
