<UserControl x:Class="Module.Infrastructure.Controls.MessageDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:constants="clr-namespace:Module.Infrastructure.Constants"
             Width="650" Height="350"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
	<prism:Dialog.WindowStyle>
		<Style TargetType="Window">
			<Setter Property="prism:Dialog.WindowStartupLocation" Value="CenterScreen"/>
			<Setter Property="ShowInTaskbar" Value="False"/>
			<Setter Property="WindowStyle" Value="None"/>
			<Setter Property="AllowsTransparency" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="Topmost" Value="True"/>
		</Style>
	</prism:Dialog.WindowStyle>
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="../Themes/PrismDialog.xaml"/>
			</ResourceDictionary.MergedDictionaries>
            <Style x:Key="MessageDialogBorderStyle" TargetType="Border" BasedOn="{StaticResource MainBorderStyle}">
                <Style.Resources>
                    <Storyboard x:Key="FlashStoryboard">
                        <DoubleAnimation Storyboard.TargetProperty="BorderBrush.Opacity" From="0" To="1" Duration="0:0:0.8" RepeatBehavior="Forever" AutoReverse="True"/>
                    </Storyboard>
                </Style.Resources>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MessageDialogType}" Value="Warning">
                        <Setter Property="BorderBrush" Value="Yellow"/>
						<DataTrigger.EnterActions>
                            <BeginStoryboard Name="WarningBorderFlash" Storyboard="{StaticResource FlashStoryboard}"/>
                        </DataTrigger.EnterActions>
						<DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="WarningBorderFlash" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding MessageDialogType}" Value="Error">
                        <Setter Property="BorderBrush" Value="Red"/>
                        <DataTrigger.EnterActions>
                            <BeginStoryboard Name="ErrorBorderFlash" Storyboard="{StaticResource FlashStoryboard}"/>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="ErrorBorderFlash" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
		</ResourceDictionary>
	</UserControl.Resources>
    <Border Style="{StaticResource MessageDialogBorderStyle}">
        <Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="50"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource MessageTitleTextBlockStyle}"/>
			<Border Grid.Row="1" Style="{StaticResource MessageBorderStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="55"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
					           Text="{Binding Message}" Style="{StaticResource MessageTextBlockStyle}"/>
					<Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Button Style="{StaticResource ButtonOnDialogStyle}" 
							        Content="{x:Static constants:Strings.OKText}" 
							        Command="{Binding CloseDialogCommand}" 
							        CommandParameter="{x:Static constants:Strings.YesText}"/>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Border>
</UserControl>
