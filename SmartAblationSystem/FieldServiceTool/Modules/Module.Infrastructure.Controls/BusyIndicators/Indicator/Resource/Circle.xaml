<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Module.Infrastructure.Controls">
	<ControlTemplate x:Key="Circle" TargetType="{x:Type controls:Indicator}">
		<Grid x:Name="MainGrid" HorizontalAlignment="Center" VerticalAlignment="Center">
			<Grid.Resources>
				<Style x:Key="rectStyle" TargetType="Rectangle">
					<Setter Property="Width" Value="4"/>
					<Setter Property="Height" Value="11"/>
					<Setter Property="RadiusX" Value="2"/>
					<Setter Property="RadiusY" Value="2"/>
					<Setter Property="Canvas.Left" Value="22"/>
					<Setter Property="Canvas.Top" Value="4"/>
					<Setter Property="Fill" Value="{DynamicResource IndicatorForeground}"/>
				</Style>
			</Grid.Resources>
			<Canvas Width="50" Height="50">
				<Rectangle x:Name="Rectangle01" 
				           Style="{DynamicResource rectStyle}"
				           Opacity="1"/>
				<Rectangle x:Name="Rectangle02"
				           Style="{DynamicResource rectStyle}"
				           Opacity="1"
				           RenderTransformOrigin="0.5,0.5">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="30"/>
							<TranslateTransform X="7.5" Y="2"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle03"
				           Style="{DynamicResource rectStyle}"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="60"/>
							<TranslateTransform X="13" Y="7.5"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle04"
				           Style="{DynamicResource rectStyle}"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="90"/>
							<TranslateTransform X="15" Y="15"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle05"
				           Style="{DynamicResource rectStyle}"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="120"/>
							<TranslateTransform X="13" Y="22.5"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle06"
				           Style="{DynamicResource rectStyle}"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="150"/>
							<TranslateTransform X="7.5" Y="28"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle07"
				           Style="{DynamicResource rectStyle}"
				           Canvas.Top="34"
				           Opacity="0.2"
				           RenderTransformOrigin="0.562,0.3"/>
				<Rectangle x:Name="Rectangle08"
				           Style="{DynamicResource rectStyle}"
				           Canvas.Top="34"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="30"/>
							<TranslateTransform X="-7.5" Y="-2"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle09"
				           Style="{DynamicResource rectStyle}"
				           Canvas.Top="34"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="60"/>
							<TranslateTransform X="-13" Y="-7.5"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle10"
				           Style="{DynamicResource rectStyle}"
				           Canvas.Top="34"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="90"/>
							<TranslateTransform X="-15" Y="-15"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle11"
				           Style="{DynamicResource rectStyle}"
				           Canvas.Top="34"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="120"/>
							<TranslateTransform X="-13" Y="-22.5"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
				<Rectangle x:Name="Rectangle12"
				           Style="{DynamicResource rectStyle}"
				           Canvas.Top="34"
				           Opacity="0.2"
				           RenderTransformOrigin="0.5,0.5"
				           UseLayoutRounding="False">
					<Rectangle.RenderTransform>
						<TransformGroup>
							<ScaleTransform/>
							<SkewTransform/>
							<RotateTransform Angle="150"/>
							<TranslateTransform X="-7.5" Y="-28"/>
						</TransformGroup>
					</Rectangle.RenderTransform>
				</Rectangle>
			</Canvas>
			<VisualStateManager.VisualStateGroups>
				<VisualStateGroup x:Name="ActiveStates">
					<VisualState x:Name="Active">
						<Storyboard BeginTime="00:00:00" RepeatBehavior="Forever">
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle01"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.20" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle12"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.20" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01.10" Value="1"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle11"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.90" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01.10" Value="0.5"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle02"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.20" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle03"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.20" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.50" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle04"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.20" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.50" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.60" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle05"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.30" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.50" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.60" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.70" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle06"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.40" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.50" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.60" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.70" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.80" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle07"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.50" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.60" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.70" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.80" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.90" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle08"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.60" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.70" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.80" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.90" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle09"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.70" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.80" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.90" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.25"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01.10" Value="0.2"/>
							</DoubleAnimationUsingKeyFrames>
							<DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
							                               Storyboard.TargetName="Rectangle10"
							                               Storyboard.TargetProperty="(UIElement.Opacity)">
								<EasingDoubleKeyFrame KeyTime="00:00:00.10" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.8000000" Value="0.2"/>
								<EasingDoubleKeyFrame KeyTime="00:00:00.90" Value="1"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01" Value="0.5"/>
								<EasingDoubleKeyFrame KeyTime="00:00:01.10" Value="0.25"/>
							</DoubleAnimationUsingKeyFrames>
						</Storyboard>
					</VisualState>
				</VisualStateGroup>
			</VisualStateManager.VisualStateGroups>
		</Grid>
	</ControlTemplate>
</ResourceDictionary>