<UserControl x:Class="Module.TestProcess.Views.Step1VersionVerificationDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:constants="clr-namespace:Module.TestProcess.Constants"
						 prism:ViewModelLocator.AutoWireViewModel="True"
             Width="700" Height="580"
             mc:Ignorable="d" d:DesignHeight="575" d:DesignWidth="800">
	<UserControl.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/Module.Infrastructure;component/Themes/Generic.xaml"/>
				<ResourceDictionary Source="pack://application:,,,/Module.Infrastructure;component/Themes/PrismDialog.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</UserControl.Resources>
	<prism:Dialog.WindowStyle>
		<Style TargetType="Window">
			<Setter Property="WindowStyle" Value="None"/>
			<Setter Property="WindowState" Value="Maximized"/>
			<Setter Property="Topmost" Value="True"/>
			<Setter Property="AllowsTransparency" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
		</Style>
	</prism:Dialog.WindowStyle>
	<Border Style="{StaticResource PassFailBorderStyle}">
		<Grid>
			<Grid.RowDefinitions>
				<RowDefinition Height="45"/>
                <RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>
			<TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource ConfirmationDialogTitleTextBlockStyle}"/>
            <TextBlock Grid.Row="1" Text="{Binding RemindMessage}" Style="{StaticResource MessageTextBlockStyle}" x:Name="_versionVerificationMessage"/>
			<Border Grid.Row="2" Style="{StaticResource MessageBorderStyle}">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="*"/>
						<RowDefinition Height="55"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*"/>
						<ColumnDefinition Width="*"/>
					</Grid.ColumnDefinitions>
					<Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Margin="15">
						<Grid.ColumnDefinitions>
							<ColumnDefinition/>
							<ColumnDefinition/>
						</Grid.ColumnDefinitions>
						<Grid Grid.Column="0">
							<Grid.RowDefinitions>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
							</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding BootloaderText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}" HorizontalAlignment="Right"/>
							<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FirmwareText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}" HorizontalAlignment="Left"/>
							<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CMCUBooTVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
							<TextBlock Name="CMCUBoot" Grid.Row="1" Grid.Column="1" Text="{Binding VersionParams.CMCUBootVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="2" Grid.Column="0"/>
							<TextBlock Grid.Row="2" Grid.Column="1"/>
							<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding PMCUBootVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="PMCUBoot" Grid.Row="3" Grid.Column="1" Text="{Binding VersionParams.PMCUBootVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding RMCUBootVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="RMCUBoot" Grid.Row="4" Grid.Column="1" Text="{Binding VersionParams.RMCUBootVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding ICBBootVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="ICBBoot" Grid.Row="5" Grid.Column="1" Text="{Binding VersionParams.ICBBootVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding RCMCUBootVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="RCMCUBoot" Grid.Row="6" Grid.Column="1" Text="{Binding VersionParams.RCMCUBootVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
						</Grid>
						<Grid Grid.Column="1" ShowGridLines="False">
							<Grid.RowDefinitions>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
								<RowDefinition/>
						</Grid.RowDefinitions>
							<Grid.ColumnDefinitions>
								<ColumnDefinition/>
								<ColumnDefinition/>
							</Grid.ColumnDefinitions>
							<TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding ApplicationText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}" HorizontalAlignment="Right"/>
							<TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FirmwareText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}" HorizontalAlignment="Left"/>
							<TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CMCUVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="CMCUApp" Grid.Row="1" Grid.Column="1" Text="{Binding VersionParams.CMCUVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="2" Grid.Column="0" Text="{Binding CPLDVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="CPLD" Grid.Row="2" Grid.Column="1" Text="{Binding VersionParams.CPLDVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="3" Grid.Column="0" Text="{Binding PMCUVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="PMCUApp" Grid.Row="3" Grid.Column="1" Text="{Binding VersionParams.PMCUVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="4" Grid.Column="0" Text="{Binding RMCUVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="RMCUApp" Grid.Row="4" Grid.Column="1" Text="{Binding VersionParams.RMCUVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="5" Grid.Column="0" Text="{Binding ICBVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="ICBApp" Grid.Row="5" Grid.Column="1" Text="{Binding VersionParams.ICBVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="6" Grid.Column="0" Text="{Binding RCMCUVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="RCMCUApp" Grid.Row="6" Grid.Column="1" Text="{Binding VersionParams.RCMCUVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding GUIVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="GUI" Grid.Row="7" Grid.Column="1" Text="{Binding VersionParams.GUIVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
							<TextBlock Grid.Row="8" Grid.Column="0" Text="{Binding DBVersionText, Mode=OneTime}" Style="{StaticResource Step1VersionVerificationTextBlockStyle}"/>
                            <TextBlock Name="DB" Grid.Row="8" Grid.Column="1" Text="{Binding VersionParams.DBVersion}" Style="{StaticResource VersionValueBlackStyle}"/>
						</Grid>
					</Grid>
					<Grid Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="2" ShowGridLines="True">
						<StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
							<Button Style="{StaticResource ButtonOnDialogStylePass}" 
							        Content="{x:Static constants:TestResult.Pass}" 
							        Command="{Binding CloseDialogCommand}" 
							        CommandParameter="{x:Static constants:TestConfirmationParameter.ParamYes}"/>
							<Button Style="{StaticResource ButtonOnDialogStyleFail}" 
							        Content="{x:Static constants:TestResult.Fail}" 
							        Command="{Binding CloseDialogCommand}" 
							        CommandParameter="{x:Static constants:TestConfirmationParameter.ParamNo}"/>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Border>
</UserControl>
