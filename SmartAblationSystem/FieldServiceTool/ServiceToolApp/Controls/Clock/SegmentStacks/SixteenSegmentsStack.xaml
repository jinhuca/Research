<local:SegmentsStackBase x:Class="ServiceToolApp.Controls.Clock.SegmentStacks.SixteenSegmentsStack"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                   xmlns:local="clr-namespace:ServiceToolApp.Controls.Clock.SegmentStacks"
                   xmlns:clock="clr-namespace:ServiceToolApp.Controls.Clock"
                   xmlns:segments="clr-namespace:ServiceToolApp.Controls.Clock.Segments"
                   mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
	<Grid>
		<ItemsControl x:Name="SegmentsArray">
			<ItemsControl.ItemsPanel>
				<ItemsPanelTemplate>
					<clock:ArrangedPanel/>
				</ItemsPanelTemplate>
			</ItemsControl.ItemsPanel>
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<clock:ArrangedPanel>
						<segments:SixteenSegments Value="{Binding Item}" 
						                          ShowDot="{Binding ShowDot}" 
						                          OnDot="{Binding OnDot}"
						                          ShowColon="{Binding ShowColon}" 
						                          OnColon="{Binding OnColon}"
						                          FillBrush="{Binding FillBrush}"
						                          SelectedFillBrush ="{Binding SelectedFillBrush}"
						                          PenColor ="{Binding PenColor}"
						                          SelectedPenColor ="{Binding SelectedPenColor}"
						                          PenThickness ="{Binding PenThickness}"
						                          GapWidth ="{Binding GapWidth}"
						                          RoundedCorners="{Binding RoundedCorners}"
						                          TiltAngle ="{Binding TiltAngle}"
						                          VerticalSegmentDivider ="{Binding VerticalSegmentDivider}"
						                          HorizontalSegmentDivider ="{Binding HorizontalSegmentDivider}"
						                          Margin="5,0,0,0"/>
					</clock:ArrangedPanel>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
	</Grid>
</local:SegmentsStackBase>
