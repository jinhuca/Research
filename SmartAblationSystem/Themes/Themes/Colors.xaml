<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<RadialGradientBrush x:Key="BackgroundTherapy"
	                     MappingMode="Absolute" GradientOrigin="15.488,0.337" Center="15.488,0.337" RadiusX="0.387" RadiusY="0.387">
		<RadialGradientBrush.GradientStops>
			<GradientStop Offset="0.00" Color="#ff1b1b21"/>
			<GradientStop Offset="1.00" Color="#ff1b1b21"/>
		</RadialGradientBrush.GradientStops>
		<RadialGradientBrush.Transform>
			<MatrixTransform Matrix="-61.440,-1078.920,1537.920,-27.000,1370.520,17094.241" />
		</RadialGradientBrush.Transform>
	</RadialGradientBrush>


	<Color x:Key="PureWhiteColor" A="#FF" R="#FF" G="#FF" B="#FF"/>
  <SolidColorBrush x:Key="PureWhiteBrush" Color="{StaticResource PureWhiteColor}"/>

	<SolidColorBrush x:Key="PanelBackground" Color="#ff2a2a32"/>

	<SolidColorBrush x:Key="IdleStateColor" Color="#ffbd55a7"/>

	<SolidColorBrush x:Key="DetailsPanelBackground" Color="#ff34343f"/>

	<SolidColorBrush x:Key="DetailsPanelBorderBrush" Color="#ff474751"/>

</ResourceDictionary>