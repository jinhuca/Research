	<Style x:Key="ImageBlinking" TargetType="{x:Type Image}">
		<Style.Triggers>
			<DataTrigger Binding="{Binding SystemState}" Value="1280">
				<DataTrigger.EnterActions>
					<BeginStoryboard x:Name="blinking">
						<Storyboard RepeatBehavior="Forever">
							<DoubleAnimation Storyboard.TargetProperty="Opacity" AutoReverse="True"
                                             To="0.1" Duration="0:0:0.5">
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</DataTrigger.EnterActions>
				<DataTrigger.ExitActions>
					<StopStoryboard BeginStoryboardName="blinking" />
				</DataTrigger.ExitActions>
			</DataTrigger>
		</Style.Triggers>
	</Style>

