<UserControl x:Class="CustomControls.UserControls.ETSTemperatureGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" >
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="FontFamily" Value="{StaticResource Lato}" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="#ffcec3c6" />
    </Style>
  </UserControl.Resources>
  <Viewbox Stretch="Uniform" >
    <Grid Width="328" Height="192" Background="#FF353540">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel Orientation="Vertical">
        <TextBlock Text="ESOPHAGUS TEMPERATURE" FontSize="14" Margin="0,0, 0, 10"/>
        <TextBlock Text="Probe Temperature / 0 - 40 °C" FontSize="12" />
      </StackPanel>
      <StackPanel Grid.Row="1" Name="_etsTemperatureGraphStackPanel" />
    </Grid>
  </Viewbox>
</UserControl>
