<UserControl x:Class="CustomControls.UserControls.ValueEditorWithUpDownButtonsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:CustomControls.UserControls"
             mc:Ignorable="d" >
  <UserControl.Resources>
    <Style TargetType="userControls:CustomTextBox">
      <Setter Property="Background" Value="#ff26262e"/>
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="#ffffffff"/>
      <Setter Property="FontFamily" Value="{StaticResource Lato}" />
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="BorderThickness" Value="0.5" />
      <Setter Property="BorderBrush" Value="#ff4f4e57"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Path=IsEditable, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Value="True">
          <Setter Property="Background" Value="#ff4a5f8f"/>
          <Setter Property="BorderBrush" Value="#ffffffff"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding Path=IsEditable, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Value="True">
          <Setter Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Popup">
      <Setter Property="Placement" Value="Left" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Source={x:Static SystemParameters.MenuDropAlignment}}" Value="False">
          <Setter Property="Placement" Value ="Right" />
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </UserControl.Resources>

  <Viewbox Stretch="Uniform">
    <Grid Height="55" Width="185">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="110"/>
      </Grid.ColumnDefinitions>

      <userControls:CustomTextBox x:Name="_valueTextBox" IsReadOnly="True" Height="42" Width="60" PreviewMouseUp="_valueTextBox_OnPreviewMouseUp"
                     Text="{Binding Path=Value, Mode=TwoWay, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" >
        <userControls:CustomTextBox.Resources>
          <Style TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="5"/>
          </Style>
        </userControls:CustomTextBox.Resources>
      </userControls:CustomTextBox>
      <!-- 2nd column: Unit or Up Down Control buttons-->
      <TextBlock Grid.Column="1" Name="_unitTextBlock" Text="{Binding Path=Unit, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                 HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource Lato}" FontSize="16" Foreground="#ffffffff" />
      <Popup x:Name="_popup" PlacementTarget="{Binding ElementName=_valueTextBox}" 
             HorizontalOffset="8" VerticalOffset="-5" HorizontalAlignment="Center" VerticalAlignment="Center"
             StaysOpen="False" AllowsTransparency="True" Closed="Popup_OnClosed"  
           IsOpen="{Binding Path=IsEditable, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" >

        <Border Name="_updownButtonsControl" Background="#ff474751" CornerRadius="25" Margin="10">
          <Border.Effect>
            <DropShadowEffect Color="#ff25252d" BlurRadius="8" Direction="-90"/>
          </Border.Effect>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource SettingUpArrowButtonStyle}" Margin="5"
                  Command="{Binding Path=IncrementalCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
            <Button Grid.Column="1" Style="{StaticResource SettingDownArrowButtonStyle}" Margin="5"
                  Command="{Binding Path=DecrementalCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
          </Grid>
        </Border>
      </Popup>

    </Grid>
  </Viewbox>
</UserControl>
