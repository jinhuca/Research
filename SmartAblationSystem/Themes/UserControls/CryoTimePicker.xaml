<UserControl x:Class="CustomControls.UserControls.CryoTimePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControls.UserControls"
             mc:Ignorable="d" >
  <UserControl.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="TextAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
  </UserControl.Resources>
  <Border Width="230" Height="183" BorderBrush="#ff707070" BorderThickness="0" Background="#FF26262E" CornerRadius="5">
    <Grid Margin="20,10" >
      <Grid.RowDefinitions>
        <RowDefinition />
        <RowDefinition />
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="30" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Up button Panel -->
      <Path Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="34" Stretch="uniform" Fill="#ff2b2b33" Stroke="#ff4f4e57" 
            Data="M 104,0 L 273,0 C 278.5,0 283,4.5 283,10 L 283,24 C 283,29.5 278.5,34 273,34 L 104,34 C 98.5,34 94,29.5 94,24 L 94,10 C 94,4.5 98.5,0 104,0 Z" />
      <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource UpArrowBtnStyle}" Height="34" Margin="10,0,0,0"
              Command="{Binding GoToNextHour, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
      <Button Grid.Row="0" Grid.Column="2" Style="{StaticResource UpArrowBtnStyle}" Height="34" Margin="0,0,10,0"
              Command="{Binding GoToNextMinute, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>

      <!-- Time value Panel -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding CurrentHour, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="10,0,0,0"/>
      <TextBlock Grid.Row="1" Grid.Column="1" Text=":" />
      <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CurrentMinute, StringFormat={}{0:00},
        RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" Margin="0,0,10,0"/>

      <!-- Down button Panel -->
      <Path Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Height="34" Stretch="uniform" Fill="#ff2b2b33" Stroke="#ff4f4e57" 
            Data="M 104,0 L 273,0 C 278.5,0 283,4.5 283,10 L 283,24 C 283,29.5 278.5,34 273,34 L 104,34 C 98.5,34 94,29.5 94,24 L 94,10 C 94,4.5 98.5,0 104,0 Z" />
      <Button Grid.Row="2" Grid.Column="0" Style="{StaticResource DownArrowBtnStyle}" Height="34" Margin="10,0,0,0"
              Command="{Binding GoToPreviousHour, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
      <Button Grid.Row="2" Grid.Column="2" Style="{StaticResource DownArrowBtnStyle}" Height="34" Margin="0,0,10,0"
              Command="{Binding GoToPreviousMinute, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>

    </Grid>
  </Border>
</UserControl>
