<UserControl x:Class="CustomControls.UserControls.ChangeTankStepUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CustomControls.UserControls"
             mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../Resources/ChangeTankResources.xaml"></ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="StepBubbleStyle" TargetType="Ellipse">
        <Setter Property="Height" Value="86" />
        <Setter Property="Width" Value="86" />
        <Setter Property="Fill" Value="#ff475e8b" />
        <Setter Property="Stroke" Value="#ff788db5"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsCurrentStep, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                     Value="True">
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Effect">
              <Setter.Value>
                <DropShadowEffect Color="White" ShadowDepth="0" BlurRadius="13" Opacity="1"/>
              </Setter.Value>
            </Setter>
          </DataTrigger>
        </Style.Triggers>
      </Style>

      <Style x:Key="StepBubbleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Arial" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="#ffffffff" />
      </Style>

      <Style x:Key="StepTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Lato}" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Regular" />
        <Setter Property="Foreground" Value="#FFCEC3C6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="30, 0, 0, 0"></Setter>
        <Style.Triggers>
          <DataTrigger Binding="{Binding IsCurrentStep, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                     Value="True">
            <Setter Property="Foreground" Value="White" />
          </DataTrigger>
        </Style.Triggers>
      </Style>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid Width="808">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="100"/>
    </Grid.ColumnDefinitions>

    <Path Grid.Row="0" Grid.ColumnSpan="3" Width="796" Height="77" Stretch="uniform" Fill="#ff2c2c31" Stroke="#ff707070" StrokeThickness="0" 
          Data="M 38.5,0 L 757.5,0 C 778.8,0 796,17.2 796,38.5 C 796,59.8 778.8,77 757.5,77 L 38.5,77 C 17.2,77 0,59.8 0,38.5 C 0,17.2 17.2,0 38.5,0 Z" />

    <Grid  Grid.Column="0" >
      <Ellipse  Style="{StaticResource StepBubbleStyle}" />
      <TextBlock Style="{StaticResource StepBubbleTextStyle}"
        Text="{Binding StepId, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"  />
    </Grid>

    <TextBlock  Grid.Column="1" Text="{Binding StepDescription, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}" 
                Style="{StaticResource StepTextStyle}" />
    <CheckBox Grid.Column="2" Style="{StaticResource StepCompletionStateStyle}" 
              IsChecked="{Binding IsCompleted, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"/>
  </Grid>
</UserControl>
