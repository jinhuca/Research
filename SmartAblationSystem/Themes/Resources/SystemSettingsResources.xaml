  <ControlTemplate x:Key="SystemSettingsButtonTemplate_" TargetType="Button">
    <ControlTemplate.Resources>
      <Storyboard x:Key="Pressed_">
        <DoubleAnimation Storyboard.TargetName="effect_"
                       Storyboard.TargetProperty="Opacity"
                       To=".3"
                       Duration="0:0:0.1"/>
        <ColorAnimation Storyboard.TargetName="border_"
                        Storyboard.TargetProperty="BorderBrush.Color"
                        To="{StaticResource BorderHighColor_}"
                        Duration="0:0:0.1"/>
      </Storyboard>
      <Storyboard x:Key="Disabled_">
        <DoubleAnimation Storyboard.TargetName="contentPresenter_" 
                         Storyboard.TargetProperty="Opacity" 
                         To="0.2" 
                         Duration="0:0:0.1"/>
      </Storyboard>
    </ControlTemplate.Resources>
    <Grid Width="{TemplateBinding Width}"
          Height="{TemplateBinding Height}"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          x:Name="gridMain_">
      <Grid.Effect>
        <DropShadowEffect x:Name="effect_" 
                          Color="White" 
                          ShadowDepth="0" 
                          BlurRadius="4" 
                          RenderingBias="Performance" 
                          Opacity="0"
                          Direction="0"/>
      </Grid.Effect>
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="Disabled" Storyboard="{StaticResource Disabled_}"/>
          <VisualState x:Name="MouseOver"/>
          <VisualState x:Name="Pressed" Storyboard="{StaticResource Pressed_}">
          </VisualState>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Image Source="../Images/SettingButtonBK.png" 
             Stretch="UniformToFill"
             x:Name="backgroundImage_"/>
      <Border BorderBrush="#FF36476B" BorderThickness="4" CornerRadius="30" 
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              x:Name="border_">
      </Border>
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" 
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}" 
                        Margin="{TemplateBinding Padding}" 
                        Focusable="False" 
                        RecognizesAccessKey="True"
                        x:Name="contentPresenter_"/>
    </Grid>
    <ControlTemplate.Triggers>
      <EventTrigger RoutedEvent="TouchDown">
        <EventTrigger.Actions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="effect_"
                               Storyboard.TargetProperty="Opacity"
                               To=".3"
                               Duration="0:0:0.1"/>
              <ColorAnimation Storyboard.TargetName="border_"
                              Storyboard.TargetProperty="BorderBrush.Color"
                              To="{StaticResource BorderHighColor_}"
                              Duration="0:0:0.1"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger.Actions>
      </EventTrigger>
      <EventTrigger RoutedEvent="TouchUp">
        <EventTrigger.Actions>
          <BeginStoryboard>
            <Storyboard>
              <DoubleAnimation Storyboard.TargetName="effect_"
                               Storyboard.TargetProperty="Opacity"
                               To="0"
                               Duration="0:0:0.1"/>
              <ColorAnimation Storyboard.TargetName="border_"
                              Storyboard.TargetProperty="BorderBrush.Color"
                              To="{StaticResource BorderNormalColor_}"
                              Duration="0:0:0.1"/>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger.Actions>
      </EventTrigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

