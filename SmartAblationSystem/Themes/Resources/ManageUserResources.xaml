<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="PanelBackgroundColor_">#ff2b2b32</Color>
  <SolidColorBrush x:Key="PanelBackgroundBrush_" Color="{StaticResource PanelBackgroundColor_}"/>

  <Color x:Key="DialogTitleTextForegroundColor_">#FFDBDBDB</Color>
  <SolidColorBrush x:Key="DialogTitleTextForeground_" Color="{StaticResource DialogTitleTextForegroundColor_}"/>

  <Color x:Key="TitleTextForegroundColor_">#FFCEC3C6</Color>
  <SolidColorBrush x:Key="TitleTextForeground_" Color="{StaticResource TitleTextForegroundColor_}"/>

  <Color x:Key="ValueTextForegroundColor_">#FFFFFFFF</Color>
  <SolidColorBrush x:Key="ValueTextForeground_" Color="{StaticResource ValueTextForegroundColor_}"/>

  <SolidColorBrush x:Key="ErrorMessageForegroundBrush_" Color="#FFFB5B5B"/>

  <Style x:Key="ToggleButtonTextStyle_" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource ValueTextForeground_}"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ToggleButtonLeftTextStyle_" TargetType="TextBlock"
         BasedOn="{StaticResource ToggleButtonTextStyle_}">
    <Setter Property="Margin" Value="0, 0, 5, 0"/>
  </Style>

  <Style x:Key="ToggleButtonRightTextStyle_" TargetType="TextBlock" 
         BasedOn="{StaticResource ToggleButtonTextStyle_}">
    <Setter Property="Margin" Value="5, 0, 0, 0"/>
  </Style>

  <Style x:Key="ManageUserTitleTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="Foreground" Value="#ffCEC3C6"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="UserListTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="Foreground" Value="#FFD1D1D1"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="DeleteUserTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Arial"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="Foreground" Value="{StaticResource TitleTextForeground_}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="30,10,30,10"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="ResetPasswordTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="Foreground" Value="{StaticResource TitleTextForeground_}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="TextDecorations" Value="Underline"/>
  </Style>

  <Style x:Key="ErrorMessageTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="Foreground" Value="{StaticResource ErrorMessageForegroundBrush_}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,0,0"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <Style x:Key="LogoImageBasedStyle_" TargetType="Image">
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Margin" Value="0,0"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="Source" Value="../Images/BSC_Logo.png"/>
  </Style>

  <Style x:Key="BscLogImageStyle_" TargetType="Image"
         BasedOn="{StaticResource LogoImageBasedStyle_}">
    <Setter Property="Height" Value="50"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="Margin" Value="0,0,10,0"/>
  </Style>

  <Style x:Key="DialogTitleTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Foreground" Value="{StaticResource DialogTitleTextForeground_}"/>
  </Style>

  <Style x:Key="SubTitleTextStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Foreground" Value="{StaticResource TitleTextForeground_}"/>
  </Style>

  <Style x:Key="DeleteUserTextStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="TextDecorations" Value="Underline"/>
    <Setter Property="Foreground" Value="{StaticResource TitleTextForeground_}"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="12,0,0,0"/>
  </Style>

  <Style x:Key="SubValueTextBoxStyle_" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="Foreground" Value="{StaticResource ValueTextForeground_}"/>
  </Style>

  <DrawingGroup x:Key="DeleteUserIconDrawing_" ClipGeometry="M0,0 V19 H19 V0 H0 Z">
    <DrawingGroup Opacity="1" Transform="1,0,0,1,-836,-587">
      <DrawingGroup Opacity="1" Transform="1,0,0,1,836,587">
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FFC3C3C3" Thickness="1.5" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <EllipseGeometry RadiusX="8.75" RadiusY="8.75" Center="9.5,9.5" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
      <DrawingGroup Transform="0.707106781186548,0.707106781186547,-0.707106781186547,0.707106781186548,851.864,590.136">
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FFC3C3C3" Thickness="1.5" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="0,18" EndPoint="0,0" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingGroup>
  </DrawingGroup>

  <Style x:Key="ToggleButtonTextOnlyStyle_" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Grid HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <BulletDecorator Background="Transparent">
              <BulletDecorator.Bullet>
                <StackPanel Orientation="Horizontal" >
                  <Border Name="_mainBorder" Width="{TemplateBinding Height}" Height="{TemplateBinding Height}" 
                        BorderThickness="2" CornerRadius="2" Background="{StaticResource RadioButtonFillBrush}"
                        BorderBrush="{StaticResource RadioButtonSelectedBorderBrush}">
                    <Grid>
                      <Rectangle Grid.Column="0" x:Name="Selected" 
                               Margin="3" Width="Auto" Height="Auto">
                        <Rectangle.Fill>
                          <SolidColorBrush Color="{StaticResource RadioButtonSelectedFillColor}"  />
                        </Rectangle.Fill>
                      </Rectangle>
                    </Grid>
                  </Border>
                </StackPanel>
              </BulletDecorator.Bullet>
            </BulletDecorator>
            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" 
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
              <Setter TargetName="_mainBorder" Property="BorderBrush" Value="LightBlue"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="false">
              <Setter TargetName="Selected" Property="Visibility" Value="Collapsed"/>
              <Setter TargetName="_mainBorder" Property="BorderBrush" Value="{StaticResource RadioButtonUnselectedBorderBrush}"/>
              <Setter Property="Foreground" Value="#ffcdc2c5"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="_mainBorder" Property="Visibility" Value="Hidden" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <ControlTemplate x:Key="TextBoxBaseTemplate_" TargetType="TextBox">
    <Border x:Name="_Border" 
            Opacity="1" 
            CornerRadius="5" 
            BorderThickness="1" 
            Background="{TemplateBinding Background}" 
            BorderBrush="{TemplateBinding BorderBrush}">
      <ScrollViewer Margin="10,0,0,0" 
                    x:Name="PART_ContentHost" 
                    Style="{DynamicResource ScrollViewer}"/>
    </Border>
  </ControlTemplate>

  <Style x:Key="TextBoxErrorStyle_" TargetType="TextBox">
    <Setter Property="Template" Value="{StaticResource TextBoxTemplate}"/>
    <Setter Property="KeyboardNavigation.TabNavigation" Value="None"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="AllowDrop" Value="true"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Background" Value="#ff26262e" />
    <Setter Property="Foreground" Value="#ffffffff" />
    <Setter Property="Height" Value="34" />
    <Setter Property="Width" Value="330" />
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Validation.ErrorTemplate">
      <Setter.Value>
        <ControlTemplate>
          <StackPanel>
            <AdornedElementPlaceholder/>
            <ItemsControl ItemsSource="{Binding}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding ErrorContent}" 
                             HorizontalAlignment="Left" 
                             TextWrapping="Wrap"
                             Margin="0,5,0,0" 
                             Foreground="{StaticResource ErrorMessageForegroundBrush_}" 
                             FontFamily="{StaticResource Lato}"
                             FontWeight="Regular"
                             FontSize="14"/>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Validation.HasError" Value="true">
        <Setter Property="BorderBrush" Value="#888E4646"/>
      </Trigger>
    </Style.Triggers>
  </Style>

</ResourceDictionary>