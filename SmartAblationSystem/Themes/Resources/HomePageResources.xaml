  <Style x:Key="ButtonTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="0,0,0,30"/>
  </Style>

  <ControlTemplate x:Key="HomeButtonButtonTemplate_" TargetType="Button">
    <ControlTemplate.Resources>
      <Storyboard x:Key="Pressed_">
        <ColorAnimation Storyboard.TargetName="startColor_" 
                        Storyboard.TargetProperty="Color" 
                        To="White" 
                        Duration="0:0:0.1"/>
        <ColorAnimation Storyboard.TargetName="endColor_" 
                        Storyboard.TargetProperty="Color" 
                        To="WhiteSmoke" 
                        Duration="0:0:0.1"/>
        <DoubleAnimation Storyboard.TargetName="effect_" 
                         Storyboard.TargetProperty="Opacity" 
                         To="1" 
                         Duration="0:0:0.1"/>
      </Storyboard>
      <Storyboard x:Key="Disabling_"/>
    </ControlTemplate.Resources>
    <Border HorizontalAlignment="Center" 
            VerticalAlignment="Center" 
            CornerRadius="50" 
            BorderThickness="7"
            Background="Transparent">
      <VisualStateManager.VisualStateGroups>
        <VisualStateGroup x:Name="CommonStates">
          <VisualState x:Name="Normal"/>
          <VisualState x:Name="MouseOver"/>
          <VisualState x:Name="Pressed" Storyboard="{StaticResource Pressed_}"/>
          <VisualState x:Name="Disabled" Storyboard="{StaticResource Disabling_}"/>
        </VisualStateGroup>
      </VisualStateManager.VisualStateGroups>
      <Border.BorderBrush>
        <LinearGradientBrush StartPoint="0.5, 0" EndPoint="0.5, 1">
          <GradientStop x:Name="startColor_" Offset="0" Color="#ff516791"/>
          <GradientStop x:Name="endColor_" Offset="1" Color="#ff3e4569"/>
        </LinearGradientBrush>
      </Border.BorderBrush>
      <Border.Effect>
        <DropShadowEffect x:Name="effect_" 
                          Color="WhiteSmoke" 
                          ShadowDepth="5" 
                          BlurRadius="40" 
                          RenderingBias="Performance" 
                          Opacity="0"
                          Direction="0"/>
      </Border.Effect>
      <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" 
            Width="216" Height="216">
        <Grid.Background>
          <ImageBrush ImageSource="../Images/HomeButtonBackground.png" Stretch="Uniform"/>
        </Grid.Background>
        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          Margin="{TemplateBinding Padding}"
                          Focusable="False"
                          RecognizesAccessKey="True"/>
      </Grid>
    </Border>
  </ControlTemplate>

  <Style x:Key="HomeButtonBaseStyle_" TargetType="Button">
    <Setter Property="Template" Value="{StaticResource HomeButtonButtonTemplate_}"/>
    <Setter Property="Stylus.IsPressAndHoldEnabled" Value="False"/>
    <Setter Property="Margin" Value="30"/>
  </Style>

  <Style x:Key="CryoTherapyButtonStyle_" TargetType="Button"
         BasedOn="{StaticResource HomeButtonBaseStyle_}">
    <Setter Property="Content">
      <Setter.Value>
        <Grid>
          <Image Source="{StaticResource TherapyDrawingImage_}"
                 Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          <TextBlock Text="Cryo Therapy"
                     Style="{StaticResource ButtonTextBlockStyle_}"/>
        </Grid>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="RecordsButtonStyle_" TargetType="Button"
