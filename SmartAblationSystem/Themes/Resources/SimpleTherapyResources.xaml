<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <SolidColorBrush x:Key="InfoTitleTextForeground_" Color="#ffCEC3C6"/>
  <SolidColorBrush x:Key="InfoValueTextForeground_" Color="#ffffffff"/>
  <SolidColorBrush x:Key="TTIForeground_" Color="#ff9ac466"/>

  <Style x:Key="SystemInfoTitleTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InfoTitleTextForeground_}"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <Style x:Key="SystemInfoValueWhiteTextBlockStyle_" TargetType="TextBlock"
         BasedOn="{StaticResource SystemInfoTitleTextBlockStyle_}">
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="FontWeight" Value="Bold"/>
  </Style>

  <Style x:Key="SystemInfoValueTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InfoValueTextForeground_}"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="FontSize" Value="65"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="SystemInfoUnitTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InfoValueTextForeground_}"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TiiValueTextBlockStyle_" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource TTIForeground_}"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Regular"/>
    <Setter Property="FontSize" Value="65"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="TiiUnitTextBlockStyle_" TargetType="TextBlock"
         BasedOn="{StaticResource SystemInfoUnitTextBlockStyle_}">
    <Setter Property="Foreground" Value="{StaticResource TTIForeground_}"/>
  </Style>

  <Style x:Key="PressureFlowTextStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource InfoTitleTextForeground_}"/>
  </Style>

  <Style x:Key="PressureFlowValueStyle_" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontSize" Value="18"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="Foreground" Value="{StaticResource InfoValueTextForeground_}"/>
  </Style>

  <Style x:Key="SystemParamTitleStyle_" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource InfoTitleTextForeground_}"/>
    <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
    <Setter Property="FontWeight" Value="Medium"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
  </Style>

  <Style x:Key="SystemParamValueStyle_" TargetType="TextBlock"
         BasedOn="{StaticResource SystemParamTitleStyle_}">
    <Setter Property="Foreground" Value="{StaticResource InfoValueTextForeground_}"/>
  </Style>

  <Style x:Key="SimpleViewPlaybackIndicatorStyle_" TargetType="ContentControl">
    <Setter Property="Template" Value="{StaticResource PlaybackIndicatorTemplate_}"/>
    <Setter Property="Width" Value="1030"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
</ResourceDictionary>