<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  
  <DrawingGroup x:Key="tankDrawingGroupNoArrow" ClipGeometry="M0,0 V216 H216 V0 H0 Z">
    <DrawingGroup Opacity="1">
      <DrawingGroup Opacity="1">
        <GeometryDrawing Brush="#FFEAEAEA" Geometry="{StaticResource TankIconGeometry1_}" />
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FFEAEAEA" Thickness="2" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="105.01,54.13" EndPoint="105.01,44.86" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing>
          <GeometryDrawing.Pen>
            <Pen Brush="#FFEAEAEA" Thickness="2" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
          </GeometryDrawing.Pen>
          <GeometryDrawing.Geometry>
            <LineGeometry StartPoint="116.01,54.13" EndPoint="116.01,44.86" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource TankIconGeometry2_}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFEAEAEA" Thickness="3" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource TankIconGeometry3_}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFEAEAEA" Thickness="2" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource TankIconGeometry4_}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFEAEAEA" Thickness="2" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Round" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource TankIconGeometry5_}">
          <GeometryDrawing.Pen>
            <Pen Brush="#FFEAEAEA" Thickness="2" StartLineCap="Flat" EndLineCap="Flat" LineJoin="Miter" />
          </GeometryDrawing.Pen>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingGroup>
  </DrawingGroup>
  <DrawingImage x:Key="TankDrawingImageNoArrow_" Drawing="{StaticResource tankDrawingGroupNoArrow}" />

  <Style x:Key="StepCompletionStateStyle" TargetType="CheckBox">
    <Setter Property="Foreground" Value="#ff888888" />
    <Setter Property="IsEnabled" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border Background="Transparent" >
            <Canvas Width="32" Height="32"  >
              <Path Width="32" Height="32" Stretch="uniform" Data="M 35.3,17.7 L 35.3,19.1 C 35.3,26.3 30.6,32.6 23.8,34.7 
                      C 16.9,36.7 9.5,34 5.6,28 C 1.7,22 2.2,14.1 6.9,8.7 C 11.5,3.2 19.2,1.5 25.8,4.4" 
                    Stroke="{TemplateBinding Foreground}" StrokeThickness="2"/>
              <Path Width="19" Height="14" Stretch="uniform" Data="M 33,6 L 18,21 L 12,15" Stroke="{TemplateBinding Foreground}" 
                    Canvas.Left="13" Canvas.Top="3" StrokeThickness="2" />
            </Canvas>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Foreground" Value="#9BC567" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ChangeTankTextBaseStyle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Lato}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="#ffcec3c6" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style x:Key="ChangeTankCaptionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource ChangeTankTextBaseStyle}">
    <Setter Property="FontSize" Value="24" />
  </Style>

  <Style x:Key="TankWeightTextStyle" BasedOn="{StaticResource ChangeTankTextBaseStyle}" TargetType="TextBlock">
    <Setter Property="FontSize" Value="28" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <ControlTemplate x:Key="Tank10Template" TargetType="RadioButton">
    <Viewbox Stretch="Uniform">
      <Canvas x:Name="_main" Width="130" Height="130" Opacity="0.8">
        <Ellipse x:Name="_border" Width="130" Height="130" Stroke="#ffcec3c6" StrokeThickness="1.5" Canvas.Left="0" Canvas.Top="0" />
        <Image Source="{StaticResource TankDrawingImageNoArrow_}" Canvas.Left="-45" Canvas.Top="-25"  />
        <TextBlock  Text="10" TextAlignment="left" FontFamily="{StaticResource Lato}"  FontSize="18" Foreground="#ffeaeaea" Canvas.Left="55" Canvas.Top="51"  />
        <TextBlock  Text="(lbs)" TextAlignment="left" FontFamily="{StaticResource Lato}"  FontSize="14" Foreground="#ffeaeaea" Canvas.Left="53" Canvas.Top="72"  />
      </Canvas>
    </Viewbox>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="_main" Property="Opacity" Value="1" />
        <Setter TargetName="_border" Property="StrokeThickness" Value="2"/>
        <Setter TargetName="_border" Property="Stroke" Value="#FF9ABCFF" />
        <Setter TargetName="_border" Property="Effect">
          <Setter.Value>
            <DropShadowEffect Color="White" BlurRadius="6" Opacity="1" ShadowDepth="1"/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <ControlTemplate x:Key="Tank15Template" TargetType="RadioButton">
    <Viewbox Stretch="Uniform">
      <Canvas x:Name="_main" Width="130" Height="130" Opacity="0.8">
        <Ellipse x:Name="_border" Width="130" Height="130" Stroke="#ffcec3c6" StrokeThickness="1.5" Canvas.Left="0" Canvas.Top="0">
        </Ellipse>
        <Image Source="{StaticResource TankDrawingImageNoArrow_}" Canvas.Left="-45" Canvas.Top="-25"  />
        <TextBlock Text="BSC" TextAlignment="left" FontFamily="{StaticResource Lato}" FontSize="16" Foreground="#ffffffff" Canvas.Left="50" Canvas.Top="59"  />
      </Canvas>
    </Viewbox>
    <ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="_main" Property="Opacity" Value="1" />
        <Setter TargetName="_border" Property="StrokeThickness" Value="2"/>
        <Setter TargetName="_border" Property="Stroke" Value="#FF9ABCFF" />
        <Setter TargetName="_border" Property="Effect">
          <Setter.Value>
            <DropShadowEffect Color="White" BlurRadius="6" Opacity="1" ShadowDepth="1"/>
          </Setter.Value>
        </Setter>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>
</ResourceDictionary>