<UserControl x:Class="Module.CatheterTestTool.Views.CatheterTestResultDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:dialogs="http://prismlibrary.com/"
             xmlns:constants="clr-namespace:Module.Infrastructure.Constants;assembly=Module.Infrastructure"
             Height="300" Width="400"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="400">
    <dialogs:Dialog.WindowStyle>
        <Style TargetType="Window">
            <Setter Property="dialogs:Dialog.WindowStartupLocation" Value="CenterScreen"/>
            <Setter Property="ShowInTaskbar" Value="False"/>
            <Setter Property="WindowStyle" Value="None"/>
            <Setter Property="AllowsTransparency" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Topmost" Value="True"/>
        </Style>
    </dialogs:Dialog.WindowStyle>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CatheterTestThemes.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Module.Infrastructure;component/Themes/PrismDialog.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="Border" x:Key="ResultBorderStyle" BasedOn="{StaticResource FlashBorderStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding AllTestsPassed}" Value="false">
                        <Setter Property="BorderBrush" Value="Red" />
                    </DataTrigger>
                </Style.Triggers> 
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Style="{StaticResource ResultBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="{Binding Title}" Style="{StaticResource MessageTitleTextBlockStyle}"/>
            <Border Grid.Row="1" Style="{StaticResource MessageBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Text="Catheter Test: " Margin="10" FontSize="28" Foreground="{StaticResource StepTextBrush}"/>
                        <TextBlock Margin="10">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="32" />
                                    <Setter Property="Foreground" Value="LimeGreen" />
                                    <Setter Property="Text" Value="PASS" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AllTestsPassed}" Value="false">
                                            <Setter Property="Foreground" Value="Red" />
                                            <Setter Property="Text" Value="FAILED" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ButtonOnDialogStyle}" 
                                    Content="{x:Static constants:Strings.OKText}" 
                                    Command="{Binding CloseDialogCommand}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
