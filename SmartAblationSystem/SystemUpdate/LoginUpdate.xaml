<Window x:Class="SystemUpdate.LoginUpdate"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemUpdate"
        mc:Ignorable="d"
        WindowStyle="None"
        Title="LoginUpdate" Height="400" Width="800" ResizeMode="NoResize" Closing="Window_Closing">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes\Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Grid Background="#191919">
        <Label x:Name="lblUsername" Content="Username" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Width="150" Height="50" FontSize="25" Margin="0,32,480,287"/>
        <Label x:Name="lblPasscodeLabel" Content="Passcode" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" VerticalAlignment="Center" Width="150" Height="50" FontSize="25" Margin="0,106,480,213"/>
        <Label x:Name="lblPasscode" Content="" HorizontalAlignment="Center" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Width="150" FontSize="25" Height="40" Margin="389,106,253,223"/>

        <TextBox Style="{StaticResource CryterionTextBoxWhite}" x:Name="txtUsername" TextWrapping="Wrap" Text="" FontSize="20" TextChanged="Username_Changed" Width="auto" VerticalContentAlignment="Center" Margin="312,-129,171,129"/>
        <Label x:Name="lblPassword" Content="Password" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Width="150" Height="50" FontSize="25" RenderTransformOrigin="0.833,0.56" Margin="0,181,480,138"/>
        <Label x:Name="lblVersion" Content="2.0.0.1" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Width="150" Height="50" FontSize="25" RenderTransformOrigin="0.833,0.56" Margin="0,350,-48,0"/>

        <PasswordBox Margin="312,22,171,-22" Style="{StaticResource CryterionPasswordBoxWhite}" x:Name="txtPassword" FontSize="20" PasswordChanged="Password_Changed" Width="auto" VerticalContentAlignment="Center"/>
        <Label x:Name="lblError" FontWeight="Bold" Foreground="Red" HorizontalAlignment="Right" Width="305" Height="50" FontSize="17" RenderTransformOrigin="0.833,0.56" Margin="0,251,175,99" Cursor=""/>
        <Button Style="{StaticResource ButtonCryterion}" x:Name="btnLogin" Content="Login" IsDefault="True" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Click="BtnLogin_Click" Height="50" FontSize="20" Foreground="White" Margin="162,292,480,27"/>
        <Button  Style="{StaticResource ButtonCryterion}" x:Name="btnQuit" Content="Cancel" HorizontalAlignment="Center" VerticalAlignment="Center" Width="150" Click="BtnQuit_Click" Height="50" FontSize="20" Foreground="White" Margin="471,292,171,27"/>

    </Grid>
</Window>
