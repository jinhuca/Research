<Window x:Class="SystemUpdate.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemUpdate"
        WindowStyle="None"
        mc:Ignorable="d"
        Title="System Updater" Height="200" Width="700"
        ContentRendered="Window_ContentRendered" ResizeMode="NoResize" Closing="Window_Closing">
    <Grid Margin="0,0,0,0" Background="#191919">
        <Grid.RowDefinitions>
            <RowDefinition Height="137*"/>
            <RowDefinition Height="34*"/>
        </Grid.RowDefinitions>

        <ProgressBar Background="#191919" Name ="StepStatus" IsIndeterminate="True" HorizontalAlignment="Left" Height="23" VerticalAlignment="Top" Width="487" Margin="106,48,0,0" Minimum =" 0" Maximum=" 100"/>

        <TextBlock Name="StepPerc" Visibility="Hidden" Foreground="#FFFFFF" Text="{Binding ElementName=StepStatus, Path=Value, StringFormat={}{0:0}%}" Margin="566.765,28.923,16.235,55.077" FontSize="14" Padding="5,0" UseLayoutRounding="False" />
        <ProgressBar Background="#191919" Name ="pbStatus" HorizontalAlignment="Left" Height="23" VerticalAlignment="Top" Width="487" Margin="106,125,0,0" Minimum =" 0" Maximum=" 100" Grid.RowSpan="2"/>
        <TextBlock Foreground="#FFFFFF" Text="{Binding ElementName=pbStatus, Path=Value, StringFormat={}{0:0}%}" Margin="567,106,34,30" FontSize="14" Padding="5,0" Grid.RowSpan="2" UseLayoutRounding="False" />
        <TextBlock  Foreground="#FFFFFF" Name ="currentProcess" Text="{Binding CurrentProcess, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="106,32,0,105" Width="487" Height="23" FontSize="18" />
        <TextBlock Foreground="#FFFFFF" Name ="stepNumber" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="106,109,0,28" Width="456" Height="23" FontSize="16">
            <TextBlock.Text>
                <MultiBinding StringFormat="Step {0}/{1}">
                    <Binding Path="CurrentStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                    <Binding Path="MaxStep" RelativeSource="{RelativeSource AncestorType=Window}"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <Label x:Name="lblVersion" Content="2.0.0.1" FontWeight="Bold" Foreground="White" HorizontalAlignment="Right" Width="150" Height="50" FontSize="20" RenderTransformOrigin="0.833,0.56" Margin="0,10,-77,-20" Grid.Row="1"/>

    </Grid>

</Window>
