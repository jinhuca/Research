<Window x:Class="SystemUpdate.MessagePopup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d"
      Title="MessagePopup" Height="336" Width="800" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes\Themes.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border Name="BorderColor" BorderThickness="0" CornerRadius="10,10,10,10" Background="{StaticResource CryterionPopupSystemMessageBrushBackground}" Margin="0,0,0,91">
        <Grid Margin="37,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Name="TitleLabel" Grid.Row="0" Uid="SystemMessageLabel"  FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Background="Transparent" />
            <Button x:Name="WarningButton" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="50" Height="50"
                            Style="{StaticResource WarningButton}"
                            RenderTransformOrigin="0.5,0.5"
                            Margin="0,0,125,0"
                            Visibility="Hidden">
            </Button>

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushControlContainer}" Margin="-29,0,5,5" Height="169" VerticalAlignment="Bottom">
                <Grid Margin="0,-55,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="65" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ErrorStackPanel" Orientation="Horizontal" Visibility="{Binding ElementName=LblErrorName, Path=Visibility}" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,0,-10"  >

                        <Label Content="ERROR" x:Name="ErrorLabel"
                           FontSize="25" FontWeight="Bold" Foreground="Yellow" Margin="0,0,10,0"/>

                        <Label Name="LblErrorName" 
                           FontSize="25" FontWeight="Bold" Foreground="Yellow" 
                           Visibility="Collapsed" />

                    </StackPanel>

                    <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" CornerRadius="10" 
                            Background="{StaticResource CryterionPopupSystemMessageBrushContentContainer }" Margin="5,6,5,36" Grid.RowSpan="3" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform/>
                                <RotateTransform Angle="0.111"/>
                                <TranslateTransform/>
                            </TransformGroup>
                        </Border.RenderTransform>

                        <Viewbox VerticalAlignment="Top" Height="150" HorizontalAlignment="Left" Margin="10,10,10,10" Stretch="Uniform" StretchDirection="DownOnly" >
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" >
                                <TextBlock x:Name="txtMessage" TextWrapping="Wrap" HorizontalAlignment="Left"
                                           VerticalAlignment="Center" TextAlignment="Left" Foreground="Black" FontSize="20" FontWeight="Bold" 
                                           Height="157" Width="790" />
                            </ScrollViewer>
                        </Viewbox>
                    </Border>

                    <Label Name="ActionRequiredLabel" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                           FontSize="25" FontWeight="Bold" Foreground="Yellow" HorizontalAlignment="Center" 
                           
                           Visibility="Collapsed" Margin="0,0,0,-10" />

                    <Border Name="ActionRequiredBox" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" CornerRadius="10" 
                            Background="{StaticResource CryterionPopupSystemMessageBrushContentContainer }" Margin="5,5,5,5"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Viewbox VerticalAlignment="Top" Height="150" Margin="5,10,0,0" Grid.RowSpan="2" HorizontalAlignment="Left" StretchDirection="Both">

                                <StackPanel Orientation="Horizontal" >
                                    <TextBlock x:Name="txtAction" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Left" 
                                               Foreground="Black" FontSize="20" FontWeight="Bold" 
                                               Height="160" Width="550" />

                                    <Grid Name="VideoPlayerGrid" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" Visibility="Collapsed" >
                                        <MediaElement LoadedBehavior="Manual" Name="VideoPlayer" Height="150" Width="250" Margin="0,-10,10,0" />
                                    </Grid>
                                </StackPanel>
                            </Viewbox>

                        </Grid>
                    </Border>



                    <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="235" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="235" />
                        </Grid.ColumnDefinitions>



                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.ColumnSpan="2" Margin="233,-10,0,10">
                            <Button Style="{StaticResource RoundCorner}" Content="Yes"  Uid="YESButton" x:Name="YesButton" Margin="0,10,10,10" Width="150"
                                    VerticalAlignment="Center"  Click="YesButton_Click"/>
                            <Button Style="{StaticResource RoundCorner}" Uid="NOButton" Content="No"  x:Name="NoButton" Margin="10,10,0,10" Width="150"
                                    VerticalAlignment="Center" IsCancel="True" Background="#FF00AFEF" Click="NoButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>