<UserControl x:Class="SmartAblationSystem.Views.DMSQuickSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:CustomControls.UserControls;assembly=CustomControls"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d">
  <UserControl.Resources>
    <converters:StateToEnableConverter x:Key="stateToEnable" />
    <converters:StateToVisibilityConverter x:Key="stateToVisibility" />
    <converters:InverseBooleanConverter x:Key="inverseBooleanConverter" />
    <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

    <Style TargetType="userControls:SettingBarWithButtonsControl">
      <Setter Property="Height" Value="90" />
    </Style>
  </UserControl.Resources>
  <Border Background="#ff2b2b33" CornerRadius="8" BorderThickness="0">
    <Grid Width="300" Height="818" >
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" >
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Path Grid.Column="0" Grid.ColumnSpan="3" Width="300" Height="51" Stretch="uniform" Data="M 10 0 L 290 0 C 295.52,0 300,5.57 300,12.44 C 300,45.43 300,51 300,51 L 0,51 C 0,51 0,45.43 0,12.44 C 0,5.57 4.47,0 10,0 Z" 
             Fill="#ff353540" Stroke="#ff707070" StrokeThickness="0"/>
        <TextBlock Grid.Column="1" Text="QUICK SETTINGS" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{StaticResource Lato}" FontSize="16" Foreground="#ffcec3c6" Width="200"/>
        <Button Grid.Column="2" Style="{StaticResource CloseButtonStyle}" Height="12"  
              Command="{Binding CloseDMSQuickSettingsCommand}" Background="Transparent"/>
      </Grid>
      <Grid Grid.Row="1" Margin="15,0" >
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1.3*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="80">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
          </Grid.ColumnDefinitions>
          <Button Content="Reset baseline" HorizontalAlignment="Left" Width="150" Height="36" Style="{StaticResource QuickSettingsBtn}"
                  Command="{Binding ResetDiaphragmCommand}" 
                  Visibility="{Binding SystemState, ConverterParameter=BASE_LINE, Converter={StaticResource stateToVisibility}}" 
                  IsEnabled="{Binding SystemState, ConverterParameter=BASE_LINE, Converter={StaticResource stateToEnable}}" 
                  Margin="0,22,0,0" VerticalAlignment="Top" />

          <StackPanel Grid.Column="1" Visibility="{Binding SystemState, ConverterParameter=BASE_LINE2, Converter={StaticResource stateToVisibility}}" 
                      VerticalAlignment="Center" Orientation="Horizontal" Name="quickMuteStack">
            <b:Interaction.Triggers>
              <b:EventTrigger EventName="MouseDown" SourceObject="{Binding ElementName=quickMuteStack}">
                <b:CallMethodAction MethodName="ToggleIsUsingAudioAlertMute" TargetObject="{Binding}"/>
              </b:EventTrigger>
            </b:Interaction.Triggers>
            <TextBlock Height="31" Width="40" Visibility="{Binding IsUsingAudioAlert, Converter={StaticResource booleanToVisibilityConverter}}">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="FontFamily" Value="{StaticResource Lato}" />
                  <Setter Property="FontSize" Value="12" />
                  <Setter Property="FontWeight" Value="Medium" />
                  <Setter Property="Foreground" Value="#FFCEC3C6" />
                  <Setter Property="TextAlignment" Value="Center" />
                  <Setter Property="HorizontalAlignment" Value="Center" />
                  <Setter Property="VerticalAlignment" Value="Center" />
                  <Setter Property="Text" Value="QUICK MUTE" />
                  <Setter Property="TextWrapping" Value="Wrap" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsUsingAudioAlertMute}" Value="True">
                      <Setter Property="Text" Value="UNDO MUTE" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <ToggleButton IsChecked="{Binding IsUsingAudioAlertMute}" Margin="10,0,0,0" Height="32"
                          Style="{StaticResource VolumeMuteToggleBtnStyle}" IsEnabled="False" Foreground="#FFFFFFFF"  
                          Visibility="{Binding IsUsingAudioAlert, Converter={StaticResource booleanToVisibilityConverter}}"/>
          </StackPanel>
        </Grid>

        <userControls:SettingBarWithButtonsControl Grid.Row="1" Description="DMS Limit:" MinValue="60" MaxValue="100" Incremental="5" Unit="%" Value="{Binding DiaphragmAmplitude, Mode=TwoWay}"/>
        <userControls:SettingBarWithButtonsControl Grid.Row="2" Description="DMS Zoom:" MinValue="100" MaxValue="200" Incremental="100" Unit="%" Value="{Binding DiaphragmSensorGain, Mode=TwoWay}"/>
        <userControls:SettingBarWithButtonsControl Grid.Row="3" Description="DMS Sensitivity:" MinValue="1" MaxValue="7" Incremental="1" Value="{Binding DMSDetectionThresholdValue, Mode=TwoWay}"/>
        <userControls:SettingBarWithButtonsControl Grid.Row="4" Description="Esophagus Temperature:" MinValue="0" MaxValue="40" Incremental="1" Unit="°C" Value="{Binding EsophagusTemperature, Mode=TwoWay}"/>

        <Grid Grid.Row="5" Height="60" >
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="DMS:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource Lato}"  FontSize="18" Foreground="#ffcec3c6"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="OFF" FontFamily="{StaticResource Lato}"  FontSize="12" Foreground="#ffffffff" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ToggleButton Style="{StaticResource SwitchToggleButton}" Height="30" 
                          IsChecked="{Binding IgnoreMinimumDiaphragmMovementValue, Converter={StaticResource inverseBooleanConverter}, Mode=TwoWay}"/>
            <TextBlock Text="ON" FontFamily="{StaticResource Lato}"  FontSize="12" Foreground="#ffffffff" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
        </Grid>
        <Grid  Grid.Row="6" Height="50">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Text="Audio Alert:" HorizontalAlignment="Left" VerticalAlignment="Center" FontFamily="{StaticResource Lato}"  FontSize="18" Foreground="#ffcec3c6"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <TextBlock Text="OFF" FontFamily="{StaticResource Lato}"  FontSize="12" Foreground="#ffffffff" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ToggleButton Style="{StaticResource SwitchToggleButton}" Height="30" IsChecked="{Binding IsUsingAudioAlertSetting, Mode=TwoWay}" />
            <TextBlock Text="ON" FontFamily="{StaticResource Lato}"  FontSize="12" Foreground="#ffffffff" VerticalAlignment="Center" Margin="10,0,0,0"/>
          </StackPanel>
        </Grid >

        <Grid Grid.Row="7" >
          <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Button Grid.Row="0" Content="More settings" Style="{StaticResource TextWithUnderlineButton}" Width="130" Height="25" HorizontalAlignment="Left" 
                  Command="{Binding GoToMoreSettingsCommand}"/>
          <Button Grid.Row="1"  Content="SAVE TO PREFERENCES" Style="{StaticResource SettingsPreferencesButton}" Width="220" Height="48" HorizontalAlignment="Right" 
                Command="{Binding SaveDMSSettingCommand}" />
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
