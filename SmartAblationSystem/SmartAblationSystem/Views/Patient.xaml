<UserControl x:Class="SmartAblationSystem.Views.Patient"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mvvm="http://prismlibrary.com/"
             mvvm:ViewModelLocator.AutoWireViewModel="True"
             xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:validation="clr-namespace:SmartAblationSystem.Validation"
             xmlns:converters1="clr-namespace:CustomControls.Converters;assembly=CustomControls"
             xmlns:helpers="clr-namespace:SmartAblationSystem.Helpers"
             Loaded="Patient_OnLoaded"
             Focusable="True" MouseDown="Patient_OnMouseOrTouchDown" TouchDown="Patient_OnMouseOrTouchDown"
             mc:Ignorable="d">
  <UserControl.Resources>
    <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
    <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />
    <converters:ScaleUnitToTextConverter x:Key="scaleUnitToTextConverter" />
    <converters:ToiseUnitToTextConverter x:Key="toiseUnitToTextConverter" />
    <converters1:InverseAndBooleansToBooleanConverter x:Key="inverseAndBooleansToBooleanConverter" />

    <Style TargetType="TextBlock" x:Key="HospitalNameTextMessageStyle">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="TextAlignment" Value="Left" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#FFDBDBDB" />
    </Style>

    <Style TargetType="TextBlock" x:Key="PatientTextMessageStyle">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="16" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#ffcec3c6" />
    </Style>
    <Style TargetType="TextBlock" x:Key="PatientTextTitleStyle" BasedOn="{StaticResource PatientTextMessageStyle}">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="FontSize" Value="20" />
      <Setter Property="Foreground" Value="#ffdbdbdb" />
    </Style>
    <Style TargetType="TextBox" x:Key="PatientTextBoxStyle" BasedOn="{StaticResource TextBoxNewStyle}">
      <Setter Property="Background" Value="#ff26262e" />
      <Setter Property="Foreground" Value="#ffffffff" />
      <Setter Property="Height" Value="34" />
      <Setter Property="Width" Value="330" />
      <Setter Property="FontSize" Value="16"/>
      <Style.Triggers>
        <Trigger Property="Validation.HasError" Value="true">
          <Setter Property="BorderBrush" Value="#FF8E4646" />
          <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TextBoxOnErrorStyle" TargetType="TextBox" BasedOn="{StaticResource PatientTextBoxStyle}">
      <Setter Property="Validation.ErrorTemplate">
        <Setter.Value>
          <ControlTemplate>
            <StackPanel>
              <AdornedElementPlaceholder x:Name="placeholder" />
              <TextBlock FontSize="14" FontFamily="{StaticResource Lato}" Foreground="#FFFB5B5B" Margin="0,5, 0,0"
                         Text="{Binding ElementName=placeholder, Path=AdornedElement.ToolTip, Mode=OneWay}" />
            </StackPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Canvas>
      <StackPanel Style="{StaticResource HospitalLogoStackPanelOnHomeStyle_}">
        <TextBlock Text="Hospital:" 
                 Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
        <TextBlock Text="{Binding HospitalName}" 
                 Style="{StaticResource HospitalNameTextBlockStyle_}"/>
      </StackPanel>
      <Image Style="{StaticResource LogoImageOnHomeStyle_}"/>
    </Canvas>
    <Grid Width="1920" Height="1000" Background="Transparent">
      <Grid.RowDefinitions>
        <RowDefinition Height="80"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="70"/>
          <RowDefinition Height="630"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Width="860" Height="629" BorderThickness="0"  Background="{StaticResource PanelBackgroundBrush_}" CornerRadius="8" >
          <Border.Effect>
            <DropShadowEffect Color="Black"
              ShadowDepth="11"
              BlurRadius="20"
              RenderingBias="Performance"
              Opacity="0.5"
              Direction="-50"/>
          </Border.Effect>
        </Border>
        <Border Grid.Row="1" Width="860" Height="629" BorderThickness="0"  Background="{StaticResource PanelBackgroundBrush_}" CornerRadius="8" >
          


          <Grid Background="Transparent" >
            
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Patient Info Panel -->
            <Grid Grid.Row="0" >
              <Path Stretch="uniform" Data="M 172,0 L 1012,0 C 1017.52,0 1022,4.47 1022,10 L 1022,78 L 162,78 L 162,10 C 162,4.47 166.47,0 172,0 Z" 
              Fill="#ff475e8b" Stroke="#ff707070" StrokeThickness="0"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Canvas  Width="35" Height="35" Margin="0,0, 15, 0" >
                  <Ellipse  Width="35" Height="35" Stroke="#ffdbdbdb" Canvas.Left="0" Canvas.Top="0" StrokeThickness="2" />
                  <Ellipse  Width="12" Height="12" Stroke="#ffdbdbdb" Canvas.Left="12" Canvas.Top="5" StrokeThickness="2" />
                  <Path  Width="26" Height="10" Stretch="uniform" 
                   Data="M -16976.07421875 -11160.2197265625 C -16976.07421875 -11160.2197265625 -16977.556640625 -11165.2724609375 -16973.9375 -11168.443359375 C -16972.166015625 -11169.9990234375 -16968.15625 -11171.2177734375 -16963.39453125 -11171.2177734375 C -16959.041015625 -11171.2177734375 -16954.96875 -11170.419921875 -16952.955078125 -11168.8916015625 C -16949.017578125 -11165.8994140625 -16950.43359375 -11160.5283203125 -16950.43359375 -11160.5283203125" 
                   Stroke="#ffdbdbdb" StrokeThickness="2" Canvas.Left="4.75390625" Canvas.Top="19.0693359375"  />
                  <Path Width="8" Height="8" Canvas.Left="18" Canvas.Top="22" Stretch="uniform" Data="M 4,2 L 4,6 M 2,4 L 6,4" Stroke="#ffdbdbdb" StrokeThickness="1.5"/>
                </Canvas>
                <TextBlock Text="PATIENT INFO" Style="{StaticResource PatientTextTitleStyle}" FontSize="20" />
              </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="70, 0" >
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="0.7*"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <!-- Load Previous Patient Button -->
              <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Height="100" >
                <Button x:Name="LoadPreviousLogedPatientButton" Height="36" Width="215" HorizontalAlignment="Left" Style="{StaticResource QuickSettingsBtn}"
                  Content="Load Previous Patient" Visibility="{Binding IsTherePatient, Converter={StaticResource booleanToVisibilityConverter}}" 
                  Command="{Binding LoadPreviousPatientCommand}"/>
              </Grid>

              <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="* Patient ID:" Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="0, 10"/>
                <TextBox x:Name="txtPatentID" Style="{StaticResource TextBoxOnErrorStyle}" IsEnabled="{Binding IsPhysicianSelectionEnabled}" MaxLength="150">
                  <i:Interaction.Triggers>
                    <i:EventTrigger EventName="LostFocus">
                      <i:InvokeCommandAction  Command="{Binding SearchPatientCommand}" CommandParameter="PatientSearch"/>
                    </i:EventTrigger>
                  </i:Interaction.Triggers>
                  <TextBox.Text>
                    <Binding Path="HospitalPatientId" Mode="TwoWay" ValidatesOnNotifyDataErrors="True" UpdateSourceTrigger="PropertyChanged">
                      <Binding.ValidationRules>
                        <validation:StringInputValidator ValidationStep="UpdatedValue" ValidatesOnTargetUpdated="True"/>
                      </Binding.ValidationRules>
                    </Binding>
                  </TextBox.Text>
                </TextBox>
              </StackPanel>

              <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="* Physician:" Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="0, 10"/>
                <!-- <TextBox Text="Dr. Kelly Wallas" Style="{StaticResource PatientTextBoxStyle}" /> -->
                <ComboBox Style="{StaticResource ComboBoxStyle}" Width="330" ItemsSource="{Binding PhysiciansComList}" 
                    DisplayMemberPath="FirstName" SelectedValuePath="Name" SelectedValue ="{Binding SelectedPhysician}"
                    IsSynchronizedWithCurrentItem="True" SelectedIndex="0"
                    IsEnabled="{Binding IsPhysicianSelectionEnabled}"/>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="* First Name:" Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="0, 10"/>
                <TextBox x:Name="txtPatientFName"  Style="{StaticResource TextBoxOnErrorStyle}" MaxLength="100">
                  <TextBox.Text >
                    <Binding Path="FirstName" Mode="TwoWay" NotifyOnValidationError="True" UpdateSourceTrigger="PropertyChanged">
                      <Binding.ValidationRules>
                        <validation:StringInputValidator />
                      </Binding.ValidationRules>
                    </Binding>
                  </TextBox.Text>
                </TextBox>
              </StackPanel>

              <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="* Last Name:" Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="0, 10"/>
                <TextBox x:Name="txtPatientLName" Style="{StaticResource TextBoxOnErrorStyle}" MaxLength="100">
                  <TextBox.Text>
                    <Binding Path="LastName" Mode="TwoWay" ValidatesOnNotifyDataErrors="True" UpdateSourceTrigger="PropertyChanged">
                      <Binding.ValidationRules>
                        <validation:StringInputValidator />
                      </Binding.ValidationRules>
                    </Binding>
                  </TextBox.Text>
                </TextBox>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}, StringFormat={}Weight {0}:}" 
                     Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="12, 10" />
                <TextBox x:Name="TxtWeight" Style="{StaticResource TextBoxOnErrorStyle}" LostFocus="WeightHeightLostFocus">
                  <TextBox.Text>
                    <Binding Path="Weight" Mode="TwoWay" Converter="{StaticResource stringTodoubleConverter}" ConverterParameter="CanBeEmpty" 
                       ValidatesOnNotifyDataErrors="True" UpdateSourceTrigger="PropertyChanged">
                      <Binding.ValidationRules>
                        <validation:RegisterValidator Min="0" Max="657" />
                      </Binding.ValidationRules>
                    </Binding>
                  </TextBox.Text>
                </TextBox>
              </StackPanel>

              <StackPanel Grid.Row="3" Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="{Binding WeightUnit, Converter={StaticResource toiseUnitToTextConverter}, StringFormat={}Height {0}:}" 
                     Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="12, 10"/>
                <TextBox x:Name="TxtHeight" Style="{StaticResource TextBoxOnErrorStyle}"  LostFocus="WeightHeightLostFocus">
                  <TextBox.Text>
                    <Binding Path="Height" Mode="TwoWay" Converter="{StaticResource stringTodoubleConverter}" ConverterParameter="CanBeEmpty" 
                       ValidatesOnNotifyDataErrors="True" UpdateSourceTrigger="PropertyChanged">
                      <Binding.ValidationRules>
                        <validation:RegisterValidator Min="0" Max="299" />
                      </Binding.ValidationRules>
                    </Binding>
                  </TextBox.Text>
                </TextBox>
              </StackPanel>

              <StackPanel Grid.Row="4" Grid.Column="0" Orientation="Vertical">
                <TextBlock Text="Date of Birth:" Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="12, 10"/>
                <DatePicker SelectedDate="{Binding Birthdate}" Style="{StaticResource PatientInfoDatePickerStyle}" Height="36" Width="330"
                          helpers:DatePickerExtensions.DefaultDisplayDate="{Binding DefaultBirthDay}"/>
              </StackPanel>

              <StackPanel Grid.Row="4" Grid.Column="2" Orientation="Vertical">
                <TextBlock Text="Gender:" Style="{StaticResource PatientTextMessageStyle}" HorizontalAlignment="Left" Margin="0, 10"/>
                <StackPanel Orientation="Horizontal" Height="34">
                  <RadioButton Content="Male" GroupName="GenderGroup" Style="{StaticResource SettingRadioButtonStyle}" Margin="0, 0, 20, 0" 
                         IsChecked="{Binding Gender, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Male}"/>
                  <RadioButton Content="Female" GroupName="GenderGroup" Style="{StaticResource SettingRadioButtonStyle}"
                         IsChecked="{Binding Gender, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Female}"/>
                </StackPanel>
              </StackPanel>

              <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" 
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="-20,-20,-20, 0">
                <Button Content="Cancel" Style="{StaticResource TextWithUnderlineButton}" Margin="10,0" Command="{Binding BackToHomeCommand}"/>
                <Button Content="START"  Margin="10,0, 0, 0" x:Name="NextButton" Style="{StaticResource SettingsApplyButton}"
                  Command="{Binding NextCommand}" CommandParameter="PatientInfo">
                  <Button.IsEnabled>
                    <MultiBinding Converter="{StaticResource inverseAndBooleansToBooleanConverter}" Mode="TwoWay">
                      <Binding ElementName="txtPatentID" Path="(Validation.HasError)" />
                      <Binding ElementName="txtPatientFName" Path="(Validation.HasError)" />
                      <Binding ElementName="txtPatientLName" Path="(Validation.HasError)" />
                      <Binding ElementName="TxtWeight" Path="(Validation.HasError)" />
                      <Binding ElementName="TxtHeight" Path="(Validation.HasError)" />
                    </MultiBinding>
                  </Button.IsEnabled>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
