<Window x:Class="SmartAblationSystem.Views.TextEntryPopupNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartAblationSystem.Views"
        mc:Ignorable="d"
        Title="NotesEditor" Height="540" Width="701"
        WindowStartupLocation="Manual" 
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent">
  <Window.Resources>
    <Color x:Key="TitleBackgroundColor_">#ff475E8B</Color>
    <SolidColorBrush x:Key="TitleBackgroundBrush_" Color="{StaticResource TitleBackgroundColor_}"/>
    <Color x:Key="TitleForegroundColor_">#DBDBDB</Color>
    <SolidColorBrush x:Key="TitleForegroundBrush_" Color="{StaticResource TitleForegroundColor_}"/>
    <Color x:Key="BackgroundColor_">#ff2b2b33</Color>
    <SolidColorBrush x:Key="BackgroundBrush_" Color="{StaticResource BackgroundColor_}"/>
    <Color x:Key="TextBoxBackgroundColor_">#ff26262e</Color>
    <SolidColorBrush x:Key="TextBoxBackgroundBrush_" Color="{StaticResource TextBoxBackgroundColor_}"/>
    <Color x:Key="MessageForegroundColor_">#FFCEC3C6</Color>
    <SolidColorBrush x:Key="MessageForegroundBrush_" Color="{StaticResource MessageForegroundColor_}"/>
    <Style x:Key="TitleTextBlockStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TitleForegroundBrush_}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MessageTextStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Foreground" Value="{StaticResource MessageForegroundBrush_}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Margin" Value="60,0,0,0"></Setter>
    </Style>
  </Window.Resources>
  <Grid Height="510" Width="671">
    <Border Background="{StaticResource BackgroundBrush_}" CornerRadius="10">
      <Border.Effect>
        <DropShadowEffect Color="Black"
                ShadowDepth="11"
                BlurRadius="20"
                RenderingBias="Performance"
                Opacity="0.5"
                Direction="-50"/>
      </Border.Effect>
    </Border>

    <Grid ShowGridLines="False" >
      <Grid.RowDefinitions>
        <RowDefinition Height="78"/>
        <RowDefinition Height="0.2*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="80"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" 
              CornerRadius="8,8,0,0" 
              Background="{StaticResource TitleBackgroundBrush_}">
        <TextBlock x:Name="TitleTextBlock" Text="" 
                   Style="{StaticResource TitleTextBlockStyle_}"/>
      </Border>
      <TextBlock Grid.Row="1"
                 x:Name="SubTitleTextBlock"
                 Text=""
                 Style="{StaticResource MessageTextStyle_}"/>
      <TextBox Grid.Row="2"
               x:Name="TxtContent"
               Margin="60,10,60,10"
               Background="{StaticResource TextBoxBackgroundBrush_}"
               Style="{StaticResource ReportTextBoxStyle_}"/>
      <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,10">
        <Button Style="{StaticResource TextWithUnderlineButton_}"
                Content="Cancel"
                IsCancel="True"
                Click="No_Click"/>
        <Button x:Name="Yes"
                Margin="20,0,20,0"
                Style="{StaticResource SaveButtonStyle_}"
                Click="Ok_Click"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>