<Window x:Class="SmartAblationSystem.Views.SaveEngineeringDataToUSB"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartAblationSystem.Views"
      xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900" Title="MessagePopup" Height="600" Width="900"
      WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <converters:BooleanToUSBConnectionConverter x:Key="booleanToUSBConnectionConverter" />
        <converters:USBDriveToStringConverter x:Key="uSBDriveToStringConverter" />
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:FieldToTextConverter x:Key="fieldToTextConverter" />

    </Window.Resources>

    <Border BorderThickness="0" CornerRadius="10,10,10,10" Background="{StaticResource CryterionBrushColorBlue}">

        <Grid Margin="0,0,0,0">

            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label x:Name="SaveToUSBDriveLabel" Grid.Row="0" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}"
                   FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" Background="Transparent" />

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushControlContainer}" Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="65" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushContentContainer}" Margin="5,5,5,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="0.5*" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,10,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="VolumeLabel" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="Black"
                                           Text="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}"
                                           FontSize="20" FontWeight="Bold" Margin="0,0,0,0" />
                                <Label Grid.Column="2" Grid.Row="0" Content="{Binding USBDriveList, Converter={StaticResource uSBDriveToStringConverter}, ConverterParameter=VOLUMELABEL, Mode=OneWay}" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding USBDriveConnected, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" />

                                <TextBlock x:Name="NameLabel" Grid.Column="1" Grid.Row="1" Text="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="0,0,0,0" />
                                <Label Grid.Column="2" Grid.Row="1" Content="{Binding USBDriveList, Converter={StaticResource uSBDriveToStringConverter}, ConverterParameter=NAME, Mode=OneWay}" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding USBDriveConnected, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" />

                                <TextBlock x:Name="DriveFormatLabel" Grid.Column="1" Grid.Row="2" 
                                           Text="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="0,0,0,0" />
                                <Label Grid.Column="2" Grid.Row="2" Content="{Binding USBDriveList, Converter={StaticResource uSBDriveToStringConverter}, ConverterParameter=DRIVEFORMAT, Mode=OneWay}" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding USBDriveConnected, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" />

                                <TextBlock x:Name="FreeSpaceLabel" Grid.Column="1" Grid.Row="3" 
                                           Text="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}"
                                           HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="0,0,0,0" />
                                <Label Grid.Column="2" Grid.Row="3" Content="{Binding USBDriveList, Converter={StaticResource uSBDriveToStringConverter}, ConverterParameter=FREESPACE, Mode=OneWay}" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding USBDriveConnected, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" />

                                <TextBlock x:Name="TotalSizeLabel" Grid.Column="1" Grid.Row="4" 
                                           Text="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}" 
                                           HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="0,0,0,0" />
                                <Label Grid.Column="2" Grid.Row="4" Content="{Binding USBDriveList, Converter={StaticResource uSBDriveToStringConverter}, ConverterParameter=TOTALSIZE, Mode=OneWay}" HorizontalAlignment="Left" FontSize="20" FontWeight="Bold" Foreground="Black" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Visibility="{Binding USBDriveConnected, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" />

                                <Image Grid.Column="0" Grid.RowSpan="4" Grid.Row="0" Source="{Binding USBDriveConnected, Converter={StaticResource booleanToUSBConnectionConverter}, Mode=OneWay}" Height="60" Width="100" />
                            </Grid>

                            <!--<Label x:Name="FileNameLabel" Grid.Column="0" Grid.Row="1" 
                                   Content="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold" Margin="10,0,0,0" />-->
                            <Label Name="LblPath" Content="{Binding SaveToUSBPath, Mode=TwoWay}" Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="4" Foreground="Black" FontSize="25" FontWeight="Bold"
                                   VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="10,0,0,0" />
                            <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Margin="0,0,0,5" >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Label x:Name="FileTypeLabel" Grid.Column="0" Grid.Row="0" 
                                       Content="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}" 
                                       FontSize="20" Foreground="Black" FontWeight="Bold" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" />

                                <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10">
                                    <Viewbox Height="30">
                                        <CheckBox Name="CSVRadioButton"  IsChecked="{Binding SaveToCSVSelected, Mode=OneWayToSource}"  Click="JSonNotSelected"      VerticalAlignment="Bottom" />
                                    </Viewbox>
                                    <TextBlock Text="Error Log Excel" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,0"  x:Name="JSonPanel" Visibility="Hidden">
                                    <Viewbox Height="30">
                                        <CheckBox Name="JSONRadioButton" IsChecked="{Binding SaveToJSONSelected, Mode=OneWayToSource}"  Click="JSonSelected" IsEnabled="False"/>
                                    </Viewbox>
                                    <TextBlock Text="Error Log Summary Report" Foreground="Gray" FontSize="20" FontWeight="Bold" Margin="10,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Grid.Row="2"  Orientation="Horizontal" HorizontalAlignment="Left" Margin="10,0,0,10"  Visibility="Hidden" >
                                    <Viewbox Height="30">
                                        <CheckBox Name="PDFRadioButton"  IsChecked="{Binding SaveToPDFSelected, Mode=OneWayToSource}"  Click="JSonNotSelected" IsEnabled="False" />
                                    </Viewbox>
                                    <TextBlock Text="Error Log DB Script (For SW Developer)"  FontSize="20"  FontWeight="Bold" Margin="10,2,0,2"  VerticalAlignment="Center" Foreground="Gray"  />
                                </StackPanel>
                            </Grid>

                            <!--<Grid Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Margin="60,30,0,0" Name="ReportPanel" Orientation="Vertical">
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                                            <Viewbox Height="30">
                                                <CheckBox Name="ReoprtRadioButton" IsChecked="{Binding SaveToReportSelected, Mode=OneWayToSource}"  Click ="JSonNotSelected" />
                                            </Viewbox>
                                            <TextBlock Text="Case Summary Report" Foreground="Black" FontSize="20" FontWeight="Bold" Margin="10,0,0,0" Width="246" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left"  Margin="40,0,0,0" >
                                            <Label Content="From: " FontSize="18" FontWeight="DemiBold"/>
                                            <ComboBox  Name="comboxBoxStartYear"  Width="120" Height="28" FontSize="18" FontWeight="DemiBold" Margin="0,0,10,0"/>
                                            <Label Content="To: " FontSize="18" FontWeight="DemiBold"/>
                                            <ComboBox  Name="comboxBoxEndYear"  Width="120" Height="28" FontSize="18" FontWeight="DemiBold"/>
                                            -->
                            <!--<DatePicker  CalendarStyle="{StaticResource styleCalendar}" BorderThickness="0" x:Name="CaseTo" Loaded="DatePicker_Loaded" Margin="1,0,2,0" Background="LightGray" RenderTransformOrigin="0.562,0.903" Height="27" Width="125" FontSize="16"/>-->
                            <!--
                                        </StackPanel>
                                        <StackPanel  Visibility="Hidden" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left"  Margin="20,6,0,0" Height="29" >
                                            <Viewbox Height="27">
                                                <CheckBox  Name="CheckBoxPDF" Margin="12, 0,0,0" IsChecked="True"/>
                                            </Viewbox>
                                            <Label  Content=" PDF Format" FontSize="18" FontWeight="DemiBold"  />

                                            <Viewbox Height="27">
                                                <CheckBox  Name="CheckBoxExcel"  Margin="20, 0,0,0"  />
                                            </Viewbox>
                                            <Label Content=" Excel Format" FontSize="18" FontWeight="DemiBold" VerticalAlignment="Bottom"  />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Grid>-->
                            <StackPanel  Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal" HorizontalAlignment="Left"  x:Name="PasswordPanel" Margin="10,0,0,0" VerticalAlignment="Top" Width="845" >
                                <Label x:Name="PasswordLabel" Uid="PasswordLabel" Content="{Binding RelativeSource={RelativeSource Self}, Path=Uid , Converter={StaticResource fieldToTextConverter}}" ContentStringFormat=" {0}: " HorizontalAlignment="Center"  VerticalAlignment="Center" Foreground="Black" FontSize="20" FontWeight="Bold" Height="39" Margin="0,10,0,2" />
                                <TextBox  x:Name="passwordBox" Grid.ColumnSpan="2" TextChanged="PasswordChangedHandler" Margin="0,10,0,1" Text=""  Width="230" 
                                     TextAlignment="Left" HorizontalAlignment="Left" VerticalAlignment="Center" FontSize="25" FontWeight="Bold" Foreground="Transparent"
                                     MaxLength="16" FontFamily="courier new" Height="31">
                                    <TextBox.TextDecorations>
                                        <TextDecorationCollection>
                                            <TextDecoration Location="Strikethrough"  PenThicknessUnit="FontRenderingEmSize">
                                                <TextDecoration.Pen>
                                                    <Pen Brush="Black" Thickness="0.5" DashCap="Round" StartLineCap="Round" EndLineCap="Round">
                                                        <Pen.DashStyle>
                                                            <DashStyle Dashes="0.0, 1.2" Offset="0.6" />
                                                        </Pen.DashStyle>
                                                    </Pen>
                                                </TextDecoration.Pen>
                                            </TextDecoration>
                                        </TextDecorationCollection>
                                    </TextBox.TextDecorations>
                                </TextBox>
                                <Label  x:Name="lblValidationMessage" Content="alphanumeric only" Margin="15,0,0,0" Visibility="Hidden"  Foreground="Red" HorizontalContentAlignment="Center" FontSize="16" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource RoundCorner}" IsEnabled="False" Content="OK" Visibility="{Binding USBDriveConnected,Converter={StaticResource booleanToVisibilityConverter}}" Grid.Column="0" Grid.Row="1" x:Name="Yes"  Margin="10,10,10,10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Ok_Click" />
                    <Button Style="{StaticResource RoundCorner}" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Grid.Column="1" Grid.Row="1" x:Name="CancelButton" Margin="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center" Click="No_Click" IsCancel="True" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>