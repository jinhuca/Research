<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:System="clr-namespace:System;assembly=mscorlib" 
             x:Class="SmartAblationSystem.Views.MechanicalMonitoring"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
	          Loaded="UserControl_Loaded"
             d:DesignHeight="1030" d:DesignWidth="1920" Background="Transparent" Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
        <converters:StateToEnableConverter x:Key="stateToEnable" />
        <converters:StateToVisibilityConverter x:Key="stateToVisibility" />
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter" />
        <converters:StatusToPicture x:Key="statusToPicture" />
        <converters:StateToColorConverter x:Key="stateToColorConverter" />
        <converters:DoubleToOnOffConverter x:Key="doubleToOnOffConverter" />
        <converters:PWMToOpacityConverter x:Key="pWMToOpacityConverter" />
        <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />
    </UserControl.Resources>

    <Grid Height="1030" VerticalAlignment="Top" Width="1920">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="1322" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" BorderThickness="2" Margin="0,2,0,2" Height="45" CornerRadius="6">
            <Border.BorderBrush>
                <SolidColorBrush Color="White"  Opacity="0.5" />
            </Border.BorderBrush>
            <UniformGrid Rows="1" Columns="7" VerticalAlignment="Center">
                <Label Content="STATUS:" Foreground="White"  FontWeight="Bold" FontSize="22" Margin="80,0,0,0" />
                <Label Content="IDLE" Foreground="{Binding SystemState, ConverterParameter=IDLE, Converter={StaticResource stateToColorConverter}}"  FontWeight="Bold" FontSize="22" />
                <Label Content="READY" Foreground="{Binding SystemState, ConverterParameter=READY, Converter={StaticResource stateToColorConverter}}"  FontWeight="Bold" FontSize="22" />
                <Label Content="INFLATION" Foreground="{Binding SystemState, ConverterParameter=INFLATION, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
                <Label Content="TRANSITION" Foreground="{Binding SystemState, ConverterParameter=TRANSITIONPID, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
                <Label Content="ABLATION" Foreground="{Binding SystemState, ConverterParameter=ABLATIONPID, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
                <Label Content="THAWING" Foreground="{Binding SystemState, ConverterParameter=THAWING, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
            </UniformGrid>
        </Border>

        <Grid Grid.Row="1" Width="1322" Height="850" VerticalAlignment="Top" Grid.Column="1" Margin="0,10,0,0">

            <Grid.Background>
                <ImageBrush ImageSource="../Images/Mechanical Panel v6-3.jpg" />
            </Grid.Background>

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>

            <TextBox x:Name="PT1textBox" Text="{Binding PT1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="54,50,15,4" Grid.Row="6" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red"  BorderBrush="Red"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="8" />
            <TextBox x:Name="PT2textBox" Text="{Binding PT2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="116,7,84,45" Grid.Row="8" Width="64" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="3" Grid.ColumnSpan="2" />
            <TextBox x:Name="PT3textBox" Text="{Binding PT3Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="109,52,92,3" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.ColumnSpan="2" Grid.Column="1" />
            <TextBox x:Name="PT4textBox" Text="{Binding PT4Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="41,47,28,5" Width="63" FontSize="22" BorderThickness="0" FontWeight="Bold" Background="Transparent" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="6" />
            <TextBox x:Name="PT5textBox" Text="{Binding PT5Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="35,48,33,5" Width="64" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="8" />

            <TextBox x:Name="PS1textBox" Text="{Binding PS1Reading, Converter={StaticResource doubleToOnOffConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="69,18,17,35" Width="46" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" Grid.Row="6" />
            <TextBox x:Name="PS2textBox" Text="{Binding PS2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Height="24" Margin="62,38,70,0" Width="60" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="1" />

            <TextBox x:Name="FM1textBox" Text="{Binding FM1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="63,13,107,41" Grid.Row="1" Width="95" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="7" Grid.ColumnSpan="2" />
            <TextBox x:Name="TS1textBox" Text="{Binding TN2OReading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="94,71,107,68" Grid.Row="6" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="2" Grid.ColumnSpan="2" Grid.RowSpan="2" />
            <TextBox x:Name="LC1textBox" Text="{Binding LC1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="67,13,1,40" Grid.Row="9" Width="64" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="8" />

            <TextBox x:Name="TC1textBox" Text="{Binding TC1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="4,17,64,36" Grid.Row="5" Width="64" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" RenderTransformOrigin="0.623,-0.381" Height="32" />
            <TextBox x:Name="TC2textBox" Text="{Binding TC2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="4,61,65,77" Grid.Row="5" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red"  VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.RowSpan="2" Height="32" />
            <TextBox x:Name="IBPtextBox" Text="{Binding CP1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="4,18,65,35" Grid.Row="6" TextWrapping="Wrap" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Height="32" />
            <TextBox x:Name="OBPtextBox" Text="{Binding CP2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="4,60,65,78" Grid.Row="6" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.RowSpan="2" Height="32"/>

            <TextBox x:Name="TN2OtextBox" Text="{Binding TS1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="122,45,79,7" Grid.Row="8" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" BorderBrush="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.ColumnSpan="2" Grid.Column="1" />
            <TextBox x:Name="PWM2textBox" Text="{Binding PatientPIDDutyCycle, ConverterParameter=WithoutDecimal, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="22,23,47,31" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="4" />
            <TextBox x:Name="PWM1textBox" Text="{Binding PIDDutyCycle, ConverterParameter=WithoutDecimal, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsHitTestVisible="False" IsReadOnly="True" HorizontalAlignment="Center" Margin="11,61,58,78" Grid.Row="8" Width="63" BorderThickness="0" FontSize="22" FontWeight="Bold" Background="Transparent" Foreground="Red" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Grid.Column="5" Grid.RowSpan="2" />
            <local:UcGateValve x:Name="GateValveSV1Uc" Visibility="{Binding IsSV1Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" Grid.Column="5" HorizontalAlignment="Left" Margin="111,62,0,0" Grid.Row="7" Grid.RowSpan="2" VerticalAlignment="Top" Grid.ColumnSpan="2"/>
            <local:UcGateValve x:Name="GateValvePV1Uc" Visibility="{Binding IsPV1Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" Opacity="{Binding  PIDDutyCycle, Converter={StaticResource pWMToOpacityConverter}}" Grid.Column="4" HorizontalAlignment="Left" Margin="94,63,0,0" Grid.Row="7" Grid.RowSpan="2" VerticalAlignment="Top" Grid.ColumnSpan="2" />
            <local:UcGateValve x:Name="GateValveSV8Uc" Visibility="{Binding IsSV8Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" Grid.Column="2" HorizontalAlignment="Left" Margin="94,69,0,0" Grid.Row="3" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.RowSpan="2"/>
            <local:UcGateValve x:Name="GateValvePV2Uc" Visibility="{Binding IsPV2Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" Opacity="{Binding PatientPIDDutyCycle, Converter={StaticResource pWMToOpacityConverter}}" Grid.Column="3" HorizontalAlignment="Left"  Margin="101,17,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2" />
            <local:UcGateValve x:Name="GateValveSV4Uc" Visibility="{Binding IsSV4Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" Grid.Column="3" Margin="100,14,76,0" Grid.Row="2" VerticalAlignment="Top" Grid.ColumnSpan="2" />

            <local:UcGateValve x:Name="GateValveSV3Uc" Visibility="{Binding IsSV3Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="2" HorizontalAlignment="Left" Margin="106,61,0,0" Grid.Row="1" VerticalAlignment="Top" Grid.ColumnSpan="2" Grid.RowSpan="2" />
            <local:Uc3WayValve x:Name="Valve3WaySV3Uc" Visibility="{Binding IsSV3Activated, Converter={StaticResource booleanToNotVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="2" HorizontalAlignment="Left" Margin="110,47,0,45" Grid.Row="1" 
                               Grid.ColumnSpan="2" Grid.RowSpan="2" />

			<local:UcGateValve x:Name="Valve3WaySV6Uc" Visibility="{Binding IsSV6Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="8" HorizontalAlignment="Left" Margin="90,7,0,81" Grid.Row="5" Grid.RowSpan="2" Grid.ColumnSpan="2" />

			<local:Uc3WayValve x:Name="Valve3WayDownSV6Uc" Visibility="{Binding IsSV6Activated, Converter={StaticResource booleanToNotVisibilityConverter}, Mode=OneWay}"
                                Grid.Column="8" HorizontalAlignment="Left" Margin="92,8,0,84" Grid.Row="5" Grid.ColumnSpan="2" Grid.RowSpan="2"  />


			<local:UcGateValve x:Name="GateValveSV9Uc" Visibility="{Binding IsSV9Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="0" Margin="80,47,99,70" Grid.Row="3"
                               Grid.ColumnSpan="2" Grid.RowSpan="2">
                <local:UcGateValve.RenderTransform>
                    <RotateTransform CenterX="41.5" CenterY="26.5" Angle="90" />
                </local:UcGateValve.RenderTransform>
            </local:UcGateValve>

            <local:UcGateValve x:Name="GateValveSV5Uc" Visibility="{Binding IsSV5Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="5" Margin="99,62,81,55" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2">
                <local:UcGateValve.RenderTransform>
                    <RotateTransform CenterX="42.5" CenterY="26.5" Angle="90" />
                </local:UcGateValve.RenderTransform>
            </local:UcGateValve>

            <local:UcGateValve x:Name="GateValveSV7Uc" Visibility="{Binding IsSV7Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="7" Margin="43,84,0,32" Grid.Row="6" Grid.RowSpan="2">
                <local:UcGateValve.RenderTransform>
                    <RotateTransform CenterX="42.5" CenterY="26.5" Angle="90" />
                </local:UcGateValve.RenderTransform>
            </local:UcGateValve>

            <local:UcGateValve x:Name="GateValveSV2Uc" Visibility="{Binding IsSV2Activated, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}"
                               Grid.Column="1" Margin="97,59,82,58" Grid.Row="6"
                               Grid.ColumnSpan="2" Grid.RowSpan="2">
                <local:UcGateValve.RenderTransform>
                    <RotateTransform CenterX="43" CenterY="27.5" Angle="90" />
                </local:UcGateValve.RenderTransform>
            </local:UcGateValve>
        </Grid>

        <StackPanel Orientation="Vertical" Grid.Column="2" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center">

            <Button x:Name="Start" Style="{StaticResource StartButton}"
                    Visibility="{Binding SystemState, ConverterParameter=START, Converter={StaticResource stateToVisibility}}"
                    Command="{Binding StartCommand}"
                    IsEnabled="{Binding SystemState, ConverterParameter=START, Converter={StaticResource stateToEnable}}" Margin="0,0,0,10"/>
            <Button x:Name="Stop"
                    Style="{StaticResource StopButton}"
                    Visibility="{Binding SystemState, ConverterParameter=STOP, Converter={StaticResource stateToVisibility}}"
                    Command="{Binding StopCommand}"
                    IsEnabled="{Binding SystemState, ConverterParameter=STOP, Converter={StaticResource stateToEnable}}" Margin="0,10,0,10"/>

            <Button x:Name="DisconnectButton"
                    Style="{StaticResource DisconnectButton}"
                    Visibility="{Binding IsCatheterConnectedAndInIReadyState, Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ConnectCommand}"
                    IsEnabled="True"
                    Margin="0,10,0,10" />

            <Button x:Name="ConnectButton" Style="{StaticResource ConnectButton}"
                    Visibility="{Binding IsCatheterElectricallyConnectedAndInIdleState, Converter={StaticResource booleanToVisibilityConverter}}"
                    Command="{Binding ConnectCommand}"
                    Margin="0,10,0,10" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Label Content="Timer: " FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" />
                <Button Width="40" Height="40" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}" Command="{Binding DecreaseTimeCommand}"
                                        Visibility="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToVisibility}}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToEnable}}">
                    <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="40" Width="40" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="-90" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Button>

                <Label x:Name="RequiredAblationTime" Content="{Binding RequiredAblationTime}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,0" Width="40" VerticalAlignment="Center" />
                <Label Content="sec" Foreground="White" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center" />

                <Button Width="40" Height="40" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" 
                                        Command="{Binding IncreaseTimeCommand}"
                                        Visibility="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToVisibility}}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToEnable}}">
                    <Button.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform />
                            <SkewTransform />
                            <RotateTransform Angle="180" />
                            <TranslateTransform />
                        </TransformGroup>
                    </Button.RenderTransform>
                    <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="40" Width="40" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform />
                                <SkewTransform />
                                <RotateTransform Angle="-90" />
                                <TranslateTransform />
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>
                </Button>
            </StackPanel>

            <Button Width="185" Height="65" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}"
                    FontSize="24" Foreground="White" Content="Fault Reset" Command="{Binding FaultResetCommand}" Style="{StaticResource ButtonCryterion}" Margin="0,10,0,10" />

            <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="8" Margin="0,50,0,0" Width="180">
                <StackPanel Orientation="Horizontal" Height="60">
                    <Button Style="{StaticResource ButtonImageNotifier}"
                            x:Name="butElectrical"
                            HorizontalAlignment="Center" Width="115"  Height="55">
                        <Image Source="/Images/electrical plug.png" Margin="10,0,0,0"/>
                    </Button>
                    <Button Style="{StaticResource ButtonImageNotifier}"
                            x:Name="butElectricalState"
                            HorizontalAlignment="Center" Width="40" Height="50" Margin="10,0,0,0">
                        <Image Source="{Binding IsCatheterCableConnected, Converter={StaticResource statusToPicture}}" Height="50" Width="40" />
                    </Button>
                </StackPanel>
            </Border>

            <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="8" Width="180" Margin="0,10,0,0">
                <StackPanel Orientation="Horizontal" Height="60" Visibility="{Binding SystemState, Converter={StaticResource stateToVisibility}, ConverterParameter=CatheterTube}">
                    <Button Style="{StaticResource ButtonImageNotifier}"
                            x:Name="butMechanical"
                            HorizontalAlignment="Left" Width="115"  Height="55">
                        <Image Source="/Images/mechanical plug.png" Margin="10,2,2,0"/>
                    </Button>
                    <Button Style="{StaticResource ButtonImageNotifier}"
                            x:Name="butMechanicalState"
                            HorizontalAlignment="Center"
                            Width="40"  Height="50">
                        <Image Source="{Binding SystemState,ConverterParameter=UseSystemState, Converter={StaticResource statusToPicture}}" Height="50" Width="40" />
                    </Button>
                </StackPanel>
            </Border>
            
          <Border BorderThickness="1" CornerRadius="8" Margin="0,50,0,0" Width="230" BorderBrush="Silver">
            <StackPanel>
              <TextBlock Text="Inflation Speed" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>
              <StackPanel Orientation="Horizontal">
                <Viewbox Height="35">
                  <RadioButton Name="SlowButton" GroupName="speed" Margin="0,0,0,0" Width="50" Command="{Binding SlowButtonCommand}"
                               IsChecked="{Binding InflationSpeedMode, Mode=OneWay, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Slow}">
                    <RadioButton.Content>
                      <TextBlock Text="Slow" 
                                  Margin="0,2,0,0" FontSize="10" FontWeight="Bold"  Foreground="White"/>
                    </RadioButton.Content>
                  </RadioButton>
                </Viewbox>
                <Viewbox Height="35">
                  <RadioButton Name="FastButton" GroupName="speed" Margin="0,0,0,0" Command="{Binding FastButtonCommand}" Width="50"
                               IsChecked="{Binding InflationSpeedMode, Mode=OneWay, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Fast}">
                    <RadioButton.Content>
                      <TextBlock Text="Fast" 
                                  Margin="0,2,0,0" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </RadioButton.Content>
                  </RadioButton>
                </Viewbox>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>
    </Grid>
</UserControl>