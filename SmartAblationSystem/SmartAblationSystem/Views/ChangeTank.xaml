<UserControl x:Class="SmartAblationSystem.Views.ChangeTank"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:userControls="clr-namespace:CustomControls.UserControls;assembly=CustomControls"
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:viewModels="clr-namespace:SmartAblationSystem.ViewModels"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance viewModels:ChangeTankViewModel}">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/CustomControls;component/Resources/ChangeTankResources.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <converters:WeightToLevelConverter x:Key="weightToLevelConverter" />
      <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
      <converters:ScaleUnitToTextConverter x:Key="scaleUnitToTextConverter" />
      <converters:TankToStringConverter x:Key="tankToStringConverter" />
      <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />
      <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid Width="1920" Height="1080" >
      <Grid.RowDefinitions>
        <RowDefinition Height="80"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="80"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0" Background="#ff000000" >
        <TextBlock Text="TANK REPLACEMENT" Style="{StaticResource ChangeTankCaptionTitleStyle}"/>
      </Grid>

      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Column="0" Margin="80,0, 20, 0" HorizontalAlignment="Left">
          <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="1" Style="{StaticResource ChangeTankCaptionTitleStyle}" Width="555" HorizontalAlignment="Left" 
                   TextWrapping="Wrap" FontWeight="Normal"
                   Text="For safe tank replacement, carefully follow each step and their video instructions." />

          <userControls:ChangeTankStepUserControl Grid.Row="2" StepId="1" StepDescription="Close tank then press Next" 
                                                IsCurrentStep="{Binding CurrentStep, Converter={StaticResource enumBooleanConverter}, ConverterParameter=CloseTank}" 
                                                IsCompleted="{Binding IsTankClosed}"/>
          <userControls:ChangeTankStepUserControl Grid.Row="3" StepId="2" StepDescription="Please wait while the system purges the lines for your safety" 
                                                IsCurrentStep="{Binding CurrentStep, Converter={StaticResource enumBooleanConverter}, ConverterParameter=WaitTankPurge}" 
                                                IsCompleted="{Binding IsTankPurged}"/>
          <userControls:ChangeTankStepUserControl Grid.Row="4" StepId="3" StepDescription="Replace the tank" 
                                                IsCurrentStep="{Binding CurrentStep, Converter={StaticResource enumBooleanConverter}, ConverterParameter=ReplaceTank}" 
                                                IsCompleted="{Binding IsTankReplaced}"/>
          <userControls:ChangeTankStepUserControl Grid.Row="6" StepId="4" StepDescription="Open the tank" 
                                                IsCurrentStep="{Binding CurrentStep, Converter={StaticResource enumBooleanConverter}, ConverterParameter=OpenTank}" 
                                                IsCompleted="{Binding IsTankOpened}"/>
          <!-- Select Tank Type : Visibility binds to TankSelectionVisible -->
          <Grid Grid.Row="5" Height="160" Visibility="{Binding TankSelectionVisible, Converter={StaticResource booleanToVisibilityConverter}}" >
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110"/>
              <ColumnDefinition Width="280"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" Text="Select a Replacement Tank Type:" HorizontalAlignment="Left"
                     Style="{StaticResource ChangeTankTextBaseStyle}" FontSize="18"/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" >
              <RadioButton Template="{StaticResource Tank15Template}" Margin="20" GroupName="TankTypeGroup"
                         IsChecked="{Binding SelectedTankType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Tank_15pounds}" 
                         Command="{Binding SelectTank}" CommandParameter="15"/>
              <RadioButton Template="{StaticResource Tank10Template}" Margin="20" GroupName="TankTypeGroup"
                         IsChecked="{Binding SelectedTankType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Tank_10pounds}"
                         Command="{Binding SelectTank}" CommandParameter="10" />
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" 
                    Visibility="{Binding IsTankOpened, Converter={StaticResource booleanToVisibilityConverter}}">
            <CheckBox Style="{StaticResource StepCompletionStateStyle}" IsChecked="True" />
            <TextBlock Text="Change tank completed!" Style="{StaticResource ChangeTankTextBaseStyle}" Foreground="White" FontSize="22" Margin="20,0, 20, 0" />
          </StackPanel>

        </Grid>

        <Grid Grid.Column="1" Width="780">
          <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="380"/>
          </Grid.RowDefinitions>
          <!-- Play Video -->
          <Grid Grid.Row="0" Width="780" VerticalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="40"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- TODO:: Current Video Description -->
            <TextBlock Grid.Row="0" Style="{StaticResource ChangeTankTextBaseStyle}" FontSize="18" FontWeight="Bold"  HorizontalAlignment="Left"
                     Text="{Binding CurrentVideoDescription}"/>
            <Border Grid.Row="1" x:Name="_border" BorderBrush="#FF2B2B33" BorderThickness="0" CornerRadius="10">
              <Grid>
                <Border Name="_mask" Background="{Binding ElementName=_border, Path=BorderBrush}" CornerRadius="{Binding ElementName=_border, Path=CornerRadius}"/>
                <Grid>
                  <Grid.OpacityMask>
                    <VisualBrush Visual="{Binding ElementName=_mask}"/>
                  </Grid.OpacityMask>
                  <MediaElement LoadedBehavior="Manual" Name="VideoPlayer" Height="440" Source="{Binding VideoSourcePath}"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
          <!-- SYSTEM INFORMATION  -->
          <Grid Grid.Row="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="40" />
              <RowDefinition Height="276" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="SYSTEM INFORMATION" Style="{StaticResource ChangeTankCaptionTitleStyle}" 
                     FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Margin="0,0,0,20"/>
            <Border Grid.Row="1" BorderThickness="0" Background="#FF2C2C31" CornerRadius="10" >
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="150"/>
                  <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <!-- Pressure Gauge Display -->
                <dxga:CircularGaugeControl Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Width="225">
                  <dxga:CircularGaugeControl.Model>
                    <dxga:CircularEcoModel />
                  </dxga:CircularGaugeControl.Model>
                  <dxga:CircularGaugeControl.Scales>
                    <dxga:ArcScale StartValue="0" EndValue="1000">
                      <dxga:ArcScale.Layers>
                        <dxga:ArcScaleLayer />
                      </dxga:ArcScale.Layers>
                      <dxga:ArcScale.Needles>
                        <dxga:ArcScaleNeedle IsInteractive="False" x:Name="pressureNeedle" Value="{Binding PT1Reading}" />
                      </dxga:ArcScale.Needles>
                      <dxga:ArcScale.Ranges>
                        <dxga:ArcScaleRange StartValue="0" EndValue="800" />
                        <dxga:ArcScaleRange StartValue="800" EndValue="850" />
                        <dxga:ArcScaleRange StartValue="850" EndValue="1000" />
                      </dxga:ArcScale.Ranges>
                      <dxga:ArcScale.CustomElements>
                        <dxga:ScaleCustomElement HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0, 160, 0, 0" FontSize="14">
                          <TextBlock Text="PSI" FontWeight="Bold" />
                        </dxga:ScaleCustomElement>
                      </dxga:ArcScale.CustomElements>
                    </dxga:ArcScale>
                  </dxga:CircularGaugeControl.Scales>
                </dxga:CircularGaugeControl>
                <!-- Tank Weight Display  -->
                <Grid Grid.Column="1" Height="95">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Stretch="Uniform" HorizontalAlignment="Left" Margin="0">
                      <ProgressBar Orientation="Vertical" Style="{StaticResource TankFillMeterStyle}"
                                 IsIndeterminate="False" Minimum="0" Maximum="100" Width="22" Height="100" 
                                 Value="{Binding LC1Reading, Converter={StaticResource weightToLevelConverter}}" />
                    </Viewbox>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Style="{StaticResource TankWeightTextStyle}" Margin="10,0 , 0 , 0" 
                               Text="{Binding LC1Reading, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=LC1Reading}"/>
                      <TextBlock Style="{StaticResource TankWeightTextStyle}" 
                               Text="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}, ConverterParameter=NoParentheses}" />
                    </StackPanel>
                  </StackPanel>
                </Grid>
                <!-- Change Tank Information  -->
                <Grid Grid.Column="2" Height="92" Margin="20, 0, 0, 0">
                  <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel.Resources>
                      <Style BasedOn="{StaticResource ChangeTankTextBaseStyle}" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="19" />
                      </Style>
                    </StackPanel.Resources>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                      <TextBlock Text="Change Date: " />
                      <TextBlock Foreground="White" 
                      Text="{Binding CurrentTank, Converter={StaticResource tankToStringConverter}, ConverterParameter=CHANGE_DATE}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                      <TextBlock Text="Weight at Change: " />
                      <TextBlock Foreground="White"
                               Text="{Binding CurrentTank, Converter={StaticResource tankToStringConverter}, ConverterParameter=WEIGHT_AT_CHANGE}"/>
                      <TextBlock Foreground="White"
                               Text="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}, ConverterParameter=NoParentheses}"
                               Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                      <TextBlock Text="Current Weight: " />
                      <TextBlock Foreground="White"
                               Text="{Binding LC1Reading, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=LC1Reading}"/>
                      <TextBlock Foreground="White"
                               Text="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}, ConverterParameter=NoParentheses}" 
                               Margin="5,0,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
      </Grid>
      <!-- Bottom Button Section -->
      <Grid Grid.Row="2" Background="#FF222228">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Content="NEXT" Style="{StaticResource SettingsApplyButton}" Width="88" 
              Command="{Binding StartCommand}" 
              Visibility="{Binding IsStartVisible, Converter={StaticResource booleanToVisibilityConverter}}"/>

          <Button Content="CANCEL" Style="{StaticResource SettingsPreferencesButton}" Width="108"
                Command="{Binding ResetCommand}" 
                Visibility="{Binding IsCancelVisible, Converter={StaticResource booleanToVisibilityConverter}}"/>

          <Button Content="FINISH" Style="{StaticResource SettingsApplyButton}" Width="96" Margin="30, 0"
                Command="{Binding FinishCommand}" 
                Visibility="{Binding IsFinishVisible, Converter={StaticResource booleanToVisibilityConverter}}"/>

        </StackPanel>
      </Grid>
    </Grid>
    <Canvas>
      <StackPanel Style="{StaticResource HospitalLogoStackPanelOnHomeStyle_}">
        <TextBlock Text="Hospital:" 
                   Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
        <TextBlock Grid.ColumnSpan="2" 
                   Text="{Binding HospitalName}" 
                   Style="{StaticResource HospitalNameTextBlockStyle_}" />
      </StackPanel>
      <Image Style="{StaticResource LogoImageOnOthersStyle_}"/>
    </Canvas>
  </Grid>
</UserControl>
