                                                <Path Data="F1 M 12.000,0.000 C 18.627,0.000 24.000,5.373 24.000,12.000 C 24.000,18.627 18.627,24.000 12.000,24.000 C 5.373,24.000 0.000,18.627 0.000,12.000 C 0.000,5.373 5.373,0.000 12.000,0.000 Z"/>

                                                <!-- Layer 1/Group 632/Ellipse 140/<Path> -->
                                                <Path StrokeThickness="2.0" Stroke="#ff7aa2f1" StrokeMiterLimit="1.0" Data="F1 M 12.000,1.000 C 18.075,1.000 23.000,5.925 23.000,12.000 C 23.000,18.075 18.075,23.000 12.000,23.000 C 5.925,23.000 1.000,18.075 1.000,12.000 C 1.000,5.925 5.925,1.000 12.000,1.000 Z"/>

                                            </Canvas>

                                        </Canvas>

                                    </Canvas>
                                </Canvas>
                                <TextBlock  Text="Enter 0 to Reset Time to Isolation" Style="{StaticResource TTIWarningStyle}" Margin="14,0,0,0"/>
                            </StackPanel>

                            <StackPanel  Grid.Column="1" Grid.Row="2" Width="330" Height="63" Margin="0,34,0,0">
                                <TextBlock Text="New Duration"  Style="{StaticResource TTIMessageStyle}"/>
                                <TextBox Name="TxtDuration" Text="{Binding VeinIsolationDuration, Mode=TwoWay}"
                                      MaxLength="5" Margin="0,9,0,0" Style="{StaticResource TextBoxNewStyle}" Width="330" Height="34" />
                            </StackPanel>
                            <TextBlock Text="Invalid duration!" Grid.Column="1" Grid.Row="3" 
                                   Visibility="{Binding IsInfoValid, Converter={StaticResource booleanToNotVisibilityConverter}, ConverterParameter=HIDDEN, Mode=OneWay}" 
                                  Style="{StaticResource TTIErrorStyle}" Margin="55,0,0,0"/>
                        </Grid>
                    </Border>


                    <Button Style="{StaticResource  TextWithUnderlineButton}" Content="Cancel" Width="65" Grid.Column="1" Grid.Row="1" Margin="58,0,0,10" HorizontalAlignment="Left" VerticalAlignment="Center" Click="No_Click" IsCancel="True" />
                    <Button Style="{StaticResource SettingsApplyButton}" Content="SAVE" Grid.Column="1" Grid.Row="1" x:Name="Yes" Margin="0,0,12,10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Ok_Click" Width="84.08" Height="48.99"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>