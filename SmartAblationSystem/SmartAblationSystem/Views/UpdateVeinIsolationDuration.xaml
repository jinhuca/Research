                                <Path Fill="#ffdadada" Data="F1 M 8.842,15.772 C 10.795,15.772 12.379,17.355 12.379,19.309 C 12.379,21.262 10.795,22.846 8.842,22.846 C 6.888,22.846 5.305,21.262 5.305,19.309 C 5.305,17.355 6.888,15.772 8.842,15.772 Z M 8.842,16.772 C 7.443,16.772 6.305,17.910 6.305,19.309 C 6.305,20.708 7.443,21.846 8.842,21.846 C 10.241,21.846 11.379,20.708 11.379,19.309 C 11.379,17.910 10.241,16.772 8.842,16.772"/>

