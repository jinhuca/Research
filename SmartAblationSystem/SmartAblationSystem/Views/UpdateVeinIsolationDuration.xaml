                            <Path StrokeThickness="1.5" Stroke="#ffdadada" StrokeLineJoin="Round" Data="F1 M 12.306,19.478 L 14.595,19.478 L 16.634,26.578 L 19.369,3.832 L 23.069,33.039 L 25.519,19.476 L 33.519,19.476"/>

