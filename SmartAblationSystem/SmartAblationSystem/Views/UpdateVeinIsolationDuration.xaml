        <DropShadowEffect Color="Black"
              ShadowDepth="11"
              BlurRadius="20"
              RenderingBias="Performance"
              Opacity="0.5"
              Direction="-50"/>
      </Border.Effect>
    </Border>
    <Grid Margin="0,0,-0,0"  >

            <Grid.RowDefinitions>
                <RowDefinition Height="78" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.Background>
                    <VisualBrush>
                        <VisualBrush.Visual>

                            <Canvas>

                                <Canvas>

                                    <!-- Layer 1/<Group>/header bg-2 -->
