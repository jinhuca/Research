                                <Canvas Width="24.000" Height="24.000"  Margin="20,0,0,0">

                                    <Canvas>

                                        <Canvas>

                                            <!-- Layer 1/Group 632/Path 60 -->
                                            <Path StrokeThickness="2.0" Stroke="#ff7aa2f1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="F1 M 10.857,10.102 L 12.392,10.102 L 12.392,18.496"/>

                                            <!-- Layer 1/Group 632/Ellipse 18 -->
                                            <Path Fill="#ff7aa2f1" Data="F1 M 12.000,5.000 C 12.746,5.000 13.350,5.604 13.350,6.350 C 13.350,7.096 12.746,7.700 12.000,7.700 C 11.254,7.700 10.650,7.096 10.650,6.350 C 10.650,5.604 11.254,5.000 12.000,5.000 Z"/>

                                            <Canvas>

