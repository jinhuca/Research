<Window x:Class="SmartAblationSystem.Views.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helpers="clr-namespace:SmartAblationSystem.Helpers"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        mc:Ignorable="d"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="OnAddUserWindowLoaded">
  <Grid>
    <Border CornerRadius="12" Width="471" Height="562" Opacity="1" 
            BorderBrush="Transparent"
            BorderThickness="0" 
            Background="{StaticResource PanelBackgroundBrush_}" >
      <Border.Effect>
        <DropShadowEffect Color="Black"
                  ShadowDepth="11"
                  BlurRadius="20"
                  RenderingBias="Performance"
                  Opacity="0.5"
                  Direction="-50"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="12" Width="471" Height="562" Opacity="1" 
            BorderBrush="Transparent"
            BorderThickness="0" 
            Background="{StaticResource PanelBackgroundBrush_}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="78"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="12,12,0,0" 
                Background="{StaticResource TitleBackgroundBrush_}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1.32*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" HorizontalAlignment="Right" 
                  Margin="0,4,7.8,0" Height="38" Width="38">
              <Grid.Background>
                <DrawingBrush Drawing="{StaticResource UserIconDrawingGroup_}" Stretch="Uniform"/>
              </Grid.Background>
            </Grid>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" 
                       Margin="6,3,0,0" 
                       Text="NEW USER" 
                       Style="{StaticResource DialogTitleTextBlockStyle_}"/>
          </Grid>
        </Border>
        <Border Grid.Row="1" 
                CornerRadius="0,0,12,12" 
                BorderBrush="Transparent" 
                BorderThickness="0" 
                Background="{StaticResource BorderBackgroundBrush_}">
          <Grid Margin="0,36,0,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="50"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="80"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Width="340">
              <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" 
                         Text="User Name:" 
                         Margin="4,8,0,0" 
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <TextBox Grid.Row="1" 
                       x:Name="TxtUserNameNew" 
                       Margin="5,10,0,0" 
                       Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       MaxLength="32" 
                       Foreground="{StaticResource ValueTextForeground_}" 
                       Style="{StaticResource TextBoxErrorStyle_}"/>
            </Grid>
            <Grid Grid.Row="1" Width="330" Height="60">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" 
                         Text="Admin:" Margin="0,0,0,20" 
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" 
                          Height="30" Margin="24,0,0,18">
                <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftTextStyle_}"/>
                <ToggleButton HorizontalAlignment="Left" 
                              IsChecked="{Binding AdminSelected}" 
                              Style="{StaticResource SwitchToggleButton}"/>
                <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightTextStyle_}"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="2" Width="340">
              <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" 
                         Text="Password:" 
                         Margin="4,0,0,0"
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <PasswordBox Grid.Row="1" Width="330" 
                           Margin="0,5,0,20" 
                           x:Name="EnteredPasswordBox" 
                           MaxLength="16"
                           helpers:BoundPasswordBox.BoundPassword="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                           PasswordChanged="EnteredPasswordBox_OnPasswordChanged" 
                           Style="{StaticResource PasswordBoxStyle_}"/>
            </Grid>
            <Grid Grid.Row="3" Width="340">
              <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" 
                         Text="Confirm Password:" 
                         Margin="4,0,0,0" 
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <PasswordBox Grid.Row="1" Width="330" 
                           Margin="0,2,0,0" 
                           x:Name="EnteredConfirmedPassword" 
                           MaxLength="16"
                           helpers:BoundPasswordBox.BoundPassword="{Binding Path=ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                           PasswordChanged="EnteredConfirmedPassword_OnPasswordChanged"
                           Style="{StaticResource PasswordBoxStyle_}"/>
            </Grid>
            <Grid Grid.Row="4" 
                  Margin="0,10,20,0" 
                  HorizontalAlignment="Right">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" 
                      Margin="0,0,5,0" 
                      Content="Cancel" 
                      Style="{StaticResource TextWithUnderlineButton_}" 
                      Click="No_Click" 
                      IsCancel="True"/>
              <Button Grid.Column="1"
                      Content="ADD USER" 
                      Foreground="White" 
                      IsEnabled="{Binding IsAddUserInformValid}"
                      Style="{StaticResource ConfirmButtonStyle_}"
                      Click="Ok_Click"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
