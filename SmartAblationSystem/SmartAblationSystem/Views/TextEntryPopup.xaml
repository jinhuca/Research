<Window x:Class="SmartAblationSystem.Views.TextEntryPopup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartAblationSystem.Views"
      mc:Ignorable="d"
        xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
      d:DesignHeight="300" d:DesignWidth="300"
      Title="MessagePopup"  Height="430" Width="960" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <converters:FieldToTextConverter x:Key="fieldToTextConverter" />
    </Window.Resources>

    <Border Name="BorderColor" BorderThickness="0" CornerRadius="10,10,10,10" Background="{StaticResource CryterionPopupSystemMessageBrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Name="TitleLabel" Grid.Row="0" Uid="treatmentnotesUID"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Uid , Converter={StaticResource fieldToTextConverter}, ConverterParameter=CAPS }"  FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" Background="Transparent" />

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushControlContainer}" Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="65" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
          
                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushContentContainer }" Margin="5,5,5,5">
                        
                        <TextBox x:Name="TxtContent" Margin="5" BorderThickness="0" AcceptsReturn="True" 
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                                 TextWrapping="Wrap" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                 TextAlignment="Left" Foreground="Black" FontSize="25" FontWeight="Bold"
                                 SpellCheck.IsEnabled="False" MaxLength="500" />
                    </Border>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource RoundCorner}" Content="OK" x:Name="OkButton" Margin="10,10,10,10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OkButton_Click" />
                        <Button Style="{StaticResource RoundCorner}" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name, Converter={StaticResource fieldToTextConverter}}" x:Name="CancelButton" Margin="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center" IsCancel="True" Background="#FF00AFEF" Click="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>