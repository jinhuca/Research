<Window x:Class="SmartAblationSystem.Views.ConnectCatheterPopup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:prism="http://prismlibrary.com/"
      prism:ViewModelLocator.AutoWireViewModel="True"
     xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
      DataContext="{Binding RelativeSource={RelativeSource Self}}"
      mc:Ignorable="d"
      d:DesignHeight="400" d:DesignWidth="600"
      Title="MessagePopup" Height="400" Width="600" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
  <Window.Resources>
    <converters:FieldToTextConverter x:Key="fieldToTextConverter" />
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
  </Window.Resources>

  <Border Name="BorderColor" BorderThickness="0" CornerRadius="10,10,10,10" Background="#C12B48">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="80" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <StackPanel VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
        
        <ContentControl Margin="0,2,40,0">
          <ContentControl.Template>
            <ControlTemplate>
              <Border Background="Transparent">
                <Canvas>
                  <Line  X1="0" Y1="0" X2="0" Y2="8" Stroke="#FFFFFFFF" Canvas.Left="15.7" Canvas.Top="9" StrokeThickness="2" />
                  <Path  Width="31" Height="26" Stretch="Uniform" Stroke="#FFFFFFFF"  Canvas.Left="0" Canvas.Top="0" 
                                           Data="M 14,3 C 14.7,1.6 16.6,1.6 17.4,2.9 L 29.6,23.7 C 30.4,25 29.4,26.7 27.9,26.7 L 3.5,26.7 C 1.9,26.7 1,25 1.8,23.7 Z" StrokeThickness="2"/>
                  <Ellipse  Width="2" Height="2" Stroke="#FFFFFFFF" Canvas.Left="14.8 " Canvas.Top="20" StrokeThickness="2"/>
                </Canvas>
              </Border>
            </ControlTemplate>
          </ContentControl.Template>
        </ContentControl>
        <Label Name="TitleLabel" Grid.Row="0" Foreground="White" Uid="SystemMessageLabel" Content="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}" FontFamily="{StaticResource Lato}" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />

      </StackPanel>
      <Border Grid.Row="1" BorderThickness="0" CornerRadius="0,0,10,10" Background="#2B2B33" >
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="65" />
          </Grid.RowDefinitions>

          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>

          <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" CornerRadius="10" Background="#2B2B33" Margin="5,5,5,5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="86*"/>
                <RowDefinition Height="5*"/>
              </Grid.RowDefinitions>

              <StackPanel VerticalAlignment="Top" Height="250" Margin="0,10,0,0" Grid.RowSpan="2"  HorizontalAlignment="Center" >

                <TextBlock x:Name="txtMessage" Width="600" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" Foreground="#CEC3C6" FontWeight="Regular" FontFamily="{StaticResource Lato}" FontSize="18" Height="50"
                                          Uid="conCatheterMesUID"  Text= "{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}"/>

                <!--<Label Name="TreatmentInfoLabel" HorizontalAlignment="Center" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Foreground="{StaticResource CryterionBrushColorBlue}" FontSize="30" FontWeight="Bold" Margin="0,-10,0,0" />-->

                <Grid HorizontalAlignment="Center" VerticalAlignment="Top">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>

                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>

                  </Grid.RowDefinitions>

                  <Image x:Name="connectorOff" Source="/Images/connector off.png" Grid.Column="0" Grid.Row="0" Width="220" Height="172" VerticalAlignment="Top" HorizontalAlignment="Center" />
                  <Image x:Name="connectorOn" Source="/Images/connector on.png" Grid.Column="0" Grid.Row="0" Width="220" Height="172" VerticalAlignment="Top" HorizontalAlignment="Center"/>

                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <Grid Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="235" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Name="VolumeControlStackPanel" Orientation="Vertical" HorizontalAlignment="Left" Margin="0,0,0,0"
                                    Height="60" Width="235" Background="Transparent">
              <Grid>

                <ToggleButton Grid.Row="0" HorizontalAlignment="Left" Height="30" Style="{StaticResource VolumeMuteToggleBtnStyle}"
                      Name="MuteButton" Margin="30,10,0,50" 
                      Visibility="{Binding IsVolumeControlEnabled, Converter={StaticResource booleanToVisibilityConverter}}"
                      Click="ToggleMuteButtonCommand" />
              </Grid>
            </StackPanel>

            <StackPanel  Height="70" Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Style="{StaticResource TextWithUnderlineButton}" Width="100" Height="48" Content="{Binding RelativeSource={RelativeSource Self}, Path=Uid , Converter={StaticResource fieldToTextConverter}}" Uid="CancelButton" x:Name="NoButton" Margin="0,0,0,15" 
                      VerticalAlignment="Center" IsCancel="True" Click="No_Click" />
              <Button Style="{StaticResource SettingsPreferencesButton}" Content="OK" FontWeight="Bold" x:Name="YesButton" Margin="0,-10,20,10" Height="50"  Width="70"
                                    VerticalAlignment="Center" Click="Yes_Click" />

            </StackPanel>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>