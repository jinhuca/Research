<Window x:Class="SmartAblationSystem.Views.EditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:converterNew="clr-namespace:SmartAblationSystem.ConvertersNew"
        xmlns:helpers="clr-namespace:SmartAblationSystem.Helpers"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True" 
        WindowStartupLocation="Manual"
        Stylus.IsPressAndHoldEnabled="True"
        Stylus.IsTapFeedbackEnabled="False"
        IsManipulationEnabled="False"
        Background="Transparent" Width="515" SizeToContent="Height" MinHeight="478"
        Loaded="OnEditUserWindowLoaded"
        x:Name="EditUserWindowName">
  <Window.Resources>
    <converterNew:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter_"/>
  </Window.Resources>
  <Grid x:Name="EditUserGrid" Width="471" Height="438">
    <Border CornerRadius="12" x:Name="EditUserWindowBorder" Width="471" Opacity="1" 
          BorderBrush="Transparent" BorderThickness="0" 
          Background="{StaticResource PanelBackgroundBrush_}">
    <Border.Effect>
      <DropShadowEffect Color="Black"
                ShadowDepth="11"
                BlurRadius="20"
                RenderingBias="Performance"
                Opacity="0.5"
                Direction="-50"/>
    </Border.Effect>
    <StackPanel>
      <Border CornerRadius="12,12,0,0" Height="78"
              Background="{StaticResource TitleBackgroundBrush_}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.32*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" HorizontalAlignment="Right" 
                Margin="0,4,7.8,0" 
                Height="38" Width="38">
            <Grid.Background>
              <DrawingBrush Drawing="{StaticResource UserIconDrawingGroup_}" Stretch="Uniform"/>
            </Grid.Background>
          </Grid>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" 
                     Margin="6,3,0,0" 
                     Text="EDIT USER" 
                     Style="{StaticResource DialogTitleTextBlockStyle_}"/>
        </Grid>
      </Border>
      <Border CornerRadius="0,0,12,12"
              BorderBrush="Transparent"
              BorderThickness="0"
              Background="{StaticResource BorderBackgroundBrush_}">
        <StackPanel Margin="0,20,0,10">
          <Grid Width="340" Height="80">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" 
                       Text="User Name:" 
                       Margin="4,0,0,5" 
                       Style="{StaticResource SubTitleTextStyle_}"/>
            <TextBox Grid.Row="1" Height="30" 
                     x:Name="TxtUserNameNew" 
                     Margin="0,0,0,1" 
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     MaxLength="32" VerticalAlignment="Top" 
                     Foreground="{StaticResource ValueTextForeground_}" 
                     Focusable="True"
                     Style="{StaticResource TextBoxErrorStyle_}"
                     PreviewTouchDown="TxtUserNameNew_OnPreviewTouchDown"/>
          </Grid>
          <Grid Background="Transparent" VerticalAlignment="Center" HorizontalAlignment="Left" Height="35" Width="200"
                Margin="70,0,0,20"
                MouseUp="AdminSelectionGrid_MouseUp">
            <StackPanel x:Name="AdminSelectionPanel"
                      Orientation="Horizontal" 
                      Background="Transparent"
                      PreviewTouchDown="AdminSelectionPanel_OnPreviewTouchDown">
              <TextBlock Text="Admin:" 
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center" 
                        Height="30" Margin="24,0,0,0">
                <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftTextStyle_}"/>
                <ToggleButton x:Name="AdminSelectionToggleButton" 
                            HorizontalAlignment="Left" 
                            IsHitTestVisible="False"
                            IsChecked="{Binding AdminSelected, Mode=TwoWay}"
                            Style="{StaticResource SwitchToggleButton}"/>
                <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightTextStyle_}"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <Grid x:Name="ResetPasswordBorder" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Left" 
                Height="35" Width="200"
                Margin="70,0,0,0" 
                Background="Transparent" 
                MouseUp="ResetPasswordGrid_MouseUp">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                        Background="Transparent"
                        PreviewTouchDown="ResetPasswordPanel_OnPreviewTouchDown">
              <ToggleButton VerticalAlignment="Bottom" Width="25" 
                            IsHitTestVisible="False" 
                            x:Name="ResetPasswordToggleButton"
                            Style="{StaticResource SaveToUsbToggleStyle_}" 
                            IsChecked="{Binding ResetPasswordSelected}"/>
              <TextBlock Text="Reset Password" Margin="14,10,0,0"
                         Style="{StaticResource ResetPasswordTextBlockStyle_}"/>
            </StackPanel>
          </Grid>
          <Grid Height="Auto" Width="340"
                Visibility="{Binding ResetPasswordSelected, Converter={StaticResource BoolToVisibilityConverter_}}">
            <Grid.RowDefinitions>
              <RowDefinition/>
              <RowDefinition/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,25,0,10" x:Name="AdminPasswordGrid"
                  Visibility="{Binding IsBSCUser, Converter={StaticResource BoolToVisibilityConverter_}, ConverterParameter=REVERSE, Mode=OneWay}">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
                         Text="Admin Password:"
                         Margin="0,8,0,10"
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <PasswordBox Grid.Row="1"
                           x:Name="AdminPasswordBox"
                           Password=""
                           PasswordChanged="AdminPasswordBox_Changed"
                           MaxLength="16"
                           Focusable="True"
                           Style="{StaticResource PasswordBoxStyle_}"
                           PreviewTouchDown="AdminPasswordBox_PreviewTouchDown"/>
            </Grid>
            <Grid Grid.Row="1" Margin="0,20,0,10">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" 
                         Text="New Password:" 
                         Margin="0,8,0,10" 
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <PasswordBox Grid.Row="1"
                           x:Name="NewPasswordBox"
                           helpers:BoundPasswordBox.BoundPassword="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PasswordChanged="NewPasswordBox_Changed" 
                           MaxLength="16"
                           Focusable="True"
                           Style="{StaticResource PasswordBoxStyle_}"
                           PreviewTouchDown="NewPasswordBox_PreviewTouchDown"/>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" 
                         Text="Confirm New Password:" 
                         Margin="0,8,0,10" 
                         Style="{StaticResource SubTitleTextStyle_}"/>
              <PasswordBox Grid.Row="1" 
                           x:Name="ConfirmPasswordBox" 
                           helpers:BoundPasswordBox.BoundPassword="{Binding Path=ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                           PasswordChanged="ConfirmPassword_Changed"
                           MaxLength="16"
                           Focusable="True"
                           Style="{StaticResource PasswordBoxStyle_}"
                           PreviewTouchDown="ConfirmPasswordBox_PreviewTouchDown"/>
            </Grid>
          </Grid>
          <StackPanel Orientation="Horizontal" 
                      Width="120" 
                      HorizontalAlignment="Left"
                      Margin="64,30,0,20"
                      Background="Transparent">
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="MouseDown">
                <i:InvokeCommandAction Command="{Binding DeleteUserCommand}" 
                                       CommandParameter="{Binding ElementName=EditUserWindowName}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
            <Grid Width="20" Height="20">
              <Grid.Background>
                <DrawingBrush Drawing="{StaticResource DeleteUserIconDrawing_}" TileMode="None" Stretch="Uniform"/>
              </Grid.Background>
            </Grid>
            <TextBlock Text="Delete User" Style="{StaticResource DeleteUserTextStyle_}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <Grid Margin="0,20,22,20"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" 
                Content="Cancel" 
                Background="Transparent"
                Style="{StaticResource TextWithUnderlineButton_}" 
                Click="CancelButton_Click"
                PreviewTouchDown="CancelButton_TouchDown"
                IsCancel="True"/>
        <Button Grid.Column="1" 
                Content="SAVE" 
                Foreground="White" 
                IsEnabled="{Binding IsEditUserInformationValid}" 
                Style="{StaticResource ConfirmButtonStyle_}"
                Click="SaveButton_Click"
                PreviewTouchDown="SaveButton_TouchDown"/>
      </Grid>
    </StackPanel>
  </Border>
  </Grid>
</Window>
