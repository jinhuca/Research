<Window x:Class="SmartAblationSystem.Views.AblationSiteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:local="clr-namespace:SmartAblationSystem.Views"
        mc:Ignorable="d"
        Title="AblationSiteWindow"
        WindowStyle="None"
				WindowStartupLocation="Manual"
        AllowsTransparency="True"
				Width="228" Height="255"
        Background="Transparent">
  <Window.Effect>
    <DropShadowEffect Color="Black"
		                  ShadowDepth="11"
		                  BlurRadius="20"
                      RenderingBias="Performance"
		                  Opacity=".5"
		                  Direction="-50">
    </DropShadowEffect>
  </Window.Effect>
  <Window.Resources>
    <SolidColorBrush x:Key="TitleForeground" Color="#ffcdc2c5"/>
    <SolidColorBrush x:Key="TitleBackground" Color="#ff475E8B"/>

    <SolidColorBrush x:Key="CtrlBackground" Color="#ff2a2a32"/>
    <Style x:Key="TitleTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{StaticResource TitleForeground}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MessageTextStyle" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="{StaticResource TitleForeground}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>
  </Window.Resources>
  <Grid HorizontalAlignment="Left">
    <Border Grid.Column="0" 
            HorizontalAlignment="Left" 
            VerticalAlignment="Top" 
            Background="{StaticResource CtrlBackground}"
            CornerRadius="8">
      <Grid Width="215" Height="242" ShowGridLines="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="50"/>
          <RowDefinition Height="56"/>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" 
                Background="{StaticResource TitleBackground}"
                CornerRadius="8,8,0,0">
          <TextBlock Text="ABLATION SITE" 
                     Style="{StaticResource TitleTextStyle}"/>
        </Border>
        <TextBlock Grid.Row="1"
                   Text="Select ablation site:" 
                   Style="{StaticResource MessageTextStyle}"/>
        <ComboBox Grid.Row="2" 
				          Style="{StaticResource ComboBoxStyle}"
				          ItemsSource="{Binding AblationSiteList}" 
				          SelectedItem="{Binding SelectedAblationSite}"/>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource TextWithUnderlineButton_}"
                  Content="Cancel"
                  IsCancel="True"
                  Click="No_Click"/>
          <Button x:Name="Yes"
                  Margin="20,0,10,0"
                  Style="{StaticResource SaveButtonStyle_}"
                  Click="Ok_Click"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>