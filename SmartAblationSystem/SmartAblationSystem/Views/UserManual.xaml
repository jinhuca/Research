<UserControl x:Class="SmartAblationSystem.Views.UserManual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920">
    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:ActionIdToActionDescriptionConverter x:Key="actionIdToActionDescriptionConverter" />
        <converters:UserToStringConverter x:Key="userToStringConverter" />
		<converters:FieldToTextConverter x:Key="fieldToTextConverter" />
    </UserControl.Resources>

    <Grid Height="1080" Width="1920" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="25*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Source="/Images/BSC_Logo.png" Margin="0,5,5,0" Height="70" HorizontalAlignment="Right" VerticalAlignment="Top" />

        <StackPanel Grid.Row="1" Orientation="Vertical">

            <Border Margin="10,0,10,0" BorderThickness="2" CornerRadius="6">
                <Border.BorderBrush>
                    <SolidColorBrush Color="White" Opacity="1" />
                </Border.BorderBrush>

                <DocumentViewer HorizontalAlignment="Center" Margin="0,5,0,5" Document="{Binding ManualDocument}"
                    Name="documentViewer" VerticalAlignment="Top" Height="870" Width="1600" />
            </Border>
        </StackPanel>

		<Button x:Name="ReturnToSettingsButton" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" 
                Height="60" Width="300" Background="Transparent"
                Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="6" Style="{StaticResource ButtonCryterion}"
                VerticalAlignment="Center" Margin="0,15,0,15"
                Command="{Binding ReturnToSettingsCommand}"
                FontSize="24" FontWeight="Bold" Foreground="White" />
	</Grid>
</UserControl>