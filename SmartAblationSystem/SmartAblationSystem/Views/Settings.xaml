<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:prism="http://prismlibrary.com/"
             x:Class="SmartAblationSystem.Views.Settings"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Loaded="Settings_OnLoaded">
  <UserControl.Resources>
    <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter"/>
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
    <converters:MinutesToUsageTimeConverter x:Key="minutesToUsageTimeConverter"/>
    <Style x:Key="DayTimeTextBlockStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Arial"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Foreground" Value="#FFDBDBDB"/>
    </Style>
    <Style x:Key="DayTimeTitleStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Foreground" Value="#FFD1D1D1"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid>
      <Grid.Background>
        <ImageBrush ImageSource="../Images/HomeBackground2.png"/>
      </Grid.Background>
      <Grid.RowDefinitions>
        <RowDefinition Height="180"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="80"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <!--<Grid Grid.Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                   Text="Hospital: " 
                   Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
          <TextBlock Grid.Column="1" 
                   Text="{Binding HospitalName}" 
                   Style="{StaticResource HospitalNameTextBlockStyle_}"/>
        </Grid>-->
        <Grid Grid.Column="1" Margin="0,6,8,0">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" 
                   Text="{Binding MinutesOfUse, Converter={StaticResource minutesToUsageTimeConverter}}" 
                   Style="{StaticResource DayTimeTextBlockStyle_}"/>
          <Grid Grid.Row="1" Width="123" Height="30" Margin="0,4,0,0" 
              HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                     Style="{StaticResource DayTimeTitleStyle_}" 
                     Text="DAYS"/>
            <TextBlock Grid.Column="1" 
                     Style="{StaticResource DayTimeTitleStyle_}" 
                     Text="HRS"/>
            <TextBlock Grid.Column="2" 
                     Style="{StaticResource DayTimeTitleStyle_}" 
                     Text="MIN"/>
          </Grid>
        </Grid>
      </Grid>
      <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="115"/>
          <RowDefinition Height="164"/>
          <RowDefinition Height="164"/>
          <RowDefinition Height="164"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="400"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,30,0,0" 
                  Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Grid Width="51" Height="34" Margin="0,0,20,0">
            <Grid.Background>
              <DrawingBrush Drawing="{StaticResource LanguageDrawingGroup_}" Stretch="Uniform"/>
            </Grid.Background>
          </Grid>
          <ComboBox Width="264" Height="40" Margin="0,0,50,0" 
                  Style="{StaticResource ComboBoxStyle_}" 
                  ItemsSource="{Binding UserManualLanguages}" 
                  DisplayMemberPath="Description" 
                  SelectedItem="{Binding SelectedUserManualLanguage}" 
                  IsSynchronizedWithCurrentItem="True">
          </ComboBox>
        </StackPanel>
        <Button Grid.Row="1" Grid.Column="0" 
              Visibility="{Binding IsUser, ConverterParameter=HIDDEN, Converter={StaticResource booleanToNotVisibilityConverter}}" 
              Command="{Binding ManageUsersCommand}" 
              Style="{StaticResource ManageUsersButtonStyle_}"/>
        <Button Grid.Row="1" Grid.Column="1" 
              Visibility="{Binding CanUseServiceTool, Converter={StaticResource booleanToVisibilityConverter}}" 
              IsEnabled="{Binding IsServiceToolsAvailable}" 
              Command="{Binding ServiceToolCommand}" 
              Style="{StaticResource ServiceToolButtonStyle_}"/>
        <Button Grid.Row="1" Grid.Column="2" 
              Visibility="{Binding CanUseCatheterTool, Converter={StaticResource booleanToVisibilityConverter}}" 
              IsEnabled="{Binding IsCatheterToolAvailable}" 
              Command="{Binding CatheterToolCommand}" 
              Style="{StaticResource CatheterButtonStyle_}"/>
        <Button Grid.Row="2" Grid.Column="0" 
              Visibility="{Binding IsUserAllowedTochangeDateTime, Converter={StaticResource booleanToVisibilityConverter}}" 
              Command="{Binding TimeAndDateCommand}" 
              Style="{StaticResource DateTimeButtonStyle_}"/>
        <Button Grid.Row="2" Grid.Column="1" 
              Visibility="{Binding IsCryterionUser, Converter={StaticResource booleanToVisibilityConverter}}" 
              Command="{Binding ViewErrorLogCommand}" 
              Style="{StaticResource ErrorLogButtonStyle_}"/>
        <Button Grid.Row="2" Grid.Column="2" 
              Visibility="{Binding CanUpdate,Converter={StaticResource booleanToVisibilityConverter}}" 
              IsEnabled="{Binding USBDriveConnected}"  
              Command="{Binding UpdateAppCommand}" 
              Style="{StaticResource UpdateButtonStyle_}"/>
        <Button Grid.Row="3" Grid.Column="0" 
              Visibility="{Binding IsCryterionUser, Converter={StaticResource booleanToVisibilityConverter}}" 
              Command="{Binding ActionLogCommand}" 
              Style="{StaticResource ActionLogButtonStyle_}"/>
        <Button Grid.Row="3" Grid.Column="1" 
              Visibility="{Binding IsBSCADMINUser,Converter={StaticResource booleanToVisibilityConverter}}" 
              Command="{Binding MaintenanceCommand}" 
              Style="{StaticResource MaintenanceButtonStyle_}"/>
      </Grid>
    </Grid>
    <Canvas>
      <StackPanel Style="{StaticResource HospitalLogoStackPanelOnHomeStyle_}">
        <TextBlock Text="Hospital:" 
                   Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
        <TextBlock Text="{Binding HospitalName}" 
                   Style="{StaticResource HospitalNameTextBlockStyle_}"/>
      </StackPanel>
      <Image Style="{StaticResource LogoImageOnHomeStyle_}"/>
    </Canvas>
  </Grid>
</UserControl>