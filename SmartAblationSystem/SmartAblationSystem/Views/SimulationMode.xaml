<Window x:Class="SmartAblationSystem.Views.SimulationMode"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:prism="http://prismlibrary.com/"
      xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
      prism:ViewModelLocator.AutoWireViewModel="True"
      mc:Ignorable="d" 
      Title="SimulationMode" Height="1080" Width="600"
      WindowStartupLocation="Manual"
      Top="13"
      Left="1377"
      ResizeMode="NoResize"
      SizeToContent="WidthAndHeight"
      WindowStyle="None"
      AllowsTransparency="True"
      Background="Transparent">

    <Window.Resources>
        <converters:BooleanToColorConverter x:Key="booleanToColorConverter" />
    </Window.Resources>

    <Border BorderThickness="0" CornerRadius="10,10,10,10" Background="{StaticResource CryterionBrushColorBlue}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Width="600" MouseDown="SimulationModeTitle_MouseDown">
                <Label Name="SimulationModeTitleLabel" Content="Simulation Mode" Width="600" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" HorizontalContentAlignment="Center" Foreground="White" Background="Transparent"/>
            </StackPanel>

            <Grid Grid.Row="1" Name="SimulationMenu">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="0.1*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">

                    <TabControl BorderThickness="1">
                        <!--ICB Tab-->
                        <TabItem Name="ICBTab" Header="ICB" FontWeight="Bold">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50*"/>
                                    <ColumnDefinition Width="50*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="20*"/>
                                    <RowDefinition Height="80*"/>
                                </Grid.RowDefinitions>
                                <!--ICB Image-->
                                <StackPanel Name="StackPanelICB" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                                    <TextBlock Text="Inter-Connection Box Simulation" TextAlignment="Center" FontSize="20" FontWeight="Bold" />
                                    <StackPanel Orientation="Horizontal">
                                        <Grid>
                                            <Canvas Width="400" Height="200">
                                                <!--ETS Connection-->
                                                <Ellipse Style="{StaticResource SimulatorICBETSConnection}" Fill="{Binding ICBETSConnection, ConverterParameter=SimulationICB, Converter={StaticResource booleanToColorConverter}}" Canvas.Left="27" Canvas.Top="82" />
                                                <!--DMS Connection-->
                                                <Ellipse Style="{StaticResource SimulatorICBDMSConnection}" Fill="{Binding ICBDMSConnection, ConverterParameter=SimulationICB, Converter={StaticResource booleanToColorConverter}}" Canvas.Left="94" Canvas.Top="82" />
                                                <!--Catheter Connection-->
                                                <Ellipse Style="{StaticResource SimulatorICBCatheterConnection}" Fill="{Binding ICBCatheterConnection, ConverterParameter=SimulationICB, Converter={StaticResource booleanToColorConverter}}" Canvas.Left="185" Canvas.Top="82" />
                                                <!--Pressure Sensor Connection-->
                                                <Ellipse Style="{StaticResource SimulatorICBPressureSensorConnection}" Fill="{Binding ICBPressureSensorConnection, ConverterParameter=SimulationICB, Converter={StaticResource booleanToColorConverter}}" Canvas.Left="276" Canvas.Top="82" />
                                                <!--Remote Control Connection-->
                                                <Ellipse Style="{StaticResource SimulatorICBRemoteControlConnection}" Fill="{Binding ICBRemoteControlConnection, ConverterParameter=SimulationICB, Converter={StaticResource booleanToColorConverter}}" Canvas.Left="344" Canvas.Top="82" />
                                            </Canvas>
                                            <Image x:Name="ICBImage" Source="/Images/SimulationICB.png" Height="200" Margin="20,0,20,0" Panel.ZIndex="-1"/>
                                        </Grid>
                                        <StackPanel Orientation="Vertical">
                                            <Button Style="{StaticResource ButtonCryterion}" Content="ETS" Width="80" Height="40" Margin="0,10,0,0" Command="{Binding ToggleETSCommand}"/>
                                            <Button Style="{StaticResource ButtonCryterion}" Content="DMS" Width="80" Height="40" Margin="0,10,0,0" Command="{Binding ToggleDMSCommand}"/>
                                            <Button Style="{StaticResource ButtonCryterion}" Content="Pressure Sensor" Width="120" Height="40" Margin="0,10,0,0" Command="{Binding TogglePressureSensorCommand}"/>
                                            <Button Style="{StaticResource ButtonCryterion}" Content="Remote Control" Width="120" Height="40" Margin="0,10,0,0" Command="{Binding ToggleRemoteControlCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                                <!--ICB Accessories-->
                                <TabControl Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                    <!--ETS Tab-->
                                    <TabItem Header="ETS" FontWeight="Bold">
                                        <StackPanel Name="StackPanelETS" Grid.Column="0">
                                            <TextBlock Text="ETS" TextAlignment="Center" FontSize="20" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <StackPanel Orientation="Vertical">
                                                    <Image Name="SingleETS" Source="/Images/SingleETS.png" Height="340" Panel.ZIndex="-1"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <Label Content="Temp: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                        <TextBox Name="SingleETSTemp" Text="{Binding SingleETSTemperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    </StackPanel>
                                                    <Button Style="{StaticResource ButtonCryterion}" Height="50" Content="Send" FontSize="20" Margin="0,50,0,0" Command="{Binding UpdateETSDataCommand}" CommandParameter="{Binding IsChecked, ElementName=ETSTypeToggleButton}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="25,0,25,0">
                                                    <Label Content="Toggle" HorizontalAlignment="Center"/>
                                                    <ToggleButton x:Name="ETSTypeToggleButton" Style="{StaticResource SimulatorAnimatedSwitch}" Height="30" Command="{Binding ToggleETSTypeCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                                </StackPanel>
                                                
                                                <StackPanel Orientation="Vertical">
                                                    <Image Name="SingleETSs" Source="/Images/Circa4.png" Height="340" Panel.ZIndex="-1"/>
                                                    <StackPanel Orientation="Horizontal">
                                                        <StackPanel Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content="T1: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor1Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content="T2: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor2Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content="T3: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor3Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content="T4: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor4Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content="T5: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor5Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Label Content="T6: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor6Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <Button Style="{StaticResource ButtonCryterion}" Height="50" Content="Copy Tip to All" FontSize="14" Command="{Binding CopyMultiETSTipToAllCommand}" CommandParameter="{Binding IsChecked, ElementName=ETSTypeToggleButton}"/>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Vertical">
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content=" T7: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor7Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content=" T8: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor8Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content=" T9: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor9Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="14,0,0,0"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content=" T10: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor10Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content=" T11: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor11Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                                                <Label Content=" T12: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor12Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <Label Content=" Tip: " HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="Black" FontSize="25" FontWeight="Bold"/>
                                                                <TextBox Text="{Binding MultiETSSensor13Temperature, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="6,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </StackPanel>
                                                    
                                                    
                                                </StackPanel>
                                                
                                            </StackPanel>
                                            
                                        </StackPanel>
                                    </TabItem>
                                    <!--DMS Tab-->
                                    <TabItem Header="DMS" FontWeight="Bold" Height="20" VerticalAlignment="Top">
                                        <StackPanel Name="StackPanelDMS" Grid.Column="1">
                                            <TextBlock Text="DMS" TextAlignment="Center" FontSize="20" FontWeight="Bold" />
                                            <StackPanel Orientation="Vertical" Margin="0,10,0,0">
                                                <Button Style="{StaticResource ButtonCryterion}" Content="Pacing - 800" Width="100" Height="40" Margin="0,0,0,20" Command="{Binding SimulateSlowDMSCommand}"></Button>
                                                <Button Style="{StaticResource ButtonCryterion}" Content="Pacing - 1000" Width="100" Height="40" Margin="0,0,0,20" Command="{Binding SimulateMediumDMSCommand}"></Button>
                                                <Button Style="{StaticResource ButtonCryterion}" Content="Pacing - 1200" Width="100" Height="40" Margin="0,0,0,20" Command="{Binding SimulateHighDMSCommand}"></Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <!--Pressure Sensor Tab-->
                                    <TabItem Header="Pressure Sensor" FontWeight="Bold">
                                        <StackPanel Name="StackPanelPressureSensor" Grid.Column="0">
                                            <TextBlock Text="Pressure Sensor" TextAlignment="Center" FontSize="20" FontWeight="Bold" />
                                            <StackPanel Orientation="Horizontal">
                                                <StackPanel Name="StackPanelBloodPressure" Orientation="Horizontal" HorizontalAlignment="Center" Margin="50,0,0,0">
                                                    <Button Name="BtnDecreaseBloodPressure" FontSize="18" Height="40" Width="40" Style="{StaticResource ButtonCryterion}" Content="-" Command="{Binding DecreaseBloodPressureCommand}" Margin="0,0,0,0"/>
                                                    <TextBox Text="{Binding SinglePressureSensorValue, Mode=TwoWay}" MaxLength="2" Foreground="Black" FontSize="25" FontWeight="Bold" Width="60" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                                                    <Button Name="BtnIncreaseBloodPressure" FontSize="18" Height="40" Width="40" Style="{StaticResource ButtonCryterion}" Content="+" Command="{Binding IncreaseBloodPressureCommand}" Margin="0,0,0,0"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="50,0,0,0">
                                                    <Label Content="Single Value / Multi Value" HorizontalAlignment="Center"/>
                                                    <ToggleButton Style="{StaticResource SimulatorAnimatedSwitch}" Height="30" Command="{Binding ToggleETSTypeCommand}" CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Vertical" Margin="50,10,0,0">
                                                    <Button Style="{StaticResource ButtonCryterion}" Content="Square Wave" Width="100" Height="40" Margin="0,0,0,20"></Button>
                                                    <Button Style="{StaticResource ButtonCryterion}" Content="Triangle Wave" Width="100" Height="40" Margin="0,0,0,20"></Button>
                                                    <Button Style="{StaticResource ButtonCryterion}" Content="Sine Wave" Width="100" Height="40" Margin="0,0,0,20"></Button>
                                                    <Button Style="{StaticResource ButtonCryterion}" Content="Heartbeat" Width="100" Height="40" Margin="0,0,0,20"></Button>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <!--Remote Control Tab-->
                                    <TabItem Header="Remote Control" FontWeight="Bold">
                                        <StackPanel Name="StackPanelRemoteControl" Grid.Column="1">
                                            <TextBlock Text="Remote Control" TextAlignment="Center" FontSize="20" FontWeight="Bold" />
                                            <Grid>
                                                <Canvas Width="500" Height="360">
                                                    <!--Remote LED-->
                                                    <Ellipse Width="8" Height="7" Fill="Black" Canvas.Left="247" Canvas.Top="21"></Ellipse>
                                                    <!--Start-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlStartStopButton}" Command="{Binding RemoteControlStartCommand}" Canvas.Top="44"></Button>
                                                    <!--Stop-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlStartStopButton}" Command="{Binding RemoteControlStopCommand}" Canvas.Top="97"></Button>
                                                    <!--Ablation Site Left-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlBlueButton}" Command="{Binding RemoteControlAblationSiteLeftCommand}" Canvas.Left="212" Canvas.Top="153" ></Button>
                                                    <!--Ablation Site Right-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlBlueButton}" Command="{Binding RemoteControlAblationSiteRightCommand}" Canvas.Left="261" Canvas.Top="153" ></Button>
                                                    <!--Increase Ablation Duration-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlBlueButton}" Command="{Binding RemoteControlTimeIncreaseCommand}" Canvas.Left="215" Canvas.Top="192" ></Button>
                                                    <!--Decrease Ablation Duration-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlBlueButton}" Command="{Binding RemoteControlTimeDecreaseCommand}" Canvas.Left="215" Canvas.Top="241" ></Button>
                                                    <!--Increase Balloon Pressure-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlBlueButton}" Command="{Binding RemoteControlPressureIncreaseCommand}" Canvas.Left="257" Canvas.Top="192" ></Button>
                                                    <!--Decrease Balloon Pressure-->
                                                    <Button Style="{StaticResource SimulatorRemoteControlBlueButton}" Command="{Binding RemoteControlPressureDecreaseCommand}" Canvas.Left="257" Canvas.Top="241" ></Button>
                                                </Canvas>
                                                <Image Name="RemoteControlImage" Source="/Images/SimulationRemote.png" Height="360" Panel.ZIndex="-1"/>
                                            </Grid>
                                        </StackPanel>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                        <TabItem Header="Other" FontWeight="Bold">
                            <StackPanel Grid.Row="2" Orientation="Vertical">
                                <TextBlock Name="Tabs" Text="Tabs" Margin="0,0,0,0" FontSize="20" FontWeight="Bold" />
                                <Button Name="PlusSimulator" FontSize="18" Height="40" Width="40" Style="{StaticResource ButtonCryterion}"
                                    Content="P+" Command="{Binding ProxIncreaseCommand}" Margin="20,0,0,0"/>

                                <Button Name="MoinsSimulator" FontSize="18" Height="40" Width="40" Style="{StaticResource ButtonCryterion}"
                                    Content="P-" Command="{Binding ProxDecreaseCommand}" Margin="20,0,0,0"/>

                                <Button Name="BtnStateSimulator" FontSize="18" Height="40" Width="140" Style="{StaticResource ButtonCryterion}"
                                    Content="Change State" Command="{Binding IncrementSystemStateCommand}" Margin="20,0,0,0"/>

                                <StackPanel Name="StackPanelBalloonTemperature" Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Name="BtnTemperatureDecreaseSimulator" FontSize="24" Height="40" Width="40" Style="{StaticResource ButtonCryterion}"
                                        Content="-" Command="{Binding DecrementTemperatureCommand}" Margin="0,0,0,0"/>

                                    <Label Content="Balloon Temperature" FontWeight="Bold" Foreground="Black" FontSize="24"/>

                                    <Button Name="BtnTemperatureIncreaseSimulator" FontSize="24" Height="40" Width="40" Style="{StaticResource ButtonCryterion}"
                                    Content="+" Command="{Binding IncrementTemperatureCommand}" Margin="0,0,0,0"/>
                                </StackPanel>

                                <Button Name="BtnUnknownState" FontSize="18" Height="40" Width="80" Style="{StaticResource ButtonCryterion}"
                                    Content="Unk St" Command="{Binding SetUnknownSystemStateCommand}" Margin="20,0,0,0"/>

                                <Button Name="BtnExceptionState" FontSize="18" Height="40" Width="80" Style="{StaticResource ButtonCryterion}"
                                    Content="Ex. St" Command="{Binding SetExceptionSystemStateCommand}" Margin="20,0,0,0"/>

                                <Button Name="BtnError" FontSize="18" Height="40" Width="40" Style="{StaticResource ButtonCryterion}"
                                    Content="Err" Command="{Binding ErrorCommand}" Margin="20,0,0,0"/>

                                
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
                <Button Style="{StaticResource RoundCorner}" Content="Close" Grid.Row="1" x:Name="CancelButton" HorizontalAlignment="Center" VerticalAlignment="Center" Click="No_Click" IsCancel="True" />
            </Grid>
        </Grid>
    </Border>
</Window>