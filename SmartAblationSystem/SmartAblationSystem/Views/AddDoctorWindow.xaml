<Window x:Class="SmartAblationSystem.Views.AddDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:helpers="clr-namespace:SmartAblationSystem.Helpers"
        mc:Ignorable="d"
        Title="AddDoctor"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Loaded="OnAddDoctorWindowLoaded">
  <Grid>
    <Border CornerRadius="12" Width="860" Height="486" Opacity="1"
            BorderBrush="Transparent"
            BorderThickness="0"
            Background="{StaticResource PanelBackgroundBrush_}">
      <Border.Effect>
        <DropShadowEffect Color="Black"
                ShadowDepth="11"
                BlurRadius="20"
                RenderingBias="Performance"
                Opacity="0.5"
                Direction="-50"/>
      </Border.Effect>
    </Border>
    <Border CornerRadius="12" Width="860" Height="486" Opacity="1"
            BorderBrush="Transparent"
            BorderThickness="0"
            Background="{StaticResource PanelBackgroundBrush_}">
      <Grid ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="78"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0" CornerRadius="12,12,0,0" 
              Background="{StaticResource TitleBackgroundBrush_}">
        <Grid ShowGridLines="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.32*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0" HorizontalAlignment="Right" 
                Margin="0,4,7.8,0" Height="38" Width="38">
            <Grid.Background>
              <DrawingBrush Drawing="{StaticResource DoctorIconDrawingGroup_}" 
                            Stretch="Uniform"/>
            </Grid.Background>
          </Grid>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" 
                     Margin="6,3,0,0" 
                     Text="NEW DOCTOR" 
                     Style="{StaticResource DialogTitleTextBlockStyle_}"/>
        </Grid>
      </Border>
      <Border Grid.Row="1" 
              CornerRadius="0,0,12,12" 
              BorderBrush="Transparent" 
              BorderThickness="0" 
              Background="{StaticResource BorderBackgroundBrush_}">
        <Grid Margin="0,32,0,10">
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Width="340" HorizontalAlignment="Left" Margin="75,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" 
                       Text="* User Name:" 
                       Margin="-8,-8,0,8" 
                       Style="{StaticResource SubTitleTextStyle_}"/>
            <TextBox Grid.Row="1" 
                     x:Name="TxtUserNameNew" 
                     Margin="0,0,0,15" 
                     Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     MaxLength="32" 
                     Foreground="{StaticResource ValueTextForeground_}" 
                     Style="{StaticResource TextBoxErrorStyle_}"/>
          </Grid>
          <Grid Grid.Row="1" HorizontalAlignment="Left" Margin="75,0,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Margin="-5,0,0,8" 
                       Text="* Dr. First Name:" 
                       Style="{StaticResource SubTitleTextStyle_}"/>
            <TextBox Grid.Row="1" Grid.Column="0" 
                     Margin="5,0,0,0" 
                     x:Name="DrFirstNameTxtBox" 
                     Text="{Binding DrFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     MaxLength="25" 
                     Style="{StaticResource TextBoxErrorStyle_}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" 
                       Margin="40,0,0,8" 
                       Text="* Dr. Last Name:" 
                       Style="{StaticResource SubTitleTextStyle_}"/>
            <TextBox Grid.Row="1" Grid.Column="1" 
                     Margin="50,0,0,0" 
                     x:Name="DrLastNameTxtBox" 
                     MaxLength="25" 
                     Text="{Binding DrLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                     Style="{StaticResource TextBoxErrorStyle_}"/>
          </Grid>
          <Grid Grid.Row="2" HorizontalAlignment="Left" Margin="75,16,0,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="30"/>
              <RowDefinition/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" 
                       Text="* New Password:" 
                       Margin="-5,4,0,10" 
                       Style="{StaticResource SubTitleTextStyle_}"/>
            <PasswordBox Grid.Row="1" Grid.Column="0" 
                         Width="330" Margin="5,0,0,0" 
                         x:Name="NewPasswordBox" 
                         MaxLength="16" 
                         helpers:BoundPasswordBox.BoundPassword="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         PasswordChanged="NewPasswordChanged" 
                         Style="{StaticResource PasswordBoxStyle_}"/>
            <TextBlock Grid.Row="0" Grid.Column="1" 
                       Text="* Confirm Password:" 
                       Margin="40,4,0,10" 
                       Style="{StaticResource SubTitleTextStyle_}"/>
            <PasswordBox Grid.Row="1" Grid.Column="1" 
                         Width="330" Margin="50,0,0,0"  
                         x:Name="ConfirmPasswordBox" 
                         helpers:BoundPasswordBox.BoundPassword="{Binding Path=ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="16"
                         Style="{StaticResource PasswordBoxStyle_}" 
                         PasswordChanged="ConfirmPasswordChanged"/>
          </Grid>
          <Grid Grid.Row="3" Margin="0,0,20,15" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" 
                    Content="Cancel" 
                    Style="{StaticResource TextWithUnderlineButton_}" 
                    Click="No_Click" 
                    IsCancel="True"/>
            <Button Grid.Column="1" 
                    Content="ADD DOCTOR" 
                    Foreground="White" 
                    Width="160" 
                    IsEnabled="{Binding IsAddDoctorInformValid}" 
                    Style="{StaticResource ConfirmButtonStyle_}" 
                    Click="Ok_Click"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
  </Grid>
</Window>
