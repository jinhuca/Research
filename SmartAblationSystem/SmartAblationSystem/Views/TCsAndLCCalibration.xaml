<UserControl x:Class="SmartAblationSystem.Views.TCsAndLCCalibration"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Unloaded="UserControl_Unloaded"
             Loaded="UserControl_Loaded"
             mc:Ignorable="d"
             d:DesignHeight="1030" d:DesignWidth="1920">

  <UserControl.Resources>
    <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
    <converters:StringToIntConverter x:Key="stringToIntConverter" />
    <converters:BooleanToIntConverter x:Key="booleanToIntConverter" />
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    <converters:GasSateToColor x:Key="gasSateToColor" />
    <converters:WeightToLevelConverter x:Key="weightToLevelConverter" />
    <converters:ScaleUnitToTextConverter x:Key="scaleUnitToTextConverter" />

  </UserControl.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Width="900" VerticalAlignment="Top" HorizontalAlignment="Center">
      <Grid.RowDefinitions>
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
        <RowDefinition Height="auto" />
      </Grid.RowDefinitions>

      <Border BorderThickness="2" Grid.Row="0" CornerRadius="6" Height="100" VerticalAlignment="Top" HorizontalAlignment="Center" Width="900" Margin="0,5,0,5">
        <Border.BorderBrush>
          <SolidColorBrush Color="White" Opacity="0.5" />
        </Border.BorderBrush>
        <StackPanel VerticalAlignment="Center">
          <Label Content="Load Cell Calibration" FontSize="52" FontWeight="Bold" Foreground="{StaticResource CryterionBrushColorBlue}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

        </StackPanel>
      </Border>
      <Border BorderThickness="2" Grid.Row="1" CornerRadius="6" Height="100" VerticalAlignment="Top" HorizontalAlignment="Center" Width="900" Margin="0,5,0,5">
        <Border.BorderBrush>
          <SolidColorBrush Color="White" Opacity="0.5" />
        </Border.BorderBrush>
        <StackPanel Orientation="Horizontal"  >
          <TextBlock Foreground="White" FontSize="32" FontWeight="Bold" Text="Load Cell Calibration Factor"  VerticalAlignment="Center" Margin="10,26,5,26" Width="416"/>
          <!--<ToggleButton Style="{StaticResource AnimatedSwitch}" Height="50" Command="{Binding CalibrationFactorCommand}" Margin="10"
                                          IsChecked="{Binding DeactivateFeatuers, Mode=OneWay}" />-->
          <TextBox Width="191" FontSize="22"  Margin="0,30,10,30" x:Name="txtCalibrationFactorValue" Text ="{Binding CalibrationFactorValue, Mode=TwoWay}" LostFocus="FieldValidation" GotFocus="ResetValue"/>
          <Button x:Name="Factorbutton" FontWeight="Bold"  Style="{StaticResource ButtonCryterion}" FontSize="18" Content="Save" Margin="0,26,0,24" Width="90" Command="{Binding CalibrationFactorCommand}"/>
          <Label x:Name="lblMessage" Content="" Width="169" Margin="3,30,0,24" FontSize="20" Foreground="Red"/>
        </StackPanel>
      </Border>
      <Border BorderThickness="2" Grid.Row="2" CornerRadius="6"  Height="710" VerticalAlignment="Top" HorizontalAlignment="Center" Width="900" Margin="0,5,0,5">
        <Border.BorderBrush>
          <SolidColorBrush Color="White"  Opacity="0.5" />
        </Border.BorderBrush>
        <StackPanel Width="900" Height="780" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Column="1">
            <StackPanel Orientation="Vertical" Grid.Column="1">
              <Label Content="Make sure that there is no weight on the load cell." FontSize="32" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,30,0,0" />
              <Label Content="If you are ready to start calibration please press the checkbox" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,0" />
            </StackPanel>
            <Viewbox Height="50" Width="50" Margin="50,40,0,0">
              <CheckBox Style="{StaticResource CheckBoxFocusVisual}" IsChecked="{Binding IsLoadCellEnabled, Mode=TwoWay}" x:Name="LoadCellCheckBox" />
            </Viewbox>
          </StackPanel>

          <!-- Gas State Image -->
          <Grid Margin="0,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"  />
              <!-- <RowDefinition Height="*" /> -->
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="25" />
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="270" />
              <ColumnDefinition Width="350" />
            </Grid.ColumnDefinitions>

            <Grid Margin="30,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Grid.Column="1" >
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>

              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Orientation="Vertical" HorizontalAlignment="Right" Grid.Column="0" Grid.Row="0">
                <Label Content="F" FontSize="20" Foreground="White" Margin="0,5,3,0" VerticalAlignment="Top" HorizontalAlignment="Right" />
                <Label Content="E" FontSize="20" Foreground="White" Margin="0,46,3,0" VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
              </StackPanel>

              <Grid Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <!-- gas gauge-->
                  <Rectangle Fill="{Binding GasState, Converter={StaticResource gasSateToColor},  Mode=TwoWay}" 
                                           Height="{Binding LC1Reading, Converter={StaticResource weightToLevelConverter},  Mode=TwoWay}"  
                                           Width="19" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" />
                  <!-- bottom of the rectangle-->
                  <Ellipse 
                                           Margin="0,90,0,0"
                                           Width="20"
                                           Height="20"
                                           Canvas.Left="20"
                                           Canvas.Top="0"
                                           Stretch="Fill"
                                           Fill="{Binding GasState, Converter={StaticResource gasSateToColor}, Mode=TwoWay}">
                    <Ellipse.Clip>
                      <RectangleGeometry Rect="1,9.8,18,9"/>
                    </Ellipse.Clip>
                  </Ellipse>
                  <!-- white border-->
                  <Rectangle Height="100" Width="25" RadiusX="14" RadiusY="14" HorizontalAlignment="Right"  VerticalAlignment="Bottom" Stroke="White" StrokeThickness="3"/>

                </Grid>
              </Grid>

              <Label Grid.Column="0" Grid.Row="1" 
                                   Content="{Binding LC1Reading, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=LC1Reading, Mode=TwoWay}"
                                   FontSize="24" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,-6,5,0" />
              <Label Grid.Column="1" Grid.Row="1" Content="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}}" FontSize="18" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Grid>


            <Button Name="LoadCellToggleButton" Style="{StaticResource ButtonCryterion}" Foreground="White"
                            Content="Tare" VerticalAlignment="Center" Grid.Column="2" Grid.Row="0" 
                            Command="{Binding StartLoadCellCalibrationCommand}"
                            IsEnabled="{Binding IsLoadCellEnabled, Mode=OneWay}"
                            FontSize="18" Height="50" Width="150" Margin="0,0,0,0" />

            <Border Grid.Column="3" Grid.Row="0" BorderThickness="2" BorderBrush="CornflowerBlue" CornerRadius="8">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition Height="10"/>
                  <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="10"/>
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Calibration Factor:" FontSize="24" Height="30" Foreground="White" Margin="10,5, 0, 0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding LoadCellCalibrationFactor}" Background="DarkGray"
                           FontSize="24" Height="30" Foreground="White" Margin="0,5, 10, 0"/>

                <!-- <TextBlock Grid.Row="1" Grid.Column="0" Text="Calib. Offset : " FontSize="24" Height="30" Foreground="White" Margin="10,5, 0, 0"/> -->
                <!-- <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding LoadCellCalibrationOffset}" FontSize="24" Height="30" Foreground="White" Margin="10,5, 0, 0"/> -->

                <Button Name="ReadCalibrationParamBtn" Content="Read Back" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" 
                        Command="{Binding ReadBackCalibrationFactorCommand}" Style="{StaticResource ButtonCryterion}" Foreground="White"
                        FontSize="18" Height="50" Width="150" Margin="0,10,0,0"/>
              </Grid>
            </Border>
          </Grid>

          <Grid Margin="10,00,10,0" Opacity="{Binding IsTareCompleted, Converter={StaticResource booleanToIntConverter}, ConverterParameter=TANK_OPACITY , Mode=OneWay}">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="310" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="110*" />
              <ColumnDefinition Width="41*" />
              <ColumnDefinition Width="69*"/>
            </Grid.ColumnDefinitions>

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                               Content="Select a tank:" FontSize="32" FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Left" Margin="334,20,0,310" Grid.RowSpan="2" />

            <Button Grid.Column="0" Grid.Row="1" x:Name="BtnTank15Pounds" Background="Transparent"
                                    Width="250" Height="250" VerticalAlignment="Top"
                                    Command="{Binding Tank15PoundsSelectedCommand}"
                                    Style="{StaticResource CircularButtonStyle }" Margin="95,60,95,0" >

              <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Grid>
                    <Ellipse Fill="Transparent" Stroke="{StaticResource CryterionBrushColorBlue}" StrokeThickness="{Binding Is15PoundsTankSelected, Converter={StaticResource booleanToIntConverter}, ConverterParameter=TANK_BORDER_THICKNESS, Mode=OneWay}"  />
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </ControlTemplate>
              </Button.Template>

              <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0">
                <Image Source="/Images/N2OTank.png" Height="200" />
                <Label Content="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}, ConverterParameter=FifteenPounds}" VerticalAlignment="Center" Foreground="White" FontSize="24" Margin="10,0,0,0" />
              </StackPanel>
            </Button>

            <Button Grid.Column="1" Grid.Row="1" x:Name="BtnTank10Pounds" Background="Transparent"
                                Width="200" Height="200" VerticalAlignment="Bottom"
                                Command="{Binding Tank10PoundsSelectedCommand}"
                                Style="{StaticResource CircularButtonStyle }" Grid.ColumnSpan="2" Margin="120,0,120,0">

              <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                  <Grid>
                    <Ellipse Fill="Transparent" Stroke="{StaticResource CryterionBrushColorBlue}" StrokeThickness="{Binding Is10PoundsTankSelected, Converter={StaticResource booleanToIntConverter}, ConverterParameter=TANK_BORDER_THICKNESS, Mode=OneWay}" />
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Grid>
                </ControlTemplate>
              </Button.Template>

              <StackPanel Orientation="Vertical" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,0">
                <Image Source="/Images/N2OTank.png" Height="130" />
                <Label Content="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}, ConverterParameter=TenPounds}" VerticalAlignment="Center" Foreground="White" FontSize="24" />
              </StackPanel>
            </Button>

          </Grid>

          <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Visibility="{Binding CalibrationSucceeded, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}" HorizontalAlignment="Center">
            <Image Source="/Images/oksign.png" Width="75" Height="75" />
            <Label Content="Calibration succeeded!" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="32" Margin="0,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
