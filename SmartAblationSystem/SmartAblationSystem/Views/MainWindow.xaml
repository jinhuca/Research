<Window x:Class="SmartAblationSystem.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
        xmlns:local="clr-namespace:SmartAblationSystem.Views"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:uc="clr-namespace:CustomControls.UserControls;assembly=CustomControls"
        xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
        xmlns:convertersNew="clr-namespace:SmartAblationSystem.ConvertersNew"
        mc:Ignorable="d"
        Height="1080" Width="1920" WindowStartupLocation="CenterScreen" WindowStyle="None" WindowState="Maximized"
        x:Name="MainWindowName"
        Loaded="MainWindowNewLook_OnLoaded">
  <Window.Resources>
    <convertersNew:MultipleBoolToVisibilityConverter x:Key="MultipleBoolToVisibilityConverter_"/>
    <convertersNew:ScreenVisibilityConverter x:Key="ScreenVisibilityConverter"/>
    <converters:VolumeToPicture x:Key="volumeToPicture" />
    <converters:StateToEnableConverter x:Key="stateToEnable" />
    <converters:StateToVisibilityConverter x:Key="stateToVisibility" />
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    <converters:NotBooleanConverter x:Key="notBooleanConverter" />
    <converters:FieldToTextConverter x:Key="fieldToTextConverter" />
    <converters:BooleanToOpacityConverter x:Key="booleanToOpacityConverter" />
    <converters:StateAndBooleanToEnableConverter x:Key="stateAndBooleanToEnableConverter" />
    <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter" />
    <converters:BooleanAndStateToVisibilityConverter x:Key="booleanAndStateToVisibilityConverter" />
    <converters:CryoTherapyViewConverter x:Key="viewConverter"/>
  </Window.Resources>
  <Border Background="{StaticResource HomeBackground}"
          PreviewTouchDown="PreviewTouchDownOnMainGrid">
    <Grid Background="{StaticResource HomeBackgroundLight}">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="76"/>
      </Grid.RowDefinitions>
      <ContentControl Grid.Row="0" Grid.RowSpan="2" 
			                Content="{Binding CurrentView}" 
			                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
      <Grid Grid.Row="1"
			      Background="{Binding ScreenName, Converter={StaticResource ScreenVisibilityConverter}, ConverterParameter=MainWindow}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="24"/>
          <ColumnDefinition Width="85"/>
          <ColumnDefinition Width="85"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Button Grid.Column="1"
				        Style="{StaticResource BarHomeButtonStyle_}"
				        Command="{Binding HomeCommand}"
				        Visibility="{Binding SystemState, ConverterParameter=HOME, Converter={StaticResource stateToVisibility}}"
				        Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}"/>

        <Button Grid.Column="2" 
                Style="{StaticResource BarInstructionButtonStyle_}"
                Command="{Binding UserManualCommand}"
                IsEnabled="{Binding SystemState, ConverterParameter=UserManual, Converter={StaticResource stateToEnable}}">
          <Button.Visibility>
            <MultiBinding Converter="{StaticResource booleanAndStateToVisibilityConverter}" ConverterParameter="UserManual">
              <Binding Path="IsUserManualLoading" />
              <Binding Path="SystemState" />
            </MultiBinding>
          </Button.Visibility>
        </Button>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="17,0,0,5">
          <Button x:Name="VolumeControl" 
                  Style="{StaticResource VolumeDownButtonStyle_}"
                  Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}"
                  IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"
                  Click="SetVolumeControlsVisibility"/>
          <Button x:Name="VolumeDown"
                  Visibility="Collapsed"
                  Style="{StaticResource VolumeDownButtonStyle_}"
                  Command="{Binding DecreaseVolumeCommand}"
                  Click="ResetVolumeControlTimer"/>
          <uc:VolumeBarCtrl x:Name="VolumeLevelCtrl" 
                            MinValue="0" MaxValue="100" 
                            Value="{Binding RequiredVolume}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="20,0,20,0"/>
          <Button x:Name="VolumeUp" 
                  Style="{StaticResource VolumeUpButtonStyle_}"
                  Command="{Binding IncreaseVolumeCommand}"
                  Click="ResetVolumeControlTimer"
                  IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}">
          </Button>
        </StackPanel>

        <Button Grid.Column="3" Width="55" Height="55" HorizontalAlignment="Left" Margin="105,0,0,5"
                x:Name="WarningButton"
                Style="{StaticResource WarningButtonStyle_}"
                Command="{Binding Path=DataContext.WarningMessagesCommand, RelativeSource={RelativeSource Self}}"
                Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}"
                IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}">
          <Button.Visibility>
            <MultiBinding Converter="{StaticResource MultipleBoolToVisibilityConverter_}">
              <Binding Path="IsWarningVisible"/>
              <Binding Path="IsVolumeChangeInvisible"/>
            </MultiBinding>
          </Button.Visibility>
        </Button>

        <Grid Grid.Column="4"
              HorizontalAlignment="Right"
              Margin="0,4,40,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="135.5"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                      Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left"
                      Background="Transparent">
            <StackPanel.Visibility>
              <MultiBinding Converter="{StaticResource viewConverter}">
                <Binding Path="SystemState"/>
                <Binding Path="ScreenName"/>
              </MultiBinding>
            </StackPanel.Visibility>
            <Button Style="{StaticResource ViewSwitchButtonStyle_}"/>
            <TextBlock Text="{Binding TherapyViewName}"
                       Style="{StaticResource ViewSwitchTextBlockStyle_}"/>
            <i:Interaction.Triggers>
              <i:EventTrigger EventName="PreviewMouseDown">
                <i:InvokeCommandAction Command="{Binding ViewChangeCommand}"/>
              </i:EventTrigger>
            </i:Interaction.Triggers>
          </StackPanel>
          <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2"
                  Background="#ff484852"
                  Width="1"
                  Height="30"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
          <TextBlock Grid.Row="0" Grid.Column="2" 
                     Text="{Binding ScreenName}" 
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,0,5"
                     Style="{StaticResource VersionTextBlockStyle_}"/>
          <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                      VerticalAlignment="Top" HorizontalAlignment="Right" 
                      Margin="0,0,0,0">
            <TextBlock Text="Version "
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource VersionTextBlockStyle_}"/>
            <TextBlock Text="{Binding SoftwareVersion}" 
                       HorizontalAlignment="Right" VerticalAlignment="Center"
                       Style="{StaticResource VersionTextBlockStyle_}"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>