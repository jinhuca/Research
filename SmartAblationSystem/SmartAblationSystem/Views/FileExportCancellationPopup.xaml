<Window x:Class="SmartAblationSystem.Views.FileExportCancellationPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
				xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
        xmlns:local="clr-namespace:SmartAblationSystem.Views"
        mc:Ignorable="d"
        Title="FileExportCancellationPopup" Height="362" Width="549"
        WindowStartupLocation="CenterScreen"
				Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">
  <Window.Resources>
    <Color x:Key="TitleBackgroundColor_">#ff4c608d</Color>
    <SolidColorBrush x:Key="TitleBackgroundBrush_" Color="{StaticResource TitleBackgroundColor_}"/>

    <Color x:Key="TextBlockNormalColor_">#FFCEC3C6</Color>
    <SolidColorBrush x:Key="TextBlockNormalBrush_" Color="{StaticResource TextBlockNormalColor_}"/>

    <Color x:Key="TextBlockHighlightColor_"></Color>
    <SolidColorBrush x:Key="TextBlockHighlightBrush_" Color="{StaticResource TextBlockHighlightColor_}"/>

    <Color x:Key="PanelBackgroundColor_">#ff2b2b32</Color>
    <SolidColorBrush x:Key="PanelBackgroundBrush_" Color="{StaticResource PanelBackgroundColor_}"/>

    <SolidColorBrush x:Key="SeparatorBrush_" Color="#ff484852"/>

    <Style x:Key="InfoTextBlockStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="Foreground" Value="{StaticResource TextBlockNormalBrush_}"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <Style x:Key="SaveToUsbTitleTextBlockStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Foreground" Value="{StaticResource TextBlockNormalBrush_}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <converters:MultipleBoolToVisibleConverter x:Key="MultipleBoolVisibleConverter"/>
    <converters:ExportStateMessageConverter x:Key="StateMessageConverter"/>
    <converters:ExportStateConverter x:Key="StateConverter"/>
    <converters:StringToVisibilityConverter x:Key="errorVisibilityConverter"/>
    <converters:BooleanToVisibilityConverter x:Key="bvConverter"/>
  </Window.Resources>

  <Border CornerRadius="12" 
          Background="{StaticResource PanelBackgroundBrush_}">
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Height="362" Width="549">
      <Grid.RowDefinitions>
        <RowDefinition Height="78"/>
        <RowDefinition Height="164"/>
        <RowDefinition Height="120"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0"
                CornerRadius="12,12,0,0"
                Background="{StaticResource TitleBackgroundBrush_}">
        <TextBlock Text="EXPORT PROCEDURES TO USB DRIVE"
                     Style="{StaticResource SaveToUsbTitleTextBlockStyle_}"/>
      </Border>
      <Grid Grid.Row="1">
        <!-- Exporting Engineering Logs -->
        <Grid Grid.Row="0" 
              VerticalAlignment="Center" 
              Visibility="{Binding SaveLogSelected, Converter={StaticResource bvConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="74"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Margin="0,20,0,0" 
                     VerticalAlignment="Center" HorizontalAlignment="Center" 
                     Text="{Binding LogExportMessage}" 
                     Style="{StaticResource InfoTextBlockStyle_}"/>
          <ProgressBar Grid.Row="1" Height="33" Width="400" 
                       Style="{StaticResource HorizontalProgressBar_}" 
                       Minimum="0" Maximum="5" Value="{Binding LogProgressBarValue}" 
                       Visibility="{Binding Path=IsExporting, Converter={StaticResource StateConverter}}"/>
        </Grid>

        <!-- Exporting Procedures -->
        <Grid Grid.Row="0" 
              VerticalAlignment="Center"  
              Visibility="{Binding SaveLogSelected, Mode=TwoWay, Converter={StaticResource bvConverter}, ConverterParameter=ProcedureExporting}">
          <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="74"/>
          </Grid.RowDefinitions>
          <!-- (1) Exporting selected procedures -->
          <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,20,0,0">
            <StackPanel.Visibility>
              <MultiBinding Converter="{StaticResource MultipleBoolVisibleConverter}" ConverterParameter="StartingSelectedProceduresExport">
                <Binding Path="IsExporting"/>
                <Binding Path="IsCanceled"/>
                <Binding Path="IsExportingCurrentProcedure"/>
              </MultiBinding>
            </StackPanel.Visibility>
            <TextBlock Text="Exporting Procedure ... " Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text="{Binding ProgressBarValue}" Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text=" of " Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text="{Binding ProcedureRecordsCount}" Style="{StaticResource InfoTextBlockStyle_}"/>
          </StackPanel>
          <!-- (2) Canceling selected procedures -->
          <TextBlock Grid.Row="0" 
                     Margin="0,16,0,0" 
                     Text="Canceling"  
                     HorizontalAlignment="Center" VerticalAlignment="Center"
                     Style="{StaticResource InfoTextBlockStyle_}">
            <TextBlock.Visibility>
              <MultiBinding Converter="{StaticResource MultipleBoolVisibleConverter}" ConverterParameter="CancelingSelectedProceduresExport">
                <Binding Path="IsExporting"/>
                <Binding Path="IsCanceled"/>
                <Binding Path="IsExportingCurrentProcedure"/>
              </MultiBinding>
            </TextBlock.Visibility>
          </TextBlock>
          <!-- (3) Canceled selected procedures -->
          <TextBlock Grid.Row="0" 
                     Margin="0,16,0,0" 
                     Text="Canceled" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" 
                     Style="{StaticResource InfoTextBlockStyle_}">
            <TextBlock.Visibility>
              <MultiBinding Converter="{StaticResource MultipleBoolVisibleConverter}" ConverterParameter="CanceledSelectedProceduresExport">
                <Binding Path="IsExporting"/>
                <Binding Path="IsCanceled"/>
                <Binding Path="IsExportingCurrentProcedure"/>
              </MultiBinding>
            </TextBlock.Visibility>
          </TextBlock>
          <!-- (4) Exported selected procedures -->
          <StackPanel Grid.Row="0" 
                      Orientation="Horizontal" 
                      VerticalAlignment="Center" 
                      HorizontalAlignment="Center" 
                      Margin="0,20,0,0">
            <StackPanel.Visibility>
              <MultiBinding Converter="{StaticResource MultipleBoolVisibleConverter}" ConverterParameter="FinishedSelectedProceduresExport">
                <Binding Path="IsExporting"/>
                <Binding Path="IsCanceled"/>
                <Binding Path="IsExportingCurrentProcedure"/>
              </MultiBinding>
            </StackPanel.Visibility>
            <TextBlock Text="Selected " Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text="{Binding ProgressBarValue}" Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text=" of " Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text="{Binding ProcedureRecordsCount}" Style="{StaticResource InfoTextBlockStyle_}"/>
            <TextBlock Text=" procedures exported to USB." Style="{StaticResource InfoTextBlockStyle_}"/>
          </StackPanel>
          <!-- (5) Exporting current procedure -->
          <TextBlock Grid.Row="0" 
                     Margin="0,20,0,0" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" 
                     Text="Exporting Current Procedure ..." 
                     Style="{StaticResource InfoTextBlockStyle_}">
            <TextBlock.Visibility>
              <MultiBinding Converter="{StaticResource MultipleBoolVisibleConverter}" ConverterParameter="StartingCurrentProcedureExport">
                <Binding Path="IsExporting"/>
                <Binding Path="IsCanceled"/>
                <Binding Path="IsExportingCurrentProcedure"/>
              </MultiBinding>
            </TextBlock.Visibility>
          </TextBlock>
          <!-- (6) Exported current procedure -->
          <TextBlock Grid.Row="0" 
                     Margin="0,20,0,0" 
                     HorizontalAlignment="Center" VerticalAlignment="Center" 
                     Text="Current procedure exported to USB" 
                     Style="{StaticResource InfoTextBlockStyle_}">
            <TextBlock.Visibility>
              <MultiBinding Converter="{StaticResource MultipleBoolVisibleConverter}" ConverterParameter="FinishedCurrentProcedureExport">
                <Binding Path="IsExporting"/>
                <Binding Path="IsCanceled"/>
                <Binding Path="IsExportingCurrentProcedure"/>
              </MultiBinding>
            </TextBlock.Visibility>
          </TextBlock>
          <!-- (7) Error in exporting -->
          <StackPanel Grid.Row="0" Orientation="Vertical" 
                      HorizontalAlignment="Center" VerticalAlignment="Center"  
                      Margin="0,160,0,0" 
                      Visibility="{Binding ErrorMessage, Converter={StaticResource errorVisibilityConverter}}">
            <TextBlock Text="Error in exporting procedures: " Style="{StaticResource InfoTextBlockStyle_}" Foreground="DarkRed"/>
            <TextBlock Text="{Binding ErrorMessage, Mode=TwoWay}" Style="{StaticResource InfoTextBlockStyle_}" Foreground="DarkRed"/>
          </StackPanel>
          <ProgressBar Grid.Row="1" Name="ProgressBar" Height="33" Width="400" 
                       Style="{StaticResource HorizontalProgressBar_}" 
                       Minimum="0" Maximum="{Binding ProcedureRecordsCount}" 
                       Value="{Binding ProgressBarValue}" 
                       Visibility="{Binding Path=IsExporting, Converter={StaticResource StateConverter}}"/>
        </Grid>
      </Grid>
      <Button Grid.Row="2" Command="{Binding CancelCommand}" 
              Style="{StaticResource ActionButtonStyle_}" 
              Margin="0,0,0,10">
        <Button.Content>
          <TextBlock Text="{Binding Path=IsExporting, Converter={StaticResource StateMessageConverter}}" 
                     Style="{StaticResource TextInsideButtonStyle_}"/>
        </Button.Content>
      </Button>
    </Grid>
  </Border>
</Window>