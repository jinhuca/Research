<UserControl x:Class="SmartAblationSystem.Views.SystemFiles"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:System="clr-namespace:System;assembly=mscorlib"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dxga="http://schemas.devexpress.com/winfx/2008/xaml/gauges"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:controls="clr-namespace:SmartAblationSystem.Controls"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920" Loaded="UserControl_Loaded"
			 Unloaded="UserControl_Unloaded">

    <UserControl.Resources>
        <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
        <converters:StringToIntConverter x:Key="stringToIntConverter" />
        <converters:BoolToSymbolPresentationConverter x:Key="presentationConverter" />
        <converters:StateToOpacityConverter x:Key="stateToOpacityConverter" />
        <converters:SegmentsStatesProvider x:Key="statesProvider" />
        <converters:GasSateToColor x:Key="gasSateToColor" />
        <converters:WeightToLevelConverter x:Key="weightToLevelConverter" />
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:BooleanToStringConverter x:Key="booleanToStringConverter" />
        <converters:MinutesToUsageTimeConverter x:Key="minutesToUsageTimeConverter" />
        <converters:IntToVersionConverter x:Key="intToVersionConverter" />
        <converters:BooleanToUSBConnectionConverter x:Key="booleanToUSBConnectionConverter" />
        <converters:NotBooleanConverter x:Key="notBooleanConverter" />
        <converters:BooleanToOpacityConverter x:Key="booleanToOpacityConverter" />
        <converters:FieldToTextConverter x:Key="fieldToTextConverter" />
        <converters:USBConnectionAndFirmwareSelectionToVisibilityConverter x:Key="uSBConnectionAndFirmwareSelectionToVisibilityConverter" />
        <controls:TrafficLightsBackgroundControl x:Key="trafficLightsBackgroundControl" />
        <SolidColorBrush x:Key="HorizontalSliderTrackNormalBackground" Color="White" />
        <LinearGradientBrush x:Key="HorizontalSliderTrackNormalBorder" EndPoint="0,1" StartPoint="0,0">
            <GradientStop Color="White" />
            <GradientStop Color="White" />
        </LinearGradientBrush>
        <Style x:Key="SliderRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="OverridesDefaultStyle" Value="true" />
            <Setter Property="IsTabStop" Value="false" />
            <Setter Property="Focusable" Value="false" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Rectangle Fill="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="trafficLightsGrid" Height="1080" Width="1920" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border BorderThickness="6" Margin="0,30,0,0" CornerRadius="20" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.RowSpan="2">
            <Border.BorderBrush>
                <SolidColorBrush Color="{StaticResource CryterionColorBlue}" />
            </Border.BorderBrush>

            <StackPanel Orientation="Horizontal"  Margin="0,0,0,0">
                <!--<StackPanel Width="50" Margin="0,20,0,20" Background="{StaticResource CryterionBrushColorBlue}">
                </StackPanel>-->

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center" Width="650" Margin="0,0,0,50">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Center" >
                        <!--<Button  Style="{StaticResource CircularButtonStyle }"  x:Name="buttonPatientImage"
                         HorizontalAlignment="Right"  VerticalAlignment="Bottom" Margin="0,0,0,0"
                         Width="300"  Height="100" />-->
                        <Label Content="SYSTEM FILES" FontSize="24" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="50,0,10,0" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,20">
                        <Label Content="Usage Time"  FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300" FlowDirection="RightToLeft" />
                        <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                            <Label Content="{Binding MinutesOfUse, Converter={StaticResource minutesToUsageTimeConverter}}"  
                                   HorizontalAlignment="Left" Width="360" Height="40"
                                   FontSize="24" FontWeight="Bold" Foreground="#00afef" HorizontalContentAlignment="Left" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="Control Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding CentralMicroControllerFirmwareVersion,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=CentralMicroControllerFirmwareVersion}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Boot Loader" FontSize="24"  Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding CentralMicroControllerBootLoaderFirmwareVersion,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=CentralMicroControllerBootLoaderFirmwareVersion}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="CPLD Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding CpldFirmwareVersion,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=CpldFirmwareVersion}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Label Content="Patient Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding PatientMicroControllerFirmwareVersion, Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=PatientMicroControllerFirmwareVersion}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Boot Loader" FontSize="24"  Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding PatientMicroControllerBootLoaderFirmwareVersion, Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=PatientMicroControllerBootLoaderFirmwareVersion}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="Repeater Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding RepeaterFirmware,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=RepeaterFirmware}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Boot Loader" FontSize="24"  Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding RepeaterBootLoaderFirmware,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=RepeaterBootLoaderFirmware}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="ICB Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label   Width="360" Height="40"  HorizontalAlignment="Right"  FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding ICBFirmware,Converter={StaticResource intToVersionConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Boot Loader" FontSize="24"  Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding ICBBootLoaderFirmwareVersion,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=ICBBootLoaderFirmware}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="Remote Control Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding RemoteControlFirmware,Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=RemoteControlFirmware}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                        <Label Content="Boot Loader" FontSize="24"  Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding RemoteControlBootLoaderFirmwareVersion, Converter={StaticResource intToVersionConverter}, Mode=TwoWay, ConverterParameter=RemoteBootLoaderFirmware}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Label Content="Catheter Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Label  Width="360" Height="40"  HorizontalAlignment="Right"   FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Center"
                         Content="{Binding CatheterFirmwareVersion,Converter={StaticResource intToVersionConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Left">
                        <Label Content="To Read Firmware reconnect the catheter  " FontSize="12" FontWeight="Bold" Foreground="Red" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="300"  FlowDirection="RightToLeft" />
                        <Button Width="220" Height="60" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Read Firmware Versions" Command="{Binding ReadFirmwareVersionCommand}" CommandParameter="PatientMicroController" Style="{StaticResource ButtonCryterion}"
                                    Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}"
                                    IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel VerticalAlignment="Top"  Margin="0,10,20,0" Orientation="Vertical" >

                    <!--<Border Grid.Column="1" BorderThickness="6" Margin="5,0,0,20" CornerRadius="6">-->
                    <!--<Border.BorderBrush>
                            <SolidColorBrush Color="{StaticResource CryterionColorBlue}" Opacity="1" />
                        </Border.BorderBrush>-->
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="DatabaseVersionLabel" FontSize="24" FontWeight="Bold" Foreground="White" VerticalAlignment="Top" Content="Database Version" Margin="0,0,10,0" />
                        <Label x:Name="DatabaseVersionValueLabel" FontSize="24" FontWeight="Bold" Foreground="{StaticResource CryterionBrushColorBlue}" VerticalAlignment="Top"
                                   Content="{Binding DatabaseVersion}" Margin="0,0,10,0" />
                    </StackPanel>
                    <!--</Border>-->

                    <StackPanel Orientation="Horizontal" Margin="0,30,0,0">
                        <Label x:Name="DateLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="Date" Margin="0,0,10,0" />
                        <Label x:Name="SomeLabel" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding CurrentDateTime}" ContentStringFormat="yyyy-MM-dd" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="RAMLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="RAM" Margin="0,0,10,0" />
                        <Label x:Name="RAM" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding RAM}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="OSDiskLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="Disk Size" Margin="0,0,10,0" />
                        <Label x:Name="OSDisk" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding OSDisk}" />
                    </StackPanel>
                    <!--<StackPanel Orientation="Horizontal">
                        <Label x:Name="MACAddressLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="MACAddress" Margin="0,0,10,0" />
                        <Label x:Name="MACAddress" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding MACAddress}" />
                    </StackPanel>-->

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="BoardMakerLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="Board Manufacturer" Margin="0,0,10,0" />
                        <Label x:Name="BoardMaker" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding BoardMaker}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="BoardProductIdLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="Board Product ID" Margin="0,0,10,0" />
                        <Label x:Name="BoardProductId" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding BoardProductId}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="CPUManufacturerLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="CPU Manufacturer" Margin="0,0,10,0" />
                        <Label x:Name="CPUManufacturer" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding CPUManufacturer}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="CpuSpeedInGHzLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="CPU Speed" Margin="0,0,10,0" />
                        <Label x:Name="CpuSpeedInGHz" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding CpuSpeedInGHz, StringFormat={}{0:C}}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="GetBIOSmakerLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="BIOS Manufacturer" Margin="0,0,10,0" />
                        <Label x:Name="GetBIOSmaker" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding GetBIOSmaker}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="BIOSversionLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="BIOS Version" Margin="0,0,10,0" />
                        <Label x:Name="BIOSverion" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding BIOSVersion}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="OSNameLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="OS Name" Margin="0,0,10,0" />
                        <Label x:Name="OSName" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding OSName}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Label x:Name="OSVersionLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="OS Version" Margin="0,0,10,0" />
                        <Label x:Name="OSVersion" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding OSVersion}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,50,0,0" Background="Red" Opacity="0.5">
                        <Label x:Name="EstimatedRemainingProcedureLabel" FontSize="24"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Margin="0,0,10,0" />
                        <Label x:Name="EstimatedRemainingProcedure" FontSize="24"  FontWeight="Bold" Foreground="#00afef" VerticalAlignment="Top"  Content="{Binding EstimatedRemainingProcedure}" />
                    </StackPanel>

                </StackPanel>

                <Border  BorderThickness="2" Margin="5,20,20,20" CornerRadius="20" VerticalAlignment="Top"  Width="500">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="White" Opacity="1" />
                    </Border.BorderBrush>

                    <StackPanel VerticalAlignment="Top"  Margin="0,20,10,0" Orientation="Vertical">

                        <StackPanel >

                            <Label Content="Close The Tank before Updating Firmware" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="Yellow"/>
                            <Image Source="/Images/N2OTank.png" HorizontalAlignment="Center" Height="100" Margin="0,0,0,0"/>
                        </StackPanel>


                        <StackPanel Orientation="Horizontal" Margin="35,20,0,0">
                            <Label x:Name="ControlFirmwareLabel" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="325"  FlowDirection="RightToLeft" />
                            <Viewbox Height="50"  Width="50" Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}">
                                <RadioButton x:Name="CMCURadioButton" Style="{StaticResource CryterionCheckBoxRadio}" IsChecked="{Binding IsCMCUSelected, Mode=TwoWay}" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                            </Viewbox>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="35,20,0,0">
                            <Label x:Name="CPLDFirmwareLabel" Content="Control and CPLD Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="325"  FlowDirection="RightToLeft" />
                            <Viewbox Height="50"  Width="50" Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}">
                                <RadioButton x:Name="CPLDRadioButton" Style="{StaticResource CryterionCheckBoxRadio}" IsChecked="{Binding IsCPLDSelected, Mode=TwoWay}" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="35,20,0,0">
                            <Label x:Name="PatientFirmwareLabel" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="325"  FlowDirection="RightToLeft" />
                            <Viewbox Height="50"  Width="50" Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}">
                                <RadioButton x:Name="PMCURadioButton" Style="{StaticResource CryterionCheckBoxRadio}" IsChecked="{Binding IsPMCUSelected, Mode=TwoWay}" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="35,20,0,0">
                            <Label x:Name="RepeaterFirmwareLabel" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="325"  FlowDirection="RightToLeft" />
                            <Viewbox Height="50"  Width="50" Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}">
                                <RadioButton x:Name="RepeaterRadioButton" Style="{StaticResource CryterionCheckBoxRadio}" IsChecked="{Binding IsRepeaterSelected, Mode=TwoWay}" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="35,20,0,0">
                            <Label Content="ICB Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="325"  FlowDirection="RightToLeft" />
                            <Viewbox Height="50"  Width="50" Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}">
                                <RadioButton x:Name="ICBRadioButton" Style="{StaticResource CryterionCheckBoxRadio}" IsChecked="{Binding IsICBSelected, Mode=TwoWay}" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="35,20,0,0">
                            <Label Content="Remote Control Firmware" FontSize="24" FontWeight="Bold" Foreground="White" Opacity="0.9" Margin="0,0,10,0"  VerticalAlignment="Center" Width="325"  FlowDirection="RightToLeft" />
                            <Viewbox Height="50"  Width="50" Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}">
                                <RadioButton x:Name="RemoteRadioButton" Style="{StaticResource CryterionCheckBoxRadio}" IsChecked="{Binding IsRemoteSelected, Mode=TwoWay}" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"/>
                            </Viewbox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="40,20,0,0" Visibility="{Binding IsLoadingFirmware, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=IsLoadingFirmware, Mode=OneWay}" HorizontalAlignment="Center" Width="330">
                            <Image  Source="/Images/Folder.png" VerticalAlignment="Center" Width="40" Height="40" />
                            <Controls:MetroProgressBar  IsIndeterminate="True"  EllipseDiameter="10" BorderBrush="White" BorderThickness="5" Height="40" Width="190" Foreground="{StaticResource CryterionPopupSystemMessageBrushBackground}">
                            </Controls:MetroProgressBar>

                            <Image  Source="/Images/Chip.png" VerticalAlignment="Center" Width="40" Height="40" />

                            <Label x:Name="percentage" Margin="10,0,0,0" Content="{Binding TransmittedDataPercentage}"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"></Label>
                            <Label x:Name="percentageValue"  Content="%"  Margin="2,0,0,0" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="16" VerticalAlignment="Center"></Label>

                        </StackPanel>

                        <StackPanel x:Name="ImportFileFromUSB" Orientation="Horizontal" Margin="0,20,0,0"  HorizontalAlignment="Center"  Visibility="Collapsed">
                            <!-- USBDriveConnected -->
                            <Button x:Name="ImportFileFromUSBButton" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Height="60" Width="220"
                                            VerticalAlignment="Top" FontSize="18" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}"
                                            Margin="70,0,0,0" Style="{StaticResource ButtonCryterion}"
                                            Command="{Binding ImportFileFromUSBCommand}"
                                            IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}"
                                            Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}"/>

                            <Image Source="{Binding USBDriveConnected, Converter={StaticResource booleanToUSBConnectionConverter}, Mode=OneWay}"
                                           Height="50" Width="70" VerticalAlignment="Top" Margin="0,0,0,0" />
                        </StackPanel>

                        <StackPanel>

                            <Label Content="Do Not Remove The USB" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="Yellow"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">

                            <Button x:Name="LoadNewFirmwareButton" Margin="70,0,0,0" Width="220" Height="60" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Command="{Binding LoadFirmwareVersionCommand}"  Style="{StaticResource ButtonCryterion}"
                                    Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoader, Converter={StaticResource booleanToOpacityConverter}}"
                          CommandParameter="SiteSetup" IsEnabled="{Binding IsBootLoaderUpdatingFirmware, Converter={StaticResource notBooleanConverter}}">
                                <Button.Visibility>

                                    <MultiBinding Converter="{StaticResource uSBConnectionAndFirmwareSelectionToVisibilityConverter}">
                                        <Binding Path="USBDriveConnected"/>
                                        <Binding Path="IsFirmwareLoadSelected"/>

                                    </MultiBinding>

                                </Button.Visibility>

                            </Button>

                            <Image Source="{Binding USBDriveConnected, Converter={StaticResource booleanToUSBConnectionConverter}, Mode=OneWay}"
                                           Height="50" Width="70" VerticalAlignment="Top" Margin="0,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,20,0,0" HorizontalAlignment="Center">

                            <Button x:Name="CancelButton" Width="220" Height="60" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Command="{Binding AppModeCommand}"  Style="{StaticResource ButtonCryterion}"
                                    IsEnabled="{Binding IsBootLoaderUpdatingFirmware}"
                                    Opacity="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=BootLoaderCancel, Converter={StaticResource booleanToOpacityConverter}}"/>
                        </StackPanel>

                        <Label x:Name="FirmwareWarnningLabel1" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" FontSize="12" FontWeight="Bold" Foreground="White"  Margin="10,30,0,10"  VerticalAlignment="Top" Width="450"  
                             Visibility="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=IsLoadingFirmware, Converter={StaticResource  booleanToVisibilityConverter}}"  />

                        <Label x:Name="FirmwareWarnningLabel2" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" FontSize="12" FontWeight="Bold" Foreground="Yellow"  Margin="10,0,0,10"  VerticalAlignment="Top" Width="480"  
                             Visibility="{Binding IsBootLoaderUpdatingFirmware, ConverterParameter=IsLoadingFirmware, Converter={StaticResource  booleanToVisibilityConverter}}"  />



                    </StackPanel>


                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>