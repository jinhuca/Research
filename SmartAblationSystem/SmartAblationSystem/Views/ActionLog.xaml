<UserControl x:Class="SmartAblationSystem.Views.ActionLog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920"
             Loaded="ActionLog_OnLoaded" Unloaded="ActionLog_OnUnloaded">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:ActionIdToActionDescriptionConverter x:Key="actionIdToActionDescriptionConverter" />
        <converters:UserToStringConverter x:Key="userToStringConverter" />
        <converters:FieldToTextConverter x:Key="fieldToTextConverter" />
    </UserControl.Resources>

    <Grid Height="1080" Width="1920" VerticalAlignment="Top">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="25*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Image Source="/Images/BSC_Logo.png" Margin="0,5,5,0" Height="70" HorizontalAlignment="Right" VerticalAlignment="Top" />

        <StackPanel Grid.Row="1" Orientation="Vertical">
            <Label Uid="ActionLogLabel"  Content="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}, ConverterParameter=CAPS}" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="50" Margin="0,10,0,0" />

            <Border Margin="10,0,10,0" BorderThickness="2" CornerRadius="6">
                <Border.BorderBrush>
                    <SolidColorBrush Color="White" Opacity="1" />
                </Border.BorderBrush>

                <DataGrid Name="UsersDataGrid" AutoGenerateColumns="False" RowHeaderWidth="0" ItemsSource="{Binding ActionLog}"
                              HeadersVisibility="Column"
                              Background="White" BorderThickness="0" Margin="0"
                              VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              AlternatingRowBackground="LightBlue" AlternationCount="2"
                              CanUserAddRows="False"
                              Height="800"
                              SelectionMode="Single">
                    <DataGrid.Resources>
                        <Style TargetType="DataGrid">
                            <Setter Property="GridLinesVisibility" Value="None" />
                        </Style>

                        <Style TargetType="{x:Type DataGridColumnHeader}">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="Foreground" Value="{StaticResource CryterionBrushColorBlue}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="25" />
                            <Setter Property="HorizontalAlignment" Value="Left" />
                        </Style>

                        <Style TargetType="{x:Type DataGridRow}">
                            <Setter Property="Background" Value="White" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CryterionBrushColorBlue}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="FontSize" Value="25" />
                            <Setter Property="Foreground" Value="Black" />
                            <Setter Property="HorizontalAlignment" Value="Left" />

                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{StaticResource CryterionBrushColorBlue}" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static DataGrid.FocusBorderBrushKey}}" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsSelected" Value="true" />
                                        <Condition Property="Selector.IsSelectionActive" Value="false" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="Background" Value="{StaticResource CryterionBrushColorBlue}" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                                </MultiTrigger>
                                <Trigger Property="IsEnabled" Value="false">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>

                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="{StaticResource CryterionColorBlue}" />
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date and Time" Binding="{Binding Time, StringFormat='{}{0:MMM dd yyyy HH:mm}'}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" />
                        <DataGridTextColumn Header="User" Binding="{Binding User.UserName}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" />
                        <DataGridTextColumn Header="Action" Binding="{Binding ActionId, Converter={StaticResource actionIdToActionDescriptionConverter}}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" />
												<DataGridTextColumn Header="Message" Binding="{Binding Message}" MinWidth="100" IsReadOnly="True"/>
                        <!--<DataGridTextColumn  Binding="{Binding Time}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" >
                            <DataGridTextColumn.Header>
                                <TextBlock Uid="DateTimeLabel" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding User.UserName}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" >
                            <DataGridTextColumn.Header>
                                <TextBlock Uid="UserLabel" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding ActionId, Converter={StaticResource actionIdToActionDescriptionConverter}}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" >
                            <DataGridTextColumn.Header>
                                <TextBlock Uid="actionTransUID" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>-->
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>

        <Button x:Name="ReturnToSettingsButton" Content="{Binding RelativeSource={RelativeSource Self}, Path=Name , Converter={StaticResource fieldToTextConverter}}" Height="60" Width="275" Background="Transparent"
                Grid.Row="5" Style="{StaticResource ButtonCryterion}" VerticalAlignment="Center" Margin="0,15,0,15"
                Command="{Binding ReturnToSettingsCommand}" FontSize="24" FontWeight="Bold" Foreground="White" />
    </Grid>
</UserControl>