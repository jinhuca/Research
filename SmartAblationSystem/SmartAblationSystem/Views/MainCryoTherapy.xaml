<UserControl x:Class="SmartAblationSystem.Views.MainCryoTherapy"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:convertersNew="clr-namespace:SmartAblationSystem.ConvertersNew"
             prism:ViewModelLocator.AutoWireViewModel="True"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920">
  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter_"/>
    <converters:BooleanAndStateToVisibilityConverter x:Key="BooleanAndStateToVisibilityConverter_"/>
    <converters:BooleanToUSBConnectionConverter x:Key="BooleanToUsbConnectionConverter_"/>
    <converters:BoolVisibilityConverter x:Key="BoolVisibleConverter_"/>
    <converters:MultipleBoolValueConverter x:Key="MultiBoolConverter_"/>
  </UserControl.Resources>
  <Grid Height="1080" Width="1920" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="80"/>
    </Grid.RowDefinitions>
    <ContentControl Content="{Binding CurrentMainCryoTherapyView}" Grid.Row="0" Background="Transparent" 
                    VerticalAlignment="Top" />
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="2.8*"/>
        <ColumnDefinition Width="1.6*"/>
        <ColumnDefinition Width="0.7*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid HorizontalAlignment="Center">
          <Button Style="{StaticResource ExitPlaybackButtonStyle_}" 
                  Visibility="{Binding AreSensorsInPlayBackMode, Converter={StaticResource BooleanToVisibilityConverter_}}" 
                  Command="{Binding ExitPlayBackCommand}" 
                  CommandParameter="ReturnToProcedure"/>
          <Button Style="{StaticResource PlaybackButtonStyle_}" 
                  Command="{Binding PlayBackCommand}" 
                  CommandParameter="ReturnToProcedure">
            <Button.Visibility>
              <MultiBinding Converter="{StaticResource BooleanAndStateToVisibilityConverter_}">
                <Binding Path="AreSensorsInPlayBackMode"/>
                <Binding Path="SystemState"/>
                <Binding Path="IsPlayBackModeDeactivted"/>
                <Binding Path="CanstartDiaphragmMovementMonitoring"/>
              </MultiBinding>
            </Button.Visibility>
          </Button>
        </Grid>
        <Button Style="{StaticResource CompleteProcedureButtonStyle_}" 
                Visibility="{Binding IsCompleteProcedureVisible}" 
                Command="{Binding NavigateToViewCommand}"  
                CommandParameter="Report"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Button Style="{StaticResource ReturnToProcedureButtonStyle_}"
                Visibility="{Binding IsReturnToProcedureVisible}"
                Command="{Binding NavigateToViewCommand}"
                CommandParameter="ReturnToProcedure"/>
        <Button Style="{StaticResource EndProcedureButtonStyle_}"
                Visibility="{Binding IsEndProcedureVisible}"
                Command="{Binding NavigateToViewCommand}" 
                CommandParameter="Home"/>
      </StackPanel>
      <Grid Grid.Column="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" 
              HorizontalAlignment="Left"
              VerticalAlignment="Center"
              Background="Transparent"
              Visibility="{Binding ReadyToExport, Converter={StaticResource BoolVisibleConverter_}}">
          <Grid.IsEnabled>
            <MultiBinding Converter="{StaticResource MultiBoolConverter_}">
              <Binding Path="USBDriveConnected" Mode="OneWay"/>
              <Binding Path="ReadyToExport" Mode="OneWay"/>
            </MultiBinding>
          </Grid.IsEnabled>
          <i:Interaction.Triggers>
            <i:EventTrigger EventName="MouseUp">
              <i:InvokeCommandAction Command="{Binding ExportCurrentProcedureCommand}"/>
            </i:EventTrigger>
          </i:Interaction.Triggers>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Image Grid.Column="0" 
                 Height="36" 
                 Stretch="Uniform"
                 IsHitTestVisible="False"
                 HorizontalAlignment="Right" Margin="0,0,0,8"
                 Source="{Binding USBDriveConnected, Converter={StaticResource BooleanToUsbConnectionConverter_}, Mode=OneWay}"/>
          <Button Grid.Column="1" IsHitTestVisible="False"
                  Style="{StaticResource SaveToUsbButtonStyle_}"/>
        </Grid>
        <Button Grid.Column="1" HorizontalAlignment="Left"
                Style="{StaticResource PrintButtonStyle_}"
                Visibility="{Binding ReadyToExport, Converter={StaticResource BoolVisibleConverter_}}"
                Command="{Binding PrintPDFCommand}"
                IsEnabled="{Binding IsPrinterAvailable}">
        </Button>
      </Grid>
    </Grid>
  </Grid>
</UserControl>