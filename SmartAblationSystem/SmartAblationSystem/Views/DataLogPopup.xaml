<Window x:Class="SmartAblationSystem.Views.DataLogPopup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartAblationSystem.Views"
      xmlns:prism="http://prismlibrary.com/"
      prism:ViewModelLocator.AutoWireViewModel="True"
      mc:Ignorable="d"
      xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
      d:DesignHeight="500" d:DesignWidth="1200"
      Title="MessagePopup" WindowState="Maximized" WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="#C0000000">

  <Window.Resources>
    <converters:FieldToTextConverter x:Key="fieldToTextConverter" />
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    <converters:ActionIdToActionDescriptionConverter x:Key="actionIdToActionDescriptionConverter" />
    <converters:UserToStringConverter x:Key="userToStringConverter" />
  </Window.Resources>

  <Border Width="1200" VerticalAlignment="Center" HorizontalAlignment="Center" Name="BorderColor" BorderThickness="0" CornerRadius="20" Background="#2b2b33">
    <Border.Effect>
      <DropShadowEffect Color="Black" ShadowDepth="42.4264068712" Opacity="0.25" BlurRadius="40" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="78" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border CornerRadius="20 20 0 0" Grid.Row="0" Background="#4B6090">
        <Label VerticalAlignment="Center" Name="TitleLabel" Uid="datalogsTransUID" Grid.Row="0" Content="{Binding RelativeSource={RelativeSource Self}, Path=Uid , Converter={StaticResource fieldToTextConverter}}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Foreground="#cec3c6" Background="Transparent" />
        <Border.Effect>
          <DropShadowEffect Color="Black" Direction="270" ShadowDepth="3" Opacity="0.16" BlurRadius="6" />
        </Border.Effect>
      </Border>

      <Grid Grid.Row="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="40" />
          <RowDefinition Height="*" />
          <RowDefinition Height="40" />
          <RowDefinition Height="auto" />
          <RowDefinition Height="20" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="30" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="30" />
        </Grid.ColumnDefinitions>
        <DataGrid 
          Grid.Row="1"
          Grid.Column="1"
          Name="ProcedureLogsDataGrid"
          AutoGenerateColumns="False"
          ItemsSource="{Binding ProcedureLogs}"
          HeadersVisibility="Column"
          Background="Transparent"
          BorderThickness="0"
          VerticalAlignment="Center"
          ScrollViewer.VerticalScrollBarVisibility="Auto"
          HorizontalScrollBarVisibility="Disabled"
          ScrollViewer.CanContentScroll="True"
          CanUserAddRows="False"
          SelectionMode="Single"
          HorizontalAlignment="Stretch"
          Style="{StaticResource sf.DataGridStyle}"
          >
          <DataGrid.Resources>
            <Style TargetType="TextBlock">
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
          </DataGrid.Resources>
          <!--<DataGrid.Resources>
            <Style TargetType="DataGrid">
              <Setter Property="GridLinesVisibility" Value="None" />
