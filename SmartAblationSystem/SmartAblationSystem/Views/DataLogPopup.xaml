          <DataGrid.Columns>
            <DataGridTextColumn Binding="{Binding ProcedureId}" MinWidth="100" CanUserResize="False" IsReadOnly="True" >
              <DataGridTextColumn.Header>
                <TextBlock Uid="procedureTransUID" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}, StringFormat=' {0} Id'}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn x:Name="Description"  Binding="{Binding Description}" MinWidth="100" CanUserResize="False" IsReadOnly="True" >
              <DataGridTextColumn.Header>
                <TextBlock Uid="descriptionTransUID" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Width="auto" Binding="{Binding LogDate, StringFormat='{}{0:MMM dd yyyy HH:mm}'}" MinWidth="120" CanUserResize="False" IsReadOnly="True" >
              <DataGridTextColumn.Header>
                <TextBlock Uid="logdataTransUID" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}" />
              </DataGridTextColumn.Header>
            </DataGridTextColumn>
            <DataGridTextColumn Width="*" Binding="{Binding PreviousInformation}" MinWidth="100" CanUserResize="False" IsReadOnly="True">
              <DataGridTextColumn.Header>
                <TextBlock Uid="previousinfoTransUID" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.ElementStyle>
                <Style>
                  <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
            <DataGridTextColumn Width="*" Binding="{Binding CommittedInformation}" MinWidth="100" CanUserResize="False" IsReadOnly="True" >
              <DataGridTextColumn.Header>
                <TextBlock Uid="committedinfoTransUID" Text="{Binding RelativeSource={RelativeSource Self}, Path=Uid, Converter={StaticResource fieldToTextConverter}}" />
              </DataGridTextColumn.Header>
              <DataGridTextColumn.ElementStyle>
                <Style>
                  <Setter Property="TextBlock.TextWrapping" Value="Wrap" />
                </Style>
              </DataGridTextColumn.ElementStyle>
            </DataGridTextColumn>
          </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
          <Button VerticalAlignment="Center" HorizontalAlignment="Center" Style="{StaticResource sf.button.rounded-edge}" Content="OK" x:Name="OkButton" Click="OkButton_Click" />
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>