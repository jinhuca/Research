<Window x:Class="SmartAblationSystem.Views.CaseSummaryReport"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             Loaded="dataGrid1_Loaded" 
             mc:Ignorable="d" 
            x:Name="CaseCalendarWindow" Width="0" Height="0" WindowStyle="None"  >
    <Grid DataContext="{Binding ElementName=CaseCalendarWindow, Path=.}" >
        <Canvas Name="canvasCalendarReport" Background="White" HorizontalAlignment="Left" MinWidth="610"  Margin="0" >
               <DataGrid x:Name="dataGrid1" MinWidth="600" BorderThickness="0"
		          Margin="8,10,2,0"
                  VerticalScrollBarVisibility="Hidden"  HorizontalScrollBarVisibility="Disabled"
		          VerticalAlignment="Top"
		          AutoGenerateColumns="False"
		          ItemsSource="{Binding CaseCalendarCollection}"
                  
                  MinRowHeight="40" CanUserSortColumns="False" CanUserResizeRows="False" CanUserResizeColumns="False" CanUserReorderColumns="False" ScrollViewer.CanContentScroll="False" >
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="{x:Type DataGridColumnHeader}">
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FontSize" Value="18"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="FontWeight" Value="DemiBold"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalAlignment" Value="Center"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
 
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Sun">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseSunValue}"  FontSize="16" FontWeight="Bold" Height="79" Width="26"  /><Label Content="{Binding CaseSun}" Width="40" FontSize="26"  Opacity="0.4" Height="50"  Margin="0,10,15,10"/></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Mon" >
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseMonValue}"  FontSize="16" FontWeight="Bold"  Height="79" Width="26"  /><Label Content="{Binding CaseMon}" Width="40" FontSize="26"  Opacity="0.4" Height="50"  Margin="0,10,15,10"/></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Tue">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseTueValue}"  FontSize="16" FontWeight="Bold" Height="79" Width="26"  /><Label Content="{Binding CaseTue}" Width="40" FontSize="26"  Opacity="0.4" Height="50"  Margin="0,10,15,10"/></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Wed">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseWedValue}" FontSize="16" FontWeight="Bold" Height="79" Width="26"  /><Label Content="{Binding CaseWed}" Width="40"  FontSize="26"  Opacity="0.4" Height="50"   Margin="0,10,15,10" /></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Thu">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseThuValue}"  FontSize="16" FontWeight="Bold" Height="79" Width="26"  /><Label Content="{Binding CaseThu}" Width="40" FontSize="26"  Opacity="0.4" Height="50"  Margin="0,10,15,10" /></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Fri">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseFriValue}"  FontSize="16" FontWeight="Bold" Height="79" Width="26"  /><Label Content="{Binding CaseFri}" Width="40" FontSize="26"  Opacity="0.4" Height="50"  Margin="0,10,15,10" /></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Sat">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock><Label Content="{Binding CaseSatValue}"  FontSize="16" FontWeight="Bold" Height="79" Width="26"  /><Label Content="{Binding CaseSat}" Width="40" FontSize="26"  Opacity="0.4" Height="50"  Margin="0,10,15,10"/></TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Canvas>
    </Grid>
</Window>
