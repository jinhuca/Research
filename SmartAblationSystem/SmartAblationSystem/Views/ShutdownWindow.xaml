<Window x:Class="SmartAblationSystem.Views.ShutdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartAblationSystem.Views"
        mc:Ignorable="d"
        Title="ShutdownWindow"
        WindowStartupLocation="CenterScreen" 
        WindowStyle="None" 
        AllowsTransparency="True"
        Background="Transparent">
  <Window.Resources>
    <SolidColorBrush x:Key="TitleBrush_" Color="#ffFFE472"/>
    <Style x:Key="TitleTextStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="Foreground" Value="#ff2B2B33"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="MessageTextStyle_" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontWeight" Value="Regular"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#FFCEC3C6"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
  </Window.Resources>
  <Grid Width="680" Height="279">
  <Border CornerRadius="10,10,10,10"
          Background="#ff2B2B33"
          >
      <Border.Effect>
        <DropShadowEffect Color="Black"
              ShadowDepth="11"
              BlurRadius="20"
              RenderingBias="Performance"
              Opacity="0.5"
              Direction="-50"/>
      </Border.Effect>
    </Border>
    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
      <Grid.RowDefinitions>
        <RowDefinition Height="78"/>
        <RowDefinition Height="131"/>
        <RowDefinition Height="70"/>
      </Grid.RowDefinitions>
      <Border Grid.Row="0"
              Background="{StaticResource TitleBrush_}"
              CornerRadius="10,10,0,0"
              VerticalAlignment="Stretch">
        <TextBlock Text="SYSTEM MESSAGE"
                   Style="{StaticResource TitleTextStyle_}"/>
      </Border>
      <TextBlock Grid.Row="1" 
                 Text="Are you sure that you want to shutdown your system now?" 
                 Style="{StaticResource MessageTextStyle_}"/>
      <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0,0,20,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0"
                Style="{StaticResource TextWithUnderlineButton_}"
                Content="Cancel"
                Click="CancelClick"
                IsCancel="True"/>
        <Button Grid.Column="1"
                Style="{StaticResource ConfirmButtonStyle_}"
                Content="CONFIRM"
                Click="ShutdownClick"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
