<Window x:Class="SmartAblationSystem.Views.EngineeringDataSelector"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartAblationSystem.Views"
      xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900" Title="MessagePopup" Height="600" Width="900"
      WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.Resources>
        <converters:FileToStringConverter x:Key="fileToStringConverter" />
    </Window.Resources>

    <Border Name="BorderColor" BorderThickness="0" CornerRadius="10,10,10,10" Background="{StaticResource CryterionPopupSystemMessageBrushBackground}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Name="TitleLabel" Grid.Row="0" Content="SELECT ENGINEERING DATA TO SAVE" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center" Foreground="White" Background="Transparent" />

            <Border Grid.Row="1" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushControlContainer}" Margin="5,5,5,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="65" />
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BorderThickness="1" CornerRadius="10" Background="{StaticResource CryterionPopupSystemMessageBrushContentContainer }" Margin="5,5,5,5">

                        <DataGrid Name="EngineeringDataFilesDataGrid" AutoGenerateColumns="False" RowHeaderWidth="0" ItemsSource="{Binding EngineeringDataFileList}"
                              HeadersVisibility="Column"
                              Background="White" BorderThickness="0" Margin="10,0,10,5"
                              VerticalAlignment="Stretch" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              CanUserAddRows="False"
                              SelectionMode="Extended">

                            <DataGrid.Resources>
                                <Style TargetType="DataGrid">
                                    <Setter Property="GridLinesVisibility" Value="None" />
                                </Style>

                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="White" />
                                    <Setter Property="Foreground" Value="{StaticResource CryterionBrushColorBlue}" />
                                    <Setter Property="FontWeight" Value="Bold" />
                                    <Setter Property="FontSize" Value="25" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />
                                </Style>

                                <Style TargetType="{x:Type DataGridRow}">
                                    <Setter Property="Background" Value="White" />
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CryterionBrushColorBlue}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="FontSize" Value="25" />
                                    <Setter Property="Foreground" Value="Black" />
                                    <Setter Property="HorizontalAlignment" Value="Left" />

                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{StaticResource CryterionBrushColorBlue}" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static DataGrid.FocusBorderBrushKey}}" />
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="true" />
                                                <Condition Property="Selector.IsSelectionActive" Value="false" />
                                            </MultiTrigger.Conditions>
                                            <Setter Property="Background" Value="{StaticResource CryterionBrushColorBlue}" />
                                            <Setter Property="Foreground" Value="Black" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.InactiveSelectionHighlightBrushKey}}" />
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="false">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"
                                                 Color="{StaticResource CryterionColorBlue}" />
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Engineering Data File" Binding="{Binding Filename, Converter={StaticResource fileToStringConverter}, ConverterParameter=FILENAME}" Width="*" MinWidth="100" CanUserResize="False" IsReadOnly="True" />

                                <!-- Make the "Selected" checkbox checked when clicked (avoid having to perform 2 clicks) -->
                                <DataGridTemplateColumn Header="Selected" Width="125" CanUserResize="False" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource RoundCorner}" Content="OK" x:Name="OkButton" Margin="10,10,10,10" HorizontalAlignment="Right" VerticalAlignment="Center" Click="OkButton_Click" />
                        <Button Style="{StaticResource RoundCorner}" Content="Cancel" x:Name="CancelButton" Margin="10,10,10,10" HorizontalAlignment="Left" VerticalAlignment="Center" IsCancel="True" Background="#FF00AFEF" Click="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>