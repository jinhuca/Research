<UserControl x:Class="SmartAblationSystem.Views.TimeAndDate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:mvvm="http://prismlibrary.com/"
             xmlns:userControls="clr-namespace:CustomControls.UserControls;assembly=CustomControls"
             xmlns:viewModels="clr-namespace:SmartAblationSystem.ViewModels"
             mvvm:ViewModelLocator.AutoWireViewModel="True" 
             Loaded="TimeAndDate_OnLoaded"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920">
  <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />

    <Style TargetType="TextBlock" x:Key="TimeAndDateTextBlockBaseStyle">
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style TargetType="TextBlock" x:Key="CaptionTitleTextStyle" BasedOn="{StaticResource TimeAndDateTextBlockBaseStyle}">
      <Setter Property="Foreground" Value="#FFCEC3C6" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="24" />
    </Style>

    <Style TargetType="TextBlock" x:Key="HospitalTextStyle" BasedOn="{StaticResource TimeAndDateTextBlockBaseStyle}">
      <Setter Property="Foreground" Value="#FFCEC3C6" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="FontSize" Value="18" />
    </Style>

    <Style TargetType="TextBlock" x:Key="DaylightTextStyle" BasedOn="{StaticResource TimeAndDateTextBlockBaseStyle}">
      <Setter Property="Foreground" Value="#FFCEC3C6" />
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="userControls:CustomTextBox" x:Key="DateTimeDisplayTextStyle">
      <Setter Property="FontFamily" Value="{StaticResource Lato}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="Foreground" Value="#FFFFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style TargetType="Border" x:Key="DateTimeDisplayBorderStyle">
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="#FF34343E" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="Height" Value="45" />
      <Setter Property="BorderBrush" Value="#FF4F4E57" />
    </Style>

    <Style TargetType="Button">
      <Setter Property="Background" Value="#FF34343E" />
      <Setter Property="Foreground" Value="#FFCEC3C6" />
      <Setter Property="FontFamily" Value="{StaticResource Lato}" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0, -3, 0, 0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <ControlTemplate.Resources>
              <Storyboard x:Key="Pressed_">
                <DoubleAnimation Storyboard.TargetName="_mainBtnBorder"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0.5"
                                 Duration="0:0:0.2"/>
              </Storyboard>
              <Storyboard x:Key="Disabled_">
                <DoubleAnimation Storyboard.TargetName="_mainBtnBorder"
                                 Storyboard.TargetProperty="Opacity"
                                 To="0.2"
                                 Duration="0:0:0"/>
              </Storyboard>
            </ControlTemplate.Resources>

            <Border Height="{TemplateBinding Height}" Width="{TemplateBinding Width}" Name="_mainBtnBorder"
                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" 
                    BorderThickness="{TemplateBinding BorderThickness}" 
                    CornerRadius="0, 0, 5, 5" Padding="{TemplateBinding Padding}">
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualState x:Name="Normal"/>
                  <VisualState x:Name="MouseOver"/>
                  <VisualState x:Name="Pressed" Storyboard="{StaticResource Pressed_}"/>
                  <VisualState x:Name="Disabled" Storyboard="{StaticResource Disabled_}"/>
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter Content="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid Height="1080" Width="1920">
      <Grid.RowDefinitions>
        <RowDefinition Height="80"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="80" />
      </Grid.RowDefinitions>
      <Grid Background="Black">
        <TextBlock Text="DATE AND TIME" Style="{StaticResource CaptionTitleTextStyle}"/>
      </Grid>

      <Grid Grid.Row="1" Background="#FF101012" >
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="130"/>
          <ColumnDefinition Width="460"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="130"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="1" x:Name="DateTimeSettingControlPanel" Background="#FF2B2B33" BorderThickness="0" CornerRadius="10" 
               HorizontalAlignment="Left" VerticalAlignment="Center" Width="390" >
          <Grid x:Name="_BSCTimeDatePanel" Margin="30,10, 30, 0">
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" HorizontalAlignment="Left" Margin="0, 20">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Style="{StaticResource DateTimeDisplayBorderStyle}" Width="330" x:Name="_DateDisplayBorder" >
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button Style="{StaticResource DatePickerDropDownButtonStyle}" IsEnabled="False" Margin="10, 0"/>
                  <userControls:CustomTextBox Grid.Column="1" Text="{Binding LastModifyDate, StringFormat='MMMM dd yyyy'}" 
                                          Style="{StaticResource DateTimeDisplayTextStyle}" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" Visibility="{Binding IsUserAllowedToModifyDateTime, Converter={StaticResource booleanToVisibilityConverter} }">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <userControls:CryoCalendar Grid.Row="0" IgnoreYearConstrain="True" ShowSelectDateCaption="False" VerticalAlignment="Top" 
                                         SelectedDate="{Binding LastModifyDate}" />
                <Grid Grid.Row="1" Width="330" Height="48" >
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="Cancel" Command="{Binding ResetDateCommand}"/>
                  <Button Grid.Column="2" Content="Set" Command="{Binding SetDateCommand}"/>
                </Grid >
              </Grid>
            </Grid>

            <Grid Grid.Row="1" Margin="0, 20">
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" Name="_TimeDisplayBorder">
                <Border.Resources>
                  <Style TargetType="Border" BasedOn="{StaticResource DateTimeDisplayBorderStyle}">
                    <Setter Property="Width" Value="230"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsUserAllowedToModifyDateTime}" Value="False">
                        <Setter Property="Width" Value="{Binding ElementName=_DateDisplayBorder, Path=ActualWidth}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>

                </Border.Resources>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Viewbox Stretch="Uniform" Grid.Column="0" Margin="8,0, 8, 0" Width="20">
                    <Grid>
                      <Path  Width="17" Height="17" Stretch="uniform" Stroke="#ffcec3c6" 
                         Data="M 20.7,11.9 C 20.7,16.7 16.7,20.7 11.9,20.7 C 7.0,20.7 3.0,16.7 3.0,11.9 C 3.0,7 7,3 11.9,3 C 16.7,3 20.7,7 20.7,11.9 Z" />
                      <Path  Width="3" Height="7" Stretch="uniform" Stroke="#ffcec3c6" 
                         Data="M 18,9 L 18,14.3 L 21.5,16.1" />
                    </Grid>
                  </Viewbox>
                  <userControls:CustomTextBox Grid.Column="1" Text="{Binding LastModifyTime, StringFormat=' HH:mm' }" Style="{StaticResource DateTimeDisplayTextStyle}" 
                         TextAlignment="Left" />
                </Grid>
              </Border>
              <Grid Grid.Row="1" x:Name="_TimePickerPanel" Visibility="{Binding IsUserAllowedToModifyDateTime, Converter={StaticResource booleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="23*"/>
                  <ColumnDefinition Width="43*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <userControls:CryoTimePicker Grid.Row="0" HorizontalAlignment="Left" SelectedTime="{Binding LastModifyTime}" Grid.ColumnSpan="2"/>
                <Grid Grid.Row="1" Width="230" Height="48" HorizontalAlignment="Left" Margin="0,3,0,3" Grid.ColumnSpan="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="2"/>
                    <ColumnDefinition />
                  </Grid.ColumnDefinitions>
                  <Button Grid.Column="0" Content="Cancel" Command="{Binding ResetTimeCommand}"/>
                  <Button Grid.Column="2" Content="Set" Command="{Binding SetTimeCommand}"/>
                </Grid >
              </Grid>
            </Grid>
            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" >
              <TextBlock Text="Daylight Saving: " Style="{StaticResource DaylightTextStyle}"/>
              <TextBlock Text="OFF" Style="{StaticResource DaylightTextStyle}" Margin="20, 0, 5, 0"  Foreground="White"/>
              <ToggleButton IsChecked="{Binding IsUsingDaylightSavingTime}" Style="{StaticResource SwitchToggleButton}" Height="30"/>
              <TextBlock Text="ON" Style="{StaticResource DaylightTextStyle}" Margin="5, 0, 0, 0"  Foreground="White"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Column="2" x:Name="TimeZoneSelectionPanel">
          <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Left" Background="Transparent">
            <ComboBox Height="35" Width="610" Style="{StaticResource ComboBoxStyle}" Background="#FF26262E" Margin="0,5" HorizontalAlignment="Left"
                    IsEnabled="{Binding IsUserAllowedToModifyDateTime}"
                    ItemsSource="{Binding TimeZoneInfoCollection}" SelectedItem="{Binding CurrentTimeZoneInfo}" />
            <Image Width="1200" Height="690" Source="/Images/WorldTimeZoneMap.png" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </StackPanel>
        </Grid>

      </Grid>

      <Grid Grid.Row="2" VerticalAlignment="Center" Height="80" Background="#FF222228">
        <Button Content="BACK TO SETTINGS" Height="49" Width="192" Foreground="White" Style="{StaticResource SettingsPreferencesButton}"
              Command="{Binding ReturnToSettingsCommand}"/>
      </Grid>
    </Grid>
    <Canvas>
      <StackPanel Style="{StaticResource HospitalLogoStackPanelOnHomeStyle_}">
        <TextBlock Text="Hospital:" 
                   Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
        <TextBlock Grid.ColumnSpan="2" 
                   Text="{Binding HospitalName}" 
                   Style="{StaticResource HospitalNameTextBlockStyle_}" />
      </StackPanel>
      <Image Style="{StaticResource LogoImageOnOthersStyle_}"/>
    </Canvas>
  </Grid>
</UserControl>
