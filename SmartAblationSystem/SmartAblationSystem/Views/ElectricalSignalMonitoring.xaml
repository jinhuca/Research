			<GroupBox Grid.Row="1"  Grid.Column="1" Header="Admin Actions" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,5,0">
                <StackPanel Orientation="Horizontal">
					<StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0">
                        <Label Grid.Column="0" Grid.Row="1" x:Name="DeflateAfterThaw" Height="50" Width="240" VerticalAlignment="Center"
                           Margin="0,0,0,5" Style="{StaticResource LabelCryterion}" FontSize="18" FontWeight="Bold" Foreground="Black" IsEnabled="{Binding IsCommandEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Deflate After Thaw" VerticalAlignment="Center" Margin="0,0,10,0" IsEnabled="{Binding IsCommandEnabled}"/>
                                <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" Command="{Binding DeflateAfterThawCommand}"
                                          IsChecked="{Binding DeflateAfterThaw, Mode=OneWay}" Margin="0,0,15,0" IsEnabled="{Binding IsCommandEnabled}"/>
                            </StackPanel>
                        </Label>
                        <Button x:Name="MaintenanceButton" Width="240" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}"
                            FontSize="18" Content="{Binding EnableOrDisableMaintenanceMode, Converter={StaticResource booleanToMaintenanceModeConverter}}"
                            Command="{Binding MaintenanceCommand}" Margin="00,0,0,0" Style="{StaticResource ButtonCryterion}" />
                    </StackPanel>
                    <Grid ShowGridLines="False" Margin="40,10,10,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="50" />
                            <RowDefinition Height="55" />
                        </Grid.RowDefinitions>
                        <Button x:Name="CloseButton" Grid.Row="0" Grid.Column="0" Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}"
                            FontSize="18" Content="Close" Command="{Binding CloseCommand}"  Style="{StaticResource ButtonCryterion}" VerticalAlignment="Top" VerticalContentAlignment="Top" HorizontalContentAlignment="Stretch" />

                        <Border BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" BorderBrush="Silver" Grid.Row="0" Grid.Column="1">
                          <StackPanel>
                            <TextBlock Text="Inflation Speed" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal">
                              <Viewbox Height="35" Margin="0,-7,0,0">
                                <RadioButton Name="SlowButton" GroupName="speed" Margin="20,0,0,0" Width="50" Command="{Binding SlowButtonCommand}"
                                   IsChecked="{Binding InflationSpeedMode, Mode=OneWay, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Slow}">
                                    <RadioButton.Content>
                                    <TextBlock Text="Slow" 
                                              Margin="0,4,0,0" FontSize="8" FontWeight="Bold"  Foreground="White"/>
                                  </RadioButton.Content>
                                </RadioButton>
                              </Viewbox>
                              <Viewbox Height="35" Margin="0,-7,0,0">
                                <RadioButton Name="FastButton" GroupName="speed" Margin="5,0,0,0" Command="{Binding FastButtonCommand}" Width="41"
                                             IsChecked="{Binding InflationSpeedMode, Mode=OneWay, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Fast}">
                                  <RadioButton.Content>
                                    <TextBlock Text="Fast" 
                                              Margin="0,4,0,0" FontSize="8" FontWeight="Bold" Foreground="White"/>
                                  </RadioButton.Content>
                                </RadioButton>
                              </Viewbox>
                            </StackPanel>
                          </StackPanel>
                        </Border>

                        <Button x:Name="LogoutButton" Grid.Row="1" Grid.Column="0" Width="149" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" HorizontalAlignment="Center"
                            FontSize="18" Content="Sign out" Command="{Binding LogoutCommand}"  Style="{StaticResource ButtonCryterion}" Margin="0,5,0,0"  />

                        <Border Grid.Row="2" Grid.Column="1" CornerRadius="6" Width="180" HorizontalAlignment="Left" Margin="40,2,0,2">
                            <Grid >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="AUTO"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Row="0" Grid.Column="0"  Style="{StaticResource ButtonImageNotifier}"  HorizontalAlignment="Left" Width="150" Height="55"  Margin="10,0,0,0"
											Command="{Binding LockTheFootSwitchCommand}" CommandParameter="UnLockTheFootSwitch" Visibility="{Binding LockTheFootSwitch, Converter={StaticResource booleanToVisibilityConverter}}">
                                    <Image Source="/Images/locked.png"  />
                                </Button>

                                <Button Grid.Row="0" Grid.Column="0"  Style="{StaticResource ButtonImageNotifier}"   HorizontalAlignment="Left" Width="150" Height="55" Margin="10,0,0,0"
											Command="{Binding LockTheFootSwitchCommand}" CommandParameter="LockTheFootSwitch" Visibility="{Binding LockTheFootSwitch, Converter={StaticResource booleanToNotVisibilityConverter}}" >
                                    <Image Source="/Images/unlock.png"  />
                                </Button>

                            </Grid>


                        </Border>


                    </Grid>
                   
                </StackPanel>
            </GroupBox>
        </Grid>

        <Grid Grid.Row="5" Width="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Row="1" Grid.Column="1"  Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,5,5,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"  VerticalAlignment="Center" Grid.Column="1">
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <Label Content="Lot" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Width="90" Height="40" Text="{Binding LotNumber, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <Label Content="SN" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Width="90" Height="40" Text="{Binding SerilaNumber, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <Label Content="Hour" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Width="90" Height="40" Text="{Binding LastUseHour, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <Label Content="Day" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Width="90" Height="40" Text="{Binding LastUseDay, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <Label Content="Month" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Width="90" Height="40" Text="{Binding LastUseMonth, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <DockPanel>
                            <Label Content="Year" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Width="90" Height="40" Text="{Binding LastUseYear, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical"  VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10,0,0,0">
                        <Button Width="140" Height="45" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Program" Command="{Binding ProgramCatheterCommand}" Style="{StaticResource ButtonCryterion}" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>

			<GroupBox Grid.Row="1" Grid.Column="0"  Foreground="White"  FontWeight="Bold" FontSize="14" Margin="5,5,5,0" IsEnabled="{Binding IsCommandEnabled}">
                <StackPanel Orientation="Horizontal">
                    <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="8" Margin="10,0,0,0" Width="170" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Height="auto">
                            <Button Style="{StaticResource ButtonImageNotifier }" x:Name="butElectrical"  HorizontalAlignment="Center" Width="115"  Height="55">
                                <Image Source="/Images/electrical plug.png"  Margin="10,0,0,0"></Image>
                            </Button>
                            <Button Style="{StaticResource ButtonImageNotifier}"
                                        x:Name="butElectricalState"
                                        HorizontalAlignment="Center" Width="40" Height="50" Margin="0,0,0,0">
                                <Image Source="{Binding IsCatheterCableConnected , Converter={StaticResource statusToPicture}}" Height="50" Width="40" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="8" Width="170" Margin="5,0,10,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Height="60" Visibility="{Binding SystemState, Converter={StaticResource stateToVisibility}, ConverterParameter=CatheterTube}">
                            <Button Style="{StaticResource ButtonImageNotifier }" x:Name="butMechanical" HorizontalAlignment="Left" Width="115"  Height="55">
                                <Image Source="/Images/mechanical plug.png" Margin="10,0,0,0"></Image>
                            </Button>
                            <Button Style="{StaticResource ButtonImageNotifier}" x:Name="butMechanicalState" HorizontalAlignment="Center" Width="40"  Height="50">
                                <Image Source="{Binding SystemState,ConverterParameter=UseSystemState, Converter={StaticResource statusToPicture}}" Height="50" Width="40" />
                            </Button>
                        </StackPanel>
                    </Border>

					<DockPanel IsEnabled="{Binding IsCommandEnabled}">



                        <Button x:Name="Stop" Style="{StaticResource StopButton}"
                                        Visibility="{Binding SystemState, ConverterParameter=STOP, Converter={StaticResource stateToVisibility}}"
                                        Command="{Binding StopCommand}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=STOP, Converter={StaticResource stateToEnable}}" Margin="0,5,20,10" Height="Auto">
                        </Button>

                        <Button x:Name="Start" Style="{StaticResource StartButton}"
                                        Visibility="{Binding SystemState, ConverterParameter=START, Converter={StaticResource stateToVisibility}}"
                                        Command="{Binding StartCommand}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=START, Converter={StaticResource stateToEnable}}" Margin="50,5,20,10" Height="Auto" Width="184" />

                        <Grid Width="200">
                            <Button x:Name="ConnectButton" Style="{StaticResource ConnectButton}" Margin="8,5,10,10"
                                            Visibility="{Binding IsCatheterElectricallyConnectedAndInIdleState, Converter={StaticResource booleanToVisibilityConverter}}"
                                            Command="{Binding ConnectCommand}" Height="Auto" Width="Auto" />

                            <Button x:Name="DisconnectButton" Style="{StaticResource DisconnectButton}"
                                            Visibility="{Binding IsCatheterConnectedAndInIReadyState, Converter={StaticResource booleanToVisibilityConverter}}"
                                            Command="{Binding ConnectCommand}" Height="Auto" Margin="8,5,10,10" Width="Auto" />

                            <StackPanel Orientation="Horizontal" Margin="-50,0,0,0" Visibility="{Binding CatheterIsConnecting, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}">
                                <Controls:ProgressRing Height="50" Width="50" Foreground="{StaticResource CryterionPopupSystemMessageBrushBackground}"></Controls:ProgressRing>
                                <Label Content="Wait system is initializing..." Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"></Label>
                            </StackPanel>

                        </Grid>
                    </DockPanel>
                </StackPanel>
            </GroupBox>
        </Grid>
    </Grid>
</UserControl>