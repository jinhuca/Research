<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:Validation="clr-namespace:SmartAblationSystem.Validation"
             xmlns:dx="http://schemas.devexpress.com/winfx/2008/xaml/core" x:Class="SmartAblationSystem.Views.ElectricalSignalMonitoring"
             xmlns:ViewModels="clr-namespace:SmartAblationSystem.ViewModels"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d"
             Unloaded="UserControl_Unloaded"
	         Loaded="UserControl_Loaded"
             d:DesignHeight="1030" d:DesignWidth="1920">
    <UserControl.Resources>
        <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
        <converters:StringToIntConverter x:Key="stringToIntConverter" />
        <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
        <converters:BooleanToMaintenanceModeConverter x:Key="booleanToMaintenanceModeConverter" />
        <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter" />
        <converters:StateIdToTextConverter x:Key="stateIdToTextConverter" />
        <converters:DoubleToOnOffConverter x:Key="doubleToOnOffConverter" />
        <converters:StateToVisibilityConverter x:Key="stateToVisibility" />
        <converters:StateToEnableConverter x:Key="stateToEnable" />
        <converters:StatusToPicture x:Key="statusToPicture" />
        <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />

        <ControlTemplate x:Key="validationErrorTemplate">
            <DockPanel>
                <TextBlock Foreground="Red" HorizontalAlignment="Right" Padding="0,0,5,0" FontSize="12"

                DockPanel.Dock="Top">Max 6553!</TextBlock>
                <AdornedElementPlaceholder x:Name="ErrorAdorner"></AdornedElementPlaceholder>
            </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="validationErrorTemplateFM1">
            <DockPanel>
                <TextBlock Foreground="Red" HorizontalAlignment="Right" Padding="0,0,5,0" FontSize="12"

                DockPanel.Dock="Top">Max 12000!</TextBlock>
                <AdornedElementPlaceholder x:Name="ErrorAdorner"></AdornedElementPlaceholder>
            </DockPanel>
        </ControlTemplate>

        <ControlTemplate x:Key="validationErrorTemplateControlBox">
            <DockPanel>
                <TextBlock Foreground="Red" HorizontalAlignment="Right" Padding="0,0,5,0" FontSize="12" DockPanel.Dock="Top">0.01 to 0.1!</TextBlock>
                <AdornedElementPlaceholder x:Name="ErrorAdorner"></AdornedElementPlaceholder>
            </DockPanel>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Height="1030" Width="1920">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="130" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="85" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Width="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <GroupBox  Style="{StaticResource GroupBoxStyle}" Content="Control Micro Controller" FontSize="18" FontWeight="Bold" Grid.Column="0" Margin="0,0,5,0" />
            <GroupBox  Style="{StaticResource GroupBoxStyle}" Content="Patient Micro Controller" FontSize="18" FontWeight="Bold" Grid.Column="1" Margin="5,0,0,0" />
        </Grid>

        <Grid Grid.Row="1" Width="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>

            <!--central Micro controller Analog -->
			<GroupBox Grid.Row="1" Grid.Column="0" Header="Analog" Foreground="White" FontWeight="Bold" FontSize="14" Margin="5,0,5,0" IsEnabled="{Binding IsCommandEnabled}">
                <UniformGrid Rows="2" Columns="6">

                    <StackPanel Orientation="Vertical">
                        <Label Content="PT1 (psig)"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PT1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="PT2 (psig)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PT2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="PT3 (psia)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PT3Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="PT4 (psia)"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PT4Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="PT5 (psia)"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <!--before it wase PT5Reading-->
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding  PT5Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="PS1 (ON/OFF)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PS1Reading, Converter={StaticResource doubleToOnOffConverter}, Mode=TwoWay}" />
                    </StackPanel>
                    <!-- befor we wase using ps2 according to validation we have to swith pt5 to ps2
                    <StackPanel Orientation="Vertical">
                        <Label Content="PS2 (psig)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PS2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    -->

                    <StackPanel Orientation="Vertical">
                        <Label Content="FM1 (sccm)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding FM1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="TN2O (°C) " Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding TS1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="TS1 (°C)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding TN2OReading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="CJ (°C)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CMCUCJReading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="LC1 (lbs)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding LC1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>
            <!-- Patient Micro Controller Analog-->
			<GroupBox Grid.Row="1" Grid.Column="1" Header="Analog" Foreground="White" FontWeight="Bold" FontSize="14" Margin="0,0,5,0" IsEnabled="{Binding IsCommandEnabled}">
                <UniformGrid Rows="2" Columns="6">

                    <StackPanel Orientation="Vertical">
                        <Label Content="TC1 (°C)"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding TC1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="TC2 (°C)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding TC2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="IBP (psig)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CP1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="OBP (psig)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CP2Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="TIP (psig)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding TIPReading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="CIMP1"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />  <!--Text="{Binding CIMP1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}"-->
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="CIMP2" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="CJ (°C)" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PMCUCJReading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="BDI" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding BloodDetecorImValue}" Visibility="{Binding IsCatheterCableConnected, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>
                </UniformGrid>
            </GroupBox>
        </Grid>

        <!--  Read value-->
        <Grid Grid.Row="3" Width="1920">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="0.8*" />
            </Grid.ColumnDefinitions>
            <!-- Central Micro Controller Register values-->
            <GroupBox Grid.Row="3" Grid.Column="0" Header="Register " Foreground="White" FontWeight="Bold" FontSize="14" Margin="5,0,5,0">
                <UniformGrid Rows="9" Columns="5">

                    <StackPanel Orientation="Vertical">
                        <Label Content="Firmware Version"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CentralMicroControllerFirmwareVersion, Converter={StaticResource stringToIntConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="CPLD Error Register" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CPLDErrorRegister, Converter={StaticResource stringToIntConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="CPLD Valve Register" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CPLDValveRegister, Converter={StaticResource stringToIntConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="CPLD System Register" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding CPLDSystemRegister, Converter={StaticResource stringToIntConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="System State"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding SystemState, Converter={StaticResource stateIdToTextConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Ablation Time" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding AblationTime, Converter={StaticResource stringToIntConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Continuous Thawing" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding ContinuousThawing, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" IsEnabled="False" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Target IF" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#d11141"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="TargetInjectionFlow" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="32767" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Target IP" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" x:Name="TargetInjectionPressure" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Background="#d11141"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="TargetInjectionPressure" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="P-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#00b159" Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="PGain" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="I-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#00b159"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="IGain" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="D-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#00b159"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="DGain" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="PID-Offset" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PIDOffset, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Background="#00b159" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Th PT1 High" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" x:Name="ThresholdPT1High" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#00aedb"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="ThresholdForPT1High" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Th PT1 Fail" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#00aedb"   Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="ThresholdForPT1Fail" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Th PT1 Low" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#00aedb"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="ThresholdForPT1Low" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="PT1 Low Range" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2" Background="#f37735"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="PT1LowRange" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="PT1 High Range" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#f37735"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="PT1HighRange" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>
                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="Th PT2 High" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
                        <TextBox BorderBrush="Black" BorderThickness="2"  Background="#ffc425"  Validation.ErrorTemplate="{StaticResource validationErrorTemplate}">
                            <TextBox.Text>
                                <Binding Path="ThresholdPT2High" Mode="TwoWay"  Converter="{StaticResource stringTodoubleConverter}">
                                    <Binding.ValidationRules>
                                        <Validation:RegisterValidator Min="-3276" Max="6553" />
                                    </Binding.ValidationRules>
                                </Binding>
                            </TextBox.Text>
                        </TextBox>
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <DockPanel>
                            <Ellipse Width="20" Height="20" Fill="Red" Stroke="Yellow" StrokeThickness="2" HorizontalAlignment="Left" Margin="0,0,5,0" />
                            <Label Content="PT2 Low Range" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                        </DockPanel>
