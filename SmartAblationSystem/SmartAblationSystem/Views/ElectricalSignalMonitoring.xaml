                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="SV7"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                        <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" Command="{Binding SetSVLevelCommand}" CommandParameter="6" IsChecked="{Binding IsSV6Activated}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="SV8"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                        <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" Command="{Binding SetSVLevelCommand}" CommandParameter="7" IsChecked="{Binding IsSV7Activated}" />
                    </StackPanel>

                    <StackPanel Orientation="Vertical">
                        <Label Content="SV9"  Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" />
                        <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" Command="{Binding SetSVLevelCommand}" CommandParameter="8" IsChecked="{Binding IsSV8Activated}" />
