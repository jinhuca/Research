                  <Image Height="115" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
                    <Image.Source>
                      <MultiBinding Converter="{StaticResource statesAndBalloonToPictuersConverter}" >
                        <Binding Path="SystemState"/>
                        <Binding Path="IsUsingDASBalloon"/>
                        <Binding Path="ISThePressureSetPointReached"/>
                        <Binding Path="PressureSetPoint"/>
                        <Binding Path="CP1Reading"/>
                        <Binding Path="IsTreatmentNumberAndPlayBackVisible" />
                      </MultiBinding>
                    </Image.Source>
                  </Image>
                </Grid>
              </Border>
            </StackPanel>
          </Grid>

          <!-- Ablation Information Panel -->
          <Border Grid.Row="1" Grid.Column="1">
            <Grid>
              <Grid>
                <Grid.Visibility>
                  <MultiBinding Converter="{StaticResource booleanAndStateToNotVisibilityConverter}" ConverterParameter="OcclusionPressureInflationShow">
                    <Binding Path="SystemState"/>
                    <Binding Path="EnabledIsBloodPressureSensorConnected"/>
                    <Binding Path="IsMonitoringBloodPressure"/>
                  </MultiBinding>
                </Grid.Visibility>
                <StackPanel Name="StackPanelTemperature" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                <TextBlock Text="TEMPERATURE °C" 
                           HorizontalAlignment="Left" 
                           VerticalAlignment="Top" 
                           Margin="90,0,0,0" 
                           Style="{StaticResource AblationSubTitleStyle}"/>
              </Grid>
              <Grid>
                <Grid.Visibility>
                  <MultiBinding Converter="{StaticResource booleanAndStateToVisibilityConverter}" ConverterParameter="OcclusionPressureInflationShow">
                    <Binding Path="SystemState"/>
                    <Binding Path="EnabledIsBloodPressureSensorConnected"/>
                    <Binding Path="IsMonitoringBloodPressure"/>
                  </MultiBinding>
                </Grid.Visibility>
                <StackPanel x:Name="StackPanelBloodPressure" VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
