                            IsChecked="{Binding SystemState, Converter={StaticResource CatheterConnectionConverter_}, ConverterParameter=CatheterMechanicalConnection}"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Background="Transparent" 
