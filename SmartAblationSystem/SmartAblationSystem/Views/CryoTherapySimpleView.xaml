    <!-- Third Row: Ablation Control Panel -->
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
			      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
      <Border Background="{StaticResource TherapyControlPanelBackground}"
				        CornerRadius="8"
				        HorizontalAlignment="Stretch"
				        VerticalAlignment="Stretch"
				        Margin="36,10,40,20">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="550"/>
            <ColumnDefinition Width="1022"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Grid Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Center">
            <Grid.IsEnabled>
              <MultiBinding  Converter="{StaticResource stateAndBooleanToEnableConverter}" ConverterParameter="RequiredTime">
                <Binding Path="SystemState"/>
                <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
              </MultiBinding>
            </Grid.IsEnabled>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="270"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="30,6,0,0"
										 Style="{StaticResource InfoTextBlockStyle}"
										 Text="ABLATION&#x0a;TIMER:"/>
            <Grid Grid.Column="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="60"/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0" 
								        Command="{Binding IncreaseTimeCommand}"
								        Visibility="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToVisibility}}"
								        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToEnable}}"
								        Style="{StaticResource UpArrowButtonStyle_}"/>
              <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
									           Text="{Binding RequiredAblationTime}"
									           Style="{StaticResource AblationTimeTextBlockStyle}"
									           Visibility="{Binding IsRequiredAblationTimeVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=IsRequiredAblationTimeVisible}"/>
                <TextBlock Grid.Column="1" 
									           Text="sec" 
									           Style="{StaticResource AblationTimeUnitStyle}"/>
              </Grid>
              <Button Grid.Column="2" 
								        Command="{Binding DecreaseTimeCommand}"
								        Visibility="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToVisibility}}"
								        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToEnable}}"
								        Style="{StaticResource DownArrowButtonStyle_}"/>
            </Grid>
            <Grid Grid.Column="2">
              <ContentControl Content="{StaticResource BicycleImage_}" 
                                Margin="20,11,0,0"
                                Visibility="{Binding ISTTISelected, Converter={StaticResource booleanToVisibilityConverter}}"/>
            </Grid>
          </Grid>
          <Grid Grid.Column="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
              <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" 
							        Style="{StaticResource VacuumOffButtonStyle}" 
							        IsEnabled="{Binding IsCatheterConnectedAndInIReadyState}"
							        Command="{Binding ConnectCommand}"/>

            <Button Grid.Column="1" 
                    Style="{StaticResource VacuumOnButtonStyle}" 
                    IsEnabled="{Binding IsCatheterElectricallyConnectedAndInIdleState}"
                    Command="{Binding ConnectCommand}"/>

            <Button Grid.Column="2" 
							        Style="{StaticResource InflationButtonStyle}" 
							        Command="{Binding StartCommand}"
							        IsEnabled="{Binding SystemState, Converter={StaticResource SystemStateToEnabledConverter_}, ConverterParameter={x:Static constants:ActionConstants.Inflate}}"/>

            <Button Grid.Column="3" 
							        Style="{StaticResource AblationButtonStyle}" 
							        Command="{Binding StartCommand}">
              <Button.IsEnabled>
                <MultiBinding Converter="{StaticResource AblationStateToEnabledConverter}" ConverterParameter="{x:Static constants:ActionConstants.Ablate}">
                  <Binding Path="IsThawingTemperatureSetPointReached"/>
                  <Binding Path="SystemState"/>
                  <Binding Path="IsInDASBalloonTransition" />
                </MultiBinding>
              </Button.IsEnabled>
            </Button>


            <Button Grid.Column="4" 
							        Style="{StaticResource StopButtonStyle}" 
							        Command="{Binding StopCommand}"
							        IsEnabled="{Binding SystemState, Converter={StaticResource StateToEnableConverter}, ConverterParameter={x:Static constants:ActionConstants.Stop}}"/>
          </Grid>
          <Grid Grid.Column="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="60"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
							        Style="{StaticResource LeftArrowButtonStyle_}"
							        Command="{Binding AblationNumberBackwardCommand}"
                      Visibility="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource BoolToVisibilityNewConverter_}}"/>
            <Grid Grid.Column="1" Margin="20,10,0,0"
							      HorizontalAlignment="Center"
							      VerticalAlignment="Center">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0"
								           Text="Treatment"
													 HorizontalAlignment="Center"
								           Style="{StaticResource TreatmentTextStyle}"/>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
									           Text="{Binding TreatmentNumber}"
														 HorizontalAlignment="Right"
									           Style="{StaticResource TreatmentTextStyle}"/>
                <TextBlock Grid.Column="1"
									           Text=" of "
									           Style="{StaticResource TreatmentTextStyle}"/>
                <TextBlock Grid.Column="2"
									           Text="{Binding TotalTreatmentNumber}"
									           Style="{StaticResource TreatmentTextStyle}"/>
              </Grid>
            </Grid>
            <Button Grid.Column="2" 
                    Style="{StaticResource RightArrowButtonStyle_}" 
                    Command="{Binding AblationNumberForwardCommand}"
                    Visibility="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource BoolToVisibilityNewConverter_}}"/>
          </Grid>
        </Grid>
      </Border>
    </Grid>

    <!-- Fourth Row: Home Panel, to be defined in Home Page -->
    <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="5"/>

  </Grid>

</local:CryoTherapyChartViewBase>