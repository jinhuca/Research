                      <MultiBinding Converter="{StaticResource GasLevelConverter_}" ConverterParameter="Ablation">
                        <Binding Path="LC1Reading"/>
                        <Binding Path="DASBalloonEnabled"/>
                        <Binding Path="IsLowFlowActivated"/>
                        <Binding Path="RequiredAblationTime"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Row="0" Grid.Column="1" Text="abl" 
                               Margin="0,0,0,5" 
                               Style="{StaticResource TankDetailsTextBlockStyle}"/>
                  <TextBlock Grid.Row="1" Grid.Column="0" 
                               HorizontalAlignment="Right" 
                               Margin="0,0,10,0" 
                               Style="{StaticResource TankDetailsTextBlockStyle}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource GasLevelConverter_}" ConverterParameter="Min">
                        <Binding Path="LC1Reading"/>
                        <Binding Path="DASBalloonEnabled"/>
                        <Binding Path="IsLowFlowActivated"/>
                        <Binding Path="RequiredAblationTime"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="min" 
                               Style="{StaticResource TankDetailsTextBlockStyle}"/>
                </Grid>
              </Grid>
              <Border Grid.Column="9" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch" 
                        Background="{StaticResource AblationInfoBorderBrush}"/>
              <Grid Grid.Column="10" Margin="30,0,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <CheckBox Grid.Row="0" 
