                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                            <TextBlock Text="IBP : "
                                         Style="{StaticResource SystemParamTitleStyle_}"/>
                            <TextBlock Text="{Binding TipOrBalloonPressureReading, Converter={StaticResource doubleToStringConverter}, ConverterParameter=TipOrBalloonPressure, Mode=OneWay}"
                                         Style="{StaticResource SystemParamValueStyle_}"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                            <TextBlock Text="OBP : "
                                         Style="{StaticResource SystemParamTitleStyle_}"/>
                            <TextBlock Text="{Binding CP2Reading, ConverterParameter=OBP, Converter={StaticResource doubleToStringConverter}, Mode=OneWay}"
                                         Style="{StaticResource SystemParamValueStyle_}"/>
                          </StackPanel>
                          <StackPanel Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                            <TextBlock Text="PSP : "
                                         Style="{StaticResource SystemParamTitleStyle_}"/>
                            <TextBlock Text="{Binding PressureSetPoint, ConverterParameter=OBP, Converter={StaticResource doubleToStringConverter}, Mode=OneWay}"
                                         Style="{StaticResource SystemParamValueStyle_}"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                            <TextBlock Text="BDI : "
                                         Style="{StaticResource SystemParamTitleStyle_}"/>
                            <TextBlock Text="{Binding BloodDetecorImValue, ConverterParameter=BloodDetecorImValue, Converter={StaticResource doubleToStringConverter}, Mode=OneWay}"
                                         Style="{StaticResource SystemParamValueStyle_}"/>
                          </StackPanel>
                        </Grid>
                      </Grid>
                    </DataTemplate>
                  </ContentControl.Resources>
                </ContentControl>
              </Grid>

              <Grid Grid.Column="8" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <Viewbox  Grid.Row="0" Grid.RowSpan="2" 
                            Stretch="Uniform" 
                            Height="100" 
                            HorizontalAlignment="Center" 
                            Margin="10,0,30,16">
                  <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
                    <ProgressBar Orientation="Vertical" 
                                   Style="{StaticResource TankFillMeterStyle}" 
                                   IsIndeterminate="False" 
                                   Minimum="0" 
                                   Maximum="100" 
                                   Value="{Binding LC1Reading, Converter={StaticResource weightToLevelConverter}}" 
                                   Width="16" Height="70"/>
