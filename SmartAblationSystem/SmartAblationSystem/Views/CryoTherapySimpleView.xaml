                          <TextBlock Text="{Binding PT2Reading, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=WithoutDecimalsPsig}"
                                       Style="{StaticResource PressureFlowValueStyle_}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                          <TextBlock Text="Flow : "
                                       Style="{StaticResource PressureFlowTextStyle_}"/>
                          <TextBlock Text="{Binding FM1Reading, Converter={StaticResource stringTodoubleConverter}}"
                                       Style="{StaticResource PressureFlowValueStyle_}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                    <DataTemplate x:Key="SimpleBSCDataTemplate_">
                      <Grid Margin="30,20,0,20"
                              DataContext="{Binding RelativeSource={RelativeSource AncestorType=ContentControl},Path=DataContext}">
                        <Grid.RowDefinitions>
                          <RowDefinition/>
                          <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                          </Grid.RowDefinitions>
                          <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Pressure : "
                                         Style="{StaticResource PressureFlowTextStyle_}"/>
                            <TextBlock Text="{Binding PT2Reading, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=WithoutDecimalsPsig}"
                                         Style="{StaticResource PressureFlowValueStyle_}"/>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock Text="Flow : "
                                         Style="{StaticResource PressureFlowTextStyle_}"/>
                            <TextBlock Text="{Binding FM1Reading, Converter={StaticResource stringTodoubleConverter}}"
                                         Style="{StaticResource PressureFlowValueStyle_}"/>
                          </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1">
                          <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                          </Grid.ColumnDefinitions>
