                        <Binding Path="IsBloodPressureSettingsPopupShow" />
                        <Binding Path="IsSimpleTherapyViewVisible" />
                      </MultiBinding>
                    </Popup.IsOpen>
                    <local:OcclusionPressureSettingsView DataContext="{Binding .}"/>
                  </Popup>

                </Grid>
              </Grid>
            </Grid>
          </Border>

          <!-- Ablation Panel -->
          <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" 
                  CornerRadius="0,0, 10,10" 
                  Background="{StaticResource DetailPanelBackgroundBrush}" 
                  BorderBrush="{StaticResource AblationInfoBorderBrush}" 
                  BorderThickness="0,3,0,0">
            <Grid HorizontalAlignment="Stretch" 
                  VerticalAlignment="Stretch">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="0.9*"/>
                <ColumnDefinition Width="2"/>
                <ColumnDefinition Width="0.74*"/>
              </Grid.ColumnDefinitions>

              <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="2.4*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="MIN TEMP" 
                           Style="{StaticResource SystemInfoTitleTextBlockStyle_}"/>
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0">
                    <TextBlock Style="{StaticResource SystemInfoValueTextBlockStyle_}">
                      <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource booleanAndStateToTextValueConverter}" ConverterParameter="VerifyState">
                          <Binding Path="IsCatheterCableConnected" />
                          <Binding Path="SystemState" />
                          <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                          <Binding Path="MaxTemperatureRate"/>
                        </MultiBinding>
                      </TextBlock.Text>
                    </TextBlock>
                  </Grid>
                  <TextBlock Grid.Column="1" 
                             Text="°C" 
                             Style="{StaticResource SystemInfoUnitTextBlockStyle_}"/>
                </Grid>
              </Grid>

              <Grid Grid.Column="1" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="2.4*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            VerticalAlignment="Bottom">
                  <TextBlock Text="COOLING TIME TO"
                    Style="{StaticResource SystemInfoTitleTextBlockStyle_}"/>
                  <TextBlock Style="{StaticResource SystemInfoValueWhiteTextBlockStyle_}">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{} {0}°C" Converter="{StaticResource coolingTimeTextConverter}">
                        <Binding Path="IsCatheterCableConnected" />
                        <Binding Path="RequiredTargetTemperatureBinding" />
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                </StackPanel>
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" HorizontalAlignment="Center"
                             Style="{StaticResource SystemInfoValueTextBlockStyle_}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource thawTimeToStringTimeToTargetTemperatureAndVeinIsolationDuration}">
                        <Binding Path="TimeToTargetTemperature"/>
                        <Binding Path="IsTargetTemperatureReached"/>
                        <Binding Path="SystemState"/>
                        <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" 
                             Text="sec" 
                             Style="{StaticResource SystemInfoUnitTextBlockStyle_}"/>
                </Grid>
              </Grid>

              <Grid Grid.Column="2" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="2.4*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="TTI" 
                           Style="{StaticResource SystemInfoTitleTextBlockStyle_}"/>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" 
                             Style="{StaticResource TiiValueTextBlockStyle_}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource thawTimeToStringTimeToTargetTemperatureAndVeinIsolationDuration}">
                        <Binding Path="VeinIsolationDuration"/>
                        <Binding Path="IsVeinIsolated"/>
                        <Binding Path="SystemState"/>
                        <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" 
                             Text="sec"
                             Style="{StaticResource TiiUnitTextBlockStyle_}"/>
                </Grid>
              </Grid>

              <Grid Grid.Column="3" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="2.4*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="TEMP @ TTI" 
                           Style="{StaticResource SystemInfoTitleTextBlockStyle_}"/>
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" 
                             Style="{StaticResource SystemInfoValueTextBlockStyle_}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource TTIValueConverter_}">
                        <Binding Path="TEMPTTI"/>
                        <Binding Path="IsVeinIsolated"/>
                        <Binding Path="SystemState"/>
                        <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" 
                             Text="°C"
                             Style="{StaticResource SystemInfoUnitTextBlockStyle_}"/>
                </Grid>
              </Grid>

              <Grid Grid.Column="4" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="2.4*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="TIME SINCE TTI" 
                           Style="{StaticResource SystemInfoTitleTextBlockStyle_}"/>
                <Grid Grid.Row="1" HorizontalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" 
                             Style="{StaticResource SystemInfoValueTextBlockStyle_}">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource timeTTIConverter}">
                        <Binding Path="IsCatheterCableConnected"/>
                        <Binding Path="CryoTherapyTime"/>
                        <Binding Path="VeinIsolationDuration"/>
                        <Binding Path="SystemState"/>
                        <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                        <Binding Path="TimeInAblationMax"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" 
                             Text="sec" 
                             Style="{StaticResource SystemInfoUnitTextBlockStyle_}"/>
                </Grid>
              </Grid>

              <Grid Grid.Column="5" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="2.4*"/>
                </Grid.RowDefinitions>
