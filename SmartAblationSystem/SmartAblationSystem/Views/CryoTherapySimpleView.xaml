                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" 
                             Text="OCCLUSION PRESSURE mmHg"
                             HorizontalAlignment="Left" 
                             VerticalAlignment="Top" 
                             Margin="90, 0, 0, 0" 
                             Style="{StaticResource AblationSubTitleStyle}"/>
                  <Button Grid.Column="1" x:Name="BloodPressureSettingsButton" Margin="0,0,50,0" 
                          Style="{StaticResource OcclusionPressureButtonStyle_}" 
