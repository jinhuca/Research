<local:CryoTherapyChartViewBase x:Class="SmartAblationSystem.Views.CryoTherapySimpleView"
                                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                                xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
                                xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
                                xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
                                xmlns:convertersNew="clr-namespace:SmartAblationSystem.ConvertersNew"
                                xmlns:local="clr-namespace:SmartAblationSystem.Views"
                                xmlns:constants="clr-namespace:SmartAblationSystem"
                                xmlns:selectors="clr-namespace:SmartAblationSystem.Selectors"
                                xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
                                mc:Ignorable="d"
                                SnapsToDevicePixels="True"
                                d:DesignHeight="1000" d:DesignWidth="1920" d:DataContext="{d:DesignData}"
                                Height="1000" Width="1920"
                                Loaded="CryoTherapySimpleView_Loaded"
                                Unloaded="UserControl_Unloaded"
                                IsVisibleChanged="CryoTherapySimpleView_OnIsVisibleChanged">
  <UserControl.Resources>
    <selectors:SimpleSystemInfoDataTemplateSelector x:Key="SimpleSystemInfoDataTemplateSelector_"/>
    <convertersNew:BoolToStringConverter x:Key="BoolToStringConverter_"/>
    <convertersNew:BoolReverseConverter x:Key="BoolReverseConverter_"/>
    <convertersNew:BoolToVisibilityConverter x:Key="BoolToVisibilityNewConverter_"/>
    <convertersNew:LowFlowEnableConverter x:Key="LowFlowEnableConverter_"/>
    <converters:StateAndBooleanToEnableConverter x:Key="stateAndBooleanToEnableConverter"/>
    <convertersNew:PlaybackAblationTimeVisibilityConverter x:Key="PlaybackAblationTimeVisibilityConverter_"/>
    <convertersNew:PlaybackTotalThawingTimeVisibilityConverter x:Key="PlaybackTotalThawingTimeVisibilityConverter_"/>
    <convertersNew:SystemStateAndAlertStateToColorConverter x:Key="StateAndAlertStateToColorConverter_" />
    <convertersNew:SystemStateAndAlertsToFlashStateConverter x:Key="StateAndAlertsToFlashStateConverter_" />
    <convertersNew:SystemStateToBoolConverter x:Key="SystemStateToBoolConverter_"/>
    <convertersNew:SystemStateToEnabledConverter x:Key="SystemStateToEnabledConverter_"/>
    <convertersNew:CatheterConnectionConverter x:Key="CatheterConnectionConverter_"/>
    <convertersNew:TTIValueConverter x:Key="TTIValueConverter_"/>
    <convertersNew:SystemStateToVisibilityConverter x:Key="StateToVisibleConverter_"/>
    <convertersNew:AblationTimeTitleConverter x:Key="AblationTimeTitleConverter_"/>
    <convertersNew:PlaybackBorderOpacityConverter x:Key="PlaybackVisibilityConverter_"/>
    <convertersNew:EmptyAblationTimeConverter x:Key="emptyConverter"/>
    <convertersNew:PlaybackTimeConverter x:Key="PlaybackTimeConverter"/>
    <convertersNew:PlaybackTimeTitleVisibilityConverter x:Key="PlaybackTimeTitleVisibilityConverter"/>
    <convertersNew:GasLevelConverter x:Key="GasLevelConverter_"/>
    <convertersNew:AblationStateToEnabledConverter x:Key="AblationStateToEnabledConverter"/>
    <converters:GasSateToColor x:Key="gasSateToColor" />
    <converters:WeightToLevelConverter x:Key="weightToLevelConverter" />
    <converters:BooleanToStringConverter x:Key="booleanToStringConverter" />
    <converters:DiaphragmMovementToStringConverter x:Key="diaphragmMovementToStringConverter"/>
    <converters:IntToPercentageConverter x:Key="intToPercentageConverter" />
    <converters:AblationSiteToStringConverter x:Key="ablationSiteToStringConverter"/>
    <converters:AblationSummaryToString x:Key="ablationSummaryToString"/>
    <converters:BooleanAndStateToVisibilityConverter x:Key="booleanAndStateToVisibilityConverter"/>
    <converters:BooleanAndStateToNotVisibilityConverter x:Key="booleanAndStateToNotVisibilityConverter"/>
    <converters:ThawTimeToStringTimeToTargetTemperatureAndVeinIsolationDuration x:Key="thawTimeToStringTimeToTargetTemperatureAndVeinIsolationDuration"/>
    <converters:StateToVisibilityConverter x:Key="stateToVisibility" />
    <converters:StateToEnableConverter x:Key="stateToEnable" />
    <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter" />
    <converters:BooleanAndStateToTextValueConverter x:Key="booleanAndStateToTextValueConverter" />
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>
    <converters:CoolingTimeTextConverter x:Key="coolingTimeTextConverter"/>
    <converters:StateToEnableConverter x:Key="StateToEnableConverter"/>
    <converters:PWReverseVisibilityConverter x:Key="pwvReverseConverter"/>
    <converters:PWVisibilityConverter x:Key="pwvConverter"/>
    <converters:PatientNameVisibilityConverter x:Key="patientNameVisibilityConverter"/>
    <converters:PatientStyleVisibilityConverter x:Key="patientStyleVisibilityConverter"/>
    <converters:ProcedureToStringConverter x:Key="procedureToStringConverter"/>
    <converters:StringToMaskConverter x:Key="stringMaskConverter"/>
    <converters:DateTimeToStringConverter x:Key="dateTimeToStringConverter" />
    <converters:StringToIntConverter x:Key="stringToIntConverter"/>
    <converters:CryoTherapyTimeConverter x:Key="cryoTherapyTimeConverter"/>
    <converters:StringTodoubleConverter x:Key="stringTodoubleConverter"/>
    <converters:NumberOfTreatmentsAndStateToEnableConverter x:Key="numberOfTreatmentsAndStateToEnableConverter"/>
    <converters:TTIStatusConverter x:Key="ttiStatusConverter"/>
    <converters:TimeTTIConverter x:Key="timeTTIConverter"/>
    <converters:BooleanToOpacityConverter x:Key="booleanToOpacityConverter" />
    <converters:StateAndTimeToVisibilityConverter x:Key="stateAndTimeToVisibilityConverter" />
    <converters:StatesAndBalloonToPictuersConverter x:Key="statesAndBalloonToPictuersConverter" />
    <converters:DoubleToStringConverter x:Key="doubleToStringConverter" />
    <converters:CryoTherapyViewPopIsOpenConverter x:Key="cryoTherapyViewPopIsOpenConverter" />
    <converters:ShortToRefrigerantUnitConverter x:Key="shortToRefrigerantUnitConverter"/>
    <converters:CatheterIDToName x:Key="catheterIDToName"/>

  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="60"/>
      <RowDefinition Height="840"/>
      <RowDefinition Height="120"/>
      <RowDefinition Height="60"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="132"/>
      <ColumnDefinition Width="1475"/>
      <ColumnDefinition Width="313"/>
    </Grid.ColumnDefinitions>
    <!-- First Row: Title -->
    <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" 
            CornerRadius="8" Margin="0,0">
      <Grid Margin="20,0,0,0" 
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="850"/>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="160"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="400"/>
          </Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                      Margin="0,0,0,0">
            <TextBlock Text="{Binding CatheterType, Converter={StaticResource catheterIDToName}, ConverterParameter=CatheterDescriptionSplit}" 
                       Margin="23,10,0,0" 
                       Style="{StaticResource TitleTextBlockStyle}"/>
            <TextBlock Text="{Binding CatheterType, Converter={StaticResource catheterIDToName}, ConverterParameter=CatheterDescriptionTM}" 
                       Margin="2,12,0,0" 
                       Style="{StaticResource TradeMarkTextBlockStyle_}"/>
            <TextBlock Text="{Binding CatheterType, Converter={StaticResource catheterIDToName}, ConverterParameter=CatheterDescription}"
                       Margin="12,10,0,0"
                       Style="{StaticResource  CatheterTypeTextBlockStyle_}"/>
          </StackPanel>
          <Border Grid.Column="1" 
                  Style="{StaticResource TestCatheterInformationBorderStyle_}"
                  Visibility="{Binding IsUsedForEngineering, Converter={StaticResource booleanToVisibilityConverter}}">
            <Grid Width="342" Height="40">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Image Grid.Column="0" 
                     Style="{StaticResource TestCatheterImageStyle_}"/>
              <TextBlock Grid.Column="1"
                         Style="{StaticResource TestCatheterTextBlockStyle_}"/>
            </Grid>
          </Border>
        </Grid>
        <Grid Grid.Column="1" 
              HorizontalAlignment="Right" 
              VerticalAlignment="Center" 
              Margin="0,10,20,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="55"/>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" Grid.ColumnSpan="2"
		          x:Name="PatientNameCheckBox" 
		          HorizontalAlignment="Center"
		          IsChecked="{Binding IsPatientNameVisible}">
            <CheckBox.Style>
              <Style TargetType="CheckBox">
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                      <StackPanel Orientation="Horizontal" Background="Transparent" Width="150" Height="50">
                        <Image x:Name="checkBoxImage" 
												       Height="22" 
                       Margin="20,0,0,0"
												       Source="../Images/ShowInfo.png"/>
                        <ContentPresenter/>
                        <TextBlock Grid.Column="1" 
                            Text="PATIENT:"
									          Margin="10,0,0,0"
                            Style="{StaticResource InfoTextBlockStyle}"/>
                      </StackPanel>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                          <Setter TargetName="checkBoxImage" Property="Source" Value="../Images/HideInfo.png"/>
                          <Setter TargetName="checkBoxImage" Property="Height" Value="26"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
            </CheckBox.Style>
          </CheckBox>
          <TextBlock Grid.Column="2" 
            x:Name="patientMask">
            <TextBlock.Style>
              <MultiBinding Converter="{StaticResource patientStyleVisibilityConverter}">
                <Binding ElementName="PatientNameCheckBox" Path="IsChecked" />
                <Binding Source="{StaticResource InfoTextBlockStyle}" />
                <Binding Source="{StaticResource MaskTextBlockStyle}" />
              </MultiBinding>
            </TextBlock.Style>
            <TextBlock.Text>
              <MultiBinding Converter="{StaticResource patientNameVisibilityConverter}" ConverterParameter="FULLNAME">
                <Binding Path="CurrentPatient"/>
                <Binding ElementName="PatientNameCheckBox" Path="IsChecked"/>
              </MultiBinding>
            </TextBlock.Text>
          </TextBlock>
        </Grid>
        <Grid Grid.Column="2" 
              VerticalAlignment="Center" 
              Margin="20,10,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="120"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="35"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.ColumnSpan="3" 
           Style="{StaticResource InfoTextBlockStyle}"
           Text="{Binding InBodyTime, StringFormat='In body time:  {0}  min'}"/>
        </Grid>
        <Grid Grid.Column="3" 
              VerticalAlignment="Center" 
              Margin="0,10,30,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.ColumnSpan="2" 
           Style="{StaticResource InfoTextBlockStyle}"
           Text="{Binding CurrentTime, Converter={StaticResource dateTimeToStringConverter}, StringFormat='Time:  {0}'}"/>
        </Grid>
      </Grid>
    </Border>

    <!-- Second Row, First Column: Control Panel -->
    <Grid Grid.Row="1" Grid.Column="0" Margin="25,10,6,14">
      <Border Background="{StaticResource TherapyControlPanelBackground}"
				        CornerRadius="12"
				        Margin="12,0,4,0">
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.2*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <StackPanel Grid.Row="0">
            <Button Visibility="{Binding SystemState, ConverterParameter=ABLATION_SITE, Converter={StaticResource stateToVisibility}}"
							        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_SITE, Converter={StaticResource stateToEnable}}"
							        Command="{Binding AblationSiteCommand}" 
                      Background="Transparent">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource HeartSiteButtonStyle_}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsAblationSiteChanged}" Value="True">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard Name="_flashStoryboard" Storyboard="{StaticResource ButtonFlashStoryboard}" />
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="_flashStoryboard" />
                      </DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <Button.Content>
                <StackPanel>
                  <Image Style="{StaticResource HeartImageStyle_}"/>
                  <TextBlock Text="{Binding AblationSite, Converter={StaticResource ablationSiteToStringConverter}, Mode=OneWay}"
                           Style="{StaticResource HeartSiteTextBlockStyle}" TextAlignment="Center" Height="40" Width="80"/>
                </StackPanel>
              </Button.Content>
            </Button>
          </StackPanel>
          <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Visibility="{Binding IsSystemUsingDASBalloon, Converter={StaticResource booleanToVisibilityConverter}}">
            <Button Style="{StaticResource PlusBalloonButtonStyle_}" 
                      Command="{Binding EnableDASBallonCommand}" Height="60" Width="80"
                      Visibility="{Binding IsBalloonRampDownActivated, Converter={StaticResource booleanToNotVisibilityConverter}}"/>
            <Button Style="{StaticResource MinusBalloonButtonStyle_}"
                      Command="{Binding EnableDASBallonCommand}" Height="60" Width="80"
                      Visibility="{Binding IsBalloonRampDownActivated, Converter={StaticResource booleanToVisibilityConverter}}"/>
          </Grid>
          <Grid Grid.Row="2">
            <Button x:Name="VeinIsolationButton" 
                    IsEnabled="{Binding IsIsolatingVein}" Width="80" Height="115" Padding="0,-20,0,0"
                    Visibility="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource booleanToNotVisibilityConverter}, ConverterParameter=HIDDEN}" 
                    Style="{StaticResource TTIIconButtonStyle_}">
              <TextBlock Style="{StaticResource TTITextBlockStyle_}" Padding="0,20,0,0">
                <TextBlock.Text>
                  <MultiBinding Converter="{StaticResource ttiStatusConverter}">
                    <Binding Path="VeinIsolationDuration"/>
                    <Binding Path="SystemState"/>
                    <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Button>
            <Button x:Name="UpdateVeinIsolationButton" Width="80" Height="80"
                    IsEnabled="{Binding IsTreatmentNumberAndPlayBackVisible}" 
                    Command="{Binding UpdateVeinIsolationDurationCommand}" 
                    Visibility="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=HIDDEN}" 
                    Style="{StaticResource TTIIconButtonStyle_}"/>

          </Grid>

          <Button Grid.Row="3" FocusVisualStyle="{x:Null}"
                  Visibility="{Binding SystemState, ConverterParameter=TREATMENT_NOTES, Converter={StaticResource stateToVisibility}}"
                  Command="{Binding TreatmentNotesCommand}" Height="60" Width="80"
                  Style="{StaticResource NoteIconButtonStyle_}">
            <Button.IsEnabled>
              <MultiBinding Converter="{StaticResource numberOfTreatmentsAndStateToEnableConverter}" ConverterParameter="VerifyState">
                <Binding Path="SystemState"/>
                <Binding Path="TotalTreatmentNumber"/>
                <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
              </MultiBinding>
            </Button.IsEnabled>
          </Button>
          <Button Grid.Row="4" 
                  Command="{Binding NotificationsCommand}" Height="60" Width="80"
                  Visibility="{Binding SystemState, ConverterParameter=TARGET_TEMPERATURE, Converter={StaticResource stateToVisibility}}"
                  IsEnabled="{Binding SystemState, ConverterParameter=TARGET_TEMPERATURE, Converter={StaticResource stateToEnable}}"
                  Style="{StaticResource SettingsIconButtonStyle_}" FocusVisualStyle="{x:Null}"/>
          <CheckBox Grid.Row="5" 
                    Style="{StaticResource FootSwitchControlStyle_}" Height="60" Width="80"
                    IsChecked="{Binding LockTheFootSwitch, Converter={StaticResource BoolReverseConverter_}}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
          <Button Grid.Row="6" 
                  Style="{StaticResource LowFlowButtonStyle_}"  Height="60" Width="80"
                  Visibility="{Binding IsUsingLowFlow, Converter={StaticResource BoolToVisibilityNewConverter_}}"
                  Command="{Binding ActivateLowFlowCommand}">
            <Button.IsEnabled>
              <MultiBinding Converter="{StaticResource LowFlowEnableConverter_}">
                <Binding Path="IsUsingLowFlow"/>
                <Binding Path="AllowUserToActivateLowFlow"/>
                <Binding Path="IsLowFlowActivated"/>
              </MultiBinding>
            </Button.IsEnabled>
          </Button>
        </Grid>
      </Border>
    </Grid>
    
    <!-- Second Row, Second Column: Main Panel -->
    <Grid Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="9,7,37,9">
      <Border x:Name="_mainBorder"
              Background="{StaticResource TherapyControlPanelBackground}" 
              BorderThickness="5" 
              CornerRadius="8" 
              Margin="1">
        <Border.BorderBrush>
          <SolidColorBrush Opacity="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource PlaybackVisibilityConverter_}}">
            <SolidColorBrush.Color>
              <MultiBinding Converter="{StaticResource StateAndAlertStateToColorConverter_}">
                <Binding Path="SystemState"/>
                <Binding Source="{StaticResource BooleanFalse}"/>
                <Binding Source="{StaticResource BooleanFalse}"/>
              </MultiBinding>
            </SolidColorBrush.Color>
          </SolidColorBrush>
        </Border.BorderBrush>
        <Border.Effect>
          <DropShadowEffect Color="{Binding ElementName=_mainBorder, Path=BorderBrush.Color}" 
                            ShadowDepth="0" 
                            BlurRadius="40" 
                            RenderingBias="Performance" 
                            Opacity="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource PlaybackVisibilityConverter_}}"
                            Direction="0"/>
        </Border.Effect>
        <Border.Style>
          <Style>
            <Style.Triggers>
              <DataTrigger Value="True">
                <DataTrigger.Binding>
                  <MultiBinding Converter="{StaticResource StateAndAlertsToFlashStateConverter_}">
                    <Binding Path="SystemState"/>
                    <Binding Path="DiaphragmAmplitudeThresholdReached"/>
                    <Binding Path="IsEsophagusTemperatureConditionAlertsMeet"/>
                    <Binding Path="EnabaleEnhancedAudio" />
                  </MultiBinding>
                </DataTrigger.Binding>
                <DataTrigger.EnterActions>
                  <BeginStoryboard Storyboard="{StaticResource FlashBorderStoryboard}"/>
                </DataTrigger.EnterActions>
                <DataTrigger.ExitActions>
                  <BeginStoryboard Storyboard="{StaticResource StopFlashBorderStoryboard}"/>
                </DataTrigger.ExitActions>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Grid Margin="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="92"/>
            <RowDefinition Height="543"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <!-- Status Panel -->
          <Grid Grid.Row="0" Grid.Column="1"
                Margin="60,0,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" 
                       Text="STATUS :" 
                       HorizontalAlignment="Left" Margin="30,0,0,0" 
                       Style="{StaticResource StateIndicatorTextStyle}"/>
            <Border Grid.Column="1" 
                    Height="2" Width="900" 
                    Margin="0,1,0,0" 
                    Background="{StaticResource AblationInfoBorderBrush}"/>
            <Grid Grid.Column="1" 
                  VerticalAlignment="Center" 
                  HorizontalAlignment="Left">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="215"/>
                <ColumnDefinition Width="215"/>
              </Grid.ColumnDefinitions>
              <ContentControl Grid.Column="0" 
                              IsEnabled="{Binding SystemState, Converter={StaticResource SystemStateToBoolConverter_}, ConverterParameter={x:Static constants:UIConstants.IdleState}}" 
                              Style="{StaticResource IdleStateIndicatorStyle_}"/>
              <ContentControl Grid.Column="1" 
                              IsEnabled="{Binding SystemState, Converter={StaticResource SystemStateToBoolConverter_}, ConverterParameter={x:Static constants:UIConstants.ReadyState}}" 
                              Style="{StaticResource ReadyStateIndicatorStyle_}"/>
              <ContentControl Grid.Column="2" 
                              IsEnabled="{Binding SystemState, Converter={StaticResource SystemStateToBoolConverter_}, ConverterParameter={x:Static constants:UIConstants.InflationState}}" 
                              Style="{StaticResource InflationIndicatorStyle_}"/>
              <ContentControl Grid.Column="3" 
                              IsEnabled="{Binding SystemState, Converter={StaticResource SystemStateToBoolConverter_}, ConverterParameter={x:Static constants:UIConstants.AblationState}}" 
                              Style="{StaticResource AblationIndicatorStyle_}"/>
              <ContentControl Grid.Column="4" 
                              IsEnabled="{Binding SystemState, Converter={StaticResource SystemStateToBoolConverter_}, ConverterParameter={x:Static constants:UIConstants.ThawingState}}" 
                              Style="{StaticResource ThawingIndicatorStyle_}"/>
            </Grid>
            <ContentControl Grid.Column="1" 
                            Style="{StaticResource SimpleViewPlaybackIndicatorStyle_}" 
                            Visibility="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource booleanToVisibilityConverter}}"/>
          </Grid>

          <!-- Ablation Temperature and Time -->
          <Grid Grid.Row="1" Grid.Column="0"
                x:Name="GridTemperatureAblationTime">
            <Grid.RowDefinitions>
              <RowDefinition Height="40"/>
              <RowDefinition Height="110"/>
              <RowDefinition Height="70"/>
              <RowDefinition Height="80"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" 
                       Text="TEMPERATURE" 
                       Style="{StaticResource TemperatureTextBlockStyle}"/>
            <Grid Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" 
                         Text="{Binding TC1Reading, Converter={StaticResource stringToIntConverter}}" 
                         Style="{StaticResource TemperatureValueStyle}"/>
              <TextBlock Grid.Column="1" 
                         Text="°C" 
                         Style="{StaticResource TemperatureUnitStyle}"/>
            </Grid>
            <Grid Grid.Row="2">
              <Grid.Visibility>
                <MultiBinding Converter="{StaticResource booleanAndStateToNotVisibilityConverter}" ConverterParameter="OcclusionPressureInflationShow">
                  <Binding Path="SystemState"/>
                  <Binding Path="EnabledIsBloodPressureSensorConnected"/>
                  <Binding Path="IsMonitoringBloodPressure"/>
                </MultiBinding>
              </Grid.Visibility>
              <TextBlock Text="ABLATION TIME" 
                         Style="{StaticResource AblationTimeTitleStyle}">
                <TextBlock.Visibility>
                  <MultiBinding Converter="{StaticResource AblationTimeTitleConverter_}" 
                                ConverterParameter="ABLATION">
                    <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                    <Binding Path="SystemState"/>
                  </MultiBinding>
                </TextBlock.Visibility>
              </TextBlock>
              <TextBlock Text="THAWING TIME" 
                         Style="{StaticResource AblationTimeTitleStyle}">
                <TextBlock.Visibility>
                  <MultiBinding Converter="{StaticResource AblationTimeTitleConverter_}" 
                                ConverterParameter="THAWING">
                    <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                    <Binding Path="SystemState"/>
                  </MultiBinding>
                </TextBlock.Visibility>
              </TextBlock>
            </Grid>

            <!-- Playback Information -->
            <Grid Grid.Row="2" Grid.RowSpan="2" 
                  Visibility="{Binding IsTreatmentNumberAndPlayBackVisible, Converter={StaticResource booleanToVisibilityConverter}}">
              <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="80"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel.Visibility>
                  <MultiBinding Converter="{StaticResource PlaybackTimeTitleVisibilityConverter}" 
                                ConverterParameter="ABLATION">
                    <Binding Path="CryoTherapyTime"/>
                    <Binding Path="TemporaryManualAblationTime"/>
                    <Binding Path="ActualAblationTime"/>
                  </MultiBinding>
                </StackPanel.Visibility>
                <TextBlock Text="ABLATION TIME" 
                           FontWeight="Bold"
                           Style="{StaticResource AblationTimeTitleStyle}"/>
                <TextBlock Text=" / SET TIMER"
                           Style="{StaticResource TotalTimeTextBlockStyle_}"/>
              </StackPanel>
              <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
                <StackPanel.Visibility>
                  <MultiBinding Converter="{StaticResource PlaybackTimeTitleVisibilityConverter}" 
                                ConverterParameter="THAWING">
                    <Binding Path="CryoTherapyTime"/>
                    <Binding Path="TemporaryManualAblationTime"/>
                    <Binding Path="ActualAblationTime"/>
                  </MultiBinding>
                </StackPanel.Visibility>
                <TextBlock Text="THAW TIME"
                           FontWeight="Bold"
                           Style="{StaticResource AblationTimeTitleStyle}"/>
                <TextBlock Text=" / TOTAL THAW TIME"
                           Style="{StaticResource TotalTimeTextBlockStyle_}"/>
              </StackPanel>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Style="{StaticResource AblationTimeValueStyle}">
                  <TextBlock.Text>
                    <MultiBinding Converter="{StaticResource PlaybackTimeConverter}">
                      <Binding Path="CryoTherapyTime"/>
                      <Binding Path="TemporaryManualAblationTime"/>
                      <Binding Path="ActualAblationTime"/>
                      <Binding Path="ThawingElapsedTime"/>
                    </MultiBinding>
                  </TextBlock.Text>
                </TextBlock>
              </Grid>
            </Grid>
            <Grid Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Grid.Visibility>
                <MultiBinding Converter="{StaticResource emptyConverter}">
                  <Binding Path="SystemState"/>
                  <Binding Path="EnabledIsBloodPressureSensorConnected"/>
                  <Binding Path="IsMonitoringBloodPressure"/>
                </MultiBinding>
              </Grid.Visibility>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" HorizontalAlignment="Center"
                         Text="-" Margin="0,0,20,16"
                         Style="{StaticResource TemperatureValueStyle}"/>
            </Grid>
            <Grid Grid.Row="3" Margin="0,0,20,0">
              <Grid.Visibility>
                <MultiBinding Converter="{StaticResource booleanAndStateToNotVisibilityConverter}" ConverterParameter="OcclusionPressureInflationShow">
                  <Binding Path="SystemState"/>
                  <Binding Path="EnabledIsBloodPressureSensorConnected"/>
                  <Binding Path="IsMonitoringBloodPressure"/>
                </MultiBinding>
              </Grid.Visibility>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
