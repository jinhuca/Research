                </Viewbox>
                <Grid Grid.Row="0" Grid.Column="1" 
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" 
                               HorizontalAlignment="Right" 
                               Style="{StaticResource TankValueTextBlockStyle}" Margin="-10,0,5,0">
                    <TextBlock.Text>
                      <MultiBinding Converter="{StaticResource GasLevelConverter_}" ConverterParameter="Weight">
                        <Binding Path="LC1Reading"/>
                        <Binding Path="DASBalloonEnabled"/>
                        <Binding Path="IsLowFlowActivated"/>
                        <Binding Path="RequiredAblationTime"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" 
                             Text="{Binding RefrigerantLevelUnit, Converter={StaticResource shortToRefrigerantUnitConverter}, ConverterParameter=NewUI}" 
                             HorizontalAlignment="Left" 
                             Margin="-9,0,0,0" 
                             Style="{StaticResource TankValueTextBlockStyle}"/>
