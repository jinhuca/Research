                      <MultiBinding Converter="{StaticResource thawTimeToStringTimeToTargetTemperatureAndVeinIsolationDuration}">
                        <Binding Path="TimeToThawTemperature"/>
                        <Binding Path="IsThawTemperatureReached"/>
                        <Binding Path="SystemState"/>
                        <Binding Path="IsTreatmentNumberAndPlayBackVisible"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <TextBlock Grid.Column="1" 
                               Text="sec"
                               Style="{StaticResource SystemInfoUnitTextBlockStyle_}"/>
                </Grid>
              </Grid>
