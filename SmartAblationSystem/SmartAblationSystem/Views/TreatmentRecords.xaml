                          </Grid>
                        </ControlTemplate>
                      </Button.Template>
                      <TextBlock Text="Reset filters" TextDecorations="Underline" />
                    </Button>

                  </Grid>
                  <ListView
                    x:Name="RecordsList"
                    Grid.Row="2"
                    d:SelectedIndex="0"
                    d:ItemsSource="{StaticResource data-list}"
                    ItemsSource="{Binding FilteredProcedureRecordsList, Mode=TwoWay}"
                    SelectedItem="{Binding NavigatedProcedureRecords, Mode=TwoWay}"
                    ScrollViewer.PanningMode="VerticalOnly"
                    SelectionMode="Single"
                    Style="{StaticResource sf.ListView}">
                    <ListView.Resources>
                      <Style TargetType="CheckBox" BasedOn="{StaticResource sf.ListView.CheckBox}"/>
                      <ControlTemplate
                        x:Key="order-symbol" TargetType="ContentControl">
                        <Canvas Margin="9 0 0 0" Width="7.5" Height="13">
                          <Path x:Name="top_chevron" Data="M0,3.717 3.727,0 7.453,3.727"  Fill="Transparent" Stroke="{StaticResource chevron-gray}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.5"/>
                          <Path x:Name="bot_chevron" Data="M0,0 3.727,3.727 7.453,0" Canvas.Top="9" Fill="Transparent" Stroke="{StaticResource chevron-gray}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeLineJoin="Round" StrokeThickness="1.5"/>
                        </Canvas>
                        <ControlTemplate.Triggers>
                          <DataTrigger Binding="{Binding State}" Value="{x:Static viewmodels:ColumnSortState.Ascending}">
                            <Setter TargetName="top_chevron" Property="Stroke" Value="{StaticResource val-white}"/>
                          </DataTrigger>
                          <DataTrigger Binding="{Binding State}" Value="{x:Static viewmodels:ColumnSortState.Descending}">
                            <Setter TargetName="bot_chevron" Property="Stroke" Value="{StaticResource val-white}"/>
                          </DataTrigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </ListView.Resources>
                    <ListView.View>
                      <GridView>
                        <GridViewColumn>
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Selected, Mode=TwoWay}" />
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                          <CheckBox
                            Command="{Binding SelectAllProceduresCommand}"
                            CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Mode=Self}}"
                            IsChecked="{Binding AllSelected, Mode=TwoWay}"
                            IsThreeState="True" />
                        </GridViewColumn>
                        <GridViewColumn Width="150" DisplayMemberBinding="{Binding Procedure.Id}">
                          <GridViewColumnHeader
                            Command="{Binding SortProcedureColumnCommand}"
                            CommandParameter="{Binding ProcedureID}" Margin="0,2,0,-2"
                            >
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Procedure Id"/>
                              <ContentControl DataContext="{Binding SortVisualStateManager[ProcedureID]}" Template="{StaticResource order-symbol}"/>
                            </StackPanel>
                          </GridViewColumnHeader>
                        </GridViewColumn>
                        <GridViewColumn Width="240" DisplayMemberBinding="{Binding ProcedureDate, StringFormat='MMMM dd, yyyy HH:mm:ss'}">
                          <GridViewColumnHeader
                            Command="{Binding SortProcedureColumnCommand}"
                            CommandParameter="{Binding ProcedureDate}"
                            >
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Procedure Date" />
                              <ContentControl DataContext="{Binding SortVisualStateManager[ProcedureDate]}" Template="{StaticResource order-symbol}"/>
                            </StackPanel>
                          </GridViewColumnHeader>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding PatientFirstName}" 
                                         TextTrimming="CharacterEllipsis" 
                                         HorizontalAlignment="Center"/>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                          <GridViewColumnHeader
                            Command="{Binding SortProcedureColumnCommand}"
                            CommandParameter="{Binding PatientFirstName}"
>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="First Name"/>
                              <ContentControl DataContext="{Binding SortVisualStateManager[PatientFirstName]}"  Template="{StaticResource order-symbol}"/>
                            </StackPanel>
                          </GridViewColumnHeader>
                        </GridViewColumn>
                        <GridViewColumn Width="150">
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding PatientLastName}" 
                                         TextTrimming="CharacterEllipsis" 
                                         HorizontalAlignment="Center"/>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                          <GridViewColumnHeader
                            Command="{Binding SortProcedureColumnCommand}"
                            CommandParameter="{Binding PatientLastName}"
>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Last Name"/>
                              <ContentControl DataContext="{Binding SortVisualStateManager[PatientLastName]}"  Template="{StaticResource order-symbol}"/>
                            </StackPanel>
                          </GridViewColumnHeader>
                        </GridViewColumn>
                        <GridViewColumn Width="150" >
                          <GridViewColumn.CellTemplate>
                            <DataTemplate>
                              <TextBlock Text="{Binding Patient.Physician, Converter={StaticResource physicianConverter}}"
                                         TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                          </GridViewColumn.CellTemplate>
                          <GridViewColumnHeader
                            Command="{Binding SortProcedureColumnCommand}"
                            CommandParameter="{Binding Physician}"
>
                            <StackPanel Orientation="Horizontal">
                              <TextBlock Text="Physician"/>
                              <ContentControl DataContext="{Binding SortVisualStateManager[Physician]}"  Template="{StaticResource order-symbol}"/>
                            </StackPanel>
                          </GridViewColumnHeader>
                        </GridViewColumn>
                      </GridView>
                    </ListView.View>
                  </ListView>
                </Grid>
              </Grid>
            </Border>
          </ContentControl>

        </Grid>
        <Grid Grid.Row="2">
          <!--<StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          -->
          <!--  Home Icon  -->
          <!--
            <Button Margin="11.5,19,26,0" Template="{StaticResource home-button}" />
          -->
          <!--  user manual Icon  -->
          <!--
            <Button Margin="26.5,19,26,0" Template="{StaticResource instruction-button}" />
            <Button Margin="24.8,18.5,0,0" Template="{StaticResource speakers-button}" />

          </StackPanel>-->
        </Grid>
      </Grid>
    </Grid>
    <Canvas>
      <StackPanel Style="{StaticResource HospitalLogoStackPanelOnHomeStyle_}">
        <TextBlock Text="Hospital:" 
                   Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
        <TextBlock Grid.ColumnSpan="2" 
                   Text="{Binding HospitalName}" 
                   Style="{StaticResource HospitalNameTextBlockStyle_}" />
      </StackPanel>
      <Image Style="{StaticResource LogoImageOnOthersStyle_}"/>
    </Canvas>
  </Grid>
</UserControl>
