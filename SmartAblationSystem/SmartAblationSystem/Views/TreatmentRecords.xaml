<UserControl
  x:Class="SmartAblationSystem.Views.TreatmentRecords"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:local="clr-namespace:SmartAblationSystem.Views"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:convertersNew="clr-namespace:SmartAblationSystem.ConvertersNew"
  xmlns:prism="http://prismlibrary.com/"
  xmlns:s="clr-namespace:System;assembly=mscorlib"
  Width="1920"
  Height="1000"
  ManipulationBoundaryFeedback="TreatmentRecords_OnManipulationBoundaryFeedback"
  xmlns:viewmodels="clr-namespace:SmartAblationSystem.ViewModels"
  d:DataContext="{d:DesignInstance Type=viewmodels:TreatmentRecordsViewModel}"
  d:DesignHeight="1080"
  d:DesignWidth="1920"
  prism:ViewModelLocator.AutoWireViewModel="True"
  mc:Ignorable="d">
  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
          <convertersNew:MultipleBoolToBoolConverter x:Key="MultipleBoolToBoolConverter_"/>
          <convertersNew:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter_"/>
        </ResourceDictionary>
        <ResourceDictionary x:Name="DummyData">
          <x:Array
            xmlns:dal="clr-namespace:DataAccessLayer;assembly=DataAccessLayer"
            xmlns:dd="clr-namespace:SmartAblationSystem.Models"
            x:Key="data-list"
            Type="{x:Type dd:ProcedureRecords}">
            <dd:ProcedureRecords>
              <dd:ProcedureRecords.Procedure>
                <dal:Procedure Id="1" ProcedureStartDateTime="10/10/2020" />
              </dd:ProcedureRecords.Procedure>
              <dd:ProcedureRecords.Patient>
                <dal:Patient FirstName="J" LastName="D">
                  <dal:Patient.Physician>
                    <dal:Physician FirstName="John" LastName="Doe" />
                  </dal:Patient.Physician>
                </dal:Patient>
              </dd:ProcedureRecords.Patient>
            </dd:ProcedureRecords>
            <dd:ProcedureRecords Selected="True">
              <dd:ProcedureRecords.Procedure>
                <dal:Procedure Id="2" ProcedureStartDateTime="10/10/2020" />
              </dd:ProcedureRecords.Procedure>
              <dd:ProcedureRecords.Patient>
                <dal:Patient FirstName="J2" LastName="D2">
                  <dal:Patient.Physician>
                    <dal:Physician FirstName="John" LastName="Doe" />
                  </dal:Patient.Physician>
                </dal:Patient>
              </dd:ProcedureRecords.Patient>
            </dd:ProcedureRecords>
            <dd:ProcedureRecords>
              <dd:ProcedureRecords.Procedure>
                <dal:Procedure Id="3" ProcedureStartDateTime="10/10/2020" />
              </dd:ProcedureRecords.Procedure>
              <dd:ProcedureRecords.Patient>
                <dal:Patient FirstName="J3" LastName="D3">
                  <dal:Patient.Physician>
                    <dal:Physician FirstName="John" LastName="Doe" />
                  </dal:Patient.Physician>
                </dal:Patient>
              </dd:ProcedureRecords.Patient>
            </dd:ProcedureRecords>
          </x:Array>
        </ResourceDictionary>
        <ResourceDictionary
          xmlns:cn="clr-namespace:SmartAblationSystem.ConvertersNew"
          xmlns:converters="clr-namespace:SmartAblationSystem.Converters">
          <converters:ProcedureToStringConverter x:Key="procedureToStringConverter" />
          <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
          <converters:ScaleUnitToTextConverter x:Key="scaleUnitToTextConverter" />
          <converters:ToiseUnitToTextConverter x:Key="toiseUnitToTextConverter" />
          <converters:StringToIntConverter x:Key="stringToIntConverter" />
          <converters:PhysicianFullNameConverter x:Key="physicianConverter" />
          <converters:IntToVeinIsolationConverter x:Key="intToVeinIsolationConverter" />
          <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
          <converters:DoubleToStringConverter x:Key="doubleToStringConverter" />
          <converters:CatheterIDToNameMultiBinding x:Key="catheterIDToNameMultiBinding" />
          <converters:AblationSiteToStringConverter x:Key="ablationSiteToStringConverter" />
          <converters:BalloonSizeTextConverter x:Key="balloonSizeTextConverter" />
          <cn:AblationTimeTitlePlaybackConverter x:Key="AblationTimeTitlePlaybackConverter_"/>
          <cn:AblationTimePlaybackConverter x:Key="AblationTimePlaybackConverter_"/>
          <convertersNew:NullableToStringConverter x:Key="NullableToStringConverter_"/>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>
  <Grid>
    <Grid Background="{StaticResource bg-darkgray}">
      <Grid.RowDefinitions>
        <RowDefinition />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="40" />
        <ColumnDefinition />
        <ColumnDefinition Width="40" />
      </Grid.ColumnDefinitions>
      <Grid Grid.Row="1" Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="80" />
          <RowDefinition Height="1*" />
          <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
          </Grid.ColumnDefinitions>
          <TextBlock
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Lato}"
            FontWeight="Regular"
            FontSize="24.00"
            Foreground="{StaticResource title-white}"
            Text="TREATMENT RECORDS" />
        </Grid>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="848" />
            <ColumnDefinition Width="26" />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <Grid.RowDefinitions>
              <RowDefinition Height="auto" />
              <RowDefinition Height="26" />
              <RowDefinition Height="1*" />
            </Grid.RowDefinitions>
            <ContentControl x:Name="patient_details" Grid.Row="0">
              <Border
                Width="848"
                Height="105"
                CornerRadius="10"
                Style="{StaticResource records-panel-bg-dark-shadow}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="26" />
                    <RowDefinition />
                    <RowDefinition Height="20" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="20" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.Resources>
                      <Style TargetType="{x:Type StackPanel}">
                        <Setter Property="Orientation" Value="Horizontal" />
                        <Setter Property="VerticalAlignment" Value="Top" />
                      </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="299" />
                      <ColumnDefinition Width="229" />
                      <ColumnDefinition />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="auto" />
                      <RowDefinition Height="13" />
                      <RowDefinition Height="auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Margin="10,0,0,0"
                                 Style="{StaticResource label}"
                                 Text="Patient: "/>
                      <TextBlock d:Text="Tod Jackson - this is really long name"
                                 Width="220"
                                 Style="{StaticResource DetailInfoValueStyle_}"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,0,5,0"
                                 HorizontalAlignment="Left"
                                 Text="{Binding CurrentPatient, ConverterParameter=FULLNAME, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                                 Visibility="{Binding IsDoctorGroup, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <TextBlock Margin="10,0,0,0"
                                 Style="{StaticResource label}"
                                 Text="Date of Birth: " />
                      <TextBlock d:Text="October 15, 1975"
                                 Style="{StaticResource DetailInfoValueStyle_}"
                                 Text="{Binding CurrentPatient, ConverterParameter=BIRTHDATE, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                                 Visibility="{Binding IsDoctorGroup, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1">
                      <TextBlock Style="{StaticResource label}" Text="Gender: " />
                      <TextBlock
                        d:Text="Male"
                        Style="{StaticResource patient-val}"
                        Text="{Binding CurrentPatient, ConverterParameter=GENDER, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                        Visibility="{Binding IsDoctorGroup, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="1">
                      <TextBlock Style="{StaticResource label}" Text="ID Number: " />
                      <TextBlock d:Text="9026145-32324321423"
                                 Style="{StaticResource patient-val}"
                                 Width="130"
                                 TextTrimming="CharacterEllipsis"
                                 Margin="0,0,5,0"
                                 Text="{Binding CurrentPatient, ConverterParameter=HOSPITAL_ID, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                                 Visibility="{Binding PatientIDVisible, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                      <TextBlock Style="{StaticResource label}" Text="Weight: " />
                      <TextBlock
                        d:Text="190"
                        Style="{StaticResource patient-val}"
                        Text="{Binding CurrentPatient, ConverterParameter=WEIGHT, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                        Visibility="{Binding IsDoctorGroup, Converter={StaticResource booleanToVisibilityConverter}}" />
                      <TextBlock
                        x:Name="KgLabel"
                        d:Text=" (lbs)"
                        Style="{StaticResource patient-val}"
                        Text="{Binding WeightUnit, Converter={StaticResource scaleUnitToTextConverter}}" />

                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Style="{StaticResource label}" Text="Height: " />
                      <TextBlock
                        d:Text="70"
                        Style="{StaticResource patient-val}"
                        Text="{Binding CurrentPatient, ConverterParameter=HEIGHT, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                        Visibility="{Binding IsDoctorGroup, Converter={StaticResource booleanToVisibilityConverter}}" />
                      <TextBlock
                        x:Name="CmLabel"
                        d:Text=" (in)"
                        Style="{StaticResource patient-val}"
                        Text="{Binding WeightUnit, Converter={StaticResource toiseUnitToTextConverter}}" />
                    </StackPanel>

                    <StackPanel
                      
                      Grid.Row="2"
                      Grid.Column="3"
                      Margin="0,0,5.5,0"
                      HorizontalAlignment="Right">
                      <Button x:Name="btnBMIInfo" 
                              TouchDown="ShowToolTip_Click"
                              Margin="0 0 11 0"
                              Style="{StaticResource BmiButtonStyle_}">
                        <Button.ToolTip>
                          <ToolTip Placement="Absolute" PlacementRectangle="600,230,0,0">
                            <ToolTip.Template>
                              <ControlTemplate TargetType="ToolTip">
                                <Border Margin="5,5,5,5">
                                  <Border.Effect>
                                    <DropShadowEffect Color="White"
                                                      ShadowDepth="0"
                                                      BlurRadius="10"
                                                      RenderingBias="Performance"
                                                      Opacity="1"
                                                      Direction="0"/>
                                  </Border.Effect>
                                  <Image Source="/Images/bmi.png" Width="714"/>
                                </Border>
                              </ControlTemplate>
                            </ToolTip.Template>
                          </ToolTip>
                        </Button.ToolTip>
                      </Button>

                      <TextBlock Style="{StaticResource label}" Text="BMI:" />
                      <TextBlock
                        d:Text="23"
                        Style="{StaticResource patient-val}"
                        Text="{Binding CurrentPatient, ConverterParameter=BMI, Converter={StaticResource procedureToStringConverter}, Mode=OneWay}"
                        Visibility="{Binding IsDoctorGroup, Converter={StaticResource booleanToVisibilityConverter}}" />
                    </StackPanel>
                  </Grid>
                </Grid>
              </Border>
            </ContentControl>
            <ContentControl x:Name="ablations_details" Grid.Row="2" 
                            VerticalAlignment="stretch">
              <Border
                Width="848"
                CornerRadius="10"
                Style="{StaticResource records-panel-bg-dark-shadow}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="22" />
                    <RowDefinition />
                    <RowDefinition Height="33" />
                  </Grid.RowDefinitions>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="30" />
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Row="1" Grid.Column="1">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="1*" />
                      <RowDefinition Height="auto" />
                      <RowDefinition Height="17" />
                      <RowDefinition Height="40" />
                    </Grid.RowDefinitions>
                    <ContentControl>
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="auto" />
                          <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="auto" />
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="auto" />
                          </Grid.ColumnDefinitions>
                          <Button Margin="0 0 5 0" Grid.Column="1"
                                  Command="{Binding ProcedureLogCommand}"
                                  Style="{StaticResource sf.button.datalog}">
                            <Button.Visibility>
                              <MultiBinding Converter="{StaticResource NullableToStringConverter_}" ConverterParameter="IsDataEdited">
                                <Binding Path="NavigatedProcedureRecords"/>
                                <Binding Path="NavigatedProcedureRecords.Procedure"/>
                              </MultiBinding>
                            </Button.Visibility>
                          </Button>
                          <StackPanel VerticalAlignment="Center" Grid.Column="0" Orientation="Horizontal">

                            <TextBlock Style="{StaticResource label}" Text="Tempearture:" />
                            <TextBlock d:Text="36" Style="{StaticResource patient-val}" />
                          </StackPanel>
                          <StackPanel VerticalAlignment="Center" Grid.Column="2" Orientation="Horizontal">

                            <TextBlock Style="{StaticResource label}" Text="Ablation Site:" />
                            <TextBlock
                              d:Text="OTHER" Margin="5,0,0,0"
                              Style="{StaticResource patient-val}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource NullableToStringConverter_}" ConverterParameter="AblationSite">
                                  <Binding Path="NavigatedProcedureRecords"/>
                                  <Binding Path="AblationSiteText" Converter="{StaticResource ablationSiteToStringConverter}" Mode="OneWay"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                          <StackPanel VerticalAlignment="Center" Grid.Column="3" Orientation="Horizontal">

                            <TextBlock Style="{StaticResource label}" Text="Catheter Used:" />
                            <TextBlock d:Text="POLARxFIT" Style="{StaticResource patient-val}" Margin="5,0,0,0">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource catheterIDToNameMultiBinding}">
                                  <Binding Path="CatheterType" />
                                  <Binding Path="IsUsedForEngineering" />
                                  <Binding Path="NavigatedProcedureRecords"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal">

                            <TextBlock Style="{StaticResource label}" Text="Catheter Size:" />
                            <TextBlock
                              d:Text="28" Margin="5,0,0,0"
                              Style="{StaticResource patient-val}">
                              <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource NullableToStringConverter_}" ConverterParameter="BalloonSize">
                                  <Binding Path="NavigatedProcedureRecords"/>
                                  <Binding Path="DASBalloonEnabled" Converter="{StaticResource balloonSizeTextConverter}" StringFormat="{}{0} mm}"/>
                                </MultiBinding>
                              </TextBlock.Text>
                            </TextBlock>
                          </StackPanel>
                        </Grid>
                        <WindowsFormsHost SnapsToDevicePixels="True" Margin="-30 0 -25 0" x:Name="ChartHost" Grid.Row="1" />
                      </Grid>
                    </ContentControl>
                    <ContentControl Grid.Row="1" VerticalAlignment="Top">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="150" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="auto" />
                          <ColumnDefinition />
                          <ColumnDefinition Width="auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="215" />
                          <RowDefinition Height="13" />
                          <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Column="0">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                          </Grid.RowDefinitions>
                          <TextBlock Style="{StaticResource val-group-title}" Text="Ablation:" />
                          <Border
                            Grid.Row="1"
                            Background="{StaticResource gray}"
                            CornerRadius="10">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="18" />
                                <RowDefinition />
                                <RowDefinition Height="18" />
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="1*" />
                              </Grid.ColumnDefinitions>
                              <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="auto" />
                                  <RowDefinition Height="14" />
                                  <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="11" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>

                                  <TextBlock
                                    Margin="1,0,0,0"
                                    Style="{StaticResource val-title}"
                                    Text="TEMPERATURE" />
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      d:Text="36"
                                      Style="{StaticResource val-large}">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NullableToStringConverter_}">
                                          <Binding Path="NavigatedProcedureRecords"/>
                                          <Binding Path="TC1Reading"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource val-unit-large}" Text="°C" />
                                  </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Grid.RowSpan="2">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>
                                  <TextBlock Style="{StaticResource val-title}" Text="ABLATION TIME">
                                    <TextBlock.Visibility>
                                      <MultiBinding Converter="{StaticResource AblationTimeTitlePlaybackConverter_}" ConverterParameter="ABLATION">
                                         <Binding Path="IsPlayBack"/>
                                         <Binding Path="SystemState"/>
                                         <Binding Path="NavigatedProcedureRecords"/>
                                      </MultiBinding>
                                    </TextBlock.Visibility>
                                  </TextBlock>
                                  <TextBlock Style="{StaticResource val-title}" Text="THAWING TIME">
                                    <TextBlock.Visibility>
                                      <MultiBinding Converter="{StaticResource AblationTimeTitlePlaybackConverter_}" ConverterParameter="THAWING">
                                        <Binding Path="IsPlayBack"/>
                                        <Binding Path="SystemState"/>
                                        <Binding Path="NavigatedProcedureRecords"/>
                                      </MultiBinding>
                                    </TextBlock.Visibility>
                                  </TextBlock>
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      d:Text="1"
                                      Style="{StaticResource val-large}"
                                      >
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource AblationTimePlaybackConverter_}">
                                          <Binding Path="CryoTherapyTime"/>
                                          <Binding Path="RequiredAblationTime"/>
                                          <Binding Path="ActualAblationTime"/>
                                          <Binding Path="ThawingElapsedTime"/>
                                          <Binding Path="NavigatedProcedureRecords"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource val-unit-large}" Text="sec" />
                                  </StackPanel>
                                </Grid>
                              </Grid>
                            </Grid>
                          </Border>
                        </Grid>
                        <Grid Grid.Column="2" HorizontalAlignment="Center">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition />
                          </Grid.RowDefinitions>

                          <TextBlock Style="{StaticResource val-group-title}" Text="Timers &amp; Rates:" />
                          <Border
                            Grid.Row="1"
                            Width="398"
                            Background="{StaticResource gray}"
                            CornerRadius="10">
                            <Grid>
                              <Grid.RowDefinitions>
                                <RowDefinition Height="19" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1*" />
                              </Grid.RowDefinitions>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="23.5" />
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.5" />
                              </Grid.ColumnDefinitions>
                              <Grid Grid.Row="1" Grid.Column="1">
                                <Grid.RowDefinitions>
                                  <RowDefinition Height="auto" />
                                  <RowDefinition Height="15" />
                                  <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="90" />
                                  <ColumnDefinition Width="19" />
                                  <ColumnDefinition Width="140" />
                                  <ColumnDefinition Width="15" />
                                  <ColumnDefinition Width="95" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Row="0">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="9" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>
                                  <TextBlock Style="{StaticResource val-title}" Text="MIN TEMP" />
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      d:Text="-40"
                                      Style="{StaticResource val-large}">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NullableToStringConverter_}">
                                          <Binding Path="NavigatedProcedureRecords"/>
                                          <Binding Path="MaxTemperatureRate"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource val-unit-large}" Text="°C" />
                                  </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>
                                  <TextBlock Style="{StaticResource val-title}" Text="TEMP@ TTI" />
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      d:Text="-38"
                                      Style="{StaticResource val-large}">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NullableToStringConverter_}" ConverterParameter="TemperatureAtTTI">
                                          <Binding Path="NavigatedProcedureRecords"/>
                                          <Binding Path="TemperatureAtTTI"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource val-unit-large}" Text="°C" />
                                  </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="2">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="9" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>
                                  <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource val-title}" Text="COOLING TIME TO " />
                                    <TextBlock Foreground="white"  Style="{StaticResource val-title-bold}" d:Text="30">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NullableToStringConverter_}">
                                          <Binding Path="NavigatedProcedureRecords"/>
                                          <Binding Path="RequiredTargetTemperature"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Foreground="white" Style="{StaticResource val-title-bold}" Text="°C" />
                                  </StackPanel>
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      d:Text="25"
                                      Style="{StaticResource val-large}">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NullableToStringConverter_}">
                                          <Binding Path="NavigatedProcedureRecords"/>
                                          <Binding Path="TimeToTargetTemperature"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource val-unit-large}" Text="sec" />
                                  </StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Grid.Column="2">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>
                                  <TextBlock Style="{StaticResource val-title}" Text="TIME SINCE TTI" />
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      d:Text="2"
                                      Style="{StaticResource val-large}">
                                      <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource NullableToStringConverter_}" ConverterParameter="TimeSinceTTI">
                                          <Binding Path="NavigatedProcedureRecords"/>
                                          <Binding Path="TimeSinceTTI"/>
                                        </MultiBinding>
                                      </TextBlock.Text>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource val-unit-large}" Text="sec" />
                                  </StackPanel>
                                </Grid>
                                <Grid Grid.Row="0" Grid.Column="4">
                                  <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="9" />
                                    <RowDefinition Height="auto" />
                                  </Grid.RowDefinitions>
                                  <TextBlock Style="{StaticResource val-title}" Text="TTI" />
                                  <StackPanel
                                    Grid.Row="2"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                      Foreground="#9bc567"
                                      d:Text="31"
                                      Style="{StaticResource val-large}">
                                      <TextBlock.Text>
