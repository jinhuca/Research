<UserControl x:Class="SmartAblationSystem.Views.CryoTherapy"
						 Uid="MainTherapyView"
						 Name="MainTherapyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters" 
             prism:ViewModelLocator.AutoWireViewModel="True"
             Loaded="CryoTherapy_OnLoaded"
						 Unloaded="CryoTherapy_OnUnloaded"
             mc:Ignorable="d" d:DesignHeight="1080" d:DesignWidth="1920">
	<UserControl.Resources>
		<converters:InverseBooleanConverter x:Key="inverseBoolConverter"/>
		<converters:SimpleViewVisibilityConverter x:Key="simpleViewConverter"/>
		<converters:NormalViewVisibilityConverter x:Key="normalViewConverter"/>
	</UserControl.Resources>

	<Grid>
		<local:CryoTherapyNormalView Uid="NormalView"
		                             x:Name="NormalViewName"
		                             IsEnabled="{Binding IsSimpleTherapyViewVisible, Converter={StaticResource inverseBoolConverter}}"
		                             Visibility="{Binding IsSimpleTherapyViewVisible, Converter={StaticResource normalViewConverter}}"/>
		<local:CryoTherapySimpleView Uid="SimpleView"
		                             x:Name="SimpleViewName" 
		                             IsEnabled="{Binding IsSimpleTherapyViewVisible}"
		                             Visibility="{Binding IsSimpleTherapyViewVisible, Converter={StaticResource simpleViewConverter}}"/>
	</Grid>
</UserControl>