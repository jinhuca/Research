<UserControl x:Class="SmartAblationSystem.Views.PIDS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             Unloaded="UserControl_Unloaded"
             xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:local="clr-namespace:SmartAblationSystem.Helpers"
             xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
             mc:Ignorable="d"
             d:DesignHeight="1080" d:DesignWidth="1920" Loaded="UserControl_Loaded">

  <UserControl.Resources>
    <converters:StringTodoubleConverter x:Key="stringTodoubleConverter" />
    <converters:StateToColorConverter x:Key="stateToColorConverter" />
    <converters:StateToEnableConverter x:Key="stateToEnable" />
    <converters:StateToVisibilityConverter x:Key="stateToVisibility" />
    <converters:BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter" />
    <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter" />
    <converters:StatusToPicture x:Key="statusToPicture" />
    <converters:BooleanToPIDModeConverter x:Key="booleanToPIDModeConverter" />
    <converters:BooleanToFlowOrPressureConverter x:Key="booleanToFlowOrPressureConverter" />
    <converters:BooleanToColorConverter x:Key="booleanToColorConverter" />
    <converters:BooleanToUSBConnectionConverter x:Key="booleanToUSBConnectionConverter" />
    <converters:StringToIntConverter x:Key="stringToIntConverter" />
    <converters:DoubleToStringConverter x:Key="doubleToStringConverter" />
    <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />
  </UserControl.Resources>

  <Grid Height="1080" Width="1920" Background="Black">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="90" />
    </Grid.RowDefinitions>

    <!-- Status top bar -->
    <Grid Grid.Row="0" Width="1920" VerticalAlignment="Top" HorizontalAlignment="Center">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Border BorderThickness="2" Margin="0,2,0,2" Height="45" CornerRadius="6">
        <Border.BorderBrush>
          <SolidColorBrush Color="White"  Opacity="0.5" />
        </Border.BorderBrush>
        <UniformGrid Rows="1" Columns="7" VerticalAlignment="Center">
          <Label Content="STATUS:" Foreground="White"  FontWeight="Bold" FontSize="22" Margin="80,0,0,0" />
          <Label Content="IDLE" Foreground="{Binding SystemState, ConverterParameter=IDLE, Converter={StaticResource stateToColorConverter}}"  FontWeight="Bold" FontSize="22" />
          <Label Content="READY" Foreground="{Binding SystemState, ConverterParameter=READY, Converter={StaticResource stateToColorConverter}}"  FontWeight="Bold" FontSize="22" />
          <Label Content="INFLATION" Foreground="{Binding SystemState, ConverterParameter=INFLATION, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
          <Label Content="TRANSITION" Foreground="{Binding SystemState, ConverterParameter=TRANSITIONPID, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
          <Label Content="ABLATION" Foreground="{Binding SystemState, ConverterParameter=ABLATIONPID, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
          <Label Content="THAWING" Foreground="{Binding SystemState, ConverterParameter=THAWING, Converter={StaticResource stateToColorConverter}}" FontWeight="Bold" FontSize="22" />
        </UniformGrid>
      </Border>
    </Grid>

    <!-- Central microcontroller and Patient micro controller title bar -->
    <Grid Grid.Row="1" Width="1920" VerticalAlignment="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <GroupBox  Style="{StaticResource GroupBoxStyle}" Content="Control Micro Controller" FontSize="18" FontWeight="Bold" Grid.Column="0" Margin="0,0,5,0" />
      <GroupBox  Style="{StaticResource GroupBoxStyle}" Content="Patient Micro Controller" FontSize="18" FontWeight="Bold" Grid.Column="1" Margin="5,0,0,0" />
    </Grid>

    <!-- Register bar - Read value-->
    <Grid Grid.Row="2" Width="1920">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Central Micro Controller Register values-->
      <GroupBox Grid.Row="2" Grid.Column="0" Header="Register " Foreground="Gray" BorderBrush="Gray" BorderThickness="0.5" FontWeight="Bold" FontSize="14" Margin="10,0,5,0">
        <Grid >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <UniformGrid Rows="1" Columns="4" Grid.Column="0" Margin="5,0" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0, 0, 0">
              <StackPanel Orientation="Vertical" >
                <Label Content="P-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14"/>
                <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PGain, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Orientation="Vertical">
                <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreaseCentralPIDvalueCommand}" CommandParameter ="PGain">
                  <Button.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="180" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Button.RenderTransform>
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

                <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreaseCentralPIDvalueCommand}" CommandParameter ="PGain" Margin="5,5,-1,0">
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

              </StackPanel>

            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >

              <StackPanel Orientation="Vertical" >
                <Label Content="I-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14"/>
                <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding IGain, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Orientation="Vertical"  >
                <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreaseCentralPIDvalueCommand}" CommandParameter ="IGain">
                  <Button.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="180" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Button.RenderTransform>
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

                <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreaseCentralPIDvalueCommand}" CommandParameter ="IGain" Margin="6,5,0,0">
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

              </StackPanel>

            </StackPanel >

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >

              <StackPanel Orientation="Vertical">
                <DockPanel>
                  <Label Content="D-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                </DockPanel>
                <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding DGain, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Orientation="Vertical"  >
                <Button Width="25" Height="25" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreaseCentralPIDvalueCommand}" CommandParameter ="DGain">
                  <Button.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="180" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Button.RenderTransform>
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

                <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreaseCentralPIDvalueCommand}" CommandParameter ="DGain" Margin="6,5,0,0">
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

              </StackPanel>

            </StackPanel  >

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <StackPanel Orientation="Vertical" >
                <DockPanel>
                  <Label Content="Offset" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14"/>
                </DockPanel>
                <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PIDOffset, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
              </StackPanel>

              <StackPanel Orientation="Vertical"  >
                <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreaseCentralPIDvalueCommand}" CommandParameter ="OffsetGain">
                  <Button.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="180" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Button.RenderTransform>
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

                <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreaseCentralPIDvalueCommand}" CommandParameter ="OffsetGain" Margin="6,5,0,0">
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

              </StackPanel>
            </StackPanel  >
          </UniformGrid >

          <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition />
              <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Visibility="{Binding IsSystemUsingDASBalloon , Converter={StaticResource booleanToVisibilityConverter}}" Margin="5,0">
              <Grid>
                <Button x:Name="DialASize" Style="{StaticResource ButtonDialASize}" Command="{Binding EnableDASBallonCommand}" Height="75" Width="75"  
								       Visibility="{Binding DASBalloonEnabled, Converter={StaticResource booleanToNotVisibilityConverter}}"/>

                <Button x:Name="ButtonDialASizeMinus" Style="{StaticResource ButtonDialASizeMinus}" Command="{Binding EnableDASBallonCommand}" Height="75"  Width="75"   
									  Visibility="{Binding DASBalloonEnabled, Converter={StaticResource booleanToVisibilityConverter}}"/>
              </Grid>

              <DockPanel Margin="10,0,0,0" >
                <Grid DockPanel.Dock="Bottom">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="PSP:" Grid.Column="0" FontSize="16" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding PressureSetPoint, ConverterParameter=OBP, Converter={StaticResource doubleToStringConverter}, Mode=OneWay}" 
                             Grid.Column="2" HorizontalAlignment="Left" FontWeight="Bold" Foreground="White" FontSize="16" />
                </Grid>

                <StackPanel Orientation="Horizontal" Height="50" >
                  <Image Source="/Images/Balloon plus status.png" Margin="8,0,0,10"  />
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="AUTO"/>
                    </Grid.ColumnDefinitions>

                    <Image Grid.Row="0" Grid.Column="0" Source="/Images/oksign.png" Margin="5,0,0,10"  Height="30"
											     Visibility="{Binding DASBalloonEnabled, Converter={StaticResource booleanToVisibilityConverter}}"/>
                    <Image Grid.Row="0" Grid.Column="0" Source="/Images/LED_OFF.png" Margin="5,0,0,10"  Height="30"
											     Visibility="{Binding DASBalloonEnabled, Converter={StaticResource booleanToNotVisibilityConverter}}"/>

                  </Grid>
                </StackPanel>
              </DockPanel>
            </StackPanel>

            <Border BorderThickness="1" CornerRadius="8" Margin="20,0,0,0" BorderBrush="Silver" Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Height="60">
                <TextBlock Text="Inflation Speed" Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" >
                  <Viewbox Height="30" >
                    <RadioButton Name="SlowButton" GroupName="speed" Margin="5,0,0,0" Width="50" Command="{Binding SlowButtonCommand}"
                                   IsChecked="{Binding InflationSpeedMode, Mode=OneWay, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Slow}">
                      <RadioButton.Content>
                        <TextBlock Text="Slow" Margin="0,3,0,0" FontSize="8" FontWeight="Bold"  Foreground="White"/>
                      </RadioButton.Content>
                    </RadioButton>
                  </Viewbox>
                  <Viewbox Height="30" Margin="5,0,0,0" >
                    <RadioButton Name="FastButton" GroupName="speed" Command="{Binding FastButtonCommand}" Width="50"
                                             IsChecked="{Binding InflationSpeedMode, Mode=OneWay, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Fast}">
                      <RadioButton.Content>
                        <TextBlock Text="Fast" Margin="0,3,0,0" FontSize="8" FontWeight="Bold" Foreground="White"/>
                      </RadioButton.Content>
                    </RadioButton>
                  </Viewbox>
                </StackPanel>
              </StackPanel>
            </Border>

          </Grid>

        </Grid>
      </GroupBox>

      <!--Patient Micro Controller: Register Values -->
      <GroupBox Grid.Row="2" Grid.Column="1" Header="Register" Foreground="Gray" BorderBrush="Gray" BorderThickness="0.5" FontWeight="Bold" FontSize="14" Margin="0,0,10,0">
        <UniformGrid Rows="1" Columns="8" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical" >
              <DockPanel>
                <Label Content="P-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PatientPGain, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}"  />


            </StackPanel>

            <StackPanel Orientation="Vertical"  >
              <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreasePatientPIDvalueCommand}" CommandParameter ="PGain">
                <Button.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="180" />
                    <TranslateTransform />
                  </TransformGroup>
                </Button.RenderTransform>
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

              <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreasePatientPIDvalueCommand}" CommandParameter ="PGain" Margin="6,5,0,0">
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

            </StackPanel>

          </StackPanel>

          <StackPanel Orientation="Horizontal">
            <StackPanel Orientation="Vertical" >
              <DockPanel>
                <Label Content="I-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PatientIGain, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />


            </StackPanel>

            <StackPanel Orientation="Vertical"  >
              <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreasePatientPIDvalueCommand}" CommandParameter ="IGain">
                <Button.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="180" />
                    <TranslateTransform />
                  </TransformGroup>
                </Button.RenderTransform>
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

              <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreasePatientPIDvalueCommand}" CommandParameter ="IGain" Margin="6,5,0,0">
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

            </StackPanel>

          </StackPanel>

          <StackPanel Orientation="Horizontal">

            <StackPanel Orientation="Vertical">
              <DockPanel>
                <Label Content="D-Gain" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14"/>
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PatientDGain, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Vertical"  >
              <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreasePatientPIDvalueCommand}" CommandParameter ="DGain">
                <Button.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="180" />
                    <TranslateTransform />
                  </TransformGroup>
                </Button.RenderTransform>
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

              <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreasePatientPIDvalueCommand}" CommandParameter ="DGain" Margin="6,5,0,0">
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

            </StackPanel>

          </StackPanel>

          <StackPanel Orientation="Horizontal">

            <StackPanel Orientation="Vertical">
              <DockPanel>
                <Label Content="Offset" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14"/>
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PatientPIDOffset, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
            </StackPanel>

            <StackPanel Orientation="Vertical"  >
              <Button Width="25" Height="25" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,5"
                                        Command="{Binding IncreasePatientPIDvalueCommand}" CommandParameter ="OffsetGain">
                <Button.RenderTransform>
                  <TransformGroup>
                    <ScaleTransform />
                    <SkewTransform />
                    <RotateTransform Angle="180" />
                    <TranslateTransform />
                  </TransformGroup>
                </Button.RenderTransform>
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

              <Button Width="25" Height="25" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}"  Command="{Binding DecreasePatientPIDvalueCommand}" CommandParameter ="OffsetGain" Margin="6,5,0,0">
                <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="25" Width="25" RenderTransformOrigin="0.5,0.5">
                  <Image.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="-90" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Image.RenderTransform>
                </Image>
              </Button>

            </StackPanel>

          </StackPanel>

          <StackPanel Orientation="Vertical" Width="50">
            <DockPanel>
              <Label Content="R-Time" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14"  Margin="-4,0,-5,0"/>
            </DockPanel>
            <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding RampUpTimeByStep, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Orientation="Vertical" Width="50">
            <DockPanel>
              <Label Content="R-Press" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="-4,0,-10,0"/>
            </DockPanel>
            <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PressureRampUpValue, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Orientation="Vertical" Width="50">
            <DockPanel>
              <Label Content="D-Time" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="-4,0,-5,0"/>
            </DockPanel>
            <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding RampDownTimeByStep, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
          </StackPanel>

          <StackPanel Orientation="Vertical" Width="50">
            <DockPanel>
              <Label Content="D-Press" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="-5,0,-5,0"/>
            </DockPanel>
            <TextBox BorderBrush="Black" BorderThickness="2" Text="{Binding PressureRampDownValue, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" />
          </StackPanel>
        </UniformGrid>
      </GroupBox>
    </Grid>

    <!-- Read / Write value-->
    <Grid Grid.Row="3" Width="1920">

      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <StackPanel x:Name="Write" Orientation="Horizontal" Grid.Column="0" Margin="0,0,5,-5" HorizontalAlignment="Right">
        <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Read" Command="{Binding ReadFromMicroControllerCommand}" CommandParameter="CentralMicroController" Style="{StaticResource ButtonCryterion}" />
        <ComboBox Style="{StaticResource MaintenanceComboBoxCryterionStyle}" FontSize="20" Width="200" Height="50" VerticalAlignment="Center" Margin="30,0,30,0"
                          ItemsSource="{Binding StatesList}" SelectedValue="{Binding SelectedState}" />

        <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="PID TO DB" Command="{Binding WriteCMCUPIDToDbCommand}" CommandParameter="CentralMicroController" Style="{StaticResource ButtonCryterion}" Margin="0,0,30,0" />

        <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Write" Command="{Binding WriteToMicroControllerCommand}" CommandParameter="CentralMicroController" Style="{StaticResource ButtonCryterion}" />
      </StackPanel>

      <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="0,0,5,-5" HorizontalAlignment="Right">
        <Label Content="TC1 (°C)" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="24" VerticalAlignment="Center" />
        <Label Content="{Binding TC1Reading, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" Foreground="{StaticResource CryterionBrushColorBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="34" FontWeight="Bold" Margin="10,0,60,0" />
        <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Read" Command="{Binding ReadFromMicroControllerCommand}" CommandParameter="PatientMicroController" Style="{StaticResource ButtonCryterion}" />
        <ComboBox Style="{StaticResource MaintenanceComboBoxCryterionStyle}" FontSize="20" Width="200" Height="50" VerticalAlignment="Center" Margin="20,0,20,0"
                          ItemsSource="{Binding StatesList}" SelectedValue="{Binding SelectedState}" />
        <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="PID TO DB" Command="{Binding WritePMCUPIDToDbCommand}" CommandParameter="CentralMicroController" Style="{StaticResource ButtonCryterion}" Margin="0,0,30,0" />

        <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Write" Command="{Binding WriteToMicroControllerCommand}" CommandParameter="PatientMicroController" Style="{StaticResource ButtonCryterion}" />
      </StackPanel>
    </Grid>

    <!-- GPIO - FM1, PT3 & IBP, PT2, PWM Inj and PWM Balance -->
    <Grid Grid.Row="4" Width="1920" Background="Black">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <Grid.RowDefinitions>
        <RowDefinition Height="2*" />
        <RowDefinition Height="2*" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <!-- PT2 -->
      <Border BorderThickness="2" Margin="5,5,5,5" CornerRadius="6" Grid.Column="0" Grid.Row="1">
        <Border.BorderBrush>
          <SolidColorBrush Color="White" Opacity="0.5" />
        </Border.BorderBrush>

        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="5,5,0,5">
          <Label Content="PT2" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="24" Margin="-132,0,0,5"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="175" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChartPT2" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <!-- Chart is loaded in the code-behind -->
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-20,0,15,0">
              <Label Content="PT2" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20" />
              <Label Content="{Binding PT2Reading, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=WithoutDecimal, Mode=TwoWay}" Foreground="{StaticResource CryterionBrushColorBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- FM1 -->
      <Border BorderThickness="2" Margin="5,5,5,5" CornerRadius="6" Grid.Column="0" Grid.Row="0">
        <Border.BorderBrush>
          <SolidColorBrush Color="White" Opacity="0.5" />
        </Border.BorderBrush>

        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="5,5,0,5">
          <Label Content="FM1" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="24" Margin="-121,0,0,5"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="175" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChartFM1" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <!-- Chart is loaded in the code-behind -->
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-20,0,15,0">
              <Label Content="FM1" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20" />
              <Label Content="{Binding FM1Reading, Mode=TwoWay}" Foreground="{StaticResource CryterionBrushColorBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- PT3 and IBP -->
      <Border BorderThickness="2" Margin="5,4,5,6" CornerRadius="6" Grid.Column="1" Grid.Row="0">
        <Border.BorderBrush>
          <SolidColorBrush Color="White" Opacity="0.5" />
        </Border.BorderBrush>

        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="5,5,0,5">
          <Label Content="PT3 and IBP" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="24" Margin="-150,0,0,5"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="175" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChartPT3" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <!-- Chart is loaded in the code-behind -->
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-20,-20,15,0">
              <Label Content="PT3" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20" />
              <Label Content="{Binding PT3Reading, Converter={StaticResource stringTodoubleConverter},  ConverterParameter=OneDecimalValue, Mode=TwoWay}" Foreground="{StaticResource CryterionBrushColorBlue}"  HorizontalAlignment="Right" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
              <Label Content="IBP" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20" Margin="0,10,0,0" />
              <Label Content="{Binding CP1Reading, Converter={StaticResource stringTodoubleConverter},  ConverterParameter=OneDecimalValue, Mode=TwoWay}" Foreground="Yellow" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
              <Label Content="OBP" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20" Margin="0,10,0,0" />
              <Label Content="{Binding CP2Reading, Converter={StaticResource stringTodoubleConverter},  ConverterParameter=OneDecimalValue, Mode=TwoWay}" Foreground="#00a300" HorizontalAlignment="Right"  VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- PWM Injection and PWM Balance -->
      <Border BorderThickness="2" Margin="5,5,5,5" CornerRadius="6" Grid.Column="1" Grid.Row="1">
        <Border.BorderBrush>
          <SolidColorBrush Color="White" Opacity="0.5" />
        </Border.BorderBrush>

        <StackPanel Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="5,5,0,5">
          <Label Content="PWM Injection and PWM Balance" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="24" Margin="-145,0,0,5"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="175" />
            </Grid.ColumnDefinitions>

            <StackPanel x:Name="ChartPWM" Grid.Column="0" Orientation="Vertical" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
              <!-- Chart is loaded in the code-behind -->
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="-20,0,15,0">
              <Label Content="PWM INJ" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20" />
              <Label Content="{Binding PIDDutyCycle, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=WithoutDecimal, Mode=TwoWay}" Foreground="{StaticResource CryterionBrushColorBlue}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
              <Label Content="PWM BAL" HorizontalAlignment="Center" Foreground="White" FontWeight="Bold" FontSize="20"  Margin="0,20,0,0" />
              <Label Content="{Binding PatientPIDDutyCycle, Converter={StaticResource stringTodoubleConverter}, ConverterParameter=WithoutDecimal, Mode=TwoWay}" Foreground="Yellow" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="40" FontWeight="Bold" Margin="0,-20,0,0" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Target flow, injection pressure and fault reset
                 Start/Stop/Vacuum
                 Target balloon pressure send + catheter connection -->
      <Grid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Target flow, injection pressure and fault reset -->
        <Border BorderThickness="2" Margin="5,5,5,5" CornerRadius="6" Grid.Column="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <Border.BorderBrush>
            <SolidColorBrush Color="White" Opacity="0.5" />
          </Border.BorderBrush>
          <StackPanel  Orientation="Horizontal" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="5,5,5,5">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top">
              <DockPanel>
                <Label Content="Target Flow" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Width="150" Height="40" Text="{Binding TargetInjectionFlow, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
              <Button Width="150" Height="45" Margin="0,5,0,0" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Send" Command="{Binding TargetInjectionFlowCommand}" Style="{StaticResource ButtonCryterion}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10,0,10,0">
              <DockPanel>
                <Label Content="Target Injection Pressure" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Width="150" Height="40" Text="{Binding TargetInjectionPressure, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
              <Button Width="150" Height="45" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Fault Reset" Command="{Binding FaultResetCommand}" Style="{StaticResource ButtonCryterion}" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="5,0,5,0" HorizontalAlignment="Center" Width="275">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Width="170" Margin="-30,5,0,0">
                <Label Content="Pressure" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="0,0,5,0" />
                <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" Command="{Binding PressureFlowCommand}" CommandParameter="7" IsChecked="{Binding IsPressureFlowActivated}" HorizontalAlignment="Center" />
                <Label Content="Flow" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="25,0,0,0" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5,5,0,0" Width="160">
                <Label Content="Auto" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="0,0,1,0" />
                <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" Command="{Binding PIDModeCommand}" CommandParameter="7" IsChecked="{Binding IsPIDModeActivated}" HorizontalAlignment="Center" Margin="5,0,0,0" />
                <Label Content="Manual" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" Margin="25,0,0,0" />
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Visibility="{Binding SaveInProgress, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}">
                <Controls:ProgressRing Height="50" Width="50" Foreground="{StaticResource CryterionPopupSystemMessageBrushBackground}"></Controls:ProgressRing>
                <Label Content="Save Engineering Data in progress..." Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"></Label>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,0" Visibility="{Binding SaveInProgress, Converter={StaticResource booleanToNotVisibilityConverter}, Mode=OneWay}">
                <StackPanel Orientation="Vertical" Width="75" HorizontalAlignment="Left">
                  <Label Content="Save Data" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
                  <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30"
                                                  IsChecked="{Binding IsLoggingActivated}"
                                                  Margin="0,-5,20,0" HorizontalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5,0,0" Width="195">
                  <!-- USBDriveConnected -->
                  <Button x:Name="BtnSaveToUSB" Content="Save to USB" Height="50" Width="110"
                                            VerticalAlignment="Top" FontSize="18" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}"
                                            Margin="5,0,0,0" Style="{StaticResource ButtonCryterion}"
                                            Command="{Binding SaveToUSBCommand}"
                                            IsEnabled="{Binding CanSaveEngineeringReportFiles}" />

                  <Image Source="{Binding USBDriveConnected, Converter={StaticResource booleanToUSBConnectionConverter}, Mode=OneWay}"
                                           Height="50" Width="70" VerticalAlignment="Top" Margin="5,0,0,0" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Start / Stop / Vacuum -->
        <Border BorderThickness="2" Margin="5,5,5,5" CornerRadius="6" Grid.Column="1"  VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <Border.BorderBrush>
            <SolidColorBrush Color="White" Opacity="0.5" />
          </Border.BorderBrush>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Orientation="Vertical">
              <DockPanel>

                <Button x:Name="Stop" Style="{StaticResource StopButton}"
                                        Visibility="{Binding SystemState, ConverterParameter=STOP, Converter={StaticResource stateToVisibility}}"
                                        Command="{Binding StopCommand}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=STOP, Converter={StaticResource stateToEnable}}" Margin="10,0,20,0">
                </Button>

                <Button x:Name="Start" Style="{StaticResource StartButton}"
                                        Visibility="{Binding SystemState, ConverterParameter=START, Converter={StaticResource stateToVisibility}}"
                                        Command="{Binding StartCommand}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=START, Converter={StaticResource stateToEnable}}" Margin="10,0,20,0" />



                <Grid Width="200">
                  <Button x:Name="ConnectButton" Style="{StaticResource ConnectButton}"
                                            Visibility="{Binding IsCatheterElectricallyConnectedAndInIdleState, Converter={StaticResource booleanToVisibilityConverter}}"
                                            Command="{Binding ConnectCommand}" />
                  <StackPanel Orientation="Horizontal" Margin="-50,0,0,0" Visibility="{Binding CatheterIsConnecting, Converter={StaticResource booleanToVisibilityConverter}, Mode=OneWay}">
                    <Controls:ProgressRing Height="50" Width="50" Foreground="{StaticResource CryterionPopupSystemMessageBrushBackground}"></Controls:ProgressRing>
                    <Label Content="Wait system is initializing..." Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"></Label>
                  </StackPanel>

                  <Button x:Name="DisconnectButton" Style="{StaticResource DisconnectButton}"
                                            Visibility="{Binding IsCatheterConnectedAndInIReadyState, Converter={StaticResource booleanToVisibilityConverter}}"
                                            Command="{Binding ConnectCommand}" />
                </Grid>
              </DockPanel>
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Target balloon pressure send + catheter connection -->
        <Border BorderThickness="2" Margin="5,5,5,5" CornerRadius="6" Grid.Column="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
          <Border.BorderBrush>
            <SolidColorBrush Color="White" Opacity="0.5" />
          </Border.BorderBrush>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,5,5,5">
            <StackPanel Orientation="Vertical">
              <DockPanel>
                <Label x:Name="TargetBalloonPressure" Content="Target Balloon Pressure" Foreground="{StaticResource CryterionBrushColorBlue}" FontWeight="Bold" FontSize="14" />
              </DockPanel>
              <TextBox BorderBrush="Black" BorderThickness="2" Width="150" Height="40" Text="{Binding TargetBalloonPressure, Converter={StaticResource stringTodoubleConverter}, Mode=TwoWay}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
              <Button Width="150" Height="50" FontWeight="Bold" Background="{StaticResource CryterionBrushColorBlue}" FontSize="18" Content="Send" Command="{Binding TargetBalloonPressureCommand}" Style="{StaticResource ButtonCryterion}" />
            </StackPanel>

            <StackPanel Orientation="Vertical" Margin="10,0,0,0">
              <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="8" Width="170" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Height="60">
                  <Button Style="{StaticResource ButtonImageNotifier }"
                                            x:Name="butElectrical"
                                            HorizontalAlignment="Center" Width="115" Height="55">
                    <Image Source="/Images/electrical plug.png" Margin="5,0,0,0"></Image>
                  </Button>
                  <Button Style="{StaticResource ButtonImageNotifier}"
                                        x:Name="butElectricalState"
                                        HorizontalAlignment="Center" Width="40" Height="50" Margin="0,0,0,0">
                    <Image Source="{Binding IsCatheterCableConnected , Converter={StaticResource statusToPicture}}" Height="50" Width="40" />
                  </Button>
                </StackPanel>
              </Border>

              <Border BorderBrush="Silver" BorderThickness="1" CornerRadius="8" Width="170" Margin="0,5,0,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Height="55" Visibility="{Binding SystemState, Converter={StaticResource stateToVisibility}, ConverterParameter=CatheterTube}">
                  <Button Style="{StaticResource ButtonImageNotifier }"
                                        x:Name="butMechanical"
                                        HorizontalAlignment="Left" Width="115" Height="50">
                    <Image Source="/Images/mechanical plug.png" Margin="10,2,2,0"></Image>
                  </Button>
                  <Button Style="{StaticResource ButtonImageNotifier}"
                                        x:Name="butMechanicalState"
                                        HorizontalAlignment="Center"
                                        Width="40"  Height="50">
                    <Image Source="{Binding SystemState,ConverterParameter=UseSystemState, Converter={StaticResource statusToPicture}}" Height="50" Width="40" />
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="10,0,0,0">
              <Label Grid.Column="0" Grid.Row="1" x:Name="DeflateAfterThaw" Height="50" Width="240" Background="Transparent" VerticalAlignment="Center"
                                   Margin="0,0,0,5" Style="{StaticResource LabelCryterion}" FontSize="18" FontWeight="Bold" Foreground="Black">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Deflate After Thaw" VerticalAlignment="Center" Margin="0,0,10,0" />
                  <ToggleButton Style="{StaticResource AnimatedSwitch}" Height="30" 
                                          IsChecked="{Binding DeflateAfterThaw, Mode=TwoWay}" Margin="0,0,15,0" />
                </StackPanel>
              </Label>

              <StackPanel Orientation="Horizontal">
                <Label Content="Timer: " FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0,0,0" />
                <Button Width="40" Height="40" Padding="0,0,0,0"  BorderThickness="0" Style="{StaticResource CircularButtonStyle}" Command="{Binding DecreaseTimeCommand}"
                                        Visibility="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToVisibility}}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToEnable}}">
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="40" Width="40" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>

                <Label x:Name="RequiredAblationTime" Content="{Binding RequiredAblationTime}" Foreground="White" FontSize="18" FontWeight="Bold" Margin="5,0,0,0" Width="40" VerticalAlignment="Center" />
                <Label Content="sec" Foreground="White" FontSize="18" Margin="0,0,5,0" VerticalAlignment="Center" />

                <Button Width="40" Height="40" Padding="0,0,0,0" BorderThickness="0" Style="{StaticResource CircularButtonStyle}" RenderTransformOrigin="0.5,0.5" Margin="5,0,0,0"
                                        Command="{Binding IncreaseTimeCommand}"
                                        Visibility="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToVisibility}}"
                                        IsEnabled="{Binding SystemState, ConverterParameter=ABLATION_TIMER, Converter={StaticResource stateToEnable}}">
                  <Button.RenderTransform>
                    <TransformGroup>
                      <ScaleTransform />
                      <SkewTransform />
                      <RotateTransform Angle="180" />
                      <TranslateTransform />
                    </TransformGroup>
                  </Button.RenderTransform>
                  <Image Source="/Images/Arrow.png" Stretch="UniformToFill" Height="40" Width="40" RenderTransformOrigin="0.5,0.5">
                    <Image.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <SkewTransform />
                        <RotateTransform Angle="-90" />
                        <TranslateTransform />
                      </TransformGroup>
                    </Image.RenderTransform>
                  </Image>
                </Button>
              </StackPanel>

              <StackPanel Orientation="Horizontal" Width="265">
                <StackPanel Orientation="Horizontal" Width="180" Visibility="{Binding CryoTherapyTimeVisible, Converter={StaticResource booleanToVisibilityConverter}, ConverterParameter=HIDDEN, Mode=OneWay}">
                  <Label Content="Ablation Time: " FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" />
                  <Label Content="{Binding CryoTherapyTime, Converter={StaticResource stringToIntConverter}, Mode=OneWay}" 
                                           Foreground="{StaticResource CryterionBrushColorBlue}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <Button Name="BtnStateSimulator" FontSize="18" Height="35" Width="90" Style="{StaticResource ButtonCryterion}"
                                        Content="Ch. State" Command="{Binding IncrementSystemStateCommand}" Margin="10,0,0,0"
                                        Visibility="Hidden" />
              </StackPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>