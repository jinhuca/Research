<Window x:Class="SmartAblationSystem.Views.EditDoctorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        xmlns:prism="http://prismlibrary.com/"
        prism:ViewModelLocator.AutoWireViewModel="True"
        xmlns:converterNew="clr-namespace:SmartAblationSystem.ConvertersNew"
        xmlns:helpers="clr-namespace:SmartAblationSystem.Helpers"
        WindowStyle="None"
        AllowsTransparency="True"
        Stylus.IsPressAndHoldEnabled="True"
        Stylus.IsTapFeedbackEnabled="False"
        IsManipulationEnabled="False"
        Background="Transparent"
        Title="EditDoctorWindow" Width="899" MinHeight="551"
        SizeToContent="Height"
        Loaded="OnEditDoctorWindowLoaded"
        x:Name="EditDoctorWindowName">
  <Window.Resources>
    <converterNew:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter_"/>
  </Window.Resources>
  <Grid x:Name="EditDoctorGrid" Width="860">
    <Border CornerRadius="12" Opacity="1"
            BorderBrush="Transparent"
            BorderThickness="0" Width="860"
            x:Name="EditDoctorWindowBorder"
            Background="{StaticResource PanelBackgroundBrush_}">
      <Border.Effect>
        <DropShadowEffect Color="Black"
              ShadowDepth="11"
              BlurRadius="20"
              RenderingBias="Performance"
              Opacity="0.5"
              Direction="-50"/>
      </Border.Effect>
    </Border>
    <Border>
      <StackPanel>
        <Border CornerRadius="12,12,0,0"  Width="860"
                Background="{StaticResource TitleBackgroundBrush_}">

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="1.22*"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" HorizontalAlignment="Right" 
                  Margin="0,0,12,0"
                  Height="78" Width="38">
              <Grid.Background>
                <DrawingBrush Drawing="{StaticResource DoctorIconDrawingGroup_}"
                              Stretch="Uniform"/>
              </Grid.Background>
            </Grid>
            <TextBlock Grid.Column="1" VerticalAlignment="Center"
                       Margin="2,3,0,0"
                       Text="EDIT DOCTOR"
                       Style="{StaticResource DialogTitleTextBlockStyle_}"/>
          </Grid>
        </Border>
        <Border CornerRadius="0,0,12,12" 
                BorderBrush="Transparent" 
                BorderThickness="0" Width="860"
                Background="{StaticResource BorderBackgroundBrush_}">
          
          <StackPanel Margin="60,30,0,10">
            <Grid Width="Auto" Height="Auto" HorizontalAlignment="Left">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2">
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="* User Name:" 
                           Margin="4,0,0,10" 
                           Style="{StaticResource SubTitleTextStyle_}"/>
                <TextBox Grid.Row="1" Height="30" 
                         x:Name="NewUserNameTextBox" 
                         Focusable="True"
                         Margin="12, 0,0,20" 
                         Text="{Binding Username, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="32" 
                         Foreground="{StaticResource ValueTextForeground_}" 
                         Style="{StaticResource TextBoxErrorStyle_}"
                         PreviewTouchDown="NewUserNameTextBox_PreviewTouchDown"/>
              </Grid>
              <Grid Grid.Row="1" Grid.Column="0" Margin="4,10,0,20">
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="* Dr. First Name:"
                           Margin="4,0,0,10" 
                           Style="{StaticResource SubTitleTextStyle_}"/>
                <TextBox Grid.Row="1" Height="30"
                         x:Name="FirstNameTextBox" 
                         Margin="12, 0,0,0" 
                         Text="{Binding DrFirstName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="25" 
                         Focusable="True"
                         Foreground="{StaticResource ValueTextForeground_}" 
                         Style="{StaticResource TextBoxErrorStyle_}"
                         PreviewTouchDown="FirstNameTextBox_PreviewTouchDown"/>
              </Grid>
              <Grid Grid.Row="1" Grid.Column="1" Margin="38,10,0,20">
                <Grid.RowDefinitions>
                  <RowDefinition/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Text="* Dr. Last Name:"
                           Margin="4,0,0,10" 
                           Style="{StaticResource SubTitleTextStyle_}"/>
                <TextBox Grid.Row="1" Height="30" 
                         x:Name="LastNameTextBox" 
                         Margin="12, 0,0,0" 
                         Text="{Binding DrLastName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                         MaxLength="25"
                         Focusable="True"
                         Foreground="{StaticResource ValueTextForeground_}" 
                         Style="{StaticResource TextBoxErrorStyle_}"
                         PreviewTouchDown="LastNameTextBox_PreviewTouchDown"/>
              </Grid>
            </Grid>
            <Grid Width="300" 
                  HorizontalAlignment="Left" 
                  Background="Transparent"
                  MouseUp="ResetPasswordGrid_MouseUp">
              <StackPanel Width="340" Orientation="Horizontal" 
                          HorizontalAlignment="Left" 
                          Margin="15,20,0,10"
                          Background="Transparent"
                          PreviewTouchDown="ResetPasswordPanel_PreviewTouchDown">
                <ToggleButton x:Name="ResetPasswordToggleButton"
                              VerticalAlignment="Bottom" Width="25" 
                              IsHitTestVisible="False"
                              Style="{StaticResource SaveToUsbToggleStyle_}" 
                              IsChecked="{Binding ResetPasswordSelected}"/>
                <TextBlock Text="Reset Password" Margin="14,0,0,0" 
                           Style="{StaticResource ResetPasswordTextBlockStyle_}"/>
              </StackPanel>
            </Grid>
            <Grid Height="Auto" Width="Auto" Margin="15,0,0,0"
                  Visibility="{Binding ResetPasswordSelected, Converter={StaticResource BoolToVisibilityConverter_}}">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Row="0" Grid.Column="0" Margin="0,15,0,10" x:Name="DoctorAdminPasswordGrid"
                    Visibility="{Binding IsBSCUser, Converter={StaticResource BoolToVisibilityConverter_}, ConverterParameter=REVERSE, Mode=OneWay}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Admin Password:" 
                           Margin="0,8,0,10" 
                           Style="{StaticResource SubTitleTextStyle_}"/>
                <PasswordBox Grid.Row="1" Width="330" Height="30" 
                             HorizontalAlignment="Left"
                             x:Name="AdminPasswordBox" 
                             Password="" 
                             PasswordChanged="TxtCurrentPassword_TextChanged" 
                             MaxLength="16" 
                             Focusable="True"
                             Style="{StaticResource PasswordBoxStyle_}"
                             PreviewTouchDown="AdminPasswordBox_PreviewTouchDown"/>
              </Grid>
              <Grid Grid.Row="1" Grid.Column="0" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="New Password:" 
                           Margin="0,8,0,10" 
                           Style="{StaticResource SubTitleTextStyle_}"/>
                <PasswordBox Grid.Row="1" Width="330" Height="30" 
                             HorizontalAlignment="Left" 
                             x:Name="NewPasswordBox" 
                             MaxLength="16"
                             Focusable="True"
                             helpers:BoundPasswordBox.BoundPassword="{Binding Path=Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                             PasswordChanged="NewPasswordBox_Changed" 
                             Style="{StaticResource PasswordBoxStyle_}"
                             PreviewTouchDown="NewPasswordBox_PreviewTouchDown"/>
              </Grid>
              <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" 
                           Text="Confirm New Password:" 
                           Margin="0,8,0,10" 
                           Style="{StaticResource SubTitleTextStyle_}"/>
                <PasswordBox Grid.Row="1" Width="330" Height="30" 
                             HorizontalAlignment="Left"
                             x:Name="ConfirmPasswordBox" 
                             helpers:BoundPasswordBox.BoundPassword="{Binding Path=ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="16"
                             Focusable="True"
                             PasswordChanged="ConfirmPassword_Changed"
                             Style="{StaticResource PasswordBoxStyle_}"
                             PreviewTouchDown="ConfirmPasswordBox_PreviewTouchDown"/>
              </Grid>
            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" 
                        Margin="15,30,0,20">
              <i:Interaction.Triggers>
                <i:EventTrigger EventName="MouseDown">
                  <i:InvokeCommandAction Command="{Binding DeleteUserCommand}" 
                                         CommandParameter="{Binding ElementName=EditDoctorWindowName}"/>
                </i:EventTrigger>
              </i:Interaction.Triggers>
              <Grid Width="20" Height="20">
                <Grid.Background>
                  <DrawingBrush Drawing="{StaticResource DeleteUserIconDrawing_}" TileMode="None" Stretch="Uniform"/>
                </Grid.Background>
              </Grid>
              <TextBlock Text="Delete Doctor" 
                         Style="{StaticResource DeleteUserTextStyle_}"/>
            </StackPanel>
            <Grid Margin="0,20,22,20"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom">
              <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0"
                      Content="Cancel"
                      Style="{StaticResource TextWithUnderlineButton_}"
                      Click="CancelButton_Click"
                      PreviewTouchDown="CancelButton_PreviewTouchDown"
                      IsCancel="True"/>
              <Button Grid.Column="1"
                      Content="SAVE"
                      Foreground="White"
                      IsEnabled="{Binding IsEditDoctorInformationValid}"
                      Style="{StaticResource ConfirmButtonStyle_}"
                      Click="SaveButton_Click"
                      PreviewTouchDown="SaveButton_PreviewTouchDown"/>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </Border>
  </Grid>
</Window>
