<Window x:Class="SmartAblationSystem.Views.SaveToUSBNotification"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartAblationSystem.Views"
        mc:Ignorable="d"
        Title="SaveToUSBNotification"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Window.Resources>
        <Style x:Key="MessageTextStyle_" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#FFCEC3C6"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ButtonTextStyle_" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
            <Setter Property="FontWeight" Value="Regular"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Foreground" Value="#ffffffff"/>
        </Style>
    </Window.Resources>
    <Border CornerRadius="10,10,10,10"
         Background="#ff2B2B33"
          Width="533" Height="235">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" Opacity="0.5"/>
        </Border.Effect>
        
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="120"/>
                <RowDefinition Height="70"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0"
            Height="30"
            CornerRadius="10,10,0,0"
            Background="#ff475E8B"
            VerticalAlignment="Top"/>
            <TextBlock Grid.Row="1"
               Text="Saving to USB will end the ongoing procedure and  &#x0a;automatically redirect you to the home page. The &#x0a;load previous patient feature will not be available. &#x0a;Please confirm to proceed."
               Style="{StaticResource MessageTextStyle_}" Margin="0,36,0,0"/>
            <Grid Grid.Row="2" HorizontalAlignment="Right" Margin="0,20,20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
              Style="{StaticResource TextWithUnderlineButton_}"
              Content="Cancel"
              Click="CancelClick"
              IsCancel="True"/>
                <Button Grid.Column="1"
              Style="{StaticResource ConfirmButtonStyle_}"
              Content="CONFIRM"
              Click="Ok_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>