<Window x:Class="SmartAblationSystem.Views.Notifications"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:userControls="clr-namespace:CustomControls.UserControls;assembly=CustomControls"
        xmlns:mvvm="http://prismlibrary.com/"
        xmlns:converters="clr-namespace:SmartAblationSystem.Converters"
        mvvm:ViewModelLocator.AutoWireViewModel="True"
        WindowStartupLocation="CenterScreen" Background="Transparent" AllowsTransparency="True"
        mc:Ignorable="d" WindowStyle="None" ResizeMode="NoResize"
        Height="1015" Width="1790">
  <Window.Resources>
    <converters:EnumBooleanConverter x:Key="enumBooleanConverter" />
    <converters:InverseBooleanConverter x:Key="inverseBooleanConverter" />
    <converters:BooleanToNotVisibilityConverter x:Key="booleanToNotVisibilityConverter" />

    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#ff2a2a32"/>
    <SolidColorBrush x:Key="PanelTextForegroundBrush" Color="#ffcdc2c5"/>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource PanelTextForegroundBrush}" />
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="18" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ToggleButtonLeftText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#ffffffff" />
      <Setter Property="FontFamily" Value="{StaticResource Lato}"/>
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Margin" Value="0, 0, 5, 0" />
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="ToggleButtonRightText" TargetType="TextBlock" BasedOn="{StaticResource ToggleButtonLeftText}">
      <Setter Property="Margin" Value="5, 0, 0, 0" />
    </Style>

    <Style TargetType="userControls:ValueEditorWithUpDownButtonsControl">
      <Setter Property="Height" Value="50" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
  </Window.Resources>
  <Border CornerRadius="12" Opacity="1"
            BorderBrush="Transparent"
            BorderThickness="0" Height="985" Width="1760"
            x:Name="EditDoctorWindowBorder"
            Background="{StaticResource PanelBackgroundBrush_}">
    <Border.Effect>
      <DropShadowEffect Color="Black"
      ShadowDepth="11"
      BlurRadius="20"
      RenderingBias="Performance"
      Opacity="0.5"
      Direction="-50"/>
    </Border.Effect>
    <Grid Background="{StaticResource WindowBackgroundBrush}" >
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height ="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

      <Border Grid.Row="0" Height="78" Background="{StaticResource WindowCaptionBarBackgroundBrush}" CornerRadius="5,5,0,0">
        <TextBlock Text="SETTINGS" Style="{StaticResource WindowCaptionText}" />
      </Border>
      <Grid Grid.Row="1" >
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="525"/>
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="20,20,20,0" >
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <Border  Background="{StaticResource PanelBackgroundBrush}" 
                 CornerRadius="10" Height="197" >
            <Grid Margin="20,0,20,20">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="15"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Row="0"  Grid.Column="0" Grid.ColumnSpan="3" Text="TIMER TARGET PREFERENCES" FontSize="18" FontWeight="Bold"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Cooling Timer Target:" FontSize="18" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="1" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Name="CoolingTimerTo"
                                                              IsEnabled="{Binding IsUserAllowedToChangeCoolingAndThawToTemperature}"
                                                       Unit="°C" MinValue="-90" MaxValue="30" Incremental="5" Value="{Binding RequiredTargetTemperature, Mode=TwoWay}"/>
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Thaw Timer Target:" FontSize="18" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Name="ThawTimerTo"
                                                              IsEnabled="{Binding IsUserAllowedToChangeCoolingAndThawToTemperature}"
                                                       Unit="°C" MinValue="-20" MaxValue="20" Incremental="5" Value="{Binding ThawTimerToTemperature, Mode=TwoWay}"/>
            </Grid>
          </Border>
          <Border  Grid.Row="1" Background="{StaticResource PanelBackgroundBrush}" 
                 CornerRadius="10" Margin="0,20, 0, 0">
            <Grid Margin="20,0, 20, 20">
              <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="20"/>
                <ColumnDefinition />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="SYSTEM SETTINGS" FontSize="18" Margin="0,10"  FontWeight="Bold"/>
              <Grid Grid.Row="1" Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Auto Playback:" FontSize="18"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Height="30">
                  <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftText}"/>
                  <ToggleButton Style="{StaticResource SwitchToggleButton}" Name="ToggleAutoPlayback" IsChecked="{Binding IsUsingAutoPlayback}"/>
                  <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightText}"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Inflation Speed:" FontSize="18"/>
                <Grid Grid.Row="1" VerticalAlignment="Top" Height="30">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="30"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <RadioButton Grid.Column="0" Name="SlowButton" Content="Slow" GroupName="InflationSpeed" Style="{StaticResource SettingRadioButtonStyle}" HorizontalAlignment="Left"
                             IsChecked="{Binding InflationSpeedMode, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Slow}" />
                  <RadioButton Grid.Column="2" Name="FastButton" Content="Fast" GroupName="InflationSpeed" Style="{StaticResource SettingRadioButtonStyle}"
                             IsChecked="{Binding InflationSpeedMode, Converter={StaticResource enumBooleanConverter}, ConverterParameter=Fast}"/>
                </Grid>
              </Grid>
              <Grid Grid.Row="2" Grid.Column="0">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Display Shadowing Graph:" FontSize="18"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Height="30">
                  <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftText}"/>
                  <ToggleButton Style="{StaticResource SwitchToggleButton}" Name="toggleCanDisplayShadowGraph" IsChecked="{Binding CanDisplayShadowGraph}"/>
                  <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightText}"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="2" Grid.Column="2" Visibility="{Binding IsSiteUsingDefalteAfterThaw, Converter={StaticResource booleanToNotVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Deflate at Thaw:" FontSize="18"/>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Height="30">
                  <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftText}"/>
                  <ToggleButton Style="{StaticResource SwitchToggleButton}" Name="ToggleDeflateAfterThaw" IsChecked="{Binding DeflateAfterThaw}"/>
                  <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightText}"/>
                </StackPanel>
              </Grid>
              <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" >
                  <TextBlock Text="Default Volume:" FontSize="18" />
                  <TextBlock Text="{Binding RequiredVolume}" Foreground="#ffffffff" FontSize="18" Margin="20,0"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Top" Height="50">
                  <Button Margin="0, 2, 15,0" Style="{StaticResource VolumeDownButtonStyle}" 
                        VerticalAlignment="Top" Height="32" Width="32" Command="{Binding DecreaseVolumeCommand}"/>
                  <userControls:ProgressSettingBarControl MinValue="0" MaxValue="100" Value="{Binding RequiredVolume}" Width="145" />
                  <Button Margin="15, 2, 0,0" Style="{StaticResource VolumeUpButtonStyle}" 
                        VerticalAlignment="Top" Height="32" Width="32" Command="{Binding IncreaseVolumeCommand}"/>
                </StackPanel>
              </Grid>
              <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Left" Command="{Binding ResetLSProCommand}"
                    Content="Reconnect Recording System" Width="270" Height="38" Style="{StaticResource RoundButtonNoBorder}" Margin="0,31,0,30"/>
            </Grid>
          </Border>
        </Grid>
        <Border Grid.Column="1" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" 
              Margin="0, 20,0,0" >
          <Grid Margin="20,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="320"/>
              <RowDefinition Height="10"/>
              <RowDefinition Height ="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="NOTIFICATION PREFERENCES" FontSize="18" VerticalAlignment="Top" Margin="0,20"  FontWeight="Bold"/>
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Low Ablation Temperature:" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="1" Grid.Column="2"  HorizontalAlignment="Left" Name="LowAblationTemperature"
                                                     Unit="°C" MinValue="-90" MaxValue="30" Incremental="5" Value="{Binding LowAblationTemperatureAlarm, Mode=TwoWay}"/>

              <TextBlock Grid.Row="2" Grid.Column="0" Text="High Ablation Temperature:" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="2" Grid.Column="2" HorizontalAlignment="Left" Name="HighAblationTemperature"
                                                     Unit="°C" MinValue="-90" MaxValue="30" Incremental="5" Value="{Binding HighAblationTemperatureAlarm, Mode=TwoWay}"/>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Esophagus Temperature:" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="3" Grid.Column="2" HorizontalAlignment="Left" Name="EsophagusTemperature"
                                                     Unit="°C" MinValue="0" MaxValue="40" Incremental="1" Value="{Binding EsophagusTemperature, Mode=TwoWay}"/>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Diaphragm Sensor Limit:" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="4" Grid.Column="2" HorizontalAlignment="Left" Name="DiaphragmAmplitude"
                                                     Unit="%" MinValue="60" MaxValue="100" Incremental="5" Value="{Binding DiaphragmAmplitude, Mode=TwoWay}"/>

              <TextBlock Grid.Row="5" Grid.Column="0" Text="Diaphragm Sensor Zoom:" />
              <userControls:ValueEditorWithUpDownButtonsControl Grid.Row="5" Grid.Column="2" HorizontalAlignment="Left" Name="DiaphragmSensorGain"
                                                     Unit="%" MinValue="100" MaxValue="200" Incremental="100" Value="{Binding DiaphragmSensorGain, Mode=TwoWay}"/>
            </Grid>

            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition Height="140"/>
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid Grid.Row="0" Grid.Column="0" Margin="0,5">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="DMS:" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30">
                  <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftText}"/>
                  <ToggleButton Style="{StaticResource SwitchToggleButton}" Name="ToggleMinimumDiaphragmMovement" 
                              IsChecked="{Binding IgnoreMinimumDiaphragmMovementValue, Converter={StaticResource inverseBooleanConverter}}"/>
                  <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightText}"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,5">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Audio Alert:" />
                <StackPanel Grid.Row="1" Orientation="Horizontal"  Height="30">
                  <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftText}"/>
                  <ToggleButton Style="{StaticResource SwitchToggleButton}" Name="ToggleAudioAlert" IsChecked="{Binding IsUsingAudioAlert}"/>
                  <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightText}"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,5">
                <Grid.RowDefinitions>
                  <RowDefinition />
                  <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Enhanced Ablation Notification:" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Height="30">
                  <TextBlock Text="OFF" Style="{StaticResource ToggleButtonLeftText}"/>
                  <ToggleButton Style="{StaticResource SwitchToggleButton}" Name="ToggleAudio" IsChecked="{Binding EnableEnhancedAudio}"/>
                  <TextBlock Text="ON" Style="{StaticResource ToggleButtonRightText}"/>
                </StackPanel>
              </Grid>

              <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10" HorizontalAlignment="Left">
                <userControls:SettingBarWithButtonsControl Name="DMSDetectionThresholdLevelOneToTen" Description="DMS Sensitivity:"
                                                         MinValue="1" MaxValue="7" Incremental="1" Value="{Binding DMSDetectionThresholdValue, Mode=TwoWay}"/>
              </Grid>
            </Grid>

          </Grid>
        </Border>
        <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}" CornerRadius="10" 
              Margin="20,20,20,0">
          <Grid Margin="20,0, 0, 0" IsEnabled="{Binding IsUserAllowedToChangeAblationTimers}">
            <Grid.RowDefinitions>
              <RowDefinition Height="50"/>
              <RowDefinition Height="150"/>
              <RowDefinition Height="250"/>
              <RowDefinition Height="250"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="ABLATION TIMERS" FontWeight="Bold"/>
            <Grid Grid.Row="1">
              <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition />
              </Grid.RowDefinitions>
              <RadioButton Grid.Row="0" Name="FixedTimerRadioButton" Style="{StaticResource RadioButtonAsCheckBoxStyle}" Content="Fixed Timer:" FontFamily="{StaticResource Lato}" FontSize="18"
                         Height="25" GroupName="AblationTimer" IsChecked="{Binding AblationDurationType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=FixedTimer}"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding ElementName=FixedTimerRadioButton, Path=IsChecked}">
                <TextBlock Text="Ablation Timer:" Margin="30,0"/>
                <userControls:ValueEditorWithUpDownButtonsControl Name="FixedAblationTimer" Unit="sec" MinValue="30" MaxValue="240" Incremental="30" Value="{Binding AblationTimer, Mode=TwoWay}"/>
              </StackPanel>
              <Rectangle Grid.Row="2" Height="2" Width="520" HorizontalAlignment="Left" Fill="#ff3d3d45" />
            </Grid>
            <Grid Grid.Row="2">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <RadioButton Name="ISTTIFixedTimerSelectedRadioButton" Style="{StaticResource RadioButtonAsCheckBoxStyle}" Content="TTI Fixed Timer:" FontFamily="{StaticResource Lato}" FontSize="18"
                         Height="25"  GroupName="AblationTimer" IsChecked="{Binding AblationDurationType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=TTIFixedTimer}"/>
              <StackPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding ElementName=ISTTIFixedTimerSelectedRadioButton, Path=IsChecked}">
                <TextBlock Text="If TTI &lt;" Margin="30, 0, 5, 0" />
                <userControls:ValueEditorWithUpDownButtonsControl Name="ExpectedVeinIsolationTimeLabel" MinValue="30" MaxValue="{Binding MaxFixedTTIExpectedTimer}" Incremental="10" 
                                                                Value="{Binding ExpectedTimeToVeinIsolation, Mode=TwoWay}" />
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" IsEnabled="{Binding ElementName=ISTTIFixedTimerSelectedRadioButton, Path=IsChecked}">
                <TextBlock Text="Then " Margin="100, 0, 0, 0" Foreground="#ff7493da"/>
                <TextBlock Text="Ablation Timer:" Margin="0, 0, 5, 0" />
                <userControls:ValueEditorWithUpDownButtonsControl Name="AblationTimerTTIFixed" Unit="sec" 
                                                                MinValue="{Binding MinTTIFixedAblationTimer1}" MaxValue="210" Incremental="30" Value="{Binding AblationTimerTTIFixed, Mode=TwoWay}"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Orientation="Horizontal" IsEnabled="{Binding ElementName=ISTTIFixedTimerSelectedRadioButton, Path=IsChecked}">
                <TextBlock Text="Else " Margin="100, 0, 0, 0" Foreground="#ff7493da"/>
                <TextBlock Text="Ablation Timer:" Margin="0, 0, 15, 0" />
                <userControls:ValueEditorWithUpDownButtonsControl Name="NewAblationTimerLabelTTIFixed" Unit="sec" 
                                                                MinValue="{Binding MinTTIFixedAblationTimer2}" MaxValue="240" Incremental="30" Value="{Binding NewAblationTimerTTIFixed, Mode=TwoWay}"/>
              </StackPanel>

              <Rectangle Grid.Row="4" Height="2" Width="520" HorizontalAlignment="Left" Fill="#ff3d3d45" />
            </Grid>
            <Grid Grid.Row="3">
              <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
              </Grid.RowDefinitions>
              <DockPanel Grid.Row="0">
                <RadioButton DockPanel.Dock="Left" Name="ISTTIDurationTimerSelectedRadioButton" Style="{StaticResource RadioButtonAsCheckBoxStyle}" Content="TTI + Duration Timer:" 
                           FontFamily="{StaticResource Lato}" FontSize="18" Height="25" GroupName="AblationTimer" IsChecked="{Binding AblationDurationType, Converter={StaticResource enumBooleanConverter}, ConverterParameter=TTIDurationTimer}"/>
                <TextBlock DockPanel.Dock="Right" Text="(Max Value 240 sec)" FontSize="14" Margin="0,0,40, 0"/>
                <Grid />
              </DockPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" IsEnabled="{Binding ElementName=ISTTIDurationTimerSelectedRadioButton, Path=IsChecked}">
                <TextBlock Text="If TTI &lt;" Margin="30, 0, 5, 0" />
                <userControls:ValueEditorWithUpDownButtonsControl Name="DurationExpectedVeinIsolationTimeLabel" MinValue="30" MaxValue="210" 
                                                                Incremental="10" Value="{Binding DurationExpectedVeinIsolationTime, Mode=TwoWay}"/>
              </StackPanel>
              <StackPanel Grid.Row="2" Orientation="Horizontal" IsEnabled="{Binding ElementName=ISTTIDurationTimerSelectedRadioButton, Path=IsChecked}">
                <TextBlock Text="Then " Margin="100, 0, 0, 0" Foreground="#ff7493da"/>
                <TextBlock Text="Ablation Timer: TTI +" Margin="0, 0, 5, 0" />
                <userControls:ValueEditorWithUpDownButtonsControl Name="AblationTimerTTI" Unit="sec" MinValue="30" MaxValue="210" 
                                                                Incremental="30" Value="{Binding AblationTimerTTI, Mode=TwoWay }"/>
              </StackPanel>
              <StackPanel Grid.Row="3" Orientation="Horizontal" IsEnabled="{Binding ElementName=ISTTIDurationTimerSelectedRadioButton, Path=IsChecked}">
                <TextBlock Text="Else " Margin="100, 0, 0, 0" Foreground="#ff7493da"/>
                <TextBlock Text="Ablation Timer: TTI +" Margin="0, 0, 15, 0" />
                <userControls:ValueEditorWithUpDownButtonsControl Name="NewAblationTimerTTI" Unit="sec" MinValue="{Binding MinTTIDurationAblationTimer2}" MaxValue="240" 
                                                                Incremental="30" Value="{Binding NewAblationTimerTTI, Mode=TwoWay}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>

      </Grid>
      <DockPanel Grid.Row="2" Height="95" Margin="20, 0">
        <Grid DockPanel.Dock="Left" VerticalAlignment="Center">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="LOAD PREFERENCES" Margin="0,0" Name="ResetFromDBBtn"
                Style="{StaticResource SettingsPreferencesButton}" 
                Click="ResetFromDBBtn_OnClick" IsEnabled="{Binding CanLoadDefault}"/>
          <Button Grid.Column="1" Content="SAVE TO PREFERENCES"  Margin="20,0" Name="SaveToDBBtn"
                Style="{StaticResource SettingsPreferencesButton}" Width="210"
                Click="SaveToDBBtn_OnClick" IsEnabled="{Binding CanSavePreferences}"/>
        </Grid>

        <Grid DockPanel.Dock="Right">
          <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" Content="Cancel"  Name="CancelButton" 
                Style="{StaticResource TextWithUnderlineButton}" Click="No_Click" IsCancel="True" />
          <Button Grid.Column="1" Content="APPLY" Margin="20,0,0,0" 
                Style="{StaticResource SettingsApplyButton}" Name="ApplyBtn"
                Click="Apply_Click" IsEnabled="{Binding IsSettingsDirtyFromUI}"/>
        </Grid>
        <Grid />
      </DockPanel>
    
  </Grid>
  </Border>
</Window>
