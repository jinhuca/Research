<UserControl x:Class="SmartAblationSystem.Views.ETS"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             mc:Ignorable="d" d:DesignWidth="70" d:DesignHeight="230">
        
            <Grid Width="50" Height="230">
                <Grid.Background>
                    <ImageBrush ImageSource="/Images/Circa Vertical.png" />                  
                </Grid.Background>
                <!--<Label Content="Sensor 8" Foreground="Yellow" ></Label>-->
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="1*" />
  
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Button x:Name="ETSBtn1" Style="{StaticResource ButtonYellow}" Grid.Column="1" Grid.Row="1" Margin="-14,4,0,0" Height="18" Width="18" Content="1" FontSize="12"  Foreground="Black"  />
                <Button x:Name="ETSBtn2" Style="{StaticResource ButtonTransparent}" Grid.Column="2" Grid.Row="2" Margin="-4,-20,0,0" Height="18" Width="18" Content="" FontSize="12" Grid.ColumnSpan="2"  Foreground="Black"  />
                <Button x:Name="ETSBtn15" Style="{StaticResource ButtonYellow}" Grid.Column="2" Grid.Row="4" Margin="-29,-26,0,0" Height="18" Width="18" Content="5" FontSize="12" Grid.ColumnSpan="2"  Foreground="Black"  />
                <Button x:Name="ETSBtn11" Style="{StaticResource ButtonYellow}" Grid.Column="3" Grid.Row="7" Margin="-7,-5,0,0"  Height="18" Width="18" Content="11" FontSize="12" Grid.ColumnSpan="2"  Foreground="Black"  />
                <Button x:Name="ETSBtn12" Style="{StaticResource ButtonYellow}" Grid.Column="1" Grid.Row="7" Margin="1,4,0,0"  Height="18" Width="18" Content="12" FontSize="12" Grid.RowSpan ="2" Grid.ColumnSpan="2"  Foreground="Black"  />
    </Grid>

</UserControl>
