<UserControl x:Class="SmartAblationSystem.Views.Home"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:i="clr-namespace:System.Windows.Interactivity;assembly=System.Windows.Interactivity"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             xmlns:local="clr-namespace:SmartAblationSystem.Views"
             xmlns:convertersNew="clr-namespace:SmartAblationSystem.ConvertersNew"
             mc:Ignorable="d" 
             d:DesignHeight="1080" d:DesignWidth="1920"
             Height="1080" Width="1920">
  <i:Interaction.Triggers>
    <i:EventTrigger EventName="Loaded">
      <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
    </i:EventTrigger>
  </i:Interaction.Triggers>
  <UserControl.Resources>
    <convertersNew:UserNameVisibilityConverter x:Key="UserNameVisibilityConverter_"/>
  </UserControl.Resources>
  <Grid Opacity="{Binding HomePageOpacity}">
    <Grid.Background>
      <ImageBrush ImageSource="../Images/HomeBackground2.png"/>
    </Grid.Background>
    <Canvas>
      <StackPanel Style="{StaticResource HospitalLogoStackPanelOnHomeStyle_}">
        <TextBlock Text="Hospital:" 
                   Style="{StaticResource HospitalTitleTextBlockStyle_}"/>
        <TextBlock Text="{Binding HospitalName}" 
                   Style="{StaticResource HospitalNameTextBlockStyle_}"/>
      </StackPanel>
      <Image Style="{StaticResource LogoImageOnHomeStyle_}"/>
    </Canvas>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="80"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="80"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="140"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.RowSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" 
                  Style="{StaticResource CryoTherapyButtonStyle_}" 
                  Command="{Binding CryoTherapyCommand}"/>
          <Button Grid.Column="1" 
                  Style="{StaticResource RecordsButtonStyle_}" 
                  Command="{Binding RecordCommand}"/>
          <Button Grid.Column="2" 
                  Style="{StaticResource ChangeTankButtonStyle_}" 
                  Command="{Binding TankCommand}"/>
          <Button Grid.Column="3" 
                  Style="{StaticResource SettingsButtonStyle_}" 
                  Command="{Binding ServiceCommand}"/>
        </Grid>
        <Grid Grid.Row="1" HorizontalAlignment="Center"  VerticalAlignment="Top">
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0" 
                  Style="{StaticResource LogOutButtonStyle_}" 
                  Visibility="{Binding UserName, Converter={StaticResource UserNameVisibilityConverter_}}"
                  Command="{Binding LogoutCommand}">
            <Button.Content>
              <Grid HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" 
                           Text="Log Out: " 
                           Style="{StaticResource LogTextBlockStyle_}" 
                           HorizontalAlignment="Right"/>
                <TextBlock Grid.Column="1" 
                           Text="{Binding UserName}" 
                           Style="{StaticResource LogTextBlockStyle_}" 
                           HorizontalAlignment="Left"/>
              </Grid>
            </Button.Content>
          </Button>
          <Button Grid.Column="1" 
                  Command="{Binding ShutDownCommand}"
                  Style="{StaticResource ShutdownButtonStyle_}"/>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
