<Window x:Class="SmartAblationSystem.Views.MessagePopup"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:SmartAblationSystem.Views"
      xmlns:mvvm="http://prismlibrary.com/"
      WindowStyle="None" AllowsTransparency="True" Background="Transparent"
      SizeToContent="WidthAndHeight" 
      WindowStartupLocation="CenterScreen" 
      mvvm:ViewModelLocator.AutoWireViewModel="True"
      mc:Ignorable="d" ResizeMode="NoResize">
  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="booleanToVisibilityConverter"/>

    <Color x:Key="MessageTitleBackgroundColor">#FF34343E</Color>
    <SolidColorBrush x:Key="MessageTitleBackgroundBrush" Color="{StaticResource MessageTitleBackgroundColor}"/>
    <Color x:Key="MessageDetailForegroundColor">#FFCEC3C6</Color>
    <SolidColorBrush x:Key="MessageDetailForegroundBrush" Color="{StaticResource MessageDetailForegroundColor}"/>

    <Style TargetType="TextBlock" x:Key="MessageBaseStyle">
      <Setter Property="FontFamily" Value="{StaticResource Lato}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="FontWeight" Value="Regular" />
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="NotificationButtonStyle" TargetType="Button">
      <Setter Property="Foreground" Value="#FF000000" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Width" Value="31" />
      <Setter Property="Margin" Value="10,0" />
      <Setter Property="Template" >
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border Background="Transparent" Name="_mainBorder">
              <Canvas>
                <Line  X1="0" Y1="0" X2="0" Y2="8" Stroke="{TemplateBinding Foreground}" Canvas.Left="15.7" Canvas.Top="9" StrokeThickness="2" />
                <Path  Width="31" Height="26" Stretch="uniform" Stroke="{TemplateBinding Foreground}"  Canvas.Left="0" Canvas.Top="0" 
                       Data="M 14,3 C 14.7,1.6 16.6,1.6 17.4,2.9 L 29.6,23.7 C 30.4,25 29.4,26.7 27.9,26.7 L 3.5,26.7 C 1.9,26.7 1,25 1.8,23.7 Z" StrokeThickness="2"/>
                <Ellipse  Width="2" Height="2" Stroke="{TemplateBinding Foreground}" Canvas.Left="14.8 " Canvas.Top="20" StrokeThickness="2"/>
              </Canvas>
            </Border>

            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding MessageType}" Value="ErrorMessage">
                <Setter Property="Foreground" Value="#FFFFFFFF" />
              </DataTrigger>
              <DataTrigger Binding="{Binding MessageType}" Value="SystemMessage">
                <Setter Property="Foreground" Value="#FFFFFFFF" />
              </DataTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionBackgroundStyle" TargetType="Path">
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="Fill" Value="#FF475E8B" />
      <!-- <Setter Property="Fill" Value="#FFFFE472" /> -->
      <Style.Triggers>
        <DataTrigger Binding="{Binding MessageType}" Value="ErrorMessage">
          <Setter Property="Fill" Value="#FFC12B48"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding MessageType}" Value="WarningMessage">
          <Setter Property="Fill" Value="#FFFFE472"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CaptionHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MessageBaseStyle}">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="TextAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <!-- <Setter Property="Foreground" Value="#FF000000" /> -->
      <Style.Triggers>
        <DataTrigger Binding="{Binding MessageType}" Value="ErrorMessage">
          <Setter Property="Foreground" Value="#FFFFFFFF"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding MessageType}" Value="WarningMessage">
          <Setter Property="Foreground" Value="#FF000000"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="MessageTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MessageBaseStyle}">
      <Setter Property="Foreground" Value="#FFFFFFFF" />
      <Setter Property="FontSize" Value="20" />
    </Style>

    <Style x:Key="MessageDetailTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MessageBaseStyle}">
      <Setter Property="Foreground" Value="{StaticResource MessageDetailForegroundBrush}" />
      <Setter Property="FontSize" Value="18" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Margin" Value="20,0" />
    </Style>
  </Window.Resources>
  <!-- Width="718" Height="535" -->
  <Border Width="718" Background="#ff2b2b33" CornerRadius="8" BorderThickness="0" Margin="0,0, 10, 10">
    <Border.Effect>
      <DropShadowEffect BlurRadius="15" Opacity="0.8"/>
    </Border.Effect>
    <Grid Margin="0" >
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Grid Grid.Row="0">
        <Path Width="718" Height="78" Style="{StaticResource CaptionBackgroundStyle}" 
              Data="M 170,0 L 868,0 
             C 873.52,0 878,4.48 878,10 
             L 878,78 L 160,78 L 160,10 
             C 160,4.48 164.48,0 170,0 Z"  
              Stroke="#ff707070" StrokeThickness="0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
          <Button Style="{StaticResource NotificationButtonStyle}" Visibility="{Binding HasCryterionMessage, Converter={StaticResource booleanToVisibilityConverter}}"
                  Command="{Binding SwitchEngineeringMessageCommand}"/>
          <TextBlock Text="{Binding CaptionTitle}" Style="{StaticResource CaptionHeaderTextStyle}" />
        </StackPanel>
      </Grid>

      <Grid Grid.Row="1" VerticalAlignment="Center" Height="80" Margin="0, 0, 0, 0" 
            Visibility="{Binding HasMessageId, Converter={StaticResource booleanToVisibilityConverter}}">
        <Border Width="638" Height="53" VerticalAlignment="Center" CornerRadius="5" Background="{StaticResource MessageTitleBackgroundBrush}">
          <TextBlock Text="{Binding CurrentMessageId}" Style="{StaticResource MessageTitleTextStyle}" HorizontalAlignment="Center"/>
        </Border>
      </Grid>
      <Grid Grid.Row="2" Margin="40, 10">
        <ScrollViewer Height="60" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding CurrentMessage}" Style="{StaticResource MessageDetailTextStyle}" 
                     TextAlignment="Center"/>
        </ScrollViewer>
      </Grid>

      <Grid Grid.Row="3" VerticalAlignment="Center" Height="80" Visibility="{Binding IsActionRequired, Converter={StaticResource booleanToVisibilityConverter}}">
        <Border Width="638" Height="53" VerticalAlignment="Center" CornerRadius="5" Background="{StaticResource MessageTitleBackgroundBrush}">
          <TextBlock Text="Action Required" Style="{StaticResource MessageTitleTextStyle}" HorizontalAlignment="Center"/>
        </Border>
      </Grid>

      <Grid Grid.Row="4" Margin="40, 0" Visibility="{Binding IsActionRequired, Converter={StaticResource booleanToVisibilityConverter}}">
        <ScrollViewer Height="110" VerticalScrollBarVisibility="Auto">
          <TextBlock Text="{Binding CurrentSolution}" Style="{StaticResource MessageDetailTextStyle}"
                   TextAlignment="Left"/>
        </ScrollViewer>
      </Grid>

      <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Height="80" 
                  Visibility="{Binding HasMoreThan1Messages, Converter={StaticResource booleanToVisibilityConverter}}">
        <Button Style="{StaticResource LeftArrowButtonStyle_}" Margin="0" Height="40" Width="40" 
                Command="{Binding NavigatePreviousMessageCommand}"/>
        <TextBlock Style="{StaticResource MessageDetailTextStyle}" >
          <TextBlock.Text>
            <MultiBinding StringFormat="{} {0} of {1}">
              <Binding Path="CurrentMessageIndex" />
              <Binding Path="TotalNumOfMessages" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <Button Style="{StaticResource RightArrowButtonStyle_}" Margin="0" Height="40" Width="40"
                Command="{Binding NavigateNextMessageCommand}"/>
      </StackPanel>

      <Grid Grid.Row="6" Height="90" >
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition />
          <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <ToggleButton Grid.Row="0" HorizontalAlignment="Left" Height="30" Style="{StaticResource VolumeMuteToggleBtnStyle}"
                      IsChecked="{Binding IsVolumeMuted}" Margin="30,30,0,30" 
                      Visibility="{Binding IsVolumeControlEnabled, Converter={StaticResource booleanToVisibilityConverter}}"
                      Command="{Binding MuteVolumeCommand}" />

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" >
          <Button Content="{Binding LeftButtonText}" Style="{StaticResource SettingsPreferencesButton}" Width="80" Height="48" HorizontalAlignment="Right" 
                  Click="Yes_Click"/>
          <Button  Content="{Binding RightButtonText}" Style="{StaticResource SettingsPreferencesButton}" Width="80" Height="48" HorizontalAlignment="Left" 
                   Click="No_Click" Visibility="{Binding HasTwoButtons, Converter={StaticResource booleanToVisibilityConverter}}" Margin="20,0,0,0"/>
        </StackPanel>
      </Grid>
    </Grid>

  </Border>
</Window>