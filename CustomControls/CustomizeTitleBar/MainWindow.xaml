<Window x:Class="CustomizeTitleBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomizeTitleBar"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
                WindowStyle="None"
        WindowStartupLocation="CenterScreen">
  <!-- 1. Maintain Native Windows Behaviors -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" 
                      ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" 
                      GlassFrameThickness="0" 
                      CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- 2. Clean Style for Title Bar Control Buttons -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="46"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <!-- Explicitly allow clicks to pass through the WindowChrome drag region -->
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#303030"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <!-- Top row dedicated for the custom Title Bar -->
      <RowDefinition Height="32"/>
      <!-- Bottom row reserved for Main Client Content -->
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom Title Bar Panel -->
    <Grid Grid.Row="0" Background="#181818">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Window Title Text -->
      <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                       Foreground="DarkGray" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12"/>

      <!-- Window Caption Buttons Wrapper -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
        <!-- Minimize Button using Segoe MDL2 Assets Glyph -->
        <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
          <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
        </Button>

        <!-- Maximize / Restore Toggle Button -->
        <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
          <TextBlock x:Name="TxtMaximize" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
        </Button>

        <!-- Close Button with Custom Red Hover State -->
        <Button Click="CloseButton_Click" ToolTip="Close">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#E81123"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
          <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Main Window Client Application Content Area -->
    <Grid Grid.Row="1" Background="#202020">
      <TextBlock Text="Your App Content Goes Here" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="20"/>
    </Grid>
  </Grid>


</Window>
