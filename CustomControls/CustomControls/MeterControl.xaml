<UserControl x:Class="CustomControls.MeterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:local="clr-namespace:CustomControls"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=local:MeterControl, IsDesignTimeCreatable=True}"
             d:DesignHeight="450" d:DesignWidth="800">
  <UserControl.Resources>
    <!--<local:ValueToAngleConverter x:Key="ValueToAngleConverter"/>-->
    <local:MultiValuesToAngleConverter x:Key="multiValuesToAngleConverter"/>
    <local:ValuesToDisplayConverter x:Key="valuesToDisplayConverter"/>
  </UserControl.Resources>
  <Grid Background="#FF2E2F45">
    <Grid Margin="0,0,0,0">
      <ed:Arc StartAngle="-120" EndAngle="120"
              Stretch="None" Height="300" Width="300" 
              StrokeThickness="20" StrokeDashArray=".15" 
              Stroke="{Binding GaugeColor, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
      <ed:Arc StartAngle="-120"
              Stretch="None" Height="300" Width="300" 
              StrokeThickness="20" StrokeDashArray=".15" 
              Stroke="{Binding NeedleColor, RelativeSource={RelativeSource AncestorType=UserControl}}">
        <ed:Arc.EndAngle>
          <MultiBinding Converter="{StaticResource multiValuesToAngleConverter}">
            <Binding Path="Value" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
            <Binding Path="MinValue" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
            <Binding Path="MaxValue" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
          </MultiBinding>
        </ed:Arc.EndAngle>
      </ed:Arc>
    </Grid>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0">
      <TextBlock Text="{Binding Label, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                 Foreground="#FF878A9F" HorizontalAlignment="Center" FontSize="14"/>
      <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Foreground="White" HorizontalAlignment="Center" 
                   FontSize="90" FontWeight="Light">
          <TextBlock.Text>
            <MultiBinding Converter="{StaticResource valuesToDisplayConverter}">
              <Binding Path="Value" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
              <Binding Path="MinValue" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
              <Binding Path="MaxValue" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
              <Binding Path="Unit" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>
        <TextBlock Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-12,0,0"
                   FontSize="20" FontWeight="Light"/>
      </StackPanel>
    </StackPanel>
  </Grid>
</UserControl>
