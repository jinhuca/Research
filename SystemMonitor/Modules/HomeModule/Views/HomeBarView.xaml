<UserControl x:Class="HomeModule.Views.HomeBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:sharedDefs="clr-namespace:SharedDefinitions;assembly=SharedDefinitions"
             xmlns:local="clr-namespace:HomeModule.Views"
             mc:Ignorable="d">
  <Border Style="{StaticResource ModuleBorderStyle}" VerticalAlignment="Stretch">
    <UniformGrid Columns="1" Margin="10" Background="Transparent" VerticalAlignment="Top" IsHitTestVisible="True">
      <Grid Margin="0,15,0,0" Background="Transparent">
        <i:Interaction.Triggers>
          <i:EventTrigger EventName="PreviewMouseLeftButtonDown">
            <prism:InvokeCommandAction Command="{Binding NavigateCommand}"
                                       CommandParameter="{x:Static sharedDefs:ViewNames.CpuViewName}"/>
          </i:EventTrigger>
        </i:Interaction.Triggers>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}"
            IsHitTestVisible="False"/>
        <!-- 👈 -->
        <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource HomePanelTextStyle}"
               IsHitTestVisible="False"/>
        <!-- 👈 -->
      </Grid>
      <Grid Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
        </Border>
        <TextBlock Grid.Column="1" Text="Memory" Style="{StaticResource HomePanelTextStyle}"/>
      </Grid>
      <Grid Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
        </Border>
        <TextBlock Grid.Column="1" Text="Disk 0" Style="{StaticResource HomePanelTextStyle}"/>
      </Grid>
      <Grid Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
        </Border>
        <TextBlock Grid.Column="1" Text="Wi-Fi" Style="{StaticResource HomePanelTextStyle}"/>
      </Grid>
      <Grid Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
        </Border>
        <TextBlock Grid.Column="1" Text="GPU 0" Style="{StaticResource HomePanelTextStyle}"/>
      </Grid>
      <Border Background="Transparent" Style="{StaticResource HomePanelBorderStyle}"
              >
        
      </Border>
        <Grid Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
        </Border>
        <TextBlock Grid.Column="1" Text="GPU 1" Style="{StaticResource HomePanelTextStyle}"/>
      </Grid>
      <Grid Margin="0,15,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
        </Border>
        <TextBlock Grid.Column="1" Text="Fans" Style="{StaticResource HomePanelTextStyle}"/>
      </Grid>
    </UniformGrid>
  </Border>

</UserControl>
