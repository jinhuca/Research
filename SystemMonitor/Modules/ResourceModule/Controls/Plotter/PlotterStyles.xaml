<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:brushes="clr-namespace:ResourceModule"
                    xmlns:local="clr-namespace:ResourceModule.Controls.Plotter">
  <Style x:Key="PlotterBaseStyle"
         TargetType="{x:Type local:PlotterControl}">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
    <Setter Property="Margin" Value="0"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Black"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="PlotStroke" Value="Black"/>
    <Setter Property="RangeAreaBrush" Value="LightGray"/>
  </Style>

  <Style x:Key="LoadPlotterStyle" 
       TargetType="{x:Type local:PlotterControl}"
       BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource LoadSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource LoadRangeLinearGradientBrush}"/>
  </Style>

  <Style x:Key="PowerPlotterStyle" 
       TargetType="{x:Type local:PlotterControl}"
       BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource PowerSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource PowerRangeLinearGradientBrush}"/>
  </Style>

  <Style x:Key="VoltagePlotterStyle"
         TargetType="{x:Type local:PlotterControl}"
         BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource VoltageSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource VoltageRangeLinearGradientBrush}"/>
  </Style>

  <Style x:Key="TemperaturePlotterStyle"
         TargetType="{x:Type local:PlotterControl}"
         BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource TemperatureSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource TemperatureRangeLinearGradientBrush}"/>
  </Style>

  <Style x:Key="ClockPlotterStyle"
         TargetType="{x:Type local:PlotterControl}"
         BasedOn="{StaticResource PlotterBaseStyle}">
    <Setter Property="PlotStroke" Value="{StaticResource ClockSolidColorBrush}"/>
    <Setter Property="RangeAreaBrush" Value="{StaticResource ClockRangeLinearGradientBrush}"/>
  </Style>
</ResourceDictionary>