<UserControl x:Class="ResourceModule.Controls.Bar.ValueIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ResourceModule.Controls.Bar"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <UserControl.Resources>
    <VisualBrush x:Key="DashBrush" TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
      <VisualBrush.Visual>
        <Canvas>
          <Rectangle Width="6" Height="10" Fill="Transparent"/>
          <Rectangle Width="5" Height="10" Fill="{Binding IndicatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </Canvas>
      </VisualBrush.Visual>
    </VisualBrush>
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="Root">
              <!-- The Track (background of the bar) -->
              <Border x:Name="PART_Track" 
                    Background="LightGray" 
                    CornerRadius="2"/>
              <!-- The Indicator (the actual progress part) -->
              <Border x:Name="PART_Indicator" 
                    HorizontalAlignment="Left" 
                    Background="{StaticResource DashBrush}" 
                    CornerRadius="2"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Grid Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
      TextElement.FontFamily="{Binding ControlFontFamily, RelativeSource={RelativeSource AncestorType=UserControl}}"
      TextElement.FontSize="{Binding ControlFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
      TextElement.FontWeight="{Binding ControlFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
      TextElement.Foreground="{Binding ControlForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
        ShowGridLines="False">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="2.5cm"/>
      <ColumnDefinition Width="5.0cm"/>
      <ColumnDefinition Width="1.3cm"/>
      <ColumnDefinition Width="0.6cm"/>
      <ColumnDefinition Width="0.5cm"/>
      <ColumnDefinition Width="1.0cm"/>
      <ColumnDefinition Width="2.0cm"/>
    </Grid.ColumnDefinitions>
    <!-- (1) Title -->
    <TextBlock Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,0,0" 
               Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontSize="{Binding TitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding TitleFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding TitleForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (2) ValueId -->
    <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,5,0" 
               Text="{Binding ValueId, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontSize="{Binding ValueIdFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding ValueIdFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding ValueIdForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (3) ValueBar -->
    <ProgressBar Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,2,0,2"
                 Width="{Binding IndicatorWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                 Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Minimum="{Binding Minimum, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                 Maximum="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}}"
                 Value="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (4) Value Text -->
    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0.2cm,0,0,0"
               Text="{Binding Value, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F2}}" 
               FontSize="{Binding ValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding ValueFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding ValueForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (5) Unit -->
    <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0.1cm,0,0,0" 
               Text="{Binding Unit, RelativeSource={RelativeSource AncestorType=UserControl}}" 
               FontSize="{Binding UnitFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding UnitFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding UnitForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (6) Separator -->
    <Rectangle Grid.Column="5" RadiusX="1" RadiusY="1" Margin="0,0,0,0"
               Height="{Binding IndicatorHeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Width="{Binding SeparatorWidth, RelativeSource={RelativeSource AncestorType=UserControl}}" 
               Fill="{Binding SeparatorBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (7) Max Title -->
    <TextBlock Grid.Column="6" HorizontalAlignment="Left" VerticalAlignment="Center" 
               Text="{Binding MaxTitle, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontSize="{Binding MaxTitleFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding MaxTitleFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding MaxTitleBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
    <!-- (8) Max Value -->
    <TextBlock Grid.Column="7" HorizontalAlignment="Right" VerticalAlignment="Center" 
               Text="{Binding Maximum, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat={}{0:F2}}"
               FontSize="{Binding MaxValueFontSize, RelativeSource={RelativeSource AncestorType=UserControl}}"
               FontWeight="{Binding MaxValueFontWeight, RelativeSource={RelativeSource AncestorType=UserControl}}"
               Foreground="{Binding MaxValueBrush, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
  </Grid>
</UserControl>
