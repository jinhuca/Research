<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style TargetType="TextBlock" x:Key="ModuleTitleTextStyle">
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontStyle" Value="Normal"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="ModuleContentTitleStyle">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="#FF878A9F"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="1,0,0,0"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="ModuleContentTextStyle">
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="1,0,0,0"/>
  </Style>
  <Style TargetType="TextBlock" x:Key="ModuleContentValueStyle">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="Foreground" Value="White"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="Margin" Value="1,0,0,0"/>
  </Style>
</ResourceDictionary>