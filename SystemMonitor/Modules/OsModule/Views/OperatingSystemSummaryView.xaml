<UserControl x:Class="OsModule.Views.OperatingSystemSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:local="clr-namespace:OsModule"
             xmlns:localView="clr-namespace:OsModule.Views"
             xmlns:localViewModel="clr-namespace:OsModule.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Border Style="{StaticResource ModuleBorderStyle}">
    <Grid Height="4cm" Width="Auto" Margin="0.5cm,0,0,0" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="0.6cm"/>
        <RowDefinition Height="0.6cm"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.00cm"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" 
                 Style="{StaticResource ModuleTitleTextStyle}" VerticalAlignment="Center"
                 Text="{x:Static localView:ViewDefinitions.ModuleName}"/>

      <StackPanel Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0.5cm,0"
                 Style="{StaticResource ModuleContentTitleStyle}"
                 Text="{x:Static localView:ViewDefinitions.CaptionTitle}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0.5cm,0"
                 Style="{StaticResource ModuleContentTextStyle}"
                 Text="{Binding Caption}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}" 
                   Text="{x:Static localView:ViewDefinitions.VersionTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding Version}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}" 
                   Text="{x:Static localView:ViewDefinitions.BuildNumberTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding BuildNumber}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="4" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.OSArchitectureTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding OSArchitecture}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="5" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.LanguageTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding Language}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="6" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.CodeSetTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding CodeSet}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="7" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.TimeZoneTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding TimeZone}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="8" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.LocaleTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding Locale}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="9" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.SerialNumberTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding SerialNumber}"/>
      </StackPanel>

      <StackPanel Grid.Row="0" Grid.Column="10" Grid.RowSpan="2" 
                  Style="{StaticResource VerticalKeyValueStackPanelStyle}">
        <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static localView:ViewDefinitions.CSNameTitle}"/>
        <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding CSName}"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
