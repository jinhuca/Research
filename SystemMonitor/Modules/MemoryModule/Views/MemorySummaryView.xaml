<UserControl x:Class="MemoryModule.Views.MemorySummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:local="clr-namespace:MemoryModule.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Border Style="{StaticResource ModuleBorderStyle}">
    <Grid Margin="10" ShowGridLines="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="1.60cm"/>
        <RowDefinition Height="2.00cm"/>
        <RowDefinition Height="2.00cm"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1*"/>
        <ColumnDefinition Width="1.0*"/>
        <ColumnDefinition Width="1.3*"/>
        <ColumnDefinition Width="2*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5.00cm"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0">
          <TextBlock Style="{StaticResource ModuleTitleTextStyle}" 
                     Text="{x:Static local:ViewDefinitions.ModuleName}"/>
          <TextBlock Style="{StaticResource ModuleSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.MemoryUsageName}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
          <TextBlock Style="{StaticResource ModuleContentValueStyle}" HorizontalAlignment="Right"
                     Text="{Binding TotalMemorySize}"/>
          <TextBlock Style="{StaticResource ValueTextStyle}" HorizontalAlignment="Right"
                     Text="{Binding AvailableMemorySize}"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" VerticalAlignment="Top" HorizontalAlignment="Right">  
        <!-- stick info -->
        <ListBox ItemsSource="{Binding StickViewModel}" Background="Black" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Text="{x:Static local:ViewDefinitions.StickTitle}" 
                           Style="{StaticResource ValueTextStyle}"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding Id}" 
                           Style="{StaticResource ValueTextStyle}"/>
                <TextBlock Grid.Column="2" 
                           Text="{Binding CapacityInGB}" 
                           Style="{StaticResource ValueTextStyle}"/>
                <TextBlock Grid.Column="3" 
                           Text="{Binding SpeedInGHz}" 
                           Style="{StaticResource ValueTextStyle}"/>
                <TextBlock Grid.Column="4" 
                           Text="{Binding FormFactor}" 
                           Style="{StaticResource ValueTextStyle}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!--<ListView ItemsSource="{Binding StickViewModel}" Background="Black">
          <ListView.View>
            <GridView>
              <GridViewColumn Width="1.20cm">
                <GridViewColumn.Header>
                  <TextBlock Text="{StaticResource }"
                </GridViewColumn.Header>
              </GridViewColumn>
            </GridView>
          </ListView.View>
        </ListView>-->
      </Grid>
    </Grid>
  </Border>
</UserControl>
