<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CpuModule.Views"
             xmlns:prism="http://prismlibrary.com/" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid Background="LightBlue" ShowGridLines="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="65"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Row="0" Grid.Column="0" Background="LightCoral">
      <TextBlock Grid.Column="0" Grid.Row="0"
                 Text="CPU" FontSize="32"/>
    </Grid>
    <Grid Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
          Background="LightGreen">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Right"
                 Text="{Binding BrandName}" FontSize="20"/>
      <TextBlock Grid.Row="1" HorizontalAlignment="Right"
                 Text="{Binding VendorName}" FontSize="20"/>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="1" Background="LightGreen" Margin="10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.BaseSpeedTitle}"/>
        <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding BaseSpeed}"/>
        
        <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.SocketNumTitle}"/>
        <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding SocketNum}"/>

        <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.PhysicalCoreNumTitle}"/>
        <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding PhysicalCoresNum}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.LogicalCoreNumTitle}"/>
        <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding LogicalCoresNum}"/>

        <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.VirtualizationTitle}"/>
        <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding Virtualization}"/>

        <TextBlock Grid.Row="5" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.L1CacheSizeTitle}"/>
        <TextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding L1CacheSize}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.L2CacheSizeTitle}"/>
        <TextBlock Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding L2CacheSize}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.L3CacheSizeTitle}"/>
        <TextBlock Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding L3CacheSize}"/>
      </Grid>
    </Grid>

    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="LightGray">
      <TextBlock FontSize="20" 
                 Text="{Binding Utilization, StringFormat='{}{0:F2} %'}"/>
    </Grid>
  </Grid>
</UserControl>
