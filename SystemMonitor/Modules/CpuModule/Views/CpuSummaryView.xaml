            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"
                     Style="{StaticResource ModuleSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.LoadsTitle}"/>
          <Viewbox Grid.Row="1" Style="{StaticResource MeterViewBoxStyle}" Width="120">
            <meter:MeterControl Label="{x:Static local:ViewDefinitions.UtilizationTitle}" 
                                Value="{Binding LiveViewModel.CpuOverallLiveViewModel.LoadViewModel}"
                                Style="{StaticResource LoadsMeterStyle}"/>
          </Viewbox>
          <ListView Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding LiveViewModel.CoreLiveViewModel}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <ctrl:ValueBar Title="{Binding Name}"
                               Value="{Binding Load.Value}"
                               Minimum="{Binding Load.Min}"
                               Maximum="{Binding Load.Max}"
                               Style="{StaticResource LoadsIndicatorStyle}"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>
        </Grid>-->
      </Grid>

      <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10,10,10,10" 
            MinHeight="30" Height="7cm">

          <ploter:PlotterControl Grid.Row="0" 
                                 Margin="0" 
                                 Background="Transparent"
                                 BorderThickness="0" 
                                 HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch" 
                                 Width="Auto" 
                                 Height="Auto"
                                 PlotStroke="AliceBlue" 
                                 YMin="0" 
                                 YMax="100" 
                                 DataSource="{Binding LiveViewModel.CpuOverallLiveViewModel.LoadViewModel, TargetNullValue=0}"/>
      </Grid>
      
      <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Margin="0">
        <!--<Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>-->
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Instruction Set Features: " Style="{StaticResource ModuleContentTitleStyle}"
             VerticalAlignment="Top" Foreground="Yellow"/>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryViewModel.CpuInstructionsViewModel}"
                Margin="20,5" Background="Transparent">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="12" Margin="0,0,10,0"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemContainerStyle>
            <Style TargetType="ContentPresenter">
              <Setter Property="Width" Value="100"/>
              <Setter Property="Height" Value="26"/>
              <Setter Property="Margin" Value="0,-5,0,-5"/>
              <Setter Property="HorizontalAlignment" Value="Center"/>
              <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Label Content="{Binding Key}" FontWeight="Bold" Margin="0">
                <Label.Style>
                  <Style TargetType="Label">
                    <Setter Property="Foreground" Value="Gray"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding Value}" Value="True">
                        <Setter Property="Foreground" Value="{StaticResource ValueBrush}"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Label.Style>
              </Label>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>

      <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0.5cm" Width="Auto" 
            VerticalAlignment="Stretch" HorizontalAlignment="Right" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="4.00cm"/>
          <ColumnDefinition Width="4.00cm"/>
          <ColumnDefinition Width="4.00cm"/>
          <ColumnDefinition Width="6.00cm"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
               Text="{x:Static local:ViewDefinitions.ProcessesTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentValueStyle}"
               Text="{Binding LiveViewModel.CpuOverallLiveViewModel.ProcessNum}"/>
        </StackPanel>

        <StackPanel Grid.Column="1" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
               Text="{x:Static local:ViewDefinitions.ThreadsTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentValueStyle}"
               Text="{Binding LiveViewModel.CpuOverallLiveViewModel.ThreadNum}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
               Text="{x:Static local:ViewDefinitions.HandlesTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentValueStyle}"
               Text="{Binding LiveViewModel.CpuOverallLiveViewModel.HandleNum}"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
               Text="{x:Static local:ViewDefinitions.UpTimeTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentValueStyle}"
               Text="{Binding LiveViewModel.CpuOverallLiveViewModel.UpTime, StringFormat='{}{0:dd\\.hh\\:mm\\:ss}'}"/>
        </StackPanel>
      </Grid>

    </Grid>
    </Border>
  </Grid>
</UserControl>
