          <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}" Margin="0,0,10,0"
                     Text="{Binding SummaryViewModel.PhysicalCoreNumViewModel}"/>
          <TextBlock Grid.Column="2" Style="{StaticResource ModuleContentTitleStyle}" Margin="0,0,10,0"
                     Text="{x:Static local:ViewDefinitions.LogicalCoreNumTitle}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource ModuleContentTextStyle}" Margin="0,0,30,0"
                     Text="{Binding SummaryViewModel.LogicalCoreNumViewModel}"/>
          <TextBlock Grid.Column="6" Style="{StaticResource ModuleContentTitleStyle}" Margin="0,0,10,0"
                     Text="{x:Static local:ViewDefinitions.L1CacheSizeTitle}"/>
          <TextBlock Grid.Column="7" Style="{StaticResource ModuleContentTextStyle}" Margin="0,0,10,0"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L1_Cache_size}"/>
          <TextBlock Grid.Column="8" Style="{StaticResource ModuleContentTitleStyle}" Margin="0,0,10,0"
                     Text="{x:Static local:ViewDefinitions.L2CacheSizeTitle}"/>
          <TextBlock Grid.Column="9" Style="{StaticResource ModuleContentTextStyle}" Margin="0,0,10,0"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L2_Cache_size}"/>
          <TextBlock Grid.Column="10" Style="{StaticResource ModuleContentTitleStyle}" Margin="0,0,10,0"
                     Text="{x:Static local:ViewDefinitions.L3CacheSizeTitle}"/>
          <TextBlock Grid.Column="11" Style="{StaticResource ModuleContentTextStyle}" Margin="0,0,10,0"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L3_Cache_size}"/>
          <TextBlock Grid.Column="12" Style="{StaticResource ModuleContentTitleStyle}" Margin="20,0,10,0"
                     Text="{x:Static local:ViewDefinitions.L1CacheLineSizeTitle}"/>
          <TextBlock Grid.Column="13" Style="{StaticResource ModuleContentTextStyle}" Margin="0,0,10,0"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L1_Cache_Line_size}"/>
        </Grid>
      </Grid>
      
      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,10" 
            HorizontalAlignment="Stretch" VerticalAlignment="Top" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!-- Voltages -->
        <Grid Grid.Column="0" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--<RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>-->
            <!--<RowDefinition Height="Auto"/>-->
          </Grid.RowDefinitions>
          <!--<TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"
                     Style="{StaticResource ModuleSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.VoltageTitle}"/>-->
          <Viewbox Grid.Row="0" Style="{StaticResource MeterViewBoxStyle}" Width="8.00cm">
            <meter:MeterControl Label="{x:Static local:ViewDefinitions.VoltageTitle}" 
                                Value="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformVoltageValueViewModel}"
                                MinValue="0"
                                MaxValue="2"
                                Unit="Volts"
                                Style="{StaticResource VoltageMeterStyle}"/>
          </Viewbox>
          <!--<ListView Grid.Row="3" Margin="0,0,0,0" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding LiveViewModel.CoreLiveViewModel}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <ctrl:ValueBar Title="{Binding Name}"
                               Value="{Binding Voltage.Value, TargetNullValue='0'}"
                               Minimum="0"
                               Maximum="2"
                               Style="{StaticResource VoltageIndicatorStyle}"
                               
                               />
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>-->
        </Grid>
        <!-- Powers -->
        <Grid Grid.Column="1" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--<RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>-->
            <!--<RowDefinition Height="*"/>-->
          </Grid.RowDefinitions>
          <!--<TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"
                     Style="{StaticResource ModuleSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.PowerTitle}"/>-->
