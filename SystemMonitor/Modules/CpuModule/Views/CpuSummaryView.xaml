<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:meter="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:ploter="clr-namespace:ResourceModule.Controls.Plotter;assembly=ResourceModule"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Indicator;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule" 
             xmlns:wpfConverters="clr-namespace:WpfConverters;assembly=WpfConverters"
             xmlns:local="clr-namespace:CpuModule.Views" 
             mc:Ignorable="d"
             HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Width="Auto" Height="Auto"
             d:DesignHeight="450" d:DesignWidth="1800">
  <UserControl.Resources>
    <wpfConverters:MHzToGHzConverter x:Key="MHzToGHzConverter"/>
  </UserControl.Resources>
  <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Border Style="{StaticResource ModuleBorderStyle}" Width="Auto" Height="Auto">
      <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ShowGridLines="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <!--<RowDefinition Height="Auto"/>-->
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ShowGridLines="False">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.5cm"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource ModuleTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.ModuleName}"/>
          <UniformGrid Grid.Column="1" Rows="2" Margin="0,0,0,0">
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.VendorNameTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.VendorNameViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.7cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.BrandNameTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.BrandNameViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.FamilyTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.FamilyIdViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.ModelTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.ModelIdViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.SteppingTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.SteppingIdViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                         Text="{x:Static local:ViewDefinitions.BaseSpeedTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.BaseSpeedViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                         Text="{x:Static local:ViewDefinitions.BusSpeedTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.BusSpeedViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.VirtualizationTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}" 
                         Text="{Binding SummaryViewModel.VirtualizationViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                         Text="{x:Static local:ViewDefinitions.SocketNumTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.SocketNumViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                         Text="{x:Static local:ViewDefinitions.PhysicalCoreNumTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.PhysicalCoreNumViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.LogicalCoreNumTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.LogicalCoreNumViewModel}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                         Text="{x:Static local:ViewDefinitions.L1CacheSizeTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}" 
                         Text="{Binding SummaryViewModel.CacheInfoViewModel.L1_Cache_size}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                         Text="{x:Static local:ViewDefinitions.L2CacheSizeTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                         Text="{Binding SummaryViewModel.CacheInfoViewModel.L2_Cache_size}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.L3CacheSizeTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}" 
                         Text="{Binding SummaryViewModel.CacheInfoViewModel.L3_Cache_size}"/>
            </Grid>
            <Grid Width="6cm">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2cm"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.L1CacheLineSizeTitle}"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}" 
                         Text="{Binding SummaryViewModel.CacheInfoViewModel.L1_Cache_Line_size}"/>
            </Grid>
          </UniformGrid>
        </Grid>

        <Grid Grid.Row="1" ShowGridLines="False" Background="Transparent" Margin="1cm">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <!-- Load -->
          <Grid Grid.Row="0" Grid.Column="0" Margin="0cm,.1cm,1.1cm,.1cm">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Style="{StaticResource MeterViewBoxStyle}">
              <meter:MeterControl Label="{x:Static local:ViewDefinitions.UtilizationTitle}" 
                                  Value="{Binding LiveViewModel.CpuOverallLiveViewModel.LoadViewModel}"
                                  Style="{StaticResource LoadsMeterStyle}"/>
            </Viewbox>
            <ploter:PlotterControl Grid.Column="1" 
                                 Margin="0" 
                                 
                                 BorderThickness="0" 
                                 HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch" 
                                 Width="Auto" 
                                 Height="5cm"
                                 
                                 YMin="0" 
                                 YMax="100" 
                                 
                                 TitleText="% Utilization"
                                 ValueText="100%"
                                   Style="{StaticResource LoadPlotterStyle}"
                                 DataSource="{Binding LiveViewModel.CpuOverallLiveViewModel.LoadViewModel, TargetNullValue=0}"/>
          </Grid>
          <!-- Power -->
          <Grid Grid.Row="0" Grid.Column="1" Margin="0cm,.1cm,1.1cm,.1cm">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5cm"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Style="{StaticResource MeterViewBoxStyle}">
              <meter:MeterControl Label="{x:Static local:ViewDefinitions.PowerTitle}" 
                                Value="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerValueViewModel}"
                                MinValue="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerMinViewModel}"
                                MaxValue="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerMaxViewModel}"
                                Unit="Watts"
                                Style="{StaticResource PowerMeterStyle}"/>
            </Viewbox>
            <ploter:PlotterControl Grid.Column="1" 
                                 Margin="0" 
                                 Background="Transparent"
                                 BorderThickness="0" 
                                 HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch" 
                                 Width="Auto" 
                                 Height="5cm"
                                 
                                 YMin="0" 
                                 YMax="100" 
                                 
                                 TitleText="Power"
                                 ValueText="100W"
                                   Style="{StaticResource PowerPlotterStyle}"
                                 DataSource="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerValueViewModel, TargetNullValue=0}"/>
          </Grid>
          <!-- Voltage -->
          <Grid Grid.Row="1" Grid.Column="0" Margin="0cm,.1cm,1.1cm,.1cm">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5cm"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Style="{StaticResource MeterViewBoxStyle}">
              <meter:MeterControl Label="{x:Static local:ViewDefinitions.VoltageTitle}" 
                                Value="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformVoltageValueViewModel}"
                                MinValue="0"
                                MaxValue="3"
                                Unit="Volts"
                                Style="{StaticResource VoltageMeterStyle}"/>
            </Viewbox>
            <ploter:PlotterControl Grid.Column="1" 
                                 Margin="0" 
                                 Background="Transparent"
                                 BorderThickness="0" 
                                 HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch" 
                                 Width="Auto" 
                                 Height="5cm"
                                 YMin="0" 
                                 YMax="3" 
                                 TitleText="Voltage"
                                 ValueText="3V"
                                   Style="{StaticResource VoltagePlotterStyle}"
                                 DataSource="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformVoltageValueViewModel, TargetNullValue=0}"/>
          </Grid>
          <!-- Temperature -->
          <Grid Grid.Row="1" Grid.Column="1" Margin="0cm,.1cm,1.1cm,.1cm">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5cm"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Style="{StaticResource MeterViewBoxStyle}" Width="8.00cm">
              <meter:MeterControl Label="{x:Static local:ViewDefinitions.TemperatureTitle}" 
                                Value="{Binding LiveViewModel.CpuOverallLiveViewModel.TemperatureViewModel}"
                                Unit="Celsius"
                                Style="{StaticResource TemperatureMeterStyle}"/>
            </Viewbox>
            <ploter:PlotterControl Grid.Column="1" 
                                   Background="Transparent" 
                                   BorderThickness="0" 
                                   HorizontalAlignment="Stretch" 
                                   VerticalAlignment="Stretch" 
                                   Width="Auto" 
                                   Height="Auto"
                                   TitleText="Temperature"
                                   ValueText="120°C"
                                   YMin="0" 
                                   YMax="120" 
                                   Style="{StaticResource TemperaturePlotterStyle}"
                                   DataSource="{Binding LiveViewModel.CpuOverallLiveViewModel.TemperatureViewModel, TargetNullValue=0}"/>
          </Grid>
          <!-- Clocks -->
          <Grid Grid.Row="2" Grid.Column="0" Margin="0cm,.1cm,1.1cm,.1cm">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5cm"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Viewbox Grid.Column="0" Style="{StaticResource MeterViewBoxStyle}">
              <meter:MeterControl Label="{x:Static local:ViewDefinitions.SpeedTitle}" 
                               Value="{Binding LiveViewModel.CpuOverallLiveViewModel.SpeedViewModel}"
                               Style="{StaticResource ClockMeterStyle}"/>
            </Viewbox>
            <ploter:PlotterControl Grid.Column="1" 
                                 Margin="0" 
                                 Background="Transparent"
                                 BorderThickness="0" 
                                 HorizontalAlignment="Stretch" 
                                 VerticalAlignment="Stretch" 
                                 Width="Auto" 
                                 Height="5cm"
                                 
                                 YMin="0" 
                                 YMax="6" 
                                 
                                 TitleText="Clock"
                                 ValueText="6 GHz"
                                   Style="{StaticResource ClockPlotterStyle}"
                                 DataSource="{Binding LiveViewModel.CpuOverallLiveViewModel.SpeedViewModel, TargetNullValue=0}"/>
          </Grid>
          <!--<ListView Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding LiveViewModel.CoreLiveViewModel}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <ctrl:ValueBar Title="{Binding Name}"
                               Value="{Binding Temperature.Value, TargetNullValue='0'}"
                               Minimum="{Binding Temperature.Min, TargetNullValue='0'}"
                               Maximum="{Binding Temperature.Max, TargetNullValue='0'}"
                               Style="{StaticResource TemperatureIndicatorStyle}"
                               HorizontalAlignment="Right"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>-->
          <!-- Processes -->
          <Grid Grid.Row="2" Grid.Column="1" Margin=".1cm" HorizontalAlignment="Center" VerticalAlignment="Bottom">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="5.00cm"/>
              <ColumnDefinition Width="5.00cm"/>
              <ColumnDefinition Width="5.00cm"/>
              <ColumnDefinition Width="6.00cm"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
              <TextBlock Style="{StaticResource ProcessThreadHandleTitleStyle}" 
                         Text="{x:Static local:ViewDefinitions.ProcessesTitle}"/>
              <TextBlock Style="{StaticResource ProcessThreadHandleValueStyle}"
                         Text="{Binding LiveViewModel.CpuOverallLiveViewModel.ProcessNum}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
              <TextBlock Style="{StaticResource ProcessThreadHandleTitleStyle}"
       Text="{x:Static local:ViewDefinitions.ThreadsTitle}"/>
              <TextBlock Style="{StaticResource ProcessThreadHandleValueStyle}"
       Text="{Binding LiveViewModel.CpuOverallLiveViewModel.ThreadNum}"/>
            </StackPanel>

            <StackPanel Grid.Column="2" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
              <TextBlock Style="{StaticResource ProcessThreadHandleTitleStyle}"
       Text="{x:Static local:ViewDefinitions.HandlesTitle}"/>
              <TextBlock Style="{StaticResource ProcessThreadHandleValueStyle}"
       Text="{Binding LiveViewModel.CpuOverallLiveViewModel.HandleNum}"/>
            </StackPanel>

            <StackPanel Grid.Column="3" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
              <TextBlock Style="{StaticResource ProcessThreadHandleTitleStyle}"
       Text="{x:Static local:ViewDefinitions.UpTimeTitle}"/>
              <TextBlock Style="{StaticResource ProcessThreadHandleValueStyle}"
       Text="{Binding LiveViewModel.CpuOverallLiveViewModel.UpTime, StringFormat='{}{0:dd\\.hh\\:mm\\:ss}'}"/>
            </StackPanel>

          </Grid>
        </Grid>

        <Grid Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="0.5cm">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="Instruction Set Features Available: " Style="{StaticResource ModuleContentTitleStyle}"
             VerticalAlignment="Top" Margin="10,0,0,0" Foreground="LightYellow" FontSize="0.5cm"/>
          <ItemsControl Grid.Row="1" ItemsSource="{Binding SummaryViewModel.CpuInstructionsViewModel}"
                Margin="20,5" Background="Transparent">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="12" Margin="0,0,10,0"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Width" Value="100"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,-5,0,-5"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Label Content="{Binding Key}" FontWeight="Bold" Margin="0">
                  <Label.Style>
                    <Style TargetType="Label">
                      <Setter Property="Foreground" Value="Gray"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Value}" Value="True">
                          <Setter Property="Foreground" Value="{StaticResource StaticValueTextBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Label.Style>
                </Label>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
