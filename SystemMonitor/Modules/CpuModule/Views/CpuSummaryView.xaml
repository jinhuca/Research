<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:local="clr-namespace:CpuModule.Views" 
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
  <Border BorderBrush="Gray" BorderThickness="3" CornerRadius="15" Margin="10" Background="Black">
    <Grid Margin="10" Width="Auto" Height="325" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="85"/>
        <RowDefinition Height="170"/>
        <RowDefinition Height="60"/>
      </Grid.RowDefinitions>
      
      
      <Grid Grid.Row="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="12"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="1*"/>
          <ColumnDefinition Width="1.0*"/>
          <ColumnDefinition Width="1.3*"/>
          <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                   Style="{StaticResource ModuleTitleTextStyle}" 
                   Text="{x:Static local:ViewDefinitions.ModuleName}"/>
        <Grid Grid.Row="0" Grid.Column="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                     Text="{x:Static local:ViewDefinitions.VendorNameTitle}"/>
          <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding VendorName}"/>
        </Grid>
        <Grid Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                     Text="{x:Static local:ViewDefinitions.BrandNameTitle}"/>
          <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding BrandName}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!--<TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                     Text="{x:Static local:ViewDefinitions.VendorNameTitle}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding VendorName}"/>-->
          
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.BaseSpeedTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding BaseSpeed}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.SocketNumTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding SocketNum}"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.VirtualizationTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding Virtualization}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <!--<TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                     Text="{x:Static local:ViewDefinitions.BrandNameTitle}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding BrandName}"/>-->
          
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
             Text="{x:Static local:ViewDefinitions.L1CacheSizeTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
             Text="{Binding L1CacheSize}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
             Text="{x:Static local:ViewDefinitions.L2CacheSizeTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
             Text="{Binding L2CacheSize}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
             Text="{x:Static local:ViewDefinitions.L3CacheSizeTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
             Text="{Binding L3CacheSize}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="3">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="90"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                   Text="{x:Static local:ViewDefinitions.L1CacheLineSizeTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding L1CacheLineSize}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.L2CacheLineSizeTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding L2CacheLineSize}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.L3CacheLineSizeTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                   Text="{Binding L2CacheLineSize}"/>
        </Grid>

      </Grid>
      
      
      <UniformGrid Grid.Row="1" Rows="1" Background="Black">
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
          <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.UtilizationTitle}"
                               Value="{Binding Utilization}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               MaxValue="100" 
                               Unit="{x:Static ctrl:Unit.Percent}"
                               CtrlBackground="Transparent" 
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FFFFA726"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
        </Viewbox>
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
          <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.SpeedTitle}" 
                               Value="{Binding CurrentSpeed}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               MaxValue="8"
                               Unit="{x:Static ctrl:Unit.GHz}"
                               CtrlBackground="Transparent" 
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FF42A5F5"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
        </Viewbox>
        <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
          <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.TemperatureTitle}" 
                               Value="{Binding Temperature}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               MaxValue="120" 
                               Unit="{x:Static ctrl:Unit.Celsius}"
                               CtrlBackground="Transparent"                             
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FFEF5350"     
                               HorizontalAlignment="Center"/>
        </Viewbox>
      </UniformGrid>
      
      <Grid Grid.Row="2" Margin="0,-30,0,0" Background="Black">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="100"/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" Background="Black">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.ProcessesTitle}"/>
          <TextBlock Grid.Row="1" Style="{StaticResource ModuleContentValueStyle}"
                   Text="{Binding Processes}"/>
        </Grid>
        <Grid Grid.Column="2" Background="Black">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.ThreadsTitle}"/>
          <TextBlock Grid.Row="1" Style="{StaticResource ModuleContentValueStyle}"
                   Text="{Binding Threads}"/>
        </Grid>
        <Grid Grid.Column="3" Background="Black">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.HandlesTitle}"/>
          <TextBlock Grid.Row="1" Style="{StaticResource ModuleContentValueStyle}"
                   Text="{Binding Handles}"/>
        </Grid>
        <Grid Grid.Column="4" Background="Black">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Style="{StaticResource ModuleContentTitleStyle}"
                   Text="{x:Static local:ViewDefinitions.UpTimeTitle}"/>
          <TextBlock Grid.Row="1" Style="{StaticResource ModuleContentValueStyle}"
                   Text="{Binding UpTime, StringFormat='{}{0:dd\\.hh\\:mm\\:ss}'}"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
