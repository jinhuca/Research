                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.MemoryPowerMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.MemoryPowerMaxViewModel}"
                       Style="{StaticResource PowerIndicatorStyle}"/>
          </Grid>-->
          <!--<ListView Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding LiveViewModel.CoreLiveViewModel}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <ctrl:ValueBar Title="{Binding Name}"
                               Value="{Binding Power.Value}"
                               Minimum="{Binding Power.Min}"
                               Maximum="{Binding Power.Max}"
                               Style="{StaticResource PowerIndicatorStyle}"
                               TitleForeground="White"
                               Margin="0,3,0,3"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>-->
        </Grid>
        <!-- Temperatures -->
        <Grid Grid.Column="2" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--<RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>-->
            <!--<RowDefinition Height="*"/>-->
          </Grid.RowDefinitions>
          <!--<TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"
                     Style="{StaticResource ModuleSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.TemperatureTitle}"/>-->
            <Viewbox Grid.Row="0" Style="{StaticResource MeterViewBoxStyle}" Width="8.00cm">
            <meter:MeterControl Label="{x:Static local:ViewDefinitions.TemperatureTitle}" 
                                Value="{Binding LiveViewModel.CpuOverallLiveViewModel.TemperatureViewModel}"
                                Style="{StaticResource TemperatureMeterStyle}"/>
          </Viewbox>
          <!--<Grid Grid.Row="2" VerticalAlignment="Stretch" ShowGridLines="True">
