<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:meter="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Indicator;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule" 
             xmlns:local="clr-namespace:CpuModule.Views" 
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
  <Border Style="{StaticResource ModuleBorderStyle}">
    <Grid Margin="0.5cm" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.00cm"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>

      <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource ModuleTitleTextStyle}" 
                 Text="{x:Static local:ViewDefinitions.ModuleName}"/>

      <Grid Grid.Row="0" Grid.Column="1" VerticalAlignment="Top"  ShowGridLines="False">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                     Margin="0,0,10,0"
                     Text="{x:Static local:ViewDefinitions.VendorNameTitle}"/>
          <TextBlock Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Margin="10,0"
                     Text="{Binding SummaryViewModel.VendorNameViewModel}"/>

          <TextBlock Grid.Column="2" Style="{StaticResource ModuleContentTitleStyle}" 
                     Margin="10,0"
                     Text="{x:Static local:ViewDefinitions.BrandNameTitle}"/>
          <TextBlock Grid.Column="3" Style="{StaticResource ModuleContentTextStyle}"
                     Margin="10,0"
                     Text="{Binding SummaryViewModel.BrandNameViewModel}"/>

          <TextBlock Grid.Column="4" Style="{StaticResource ModuleContentTitleStyle}" 
                     Margin="30,0"
                     Text="{x:Static local:ViewDefinitions.FamilyTitle}"/>
          <TextBlock Grid.Column="5" Style="{StaticResource ModuleContentTextStyle}"
                     Margin="10,0"
                     Text="{Binding SummaryViewModel.FamilyIdViewModel}"/>

          <TextBlock Grid.Column="6" Style="{StaticResource ModuleContentTitleStyle}" 
                     Margin="10,0"
                     Text="{x:Static local:ViewDefinitions.ModelTitle}"/>
          <TextBlock Grid.Column="7" Style="{StaticResource ModuleContentTextStyle}"
                     Margin="10,0"
                     Text="{Binding SummaryViewModel.ModelIdViewModel}"/>

          <TextBlock Grid.Column="8" Style="{StaticResource ModuleContentTitleStyle}" 
                     Margin="10,0"
                     Text="{x:Static local:ViewDefinitions.SteppingTitle}"/>
          <TextBlock Grid.Column="9" Style="{StaticResource ModuleContentTextStyle}"
                     Margin="10,0"
                     Text="{Binding SummaryViewModel.SteppingIdViewModel}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="0" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="0.15cm"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.80cm"/>
            <ColumnDefinition Width="3.5cm"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.BaseSpeedTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.BaseSpeedViewModel}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.BusSpeedTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.BusSpeedViewModel}"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.SocketNumTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.SocketNumViewModel}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="0.15cm"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.80cm"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.PhysicalCoreNumTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.PhysicalCoreNumViewModel}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.LogicalCoreNumTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.LogicalCoreNumViewModel}"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.VirtualizationTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.VirtualizationViewModel}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="0.15cm"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.80cm"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.L1CacheSizeTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L1_Cache_size}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.L2CacheSizeTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L2_Cache_size}"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.L3CacheSizeTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L3_Cache_size}"/>
        </Grid>
        <Grid Grid.Row="1" Grid.Column="3">
          <Grid.RowDefinitions>
            <RowDefinition Height="0.15cm"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3.60cm"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}" 
                     Text="{x:Static local:ViewDefinitions.L1CacheLineSizeTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L1_Cache_Line_size}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.L2CacheLineSizeTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L2_Cache_Line_size}"/>
          <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.L3CacheLineSizeTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding SummaryViewModel.CacheInfoViewModel.L3_Cache_Line_size}"/>
        </Grid>
      </Grid>

      <UniformGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Rows="1">
        <Viewbox Style="{StaticResource MeterViewBoxStyle}">
          <meter:MeterControl Label="{x:Static local:ViewDefinitions.UtilizationTitle}"
                             Value="{Binding LiveViewModel.CpuOverallLiveViewModel.LoadViewModel}"
                             Style="{StaticResource PercentageMeterStyle}"/>
        </Viewbox>
        <Viewbox Style="{StaticResource MeterViewBoxStyle}">
          <meter:MeterControl Label="{x:Static local:ViewDefinitions.SpeedTitle}" 
                               Value="{Binding LiveViewModel.CpuOverallLiveViewModel.SpeedViewModel}"
                               Style="{StaticResource SpeedMeterStyle}"/>
        </Viewbox>
        <Viewbox Style="{StaticResource MeterViewBoxStyle}">
          <meter:MeterControl Label="{x:Static local:ViewDefinitions.TemperatureTitle}" 
                               Value="{Binding LiveViewModel.CpuOverallLiveViewModel.TemperatureViewModel}"
                               Style="{StaticResource TemperatureMeterStyle}"/>
        </Viewbox>
      </UniformGrid>

      <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
        <Grid.ColumnDefinitions>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Row="0" Grid.Column="4" Background="Transparent" MinHeight="40" 
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"
                     
                   Style="{StaticResource ModuleSubTitleTextStyle}"
                   Text="{x:Static local:ViewDefinitions.PowerTitle}"/>
          <ctrl:ValueBar Grid.Row="1" Grid.Column="0" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.PlatFormPowerTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.PlatformPowerMaxViewModel}"
                       Style="{StaticResource PowerIndicatorStyle}"/>
          <ctrl:ValueBar Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.PackagePowerTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.PackagePowerValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.PackagePowerMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.PackagePowerMaxViewModel}"
                       Style="{StaticResource PowerIndicatorStyle}"/>
          <ctrl:ValueBar Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.CoresPowerTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.CoresPowerValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoresPowerMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoresPowerMaxViewModel}"
                       Style="{StaticResource PowerIndicatorStyle}"/>
          <ctrl:ValueBar Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.MemoryPowerTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.MemoryPowerValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.MemoryPowerMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.MemoryPowerMaxViewModel}"
                       Style="{StaticResource PowerIndicatorStyle}"/>
        </Grid>
        
        <Grid Grid.Row="0" Grid.Column="1" Background="Transparent" MinHeight="40" 
              VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,10"
                   Style="{StaticResource ModuleSubTitleTextStyle}"
                   Text="{x:Static local:ViewDefinitions.TemperatureTitle}"/>
          <ctrl:ValueBar Grid.Row="1" Grid.Column="0" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.PackageTemperatureTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.PackageTemperatureValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.PackageTemperatureMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.PackageTemperatureMaxViewModel}"
                       Style="{StaticResource TemperatureIndicatorStyle}"/>
          
          <ctrl:ValueBar Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.CoreAvgTemperatureTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreAvgTemperatureValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreAvgTemperatureMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreAvgTemperatureMaxViewModel}"
                       Style="{StaticResource TemperatureIndicatorStyle}"/>
          
          <ctrl:ValueBar Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"
                       Title="{x:Static local:ViewDefinitions.CoreMaxTemperatureTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreMaxTemperatureValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreMaxTemperatureMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreMaxTemperatureMaxViewModel}"
                       Style="{StaticResource TemperatureIndicatorStyle}"/>
        </Grid>

        <Grid Grid.Row="0" Grid.Column="2" MinHeight="40" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
        </Grid>
      </Grid>

    </Grid>
  </Border>
</UserControl>
