                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.PackageTemperatureMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.PackageTemperatureMaxViewModel}"
                       Style="{StaticResource TemperatureIndicatorStyle}"/>
            <ctrl:ValueBar Grid.Row="1" VerticalAlignment="Center" Margin="0" 
                       Title="{x:Static local:ViewDefinitions.CoreAvgTemperatureTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreAvgTemperatureValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreAvgTemperatureMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreAvgTemperatureMaxViewModel}"
                       Style="{StaticResource TemperatureIndicatorStyle}"/>

            <ctrl:ValueBar Grid.Row="2" VerticalAlignment="Center" Margin="0"
                       Title="{x:Static local:ViewDefinitions.CoreMaxTemperatureTitle}"
                       Value="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreMaxTemperatureValueViewModel}"
                       Minimum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreMaxTemperatureMinViewModel}"
                       Maximum="{Binding LiveViewModel.CpuOverallLiveViewModel.CoreMaxTemperatureMaxViewModel}"
                       Style="{StaticResource TemperatureIndicatorStyle}"/>
          </Grid>-->
          <!--<ListView Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding LiveViewModel.CoreLiveViewModel}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <ctrl:ValueBar Title="{Binding Name}"
                               Value="{Binding Temperature.Value, TargetNullValue='0'}"
                               Minimum="{Binding Temperature.Min, TargetNullValue='0'}"
                               Maximum="{Binding Temperature.Max, TargetNullValue='0'}"
                               Style="{StaticResource TemperatureIndicatorStyle}"
                               HorizontalAlignment="Right"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>-->
        </Grid>
        <!-- Clocks -->
        <Grid Grid.Column="3" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!--<RowDefinition Height="Auto"/>
            <RowDefinition Height="70"/>-->
            <!--<RowDefinition Height="Auto"/>-->
          </Grid.RowDefinitions>
          <!--<TextBlock Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,0"
                     Style="{StaticResource ModuleSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.ClockTitle}"/>-->
            <Viewbox Grid.Row="0" Style="{StaticResource MeterViewBoxStyle}" Width="8.00cm">
            <meter:MeterControl Label="{x:Static local:ViewDefinitions.SpeedTitle}" 
                               Value="{Binding LiveViewModel.CpuOverallLiveViewModel.SpeedViewModel}"
                               Style="{StaticResource ClockMeterStyle}"/>
          </Viewbox>
          <!--<ListView Grid.Row="3" Margin="0,10,0,0" Background="Transparent" BorderThickness="0"
                    ItemsSource="{Binding LiveViewModel.CoreLiveViewModel}">
            <ListView.ItemTemplate>
              <DataTemplate>
                <ctrl:ValueBar Title="{Binding Name}"
                               Value="{Binding Speed.Value, Converter={StaticResource MHzToGHzConverter}}"
                               Minimum="{Binding Speed.Min, Converter={StaticResource MHzToGHzConverter}}"
                               Maximum="{Binding Speed.Max, Converter={StaticResource MHzToGHzConverter}}"
                               Style="{StaticResource ClocksIndicatorStyle}"/>
              </DataTemplate>
            </ListView.ItemTemplate>
          </ListView>-->

        </Grid>
        <!-- Loads -->
        <!--<Grid Grid.Column="4" ShowGridLines="True">
