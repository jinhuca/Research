<UserControl x:Class="CpuModule.Views.CpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:prism="http://prismlibrary.com/" 
             xmlns:local="clr-namespace:CpuModule.Views" 
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
  <Grid Background="LightBlue" ShowGridLines="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="65"/>
      <RowDefinition Height="2*"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Row="0" Grid.Column="0" Background="Transparent">
      <TextBlock Grid.Column="0" Grid.Row="0"
                 Text="CPU" FontSize="42"/>
    </Grid>
    <Grid Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right"
          Background="Black">
      <Grid.RowDefinitions>
        <RowDefinition/>
        <RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Grid.Row="0" HorizontalAlignment="Right"
                 Text="{Binding BrandName}" FontSize="16" Foreground="White"/>
      <TextBlock Grid.Row="1" HorizontalAlignment="Right"
                 Text="{Binding VendorName}" FontSize="16" Foreground="White"/>
    </Grid>

    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Background="Black">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Column="0" Background="Black">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
          <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.UtilizationTitle}"
                               Value="{Binding Utilization}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               MaxValue="100" 
                               Unit="%"
                               CtrlBackground="Transparent" 
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FFEF5350" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
          </Viewbox>
          <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.SpeedTitle}" 
                               Value="{Binding CurrentSpeed}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               
                               MaxValue="8"
                               
                               Unit="GHz"
                               CtrlBackground="Transparent" 
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FF42A5F5"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
          </Viewbox>
        </StackPanel>
      </Grid>

      <Grid Grid.Column="1" Background="LightGray" Margin="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
          </Grid.ColumnDefinitions>
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.BaseSpeedTitle}"/>
          <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding BaseSpeed}"/>

          <TextBlock Grid.Row="1" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.SocketNumTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding SocketNum}"/>

          <TextBlock Grid.Row="2" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.PhysicalCoreNumTitle}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding PhysicalCoresNum}"/>

          <TextBlock Grid.Row="3" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.LogicalCoreNumTitle}"/>
          <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding LogicalCoresNum}"/>

          <TextBlock Grid.Row="4" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.VirtualizationTitle}"/>
          <TextBlock Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding Virtualization}"/>

          <TextBlock Grid.Row="5" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.L1CacheSizeTitle}"/>
          <TextBlock Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding L1CacheSize}"/>

          <TextBlock Grid.Row="6" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.L2CacheSizeTitle}"/>
          <TextBlock Grid.Row="6" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding L2CacheSize}"/>

          <TextBlock Grid.Row="7" Grid.Column="0" HorizontalAlignment="Right"
                   FontSize="18" Margin="0,0,10,0"
                   Text="{x:Static local:ViewDefinitions.L3CacheSizeTitle}"/>
          <TextBlock Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left"
                   FontSize="18"
                   Text="{Binding L3CacheSize}"/>
        </Grid>
      </Grid>
    </Grid>
    <Grid Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Margin="10" Background="LightGray">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition/>
        <ColumnDefinition/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <Grid Grid.Row="0" Grid.Column="0" Background="LightSlateGray">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="12" Text="{x:Static local:ViewDefinitions.UtilizationTitle}"/>
        <TextBlock Grid.Row="1" FontSize="24" Text="{Binding Utilization, StringFormat='{}{0:F2} %'}"/>
      </Grid>
      <Grid Grid.Row="0" Grid.Column="1" Background="LightSlateGray">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="12" Text="{x:Static local:ViewDefinitions.SpeedTitle}"/>
        <TextBlock Grid.Row="1" FontSize="24" Text="{Binding CurrentSpeed, StringFormat='{}{0:F2} GHz'}"/>
      </Grid>
      <Grid Grid.Row="0" Grid.Column="2" Background="LightSlateGray">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="12" Text="{x:Static local:ViewDefinitions.UpTimeTitle}"/>
        <TextBlock Grid.Row="1" FontSize="24" Text="{Binding UpTime, StringFormat='{}{0:dd\\.hh\\:mm\\:ss}'}"/>
      </Grid>
      <Grid Grid.Row="1" Grid.Column="0" Background="LightSlateGray">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="12" Text="{x:Static local:ViewDefinitions.ProcessesTitle}"/>
        <TextBlock Grid.Row="1" FontSize="24" Text="{Binding Processes}"/>
      </Grid>
      <Grid Grid.Row="1" Grid.Column="1" Background="LightSlateGray">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="12" Text="{x:Static local:ViewDefinitions.ThreadsTitle}"/>
        <TextBlock Grid.Row="1" FontSize="24" Text="{Binding Threads}"/>
      </Grid>
      <Grid Grid.Row="1" Grid.Column="2" Background="LightSlateGray">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" FontSize="12" Text="{x:Static local:ViewDefinitions.HandlesTitle}"/>
        <TextBlock Grid.Row="1" FontSize="24" Text="{Binding Handles}"/>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
