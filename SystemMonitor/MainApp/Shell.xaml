<Window x:Class="MainApp.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:MainApp"
        xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
        xmlns:converters="clr-namespace:ResourceModule.Converters;assembly=ResourceModule"
        xmlns:shared="clr-namespace:SharedDefinitions;assembly=SharedDefinitions"
        Icon="pack://application:,,,/sm1.ico"
        mc:Ignorable="d" 
        WindowState="Maximized"
        Background="#333333"
        Title="{x:Static shared:TextDefinitions.AppTitle}">
  <Window.Resources>
    <converters:WindowStateConverter x:Key="WindowStateConverter"/>
  </Window.Resources>
  
  <!-- Maintain Native Windows Behaviors -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" 
                  ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" 
                  GlassFrameThickness="0" 
                  CornerRadius="0"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="Transparent" BorderThickness="2" CornerRadius="5" Margin="3" Background="{StaticResource ShellBackgroundSolidBrush}">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="32"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
      <!-- Custom Title Bar Panel -->
      <Grid Grid.Row="0" Background="{StaticResource TitleBarBackgroundSolidBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Window Title Text -->
        <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                   Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="16"/>

        <!-- Window Caption Buttons Wrapper -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- Minimize Button using Segoe MDL2 Assets Glyph -->
          <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
            <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,15,0,0"/>
          </Button>

          <!-- Maximize / Restore Toggle Button -->
          <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
            <TextBlock x:Name="TxtMaximize" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Text="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowStateConverter}}"/>
          </Button>
          <!-- Close Button with Custom Red Hover State -->
          <Button Click="CloseButton_Click" ToolTip="Close">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                <Style.Triggers>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E81123"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </Button.Style>
            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
          </Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ShowGridLines="False">
          <Grid.RowDefinitions>
            <RowDefinition Height="1.60cm"/>
            <RowDefinition Height="Auto"/>
            <!--<RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>-->
            <!--<RowDefinition Height="2.80cm"/>-->
          </Grid.RowDefinitions>
          <!--<Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>-->
          <ContentControl x:Name="OsRegion" Grid.Row="0"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      prism:RegionManager.RegionName="{x:Static shared:RegionNames.OsRegionName}"/>
          <!--<ContentControl x:Name="HomeRegion" Grid.Row="1" Grid.Column="0" Grid.RowSpan="4" 
                      prism:RegionManager.RegionName="{x:Static shared:RegionNames.HomeRegionName}"/>-->
          <ContentControl x:Name="CpuRegion" Grid.Row="1" 
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      prism:RegionManager.RegionName="{x:Static shared:RegionNames.CpuRegionName}"/>
          <!--<ContentControl x:Name="GpuRegion" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                    prism:RegionManager.RegionName="{x:Static shared:RegionNames.GpuSummaryRegionName}"/>-->
          <!--<ContentControl x:Name="MemoryRegion" Grid.Row="2" Grid.Column="1" 
                    prism:RegionManager.RegionName="{x:Static shared:RegionNames.MemoryRegionName}"/>
      <ContentControl x:Name="StorageRegion" Grid.Row="2" Grid.Column="2" 
                    prism:RegionManager.RegionName="{x:Static shared:RegionNames.StorageRegionName}"/>
      <ContentControl x:Name="BiosRegion" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
                    prism:RegionManager.RegionName="{x:Static shared:RegionNames.BiosRegionName}"/>-->
          <!--<ContentControl x:Name="StasticsRegion" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Stretch"
                    prism:RegionManager.RegionName="{x:Static shared:RegionNames.StatisticsRegionName}"/>-->
        </Grid>
      </Grid>
    </Border>
  
</Window>
