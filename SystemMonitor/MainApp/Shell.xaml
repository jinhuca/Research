<Window x:Class="MainApp.Shell"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:prism="http://prismlibrary.com/"
        xmlns:local="clr-namespace:MainApp"
        xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
        xmlns:converters="clr-namespace:ResourceModule.Converters;assembly=ResourceModule"
        xmlns:shared="clr-namespace:SharedDefinitions;assembly=SharedDefinitions"
        Icon="pack://application:,,,/sm1.ico"
        mc:Ignorable="d" 
        WindowStyle="None"
        AllowsTransparency="True"
        WindowState="Maximized"
        Background="Transparent"
        Title="{x:Static shared:TextDefinitions.AppTitle}">
  <Window.Resources>
    <converters:WindowStateConverter x:Key="WindowStateConverter"/>
  </Window.Resources>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="32" 
                  ResizeBorderThickness="{x:Static SystemParameters.WindowResizeBorderThickness}" 
                  GlassFrameThickness="0" 
                  CornerRadius="5"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="#FF0088FF" BorderThickness="2" CornerRadius="10" Margin="1" Background="Black">
    <Border.Effect>
      <DropShadowEffect Color="#FF00AAFF" BlurRadius="1" ShadowDepth="2" Direction="0" Opacity="1"/>
    </Border.Effect>
    <Grid Margin="0,5,0,5">
      <Grid.RowDefinitions>
        <RowDefinition Height="32"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <!-- Custom Title Bar Panel -->
      <Border Grid.Row="0" Background="#FF112255" CornerRadius="10,10,0,0" Margin="0,-5,0,0">
        <Grid Grid.Row="0" >
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
            <!-- icon -->
            <Image Source="/Assets/IconPng.png" Stretch="Uniform" Margin="10,4,5,2"/>
            <!-- Window Title Text -->
            <TextBlock Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" 
                       Foreground="WhiteSmoke" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="20"/>
          </StackPanel>

          <!-- Window Caption Buttons Wrapper -->
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <!-- Minimize Button using Segoe MDL2 Assets Glyph -->
            <Button Style="{StaticResource TitleBarButtonStyle}" Click="MinimizeButton_Click" ToolTip="Minimize">
              <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="16" Margin="0,15,0,0"/>
            </Button>
            <!-- Maximize / Restore Toggle Button -->
            <Button x:Name="BtnMaximize" Style="{StaticResource TitleBarButtonStyle}" Click="MaximizeButton_Click" ToolTip="Maximize">
              <TextBlock x:Name="TxtMaximize" FontFamily="Segoe MDL2 Assets" FontSize="16"
                       Text="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource WindowStateConverter}}"/>
            </Button>
            <!-- Close Button with Custom Red Hover State -->
            <Button Click="CloseButton_Click" ToolTip="Close">
              <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Background" Value="#E81123"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Button.Style>
              <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="1" ShowGridLines="False">
        <!--<Grid.RowDefinitions>
          <RowDefinition Height="1.60cm"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>-->
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <!--<ContentControl x:Name="OsRegion" Grid.Row="0" Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      prism:RegionManager.RegionName="{x:Static shared:RegionNames.OsRegionName}"/>-->
        <!--<ContentControl x:Name="HomeRegion" Grid.Column="0" Grid.RowSpan="2" 
                      prism:RegionManager.RegionName="{x:Static shared:RegionNames.HomeRegionName}"/>-->
        <Border Grid.Column="0" Grid.RowSpan="2"
                Style="{StaticResource ModuleBorderStyle}" VerticalAlignment="Stretch">
          <UniformGrid Columns="1" Margin="10" Background="Transparent" VerticalAlignment="Top">
            <Button Command="{Binding NavigateCommand}" 
                    CommandParameter="{x:Static shared:ViewNames.CpuViewName}"
                    Style="{StaticResource HomePanelButtonStyle}">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}"/>
                <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource HomePanelTextStyle}"/>
              </Grid>
            </Button>

            <Button Command="{Binding NavigateCommand}" 
                    CommandParameter="{x:Static shared:ViewNames.GpuViewName}"
                    Style="{StaticResource HomePanelButtonStyle}">
              <Grid Margin="0,15,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
                </Border>
                <TextBlock Grid.Column="1" Text="GPU" Style="{StaticResource HomePanelTextStyle}"/>
              </Grid>
            </Button>
            
            <Button Command="{Binding NavigateCommand}" 
                    CommandParameter="{x:Static shared:ViewNames.MemoryViewName}"
                    Style="{StaticResource HomePanelButtonStyle}">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
                </Border>
                <TextBlock Grid.Column="1" Text="Memory" Style="{StaticResource HomePanelTextStyle}"/>
              </Grid>
            </Button>

            <Button Command="{Binding NavigateCommand}" 
                    CommandParameter="{x:Static shared:ViewNames.StorageViewName}"
                    Style="{StaticResource HomePanelButtonStyle}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
                </Border>
                <TextBlock Grid.Column="1" Text="Storage" Style="{StaticResource HomePanelTextStyle}"/>
              </Grid>
            </Button>
            
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
              </Border>
              <TextBlock Grid.Column="1" Text="Wi-Fi" Style="{StaticResource HomePanelTextStyle}"/>
            </Grid>

            <Grid Margin="0,15,0,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
              </Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource HomePanelBorderStyle}">
              </Border>
              <TextBlock Grid.Column="1" Text="Fans" Style="{StaticResource HomePanelTextStyle}"/>
            </Grid>
            
          </UniformGrid>
        </Border>
        <ContentControl x:Name="CpuRegion" Grid.Column="1"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                      prism:RegionManager.RegionName="{x:Static shared:RegionNames.MainContentRegionName}"/>
      </Grid>
    </Grid>
  </Border>

</Window>
