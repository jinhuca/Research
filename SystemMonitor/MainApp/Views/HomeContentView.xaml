<UserControl x:Class="MainApp.Views.HomeContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:shared="clr-namespace:SharedDefinitions;assembly=SharedDefinitions"
             xmlns:plotter="clr-namespace:ResourceModule.Controls.Plotter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:local="clr-namespace:MainApp.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition/>
      <ColumnDefinition/>
    </Grid.ColumnDefinitions>

    <!-- CPU -->
    <Button Style="{StaticResource HomePanelButtonStyle}"
            Grid.Row="0" Grid.Column="0"
            Width="360" Height="100"
            Command="{Binding NavigateCommand}" 
            CommandParameter="{x:Static shared:ViewNames.CpuViewName}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <TextBlock Grid.Row="0" Text="CPU" Style="{StaticResource HomeCaptionTextStyle}"/>
          <plotter:PlotterControl Grid.Row="1" Width="Auto" Height="Auto" 
                                  VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                                  AxisGridStroke="Transparent"
                                  Style="{StaticResource LoadPlotterStyle}"
                                  TitleText=""
                                  ValueText=""
                                  IsTitleEnabled="Collapsed"
                                  DataSource="{Binding CpuLoad}"/>
        </Grid>
        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="70"/>
            <ColumnDefinition/>
          </Grid.ColumnDefinitions>
          <!--<TextBlock Grid.Row="0" Grid.Column="0"
                     Style="{StaticResource HomeSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.VendorName}"/>-->
          <TextBlock Grid.Row="0" Grid.Column="1"
                   Style="{StaticResource HomeValueTextStyle}"
                   Text="{Binding CpuVendor}"/>

          <!--<TextBlock Grid.Row="1" Grid.Column="0"
                     Style="{StaticResource HomeSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.BrandName}"/>-->
          <TextBlock Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource HomeValueTextStyle}"
                     Text="{Binding CpuBrand}"/>

          <!--<TextBlock Grid.Row="2" Grid.Column="0" 
                     Style="{StaticResource HomeSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.ClockInGHz}"/>-->
          <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
            <TextBlock Style="{StaticResource HomeValueTextStyle}"
                     Text="{Binding CpuClock}"/>
            <TextBlock Style="{StaticResource HomeValueTextStyle}"
                       Text=" GHz"/>
          </StackPanel>

          <!--<TextBlock Grid.Row="3" Grid.Column="0" 
                     Style="{StaticResource HomeSubTitleTextStyle}"
                     Text="{x:Static local:ViewDefinitions.LoadInPercentage}"/>-->
          <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <TextBlock Style="{StaticResource HomeValueTextStyle}"
                       Text="{Binding CpuLoad}"/>
            <TextBlock Style="{StaticResource HomeValueTextStyle}"
                       Text=" %"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Button>

    <!-- GPU -->
    <Button Grid.Row="0" Grid.Column="1"
            Width="360" Height="100" 
            Style="{StaticResource HomePanelButtonStyle}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="110"/>
          <ColumnDefinition/>
          <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" 
                   Text="GPU" Style="{StaticResource HomeCaptionTextStyle}"/>
        <Grid Grid.Column="1">
          
        </Grid>
        <Grid Grid.Column="2">

        </Grid>
      </Grid>
    </Button>
  </Grid>
</UserControl>
