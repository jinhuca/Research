<UserControl x:Class="MainApp.Contents.CpuLoadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ploter="clr-namespace:ResourceModule.Controls.Plotter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:local="clr-namespace:MainApp.Contents"
             mc:Ignorable="d">
  <ploter:PlotterControl Style="{StaticResource LoadPlotterStyle}"
                         TitleText="" 
                         ValueText=""
                         IsTitleEnabled="Collapsed"
                         HorizontalAlignment="Stretch"
                         VerticalAlignment="Stretch"
                         PlotStroke="Transparent"/>
</UserControl>
