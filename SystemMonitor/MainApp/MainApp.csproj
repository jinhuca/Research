<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IntermediateOutputPath>$(SolutionDir)\Build\Intermediate\</IntermediateOutputPath>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <BaseOutputPath>$(SolutionDir)\Build</BaseOutputPath>
    <StartupObject>MainApp.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>sm1.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="sm1.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Prism.Core" Version="9.0.537" />
    <PackageReference Include="Prism.Unity" Version="9.0.537" />
    <PackageReference Include="Prism.Wpf" Version="9.0.537" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\BiosModule\BiosModule.csproj" />
    <ProjectReference Include="..\Modules\CpuModule\CpuModule.csproj" />
    <ProjectReference Include="..\Modules\GpuModule\GpuModule.csproj" />
    <ProjectReference Include="..\Modules\LogModule\LogModule.csproj" />
    <ProjectReference Include="..\Modules\MemoryModule\MemoryModule.csproj" />
    <ProjectReference Include="..\Modules\OsModule\OsModule.csproj" />
    <ProjectReference Include="..\Modules\ResourceModule\ResourceModule.csproj" />
    <ProjectReference Include="..\Modules\StorageModule\StorageModule.csproj" />
    <ProjectReference Include="..\Services\CpuInfoServices\CpuInfoServices.csproj" />
    <ProjectReference Include="..\Shared\SharedDefinitions\SharedDefinitions.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\IconPng.png" />
    <Resource Include="sm1.ico" />
  </ItemGroup>

</Project>
