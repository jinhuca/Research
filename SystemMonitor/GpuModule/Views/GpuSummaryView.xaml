<UserControl x:Class="GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:GpuModule.Views"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             mc:Ignorable="d" d:DesignHeight="350" d:DesignWidth="800">
  <UserControl.Resources>
    <converters:ByteUnitConverters x:Key="ByteConverter"/>
  </UserControl.Resources>
  <Border Style="{StaticResource ModuleBorderStyle}">
    <Grid Margin="10" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="100" MinHeight="85"/>
        <RowDefinition Height="180" MinHeight="180"/>
        <RowDefinition Height="40" MinHeight="40"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                 Style="{StaticResource ModuleTitleTextStyle}" 
                 Text="{x:Static local:ViewDefinitions.ModuleName}"/>
      <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="4">
        <Grid.RowDefinitions>
          <RowDefinition/>
          <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" HorizontalAlignment="Left" Margin="20,0,0,0" Width="800">
          <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="1.2*"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Row="0" Grid.Column="0" 
                     Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.BrandName}"/>
          <TextBlock Grid.Row="1" Grid.Column="0" 
                     Style="{StaticResource ModuleContentTextStyle}" 
                     Text="{Binding InternalGpuSummaryViewModel.Name}"/>
          <TextBlock Grid.Row="2" Grid.Column="0" 
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Name}"/>

          <TextBlock Grid.Row="0" Grid.Column="1" 
                     Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.VendorTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.Vendor}"/>
          <TextBlock Grid.Row="2" Grid.Column="1" 
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Vendor}"/>

          <TextBlock Grid.Row="0" Grid.Column="2" 
                     Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.TypeTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="2" 
                     Style="{StaticResource ModuleContentTextStyle}" 
                     Text="{Binding InternalGpuSummaryViewModel.Type}"/>
          <TextBlock Grid.Row="2" Grid.Column="2" 
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Type}"/>
          
          <TextBlock Grid.Row="0" Grid.Column="3" 
                     Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.VersionTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="3"
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.Version}"/>
          <TextBlock Grid.Row="2" Grid.Column="3"
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Version}"/>
          
          <TextBlock Grid.Row="0" Grid.Column="4" 
                     Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.RamTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="4"
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.Ram}"/>
          <TextBlock Grid.Row="2" Grid.Column="4"
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Ram}"/>

          <TextBlock Grid.Row="0" Grid.Column="5" 
                     Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.IdTitle}"/>
          <TextBlock Grid.Row="1" Grid.Column="5" 
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.ID}"/>
          <TextBlock Grid.Row="2" Grid.Column="5" 
                     Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.ID}"/>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</UserControl>
