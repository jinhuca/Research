<UserControl x:Class="GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:GpuModule.Views"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             xmlns:converters="clr-namespace:Converters;assembly=Converters"
             mc:Ignorable="d" d:DesignHeight="350" d:DesignWidth="800">
  <UserControl.Resources>
    <converters:ByteUnitConverters x:Key="ByteConverter"/>
  </UserControl.Resources>
  <Border Style="{StaticResource ModuleBorderStyle}">
    <Grid Margin="0.5cm" Width="Auto" Height="8.00cm" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="2.10cm" MinHeight="2.10cm"/>
        <RowDefinition Height="4.85cm" MinHeight="4.85cm"/>
        <RowDefinition Height="2.80cm" MinHeight="2.80cm"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2.00cm"/>
        <ColumnDefinition/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0"
                 Style="{StaticResource ModuleTitleTextStyle}" 
                 Text="{x:Static local:ViewDefinitions.ModuleName}"/>
      <Grid Grid.Row="0" Grid.Column="1" ShowGridLines="False">
        <Grid.ColumnDefinitions>
          <ColumnDefinition MinWidth="5.00cm"/>
          <ColumnDefinition MinWidth="2.60cm"/>
          <ColumnDefinition MinWidth="3.00cm"/>
          <ColumnDefinition MinWidth="3.00cm"/>
          <ColumnDefinition MinWidth="3.00cm"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Column="0" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.BrandName}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}" 
                     Text="{Binding InternalGpuSummaryViewModel.Name}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Name}"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.TypeTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}" 
                     Text="{Binding InternalGpuSummaryViewModel.Type}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Type}"/>
        </StackPanel>
        <StackPanel Grid.Column="2" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.VersionTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.Version}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Version}"/>
        </StackPanel>
        <StackPanel Grid.Column="3" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.RamTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.Ram}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.Ram}"/>
        </StackPanel>
        <StackPanel Grid.Column="4" Style="{StaticResource TightVerticalKeyValueStackPanelStyle}">
          <TextBlock Style="{StaticResource ModuleContentTitleStyle}"
                     Text="{x:Static local:ViewDefinitions.IdTitle}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding InternalGpuSummaryViewModel.ID}"/>
          <TextBlock Style="{StaticResource ModuleContentTextStyle}"
                     Text="{Binding DedicatedGpuSummaryViewModel.ID}"/>
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Rows="1">
        <Viewbox Style="{StaticResource MeterViewBoxStyle}">
          <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.UtilizationTitle}"
                           Value="{Binding Utilization}" 
                           Style="{StaticResource MeterStyle100}"
                           MinValue="0" 
                           MaxValue="100"
                           Unit="{x:Static ctrl:Unit.Percent}"
                           CtrlBackground="Transparent" 
                           GaugeColor="#FF878A9F" 
                           NeedleColor="#FFFFA726"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"/>
        </Viewbox>
        <Viewbox Style="{StaticResource MeterViewBoxStyle}">
          <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.SpeedTitle}" 
                               Value="{Binding Speed}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               MaxValue="8"
                               Unit="{x:Static ctrl:Unit.GHz}"
                               CtrlBackground="Transparent" 
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FF42A5F5"
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>
        </Viewbox>
        <Viewbox Style="{StaticResource MeterViewBoxStyle}">
          <ctrl:MeterControl Label="{x:Static local:ViewDefinitions.TemperatureTitle}" 
                               Value="{Binding Temperature}" 
                               Style="{StaticResource MeterStyle100}"
                               MinValue="0" 
                               MaxValue="120" 
                               Unit="{x:Static ctrl:Unit.Celsius}"
                               CtrlBackground="Transparent"                             
                               GaugeColor="#FF878A9F" 
                               NeedleColor="#FFEF5350"     
                               HorizontalAlignment="Center"/>
        </Viewbox>

      </UniformGrid>
    </Grid>
  </Border>
</UserControl>
