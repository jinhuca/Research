<UserControl x:Class="GpuModule.Views.GpuSummaryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:ed="http://schemas.microsoft.com/expression/2010/drawing"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:local="clr-namespace:GpuModule.Views"
             xmlns:ctrl="clr-namespace:ResourceModule.Controls.Meter;assembly=ResourceModule"
             xmlns:styles="clr-namespace:ResourceModule;assembly=ResourceModule"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800">
  <Border Style="{StaticResource ModuleBorderStyle}">
    <Grid Margin="10" ShowGridLines="False">
      <Grid.RowDefinitions>
        <RowDefinition Height="85" MinHeight="85"/>
        <RowDefinition Height="180" MinHeight="180"/>
        <RowDefinition Height="60" MinHeight="40"/>
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="80"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                 Style="{StaticResource ModuleTitleTextStyle}" 
                 Text="{x:Static local:ViewDefinitions.ModuleName}"/>
      <ItemsControl Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" Grid.RowSpan="3"
                    ItemsSource="{Binding GpuSummaryList}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Margin="5">
              <TextBlock Text="{Binding Key}" FontWeight="Bold" Margin="0,0,10,0" Style="{StaticResource ModuleContentTextStyle}" VerticalAlignment="Top"/>
              <ItemsControl ItemsSource="{Binding Value}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Key}" Style="{StaticResource ModuleContentTitleStyle}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Value}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Vertical" Margin="0,0,10,0">
                      <TextBlock Text="{Binding Value}" Style="{StaticResource ModuleContentTextStyle}"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>

      </ItemsControl>
    </Grid>
  </Border>
</UserControl>
