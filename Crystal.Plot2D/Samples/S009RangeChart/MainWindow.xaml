<Window x:Class="S009RangeChart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:S009RangeChart"
        xmlns:d3="http://schemas.crystal.com/Plot2D"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
  <Grid>
    <!-- The main plotter canvas -->
    <d3:Plotter Name="plotter">
      <d3:Header Content="Daily Temperature Range"/>
      <d3:VerticalAxisTitle Content="Temperature (°C)"/>
      <d3:HorizontalAxisTitle Content="Day"/>
    </d3:Plotter>
  </Grid>
</Window>
