<Window x:Class="ProgressBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProgressBar" 
        xmlns:ctrl="clr-namespace:ProgressBar.ValueRange"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
  <Window.Resources>
    <VisualBrush x:Key="DashBrush" TileMode="Tile" Viewport="0,0,5,5" ViewportUnits="Absolute">
      <VisualBrush.Visual>
        <Canvas>
          <!-- This rectangle represents one dash -->
          <Rectangle Width="6" Height="10" Fill="Transparent"/>
          <Rectangle Width="3" Height="10" Fill="Green"/>
        </Canvas>
      </VisualBrush.Visual>
    </VisualBrush>
    <!-- Custom Style for the ProgressBar -->
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="Root">
              <!-- The Track (background of the bar) -->
              <Border x:Name="PART_Track" 
                                Background="LightGray" 
                                CornerRadius="2" />
              <!-- The Indicator (the actual progress part) -->
              <Border x:Name="PART_Indicator" 
                                HorizontalAlignment="Left" 
                                Background="{StaticResource DashBrush}" 
                                CornerRadius="2" />
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition/>
      <RowDefinition/>
      <RowDefinition/>
      <RowDefinition/>
    </Grid.RowDefinitions>
    <ProgressBar Grid.Row="0" Width="200" Height="30" Value="56" Minimum="0" Maximum="100" Orientation="Vertical"/>
    <StatusBar Grid.Row="1" VerticalAlignment="Center" Width="200" Height="30">
      <StatusBarItem>
        <TextBlock Text="Ready" />
      </StatusBarItem>
      <Separator />
      <StatusBarItem HorizontalContentAlignment="Stretch">
        <ProgressBar Value="50" Width="100" Height="15"/>
      </StatusBarItem>
    </StatusBar>

    <StatusBar Grid.Row="2" Name="sbar" HorizontalAlignment="Center"
           VerticalAlignment="Center" Background="Beige" >

      <StatusBarItem>
        <TextBlock>Downloading File</TextBlock>
      </StatusBarItem>
      <StatusBarItem>
        <ProgressBar Width="100" Height="20"
                 Name="progressBar1">
          <ProgressBar.Triggers>
            <EventTrigger RoutedEvent="ProgressBar.Loaded">
              <BeginStoryboard>
                <Storyboard>
                  <DoubleAnimation
                Storyboard.TargetName="progressBar1" 
                Storyboard.TargetProperty="Value"
                From="0" To="100" Duration="0:0:5"  />
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ProgressBar.Triggers>
        </ProgressBar>
      </StatusBarItem>
      <Separator/>
      <StatusBarItem>
        <TextBlock>Online</TextBlock>
      </StatusBarItem>l
      <!--<StatusBarItem HorizontalAlignment="Right">
        <Image Source="images\help.bmp" Width="16" Height="16"/>
      </StatusBarItem>-->
    </StatusBar>


    <ctrl:ValueIndicator Grid.Row="3" ControlFontFamily="Arial" ControlFontSize="12" ControlFontWeight="Regular"
                         IndicatorHeight="20" IndicatorWidth="180"
                         Title="Core # 02" TitleFontSize="20" TitleForeground="DarkRed"
                         ValueId="Temperature"
                         Value="56.226321" Minimum="0" Maximum="120" ValueFontSize="13" ValueForeground="Green"
                         SeparatorWidth="5" 
                         Unit="%" UnitFontSize="15" UnitForeground="DarkBlue"
                         MaxTitle="Max: ">

    </ctrl:ValueIndicator>

  </Grid>
</Window>
